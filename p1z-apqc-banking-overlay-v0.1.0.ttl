    skos:prefLabel "Number of new hires per FTE that perform the process group \"manage employee on-boarding, development, and training\"" ;
    p1z:apqcMetricId "112946" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Total number of new hires / Number of FTEs that perform the process group \"manage employee on-boarding, development, and training\"" ;
    p1z:units "hires" .

apqc:MET103624 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the processes \"manage employee development\" and \"develop and train employees\" per $1,000 revenue" ;
    p1z:apqcMetricId "103624" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Total cost to perform the processes \"manage employee development\" and \"develop and train employees\" / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET112948 a p1z:Metric ;
    skos:prefLabel "Percentage of FTEs that perform the process group \"manage employee on-boarding, development, and training\" that perform the process \"manage employee development\"" ;
    p1z:apqcMetricId "112948" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs that perform the process \"manage employee development\" / Number of FTEs that perform the process group \"manage employee on-boarding, development, and training\") * 100" ;
    p1z:units "percent" .

apqc:MET112957 a p1z:Metric ;
    skos:prefLabel "Percentage of FTEs that perform the HR function that perform the process group \"manage employee on-boarding, development, and training\"" ;
    p1z:apqcMetricId "112957" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs that perform the process group \"manage employee on-boarding, development, and training\" / Number of FTEs who perform the function \"develop and manage human capital\") * 100" ;
    p1z:units "percent" .

apqc:MET112846 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the process group \"manage employee on-boarding, development, and training\" per process group FTE" ;
    p1z:apqcMetricId "112846" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Systems cost to perform process group \"manage employee on-boarding, development, and training\" / Number of FTEs that perform the process group \"manage employee on-boarding, development, and training\"" ;
    p1z:units "dollars" .

apqc:MET112950 a p1z:Metric ;
    skos:prefLabel "Percentage of FTEs that perform the process group \"manage employee on-boarding, development, and training\" that perform the process \"develop and train employees\"" ;
    p1z:apqcMetricId "112950" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs that perform the process \"develop and train employees\" / Number of FTEs that perform the process group \"manage employee on-boarding, development, and training\") * 100" ;
    p1z:units "percent" .

apqc:MET112958 a p1z:Metric ;
    skos:prefLabel "Internal cost to perform learning administration activities per FTE in learning administration" ;
    p1z:apqcMetricId "112958" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Internal cost for learning administration (excluding activities for processing and distributing payments) / Number of FTEs who perform learning administrative activities (exclude activities for processing and distributing payments)" ;
    p1z:units "dollars" .

apqc:MET107951 a p1z:Metric ;
    skos:prefLabel "Estimate if not using AI - Total IT cost, excluding depreciation/amortization, as a percentage of revenue" ;
    p1z:apqcMetricId "107951" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Estimate if not using AI - Total annual IT cost, excluding depreciation/amortization (i.e., based on cash flow) as a percentage of revenue" ;
    p1z:units "percent" .

apqc:MET105538 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the finance function as a percentage of internal finance function cost" ;
    p1z:apqcMetricId "105538" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Systems cost to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

apqc:MET105540 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the finance function as a percentage of internal finance function cost" ;
    p1z:apqcMetricId "105540" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

apqc:MET105539 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the finance function as a percentage of internal finance function cost" ;
    p1z:apqcMetricId "105539" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Overhead cost to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

apqc:MET112885 a p1z:Metric ;
    skos:prefLabel "Total DWEs in process group \"perform planning and management accounting\" per 1,000 business entity FTEs" ;
    p1z:apqcMetricId "112885" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Total number of DWEs in process group \"perform planning and management accounting\" / (Number of business entity FTEs * .001)" ;
    p1z:units "DWEs" .

apqc:MET106083 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process group \"perform revenue accounting\" per $100,000 revenue" ;
    p1z:apqcMetricId "106083" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Overhead cost to perform the process \"process customer credit\" + Overhead cost to perform the process \"invoice customer\" + Overhead cost to perform the process \"process accounts receivable (AR)\" + Overhead cost to perform the process \"manage and process collections\" + Overhead cost to perform the process \"manage and process adjustments/deductions\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"process customer credit\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"invoice customer\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"process accounts receivable (AR)\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process collections\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * 0.00001)" ;
    p1z:units "dollars" .

apqc:MET105949 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the processes \"process accounts receivable (AR)\", \"manage and process collections\", and \"manage and process adjustments/deductions\" per $100,000 revenue" ;
    p1z:apqcMetricId "105949" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Overhead cost to perform the process \"process accounts receivable (AR)\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"process accounts receivable (AR)\" +  Overhead cost to perform the process \"manage and process collections\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process collections\" + Overhead cost to perform the process \"manage and process adjustments/deductions\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .00001)" ;
    p1z:units "dollars" .

apqc:MET112596 a p1z:Metric ;
    skos:prefLabel "Number of active customers managed per FTE that performs the order to invoice processes" ;
    p1z:apqcMetricId "112596" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Number of active customers in customer master file / (Number of FTEs who perform the process \"manage sales orders\" + Number of FTEs who perform the process \"process customer credit\" + Number of FTEs who perform the process \"invoice customer\")" ;
    p1z:units "active customers" .

apqc:MET105941 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the processes \"process accounts receivable (AR)\", \"manage and process collections\", and \"manage and process adjustments/deductions\" per $100,000 revenue" ;
    p1z:apqcMetricId "105941" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the process \"process accounts receivable (AR)\" +  Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process collections\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .00001)" ;
    p1z:units "dollars" .

apqc:MET105961 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the processes \"process accounts receivable (AR)\", \"manage and process collections\", and \"manage and process adjustments/deductions\" per $100,000 revenue" ;
    p1z:apqcMetricId "105961" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Overhead cost to perform the process \"process accounts receivable (AR)\" +  Overhead cost to perform the process \"manage and process collections\" + Overhead cost to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .00001)" ;
    p1z:units "dollars" .

apqc:MET105945 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the processes \"process accounts receivable (AR)\", \"manage and process collections\", and \"manage and process adjustments/deductions\" per $1,000 revenue" ;
    p1z:apqcMetricId "105945" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Outsourced cost to perform the process \"process accounts receivable (AR)\" +  Outsourced cost to perform the process \"manage and process collections\" + Outsourced cost to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET105561 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the process \"process accounts receivable (AR)\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105561" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the process \"process accounts receivable (AR)\" allocated to external costs" ;
    p1z:units "percent" .

apqc:MET105567 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"process accounts receivable (AR)\" per $100,000 revenue" ;
    p1z:apqcMetricId "105567" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Percentage of internal costs of the process \"process accounts receivable (AR)\" allocated to overhead and other costs * Percentage of total cost to perform the process \"process accounts receivable (AR)\" allocated to internal costs * 0.0001 * Total cost to perform the process \"process accounts receivable (AR)\") / (Total business entity revenue * .00001)" ;
    p1z:units "dollars" .

apqc:MET105957 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the process \"process accounts receivable (AR)\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105957" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Overhead cost to perform the process \"process accounts receivable (AR)\" / Total cost to perform the process \"process accounts receivable (AR)\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105566 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"process accounts receivable (AR)\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105566" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Overhead cost to perform the process \"process accounts receivable (AR)\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"process accounts receivable (AR)\") / Total cost to perform the process \"process accounts receivable (AR)\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105937 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the process \"process accounts receivable (AR)\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105937" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the process \"process accounts receivable (AR)\" / Total cost to perform the process \"process accounts receivable (AR)\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105564 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"manage and process collections\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105564" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Overhead cost to perform the process \"manage and process collections\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process collections\") / Total cost to perform the process \"manage and process collections\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105935 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the process \"manage and process collections\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105935" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process collections\" / Total cost to perform the process \"manage and process collections\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105955 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the process \"manage and process collections\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105955" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Overhead cost to perform the process \"manage and process collections\" / Total cost to perform the process \"manage and process collections\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105565 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"manage and process collections\" per $1,000 revenue" ;
    p1z:apqcMetricId "105565" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"manage and process collections\" * Percentage of total cost of the process \"manage and process collections\" allocated to internal costs * Percentage of internal costs of the process \"manage and process collections\" allocated to overhead and other costs * 0.0001) / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET105562 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"manage and process adjustments/deductions\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105562" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Overhead cost to perform the process \"manage and process adjustments/deductions\" + Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process adjustments/deductions\") / Total cost to perform the process \"manage and process adjustments/deductions\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105563 a p1z:Metric ;
    skos:prefLabel "Overhead and other costs to perform the process \"manage and process adjustments/deductions\" per $1,000 revenue" ;
    p1z:apqcMetricId "105563" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"manage and process adjustments/deductions\" * Percentage of total cost of the process \"manage and process adjustments/deductions\" allocated to internal costs * Percentage of internal costs of the process \"manage and process adjustments/deductions\" allocated to overhead and other costs * 0.0001) / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET105933 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the process \"manage and process adjustments/deductions\" as a percentage of total process cost" ;
    p1z:apqcMetricId "105933" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the process \"manage and process adjustments/deductions\" / Total cost to perform the process \"manage and process adjustments/deductions\") * 100.0" ;
    p1z:units "percent" .

apqc:MET105559 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the process \"manage and process adjustments/deductions\" as a percentage of total process cost" ;
