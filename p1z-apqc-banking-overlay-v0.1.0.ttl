# Industry-new metrics (109) and cross-maps

apqc:MET105231 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105231" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to internal personnel cost" ;
    p1z:units "percent" .

apqc:MET105234 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105234" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to internal overhead cost" ;
    p1z:units "percent" .

apqc:MET105229 a p1z:Metric ;
    skos:prefLabel "Equipment cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105229" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to equipment cost" ;
    p1z:units "percent" .

apqc:MET105237 a p1z:Metric ;
    skos:prefLabel "Variable cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105237" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to variable cost" ;
    p1z:units "percent" .

apqc:MET105230 a p1z:Metric ;
    skos:prefLabel "Material cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105230" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to material cost" ;
    p1z:units "percent" .

apqc:MET105236 a p1z:Metric ;
    skos:prefLabel "Fixed cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105236" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to fixed cost" ;
    p1z:units "percent" .

apqc:MET105233 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105233" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to outsourced cost" ;
    p1z:units "percent" .

apqc:MET105232 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105232" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to internal systems cost" ;
    p1z:units "percent" .

apqc:MET105235 a p1z:Metric ;
    skos:prefLabel "Other costs to perform the function \"develop and manage products and services\" as a percentage of total cost" ;
    p1z:apqcMetricId "105235" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to costs other than equipment, material, internal personnel, internal systems, internal overhead, or outsourced costs" ;
    p1z:units "percent" .

apqc:MET112594 a p1z:Metric ;
    skos:prefLabel "Number of supply chain function FTEs per $1 billion revenue" ;
    p1z:apqcMetricId "112594" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Total number of FTEs that perform the supply chain function / (Total business entity revenue * .000000001)" ;
    p1z:units "FTEs" .

apqc:MET112592 a p1z:Metric ;
    skos:prefLabel "Number of active suppliers in vendor master file per $1 million revenue" ;
    p1z:apqcMetricId "112592" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of active unique suppliers in vendor master file / (Total business entity revenue * .000001)" ;
    p1z:units "active vendors" .

apqc:MET112359 a p1z:Metric ;
    skos:prefLabel "Number of purchase order line items per FTE that performs the process group \"procure materials and services\"" ;
    p1z:apqcMetricId "112359" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Number of purchase order line items processed / Number of FTEs who perform the process group \"procure materials and services\"" ;
    p1z:units "purchase order line items" .

apqc:MET112358 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the process \"select suppliers and develop/maintain contracts\" per process FTE" ;
    p1z:apqcMetricId "112358" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Personnel cost to perform the process \"select suppliers and develop/maintain contracts\" / Number of FTEs who perform the process \"select suppliers and develop/maintain contracts\"" ;
    p1z:units "dollars" .

apqc:MET112838 a p1z:Metric ;
    skos:prefLabel "12-month difference in warranty costs (repair and replacement) as a percentage of sales" ;
    p1z:apqcMetricId "112838" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Warranty costs as a percentage of sales - Warranty costs as a percentage of sales measured 12 months ago" ;
    p1z:units "percent" .

apqc:MET112839 a p1z:Metric ;
    skos:prefLabel "12-month difference in finished-product first-pass quality yield for primary products" ;
    p1z:apqcMetricId "112839" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Finished product first-pass quality yield for primary products - Finished product first-pass quality yield for primary products measured 12 months ago" ;
    p1z:units "percent" .

apqc:MET105122 a p1z:Metric ;
    skos:prefLabel "Number of new retail deposit account applications initiated through contact centers as a percentage of total new applications initiated" ;
    p1z:apqcMetricId "105122" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of new retail deposit account applications initiated through contact centers / Total number of new retail deposit account applications initiated) * 100" ;
    p1z:units "percent" .

apqc:MET105412 a p1z:Metric ;
    skos:prefLabel "Annual rate of growth in number of deposit accounts (all types)" ;
    p1z:apqcMetricId "105412" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of retail deposit accounts opened in the last 12 months - Number of retail deposit accounts discontinued in the last 12 months) / Total number of retail deposit accounts held" ;
    p1z:units "percent" .

apqc:MET105088 a p1z:Metric ;
    skos:prefLabel "Cycle time (in business days) to process a new retail deposit account application" ;
    p1z:apqcMetricId "105088" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time (in business days) to process a new retail deposit account applications" ;
    p1z:units "days" .

apqc:MET105411 a p1z:Metric ;
    skos:prefLabel "Retail deposit accounts opened as a percentage of applications initiated (all types and channels)" ;
    p1z:apqcMetricId "105411" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of retail deposit accounts opened in the last 12 months / Total number of new retail deposit account applications initiated) * 100" ;
    p1z:units "percent" .

apqc:MET105095 a p1z:Metric ;
    skos:prefLabel "Percentage of FTEs who perform the process \"open accounts\" allocated to branch banking activities" ;
    p1z:apqcMetricId "105095" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
