    p1z:formula "Labor related cost savings as a percentage of total savings generated by finance shared services center" ;
    p1z:units "Percent" .

apqc:MET105550 a p1z:Metric ;
    skos:prefLabel "Percentage of non-labor savings out of total savings observed through implementation of a finance shared services center" ;
    p1z:apqcMetricId "105550" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Cost savings other than labor related or non-labor related as a percentage of total savings generated by the shared services center" ;
    p1z:units "percent" .

apqc:MET105552 a p1z:Metric ;
    skos:prefLabel "Percentage of journal entries that are automated or system generated at the finance shared services center" ;
    p1z:apqcMetricId "105552" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of journal entry line items recorded to the general ledger using automated methods" ;
    p1z:units "Percent" .

apqc:MET105553 a p1z:Metric ;
    skos:prefLabel "Total number of finance employees dedicated to \"Problem desk\" or \"Customer Care\" inquiries as a percentage of finance shared services center employees" ;
    p1z:apqcMetricId "105553" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of dedicated finance employees fielding incoming finance inquiries / Number of Shared Services Center Employees) * 100" ;
    p1z:units "Percent" .

apqc:MET106016 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the finance function per business entity employee" ;
    p1z:apqcMetricId "106016" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Total cost to perform the function \"manage financial resources\" / Number of business entity employees" ;
    p1z:units "dollars" .

apqc:MET106019 a p1z:Metric ;
    skos:prefLabel "Number of business entity employees per finance function FTE" ;
    p1z:apqcMetricId "106019" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Number of business entity employees / Number of FTEs who perform the function \"manage financial resources\"" ;
    p1z:units "employees" .

apqc:MET106072 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the order-to-cash processes per $1 billion revenue" ;
    p1z:apqcMetricId "106072" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process \"manage sales orders\" + Number of FTEs who perform the process \"process customer credit\" + Number of FTEs who perform the process \"invoice customer\" + Number of FTEs who perform the process \"process accounts receivable (AR)\" + Number of FTEs who perform the process \"manage and process collections\" + Number of FTEs who perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .000000001)" ;
    p1z:units "FTEs" .

apqc:MET106073 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the order-to-cash processes per $1,000 revenue" ;
    p1z:apqcMetricId "106073" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"manage sales orders\" + Total cost to perform the process \"process customer credit\" + Total cost to perform the process \"invoice customer\" + Total cost to perform the process \"process accounts receivable (AR)\" + Total cost to perform the process \"manage and process collections\" + Total cost to perform the process \"manage and process adjustments/deductions\") / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET106169 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the order-to-cash processes per process FTE" ;
    p1z:apqcMetricId "106169" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"manage sales orders\" + Total cost to perform the process \"process customer credit\" + Total cost to perform the process \"invoice customer\" + Total cost to perform the process \"process accounts receivable (AR)\" + Total cost to perform the process \"manage and process collections\" + Total cost to perform the process \"manage and process adjustments/deductions\") / (Number of FTEs who perform the process \"manage sales orders\" + Number of FTEs who perform the process \"process customer credit\" + Number of FTEs who perform the process \"invoice customer\" + Number of FTEs who perform the process \"process accounts receivable (AR)\" + Number of FTEs who perform the process \"manage and process collections\" + Number of FTEs who perform the process \"manage and process adjustments/deductions\")" ;
    p1z:units "dollars" .

apqc:MET106341 a p1z:Metric ;
    skos:prefLabel "Average span of control for the finance function" ;
    p1z:apqcMetricId "106341" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Average span of control for the finance function" ;
    p1z:units "direct reports" .

apqc:MET106344 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the finance function as a percentage of selling, general, and administrative (SGA) costs" ;
    p1z:apqcMetricId "106344" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the function \"manage financial resources\" / Total SG&A costs) * 100" ;
    p1z:units "percent" .

apqc:MET106457 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the finance function per $100,000 revenue" ;
    p1z:apqcMetricId "106457" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\") / (Total business entity revenue * .00001)" ;
    p1z:units "dollars" .

apqc:MET106458 a p1z:Metric ;
    skos:prefLabel "Amount of recurring non-labor savings generated from the implementation of a finance shared services center per $1,000 revenue" ;
    p1z:apqcMetricId "106458" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Approximate value of recurring non-labor savings from implementing finance shared services center / (Total business entity revenue * 0.001)" ;
    p1z:units "dollars" .

apqc:MET107429 a p1z:Metric ;
    skos:prefLabel "Cycle time in days to perform the order-to-cash (O2C) processes" ;
    p1z:apqcMetricId "107429" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in days to perform the order-to-cash (O2C) processes" ;
    p1z:units "days" .

apqc:MET107608 a p1z:Metric ;
    skos:prefLabel "Number of employees per legal entity supported by the finance shared services center" ;
    p1z:apqcMetricId "107608" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Number of business entity employees / Number of legal entities the shared services organization supports" ;
    p1z:units "employees" .

apqc:MET107609 a p1z:Metric ;
    skos:prefLabel "Percentage of other savings out of total savings observed through implementation of a finance shared services center" ;
    p1z:apqcMetricId "107609" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Cost savings other than labor related or non-labor related generated by the shared services center" ;
    p1z:units "percent" .

apqc:MET107854 a p1z:Metric ;
    skos:prefLabel "Percentage change in finance function FTEs over the past 12 months" ;
    p1z:apqcMetricId "107854" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "((Number of finance function FTEs (including contractors and outsourced resources) that were added/hired in the past 12 months - Number of finance function FTEs (including contractors and outsourced resources) that were eliminated/redeployed in the past 12 months) / ((Number of FTEs who perform the function \"manage financial resources\" - Number of finance function FTEs (including contractors and outsourced resources) that were added/hired in the past 12 months + Number of finance function FTEs (including contractors and outsourced resources) that were eliminated/redeployed in the past 12 months)^2)^0.5) * 100" ;
    p1z:units "percent" .

apqc:MET107855 a p1z:Metric ;
    skos:prefLabel "Percentage of finance function FTEs added/hired in the past 12 months attributed to AI" ;
    p1z:apqcMetricId "107855" ;
