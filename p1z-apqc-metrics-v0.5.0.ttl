    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of current finance function FTEs that had skill requirement changes in the past 12 months" ;
    p1z:units "percent" .

apqc:MET107859 a p1z:Metric ;
    skos:prefLabel "Average number of learning days per finance function employee" ;
    p1z:apqcMetricId "107859" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Average number of learning days per finance function employee" ;
    p1z:units "days" .

apqc:MET107861 a p1z:Metric ;
    skos:prefLabel "Learning budget per finance function employee" ;
    p1z:apqcMetricId "107861" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Learning budget per finance function employee" ;
    p1z:units "dollars" .

apqc:MET108021 a p1z:Metric ;
    skos:prefLabel "Total cost to perform record-to-report processes per $1 billion revenue" ;
    p1z:apqcMetricId "108021" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"perform fixed-asset accounting\" + Total cost to perform the process \"manage policies and procedures\" + Total cost to perform the process \"perform general accounting\" + Total cost to perform the process \"perform financial reporting\" + Total cost to perform the process \"perform capital project accounting\") / (Total business entity revenue * .000000001)" ;
    p1z:units "dollars" .

apqc:MET108217 a p1z:Metric ;
    skos:prefLabel "Total cost of continuing operations as percentage of revenue" ;
    p1z:apqcMetricId "108217" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total costs of continuing operations / Total business entity revenue) * 100" ;
    p1z:units "percent" .

