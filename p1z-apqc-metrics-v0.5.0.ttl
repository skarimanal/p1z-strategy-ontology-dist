    p1z:units "dollars" .

apqc:MET111414 a p1z:Metric ;
    skos:prefLabel "Percentage of total finance chatbots and automated bots that are chatbots" ;
    p1z:apqcMetricId "111414" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of chatbots (distinct from bots) running in finance organization today / (Number of chatbots (distinct from bots) running in finance organization today + Number of automated bots (not chatbots) running in finance organization today)) * 100" ;
    p1z:units "percent" .

apqc:MET111415 a p1z:Metric ;
    skos:prefLabel "Percentage of total finance chatbots and automated bots that are automated bots" ;
    p1z:apqcMetricId "111415" ;
    p1z:metricClass p1zv:OperationalDriver ;
