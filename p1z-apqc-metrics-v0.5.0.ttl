    p1z:formula "(Research and development (R&D) costs (three reporting periods prior) / Total revenue (three reporting periods prior)) * 100.0" ;
    p1z:units "percent" .

apqc:MET104144 a p1z:Metric ;
    skos:prefLabel "Total R&D cost per $1,000 revenue (three reporting periods prior)" ;
