apqc:MET108996 a p1z:Metric ;
    skos:prefLabel "Personnel cost budgeted to perform the sales function per sales function FTE" ;
    p1z:apqcMetricId "108996" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Budget for sales * Percentage of sales budget allocated to personnel cost * .01) / (Number of FTEs who perform sales function activities and operate in the sales function + Number of FTEs who perform sales function activities and operate outside the sales function)" ;
    p1z:units "dollars" .

apqc:MET108997 a p1z:Metric ;
    skos:prefLabel "Closed deals with B2B customers per active B2B customer account" ;
    p1z:apqcMetricId "108997" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of closed deals with B2B customers / Number of active B2B customers" ;
    p1z:units "deals" .

apqc:MET109037 a p1z:Metric ;
    skos:prefLabel "Budget for sales & marketing as a percentage of revenue" ;
    p1z:apqcMetricId "109037" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Budget for marketing + Budget for sales) / Total business entity revenue) * 100.0" ;
    p1z:units "percent" .

apqc:MET109038 a p1z:Metric ;
    skos:prefLabel "Number of sales & marketing FTEs as a percentage of total business entity FTEs" ;
    p1z:apqcMetricId "109038" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Number of FTEs who perform the sales function + Number of FTEs who perform the marketing function) / Number of business entity FTEs) * 100.0" ;
    p1z:units "percent" .

apqc:MET109039 a p1z:Metric ;
    skos:prefLabel "Number of sales & marketing FTEs per $1 billion revenue" ;
    p1z:apqcMetricId "109039" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the sales function + Number of FTEs who perform the marketing function) / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

