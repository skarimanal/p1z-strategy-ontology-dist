    p1z:units "contacts" .

apqc:MET107288 a p1z:Metric ;
    skos:prefLabel "Percentage change in customer service FTEs (including external) over the past 12 months" ;
    p1z:apqcMetricId "107288" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Number of customer service FTEs (including external) added/hired in the past 12 months - Number of customer service FTEs (including external) eliminated/redeployed in the past 12 months) / ((Number of customer service FTEs (including external) - Number of customer service FTEs (including external) added/hired in the past 12 months + Number of customer service FTEs (including external) eliminated/redeployed in the past 12 months)^2)^0.5) * 100" ;
    p1z:units "percent" .

