    p1z:apqcMetricId "105618" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Total cost to perform the process \"report time\" * Percentage of total cost to perform the process \"report time\" allocated to internal costs  * Percentage of internal cost to perform the process \"report time\" allocated to systems costs * 0.0001) + (Total cost to perform the process \"manage pay\" * Percentage of total cost of the process \"manage pay\" allocated to internal costs * Percentage of internal cost to perform the process \"manage pay\" allocated to systems costs * 0.0001) + (Total cost to perform the process \"process payroll taxes\" * Percentage of total cost to perform the process \"process payroll taxes\" allocated to internal costs * Percentage of internal cost to perform the process \"process payroll taxes\" allocated to systems costs * 0.0001)) / Total number of employees paid" ;
    p1z:units "dollars" .

