apqc:MET104723 a p1z:Metric ;
    skos:prefLabel "Cycle time in days from identifying the need to hire a new employee until new hire begins in the agreed position" ;
    p1z:apqcMetricId "104723" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in days from identifying the need to hire a new employee to approval of job requisition + Cycle time in days from approval of job requisition to acceptance of job offer + Cycle time in days from job offer acceptance until new hire begins in the agreed position, including time for orientation and initial set-up" ;
    p1z:units "days" .

apqc:MET107385 a p1z:Metric ;
    skos:prefLabel "Data science, digital skills and other specialty IT skills employee new hire retention after 12 months" ;
    p1z:apqcMetricId "107385" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Organization's 12 month retention rate for data science digital skills and other specialty IT skills employees" ;
    p1z:units "percent" .

apqc:MET107799 a p1z:Metric ;
    skos:prefLabel "Percentage change in the new data science, digital skills and other specialty IT skills employee 12 month retention rate in the past 12 months (pre- to post-Covid)" ;
    p1z:apqcMetricId "107799" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Organization's 12 month retention rate for data science digital skills and other specialty IT skills employees - 12 month retention rate for data science, digital skills, and other specialty IT skills employees 12 months ago (pre-Covid)) / 12 month retention rate for data science, digital skills, and other specialty IT skills employees 12 months ago (pre-Covid)) * 100" ;
    p1z:units "percent" .

