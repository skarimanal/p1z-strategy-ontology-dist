    p1z:units "bots" .

apqc:MET112581 a p1z:Metric ;
    skos:prefLabel "Number of automated bots (not chatbots) in finance organization today per 1,000 business entity FTEs" ;
    p1z:apqcMetricId "112581" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Number of automated bots (not chatbots) running in finance organization today / (Number of business entity FTEs * .001)" ;
    p1z:units "bots" .

apqc:MET112582 a p1z:Metric ;
    skos:prefLabel "Number of automated bots and chatbots in finance organization today per 1,000 business entity FTEs" ;
