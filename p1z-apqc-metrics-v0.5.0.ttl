apqc:MET100152 a p1z:Metric ;
    skos:prefLabel "Cycle time in business days to process the payroll" ;
    p1z:apqcMetricId "100152" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in business days to process payroll from HR/benefits system cut-off to payroll transmit date" ;
    p1z:units "days" .

apqc:MET100464 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"process payroll\" as a percentage of revenue" ;
    p1z:apqcMetricId "100464" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Total cost to perform the process \"report time\" + Total cost to perform the process \"manage pay\" + Total cost to perform the process \"process payroll taxes\") / Total business entity revenue) * 100" ;
    p1z:units "percent" .

apqc:MET100920 a p1z:Metric ;
    skos:prefLabel "Number of employees paid per FTE that performs the process group \"process payroll\"" ;
    p1z:apqcMetricId "100920" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Total number of employees paid / (Number of FTEs who perform the process \"report time\" + Number of FTEs who perform the process \"manage pay\" + Number of FTEs who perform the process \"process payroll taxes\")" ;
    p1z:units "employees" .

apqc:MET101106 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process group \"process payroll\" per $1 billion revenue" ;
    p1z:apqcMetricId "101106" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process \"report time\" + Number of FTEs who perform the process \"manage pay\" + Number of FTEs who perform the process \"process payroll taxes\") / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

apqc:MET101184 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process group \"process payroll\" per 1,000 employees paid" ;
    p1z:apqcMetricId "101184" ;
    p1z:metricClass p1zv:OperationalDriver ;
