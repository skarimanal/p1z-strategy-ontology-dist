apqc:MET107287 a p1z:Metric ;
    skos:prefLabel "Number of inbound contacts per customer service FTE (including external FTEs)" ;
    p1z:apqcMetricId "107287" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
