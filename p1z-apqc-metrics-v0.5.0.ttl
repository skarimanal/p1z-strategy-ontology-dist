apqc:MET100957 a p1z:Metric ;
    skos:prefLabel "Number of external service provider FTEs who perform the function \"manage information technology\" per $1 billion revenue" ;
    p1z:apqcMetricId "100957" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs who perform the function \"manage information technology\" (internal and external) * Percentage of FTEs who perform the function \"manage information technology\" who are external FTEs *.01) / (Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET100970 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform IT development and maintenance per $1 billion revenue" ;
    p1z:apqcMetricId "100970" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the function \"manage information technology\" (internal and external) * (Percentage of IT FTEs performing the process area \"Manage enterprise information\" + Percentage of IT FTEs performing the process group \"develop and maintain information technology solutions\")*.01) / (Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET100972 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform IT operations per $1 billion revenue" ;
    p1z:apqcMetricId "100972" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the function \"manage information technology\" (internal and external) * (Percentage of IT FTEs performing the process group \"deploy information technology solutions\" + Percentage of IT FTEs performing the process group \"deliver and support information technology services\")*.01) / (Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET100974 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform IT planning and management per $1 billion revenue" ;
    p1z:apqcMetricId "100974" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the function \"manage information technology\" (internal and external) * (Percentage of IT FTEs performing the process group \"manage the business of information technology\" + Percentage of IT FTEs performing the process group \"develop and manage IT customer relationships\" + Percentage of IT FTEs performing the process group \"develop and implement security, privacy, and data protection controls\")*.01) / (Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET101241 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform IT processes per $1 billion revenue" ;
    p1z:apqcMetricId "101241" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of FTEs who perform the function \"manage information technology\" (internal and external)/(Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET101295 a p1z:Metric ;
    skos:prefLabel "Number of end users serviced by the IT function per IT function FTE" ;
    p1z:apqcMetricId "101295" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Number of end users serviced by the function \"manage information technology\" / Number of FTEs who perform the function \"manage information technology\" (internal and external)" ;
    p1z:units "end users serviced" .

apqc:MET101770 a p1z:Metric ;
    skos:prefLabel "Percentage of FTEs who perform the function \"manage information technology\" who are external service providers" ;
    p1z:apqcMetricId "101770" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of FTEs who perform the function \"manage information technology\" who are external FTEs" ;
    p1z:units "percent" .

apqc:MET102723 a p1z:Metric ;
    skos:prefLabel "Percentage of total IT cost, including depreciation/amortization, allocated to IT operations" ;
    p1z:apqcMetricId "102723" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Total cost, including depreciation/amortization, to perform the process group \"deploy information technology solutions\" + Total cost, including depreciation/amortization, to perform the process group \"deliver and support information technology services\") / Total annual IT cost (including depreciation/amortization)) * 100" ;
    p1z:units "percent" .

apqc:MET102725 a p1z:Metric ;
    skos:prefLabel "Percentage of total IT cost, including depreciation/amortization, allocated to IT planning and management" ;
    p1z:apqcMetricId "102725" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Total cost, including depreciation/amortization, to perform the process group \"manage the business of information technology\" + Total cost, including depreciation/amortization, to perform the process group \"develop and manage IT customer relationships\" + Total cost, including depreciation/amortization, to perform the process group \"manage business resiliency and risk\" + Total cost, including depreciation/amortization, to perform the process group \"manage IT knowledge\") / Total annual IT cost (including depreciation/amortization)) * 100" ;
    p1z:units "percent" .

apqc:MET102727 a p1z:Metric ;
    skos:prefLabel "Percentage of total IT cost, including depreciation/amortization, allocated to IT development and maintenance" ;
    p1z:apqcMetricId "102727" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Total cost, including depreciation/amortization, to perform the process group \"manage enterprise information\" + Total cost, including depreciation/amortization, to perform the process group \"develop and maintain information technology solutions\") / Total annual IT cost (including depreciation/amortization)) * 100" ;
    p1z:units "percent" .

