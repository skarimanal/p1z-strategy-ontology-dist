    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs who perform the process \"manage policies and procedures\" / Number of FTEs who perform the function \"manage financial resources\") * 100" ;
    p1z:units "percent" .

