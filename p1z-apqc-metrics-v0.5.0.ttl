apqc:MET101340 a p1z:Metric ;
    skos:prefLabel "New employees as a percentage of total business entity employees" ;
    p1z:apqcMetricId "101340" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Total number of new hires / Number of business entity employees) * 100" ;
    p1z:units "percent" .

apqc:MET104563 a p1z:Metric ;
    skos:prefLabel "Number of approved job requisitions per FTE that performs the process group \"recruit, source, and select employees\"" ;
    p1z:apqcMetricId "104563" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Annual number of job requisitions / Number of FTEs who perform the process group \"recruit, source, and select employees\"" ;
    p1z:units "job requisitions" .

apqc:MET104564 a p1z:Metric ;
    skos:prefLabel "Number of new hires as a percentage of approved job requisitions" ;
