apqc:MET107936 a p1z:Metric ;
    skos:prefLabel "Public clouds as a percentage of total enterprise clouds" ;
    p1z:apqcMetricId "107936" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of public clouds / (Number of public clouds + Number of private clouds + Number of hybrid clouds)) * 100" ;
    p1z:units "percent" .

apqc:MET107937 a p1z:Metric ;
    skos:prefLabel "Private clouds as a percentage of total enterprise clouds" ;
    p1z:apqcMetricId "107937" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of private clouds / (Number of public clouds + Number of private clouds + Number of hybrid clouds)) * 100" ;
    p1z:units "percent" .

apqc:MET107938 a p1z:Metric ;
    skos:prefLabel "Hybrid clouds as a percentage of total enterprise clouds" ;
    p1z:apqcMetricId "107938" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of hybrid clouds / (Number of public clouds + Number of private clouds + Number of hybrid clouds)) * 100" ;
    p1z:units "percent" .

apqc:MET107941 a p1z:Metric ;
    skos:prefLabel "Percentage change in IT function FTEs over the past 12 months" ;
    p1z:apqcMetricId "107941" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "((Number of  IT FTEs (including contractors and outsourced resources) that were added/hired in the past 12 months - Number of  IT FTEs (including contractors and outsourced resources) that were eliminated/redeployed in the past 12 months) / ((Number of FTEs who perform the function \"manage information technology\" (internal and external) - Number of  IT FTEs (including contractors and outsourced resources) that were added/hired in the past 12 months + Number of  IT FTEs (including contractors and outsourced resources) that were eliminated/redeployed in the past 12 months)^2)^0.5) * 100" ;
    p1z:units "percent" .

