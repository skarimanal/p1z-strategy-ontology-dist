    p1z:formula "Total cost to perform the process group \"recruit, source, select employees\" per new hire and rehire" ;
    p1z:units "dollars" .

apqc:MET111126 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"recruit, source, and select employees\" as a percentage of total HR function cost" ;
    p1z:apqcMetricId "111126" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process group \"recruit, source, and select employees\"  / Total cost to perform the function \"develop and manage human capital\") * 100" ;
    p1z:units "percent" .

apqc:MET111127 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"recruit, source, and select employees\" per HR function FTE" ;
    p1z:apqcMetricId "111127" ;
