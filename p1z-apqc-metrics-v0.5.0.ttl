apqc:MET102057 a p1z:Metric ;
    skos:prefLabel "Percentage of total finance function FTEs allocated to the process group \"process payroll\"" ;
    p1z:apqcMetricId "102057" ;
    p1z:metricClass p1zv:OperationalDriver ;
