apqc:MET107794 a p1z:Metric ;
    skos:prefLabel "Percentage change in the cycle time in days from approval of job requisition to acceptance of job offer in the past 12 months (pre- to post-Covid)" ;
    p1z:apqcMetricId "107794" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Number of days dedicated to formal learning per employee - Average time in calendar days from job requisition approval to acceptance of job offer 12 months ago (pre-Covid)) / Average time in calendar days from job requisition approval to acceptance of job offer 12 months ago (pre-Covid)) * 100" ;
    p1z:units "percent" .

apqc:MET110832 a p1z:Metric ;
