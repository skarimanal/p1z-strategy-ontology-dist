    p1z:units "percent" .

apqc:MET112579 a p1z:Metric ;
    skos:prefLabel "Total number of digital worker equivalents (DWEs) in finance function per 1,000 business entity FTEs" ;
    p1z:apqcMetricId "112579" ;
