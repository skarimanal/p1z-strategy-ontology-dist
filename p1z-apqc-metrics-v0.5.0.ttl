apqc:MET105213 a p1z:Metric ;
    skos:prefLabel "Number of FTEs (including external) that perform the process group \"govern and manage product/service development program\" per $1 billion revenue" ;
    p1z:apqcMetricId "105213" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs (including external) that perform the function \"develop and manage products and services\" * Percentage of FTEs (including external) that perform the function \"develop and manage products and services\" allocated to the process group \"govern and manage product/service development program\" * 0.01) / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

apqc:MET105214 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"govern and manage product/service development program\" per $1,000 revenue" ;
    p1z:apqcMetricId "105214" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the function \"develop and manage products and services\" * Percentage of total cost to perform the function \"develop and manage products and services\" allocated to the process group \"govern and manage product/service development program\" * 0.01) / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET105217 a p1z:Metric ;
    skos:prefLabel "Number of FTEs (including external) that perform the process group \"govern and manage product/service development program\" as a percentage of total function FTEs" ;
    p1z:apqcMetricId "105217" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of FTEs (including external) that perform the function \"develop and manage products and services\" allocated to the process group \"govern and manage product/service development program\"" ;
    p1z:units "percent" .

apqc:MET105224 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"govern and manage product/service development program\" as a percentage of total function cost" ;
    p1z:apqcMetricId "105224" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to the process group \"govern and manage product/service development program\"" ;
    p1z:units "percent" .

