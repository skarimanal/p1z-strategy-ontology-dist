apqc:MET100140 a p1z:Metric ;
    skos:prefLabel "Cycle time in calendar days (including weekends) from identification of change in risk until changes to risk management policies and procedures are completed and ready for deployment/communication/implementation by the business entity" ;
    p1z:apqcMetricId "100140" ;
    p1z:metricClass p1zv:OperationalDriver ;
