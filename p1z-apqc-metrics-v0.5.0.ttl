apqc:MET105220 a p1z:Metric ;
    skos:prefLabel "Number of FTEs (including external) that perform the process group \"generate and define new product/service ideas\" as a percentage of total function FTEs" ;
    p1z:apqcMetricId "105220" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of FTEs (including external) that perform the function \"develop and manage products and services\" allocated to the process group \"generate and define new product/service ideas\"" ;
    p1z:units "percent" .

apqc:MET105225 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"generate and define new product/service ideas\" as a percentage of total function cost" ;
    p1z:apqcMetricId "105225" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total cost to perform the function \"develop and manage products and services\" allocated to the process group \"generate and define new product/service ideas\"" ;
    p1z:units "percent" .

apqc:MET105463 a p1z:Metric ;
    skos:prefLabel "Number of FTEs (including external) that perform the process group \"generate and define new product/service ideas\" per $1 billion revenue" ;
    p1z:apqcMetricId "105463" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs (including external) that perform the function \"develop and manage products and services\" * Percentage of FTEs (including external) that perform the function \"develop and manage products and services\" allocated to the process group \"generate and define new product/service ideas\" * 0.01) / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

apqc:MET105468 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"generate and define new product/service ideas\" per $1,000 revenue" ;
    p1z:apqcMetricId "105468" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the function \"develop and manage products and services\" * Percentage of total cost to perform the function \"develop and manage products and services\" allocated to the process group \"generate and define new product/service ideas\" * 0.01) / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET100664 a p1z:Metric ;
    skos:prefLabel "Cycle time in days from the start of design and development through completion of test marketing for existing product/service improvement projects" ;
    p1z:apqcMetricId "100664" ;
