    p1z:formula "(Centrally managed systems cost to perform the process \"manage sales orders\" + Centrally managed systems cost to perform the processes \"manage customer service requests/inquiries\" and \"manage customer complaints\") / Number of active customers in customer master file" ;
    p1z:units "dollars" .

