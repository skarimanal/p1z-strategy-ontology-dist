    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of finance function FTEs eliminated/redeployed in the past 12 months that are attributed to AI" ;
    p1z:units "percent" .

apqc:MET107857 a p1z:Metric ;
    skos:prefLabel "Percentage of finance function FTEs having had skill requirement changes in the past 12 months" ;
    p1z:apqcMetricId "107857" ;
