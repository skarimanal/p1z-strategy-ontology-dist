apqc:MET104861 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process \"process warranty claims\" per $1,000 revenue" ;
    p1z:apqcMetricId "104861" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Total cost of the process \"process warranty claims\" / (Total business entity revenue * 0.001)" ;
    p1z:units "Dollars" .

apqc:MET104863 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the process \"process warranty claims\" per $1,000 revenue" ;
    p1z:apqcMetricId "104863" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Percentage of total cost of the process \"process warranty claims\" allocated to internal costs * Percentage of internal cost to perform the process \"process warranty claims\" allocated to personnel cost * Total cost of the process \"process warranty claims\") * .0001) / (Total business entity revenue * 0.001)" ;
    p1z:units "Dollars" .

apqc:MET104865 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the process \"process warranty claims\" per $1,000 revenue" ;
    p1z:apqcMetricId "104865" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Percentage of total cost of the process \"process warranty claims\" allocated to internal costs * Percentage of internal cost to perform the process \"process warranty claims\" allocated to systems cost * Total cost of the process \"process warranty claims\") * .0001) / (Total business entity revenue * 0.001)" ;
    p1z:units "Dollars" .

apqc:MET104867 a p1z:Metric ;
