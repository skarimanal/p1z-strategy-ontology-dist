    p1z:units "percent" .

apqc:MET103051 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the process group \"manage internal controls\" per $1,000 revenue" ;
    p1z:apqcMetricId "103051" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Personnel cost to perform the process \"establish internal controls, policies, and procedures\" + Personnel cost to perform the process \"operate controls and monitor compliance with internal controls policies and procedures\" + Personnel cost to perform the process \"report on internal controls compliance\") / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET103378 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the process group \"manage internal controls\" per $100,000 revenue" ;
    p1z:apqcMetricId "103378" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Systems cost to perform the process \"establish internal controls, policies, and procedures\" + Systems cost to perform the process \"operate controls and monitor compliance with internal controls policies and procedures\" + Systems cost to perform the process \"report on internal controls compliance\") / (Total business entity revenue * 0.000010)" ;
    p1z:units "dollars" .

apqc:MET104014 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"manage internal controls\" as a percentage of revenue" ;
    p1z:apqcMetricId "104014" ;
