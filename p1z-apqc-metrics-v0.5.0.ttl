apqc:MET100401 a p1z:Metric ;
    skos:prefLabel "Centrally managed systems cost to perform the processes \"manage sales orders\", \"manage customer service requests/inquiries\", and \"manage customer complaints\" per $1,000 revenue" ;
    p1z:apqcMetricId "100401" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Centrally managed systems cost to perform the process \"manage sales orders\" + Centrally managed systems cost to perform the processes \"manage customer service requests/inquiries\" and \"manage customer complaints\") / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET100403 a p1z:Metric ;
    skos:prefLabel "Centrally managed systems cost to perform the processes \"manage sales orders\", \"manage customer service requests/inquiries\", and \"manage customer complaints\" per active customer" ;
