apqc:MET105218 a p1z:Metric ;
    skos:prefLabel "Number of IT FTEs that perform the process group \"develop and implement security, privacy, and data protection controls\" per $1 billion revenue" ;
    p1z:apqcMetricId "105218" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the function \"manage information technology\" (internal and external) * Percentage of IT FTEs performing the process group \"develop and implement security, privacy, and data protection controls\" *.01) / (Total business entity revenue * 0.0000000010)" ;
    p1z:units "FTEs" .

apqc:MET107816 a p1z:Metric ;
    skos:prefLabel "Percentage change in cybersecurity FTEs over the past 12 months" ;
    p1z:apqcMetricId "107816" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "((Total number of cybersecurity FTEs (including contractors and outsourced resources) added/hired in the past 12 months - Total number of cybersecurity FTEs (including contractors and outsourced resources) eliminated/redeployed in the past 12 months) / ((Total number of cybersecurity FTEs (including contractors and outsourced resources) - Total number of cybersecurity FTEs (including contractors and outsourced resources) added/hired in the past 12 months + Total number of cybersecurity FTEs (including contractors and outsourced resources) eliminated/redeployed in the past 12 months)^2)^0.5) * 100" ;
    p1z:units "percent" .

