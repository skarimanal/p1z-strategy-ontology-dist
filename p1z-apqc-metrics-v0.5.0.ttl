    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Customer accounts set up for EDI to submit sales orders / Number of customers in the customer master file) * 100.0" ;
    p1z:units "percent" .

apqc:MET101926 a p1z:Metric ;
    skos:prefLabel "Revenue received from internet orders, mobile orders, EDI orders, and orders from a direct connection to the system as a percentage of total business entity revenue" ;
    p1z:apqcMetricId "101926" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Revenue received from internet orders + Revenue received from WAP orders + Revenue received from EDI orders + Revenue received from orders through a direct connection to the system) / Total business entity revenue) * 100.0" ;
    p1z:units "percent" .

apqc:MET102288 a p1z:Metric ;
    skos:prefLabel "Marketing FTEs as a percentage of total business entity FTEs" ;
