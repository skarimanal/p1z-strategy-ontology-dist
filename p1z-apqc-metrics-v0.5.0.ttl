apqc:MET101163 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process group \"manage internal controls\" per $1 billion revenue" ;
    p1z:apqcMetricId "101163" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process \"establish internal controls, policies, and procedures\" + Number of FTEs who perform the process \"operate controls and monitor compliance with internal controls policies and procedures\" + Number of FTEs who perform the process \"report on internal controls compliance\") / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

apqc:MET102041 a p1z:Metric ;
    skos:prefLabel "Percentage of total finance function FTEs allocated to the process group \"manage internal controls\"" ;
    p1z:apqcMetricId "102041" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs who perform the process group \"manage internal controls\" / Number of FTEs who perform the function \"manage financial resources\") * 100" ;
    p1z:units "percent" .

apqc:MET102217 a p1z:Metric ;
