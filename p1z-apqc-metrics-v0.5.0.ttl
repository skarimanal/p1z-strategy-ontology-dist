@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix p1z:  <https://ontology.pointonezero.com/strategy/core#> .
@prefix p1zv: <https://ontology.pointonezero.com/strategy/vocab#> .
@prefix apqc: <https://ontology.pointonezero.com/strategy/apqc#> .

<https://ontology.pointonezero.com/strategy/apqc/metrics> a owl:Ontology ;
    dct:title "P1Z Metric Instances: APQC PCF Key Measures" ;
    owl:versionInfo "0.5.0" ;
    dct:source "APQC Process Classification Framework (PCF), Cross-Industry, Excel Version 8.0, February 2026, Metrics sheet" ;
    dct:description "APQC-published key measures as Metric instances in the single metrics taxonomy, cross-mapped to the spine elements they gauge via hasAssociatedMetric. The stable 6-digit APQC metric ID keys each URI. Round 2 (v0.4.0) populated categories 1.0 and 13.0; round 3 (v0.5.0) extends coverage to all 13 categories of the cross-industry PCF. All metrics carry metricClass OperationalDriver and an APQC measure-category facet tag." ;
    dct:rights "APQC Process Classification Framework (PCF) is an open standard developed by APQC, a nonprofit that promotes benchmarking and best practices worldwide. The PCF is intended to facilitate organizational improvement through process management and benchmarking, regardless of industry, size, or geography. To download the full PCF or industry-specific versions of the PCF, as well as associated measures and benchmarking, please visit www.apqc.org/pcf." .

apqc:MET101337 a p1z:Metric ;
    skos:prefLabel "Number of new businesses launched over the past three reporting periods per $1 billion revenue (current reporting period)" ;
    p1z:apqcMetricId "101337" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of new businesses/services launched over the past three years / (Total business entity revenue * 0.000000001)" ;
    p1z:units "new businesses" .

apqc:MET101339 a p1z:Metric ;
    skos:prefLabel "Number of new businesses launched over the past three reporting periods per $100 million R&D spend (three reporting periods prior)" ;
    p1z:apqcMetricId "101339" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of new businesses/services launched over the past three years / (Research and development (R&D) costs (three reporting periods prior) * 0.000000010)" ;
    p1z:units "new businesses" .

apqc:MET106127 a p1z:Metric ;
    skos:prefLabel "Actual Open-to-buy retail inventory as a percentage of planned retail inventory" ;
    p1z:apqcMetricId "106127" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Actual Open-to-buy inventory as a percentage of planned inventory" ;
    p1z:units "percent" .

apqc:MET100026 a p1z:Metric ;
    skos:prefLabel "Budget for research and development (R&D) as a percentage of revenue" ;
    p1z:apqcMetricId "100026" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Budget for research and development (R&D) / Total business entity revenue) * 100.0" ;
    p1z:units "percent" .

apqc:MET100379 a p1z:Metric ;
    skos:prefLabel "Average time-to-market in days for all products (including product improvements and extensions)" ;
    p1z:apqcMetricId "100379" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Average time-to-market in days for all products" ;
    p1z:units "days" .

apqc:MET100383 a p1z:Metric ;
    skos:prefLabel "Average time-to-profitability in months for new product/service development projects" ;
    p1z:apqcMetricId "100383" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Average time-to-profitability in months for new product/service development projects" ;
    p1z:units "months" .

apqc:MET100406 a p1z:Metric ;
    skos:prefLabel "Compounded annual growth rate of R&D costs over the past three reporting periods" ;
    p1z:apqcMetricId "100406" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(((Costs of research and development (R&D) / Research and development (R&D) costs (three reporting periods prior)) ^ 0.3333) - 1) * 100.0" ;
    p1z:units "percent" .

apqc:MET100694 a p1z:Metric ;
    skos:prefLabel "Engineering change order (ECO) costs as a percentage of the total new product development cost" ;
    p1z:apqcMetricId "100694" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Engineering change-order costs as a percentage of total new product development costs" ;
    p1z:units "percent" .

apqc:MET101357 a p1z:Metric ;
    skos:prefLabel "Number of new product/service development projects per $1 billion revenue" ;
    p1z:apqcMetricId "101357" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of new product/service developments projects / (Total business entity revenue * 0.000000001)" ;
    p1z:units "projects" .

apqc:MET101764 a p1z:Metric ;
    skos:prefLabel "Percentage growth in R&D cost from three reporting periods prior" ;
    p1z:apqcMetricId "101764" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Costs of research and development (R&D) - Research and development (R&D) costs (three reporting periods prior)) / Research and development (R&D) costs (three reporting periods prior)) * 100.0" ;
    p1z:units "percent" .

apqc:MET101985 a p1z:Metric ;
    skos:prefLabel "Percentage of existing product/service improvement and extension projects launched on budget" ;
    p1z:apqcMetricId "101985" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Percentage of existing product/service improvement projects launched on budget" ;
    p1z:units "percent" .

apqc:MET102003 a p1z:Metric ;
    skos:prefLabel "Percentage of external ideas from suppliers" ;
    p1z:apqcMetricId "102003" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of external ideas from suppliers" ;
    p1z:units "percent" .

apqc:MET102125 a p1z:Metric ;
    skos:prefLabel "Percentage of total innovation spend allocated to enhancements to existing products/processes/business models" ;
    p1z:apqcMetricId "102125" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total innovation spend allocated to enhancements to existing products/processes/business models" ;
    p1z:units "percent" .

apqc:MET102126 a p1z:Metric ;
    skos:prefLabel "Percentage of total innovation spend allocated to major extensions to existing products/processes/business models" ;
    p1z:apqcMetricId "102126" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total innovation spend allocated to major extensions to products/processes/business models" ;
    p1z:units "percent" .

apqc:MET102127 a p1z:Metric ;
    skos:prefLabel "Percentage of total innovation spend allocated to new or white space opportunities" ;
    p1z:apqcMetricId "102127" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of total innovation spend allocated to new or white space opportunities" ;
    p1z:units "percent" .

apqc:MET102458 a p1z:Metric ;
    skos:prefLabel "Percentage of R&D cost related to new product development projects" ;
    p1z:apqcMetricId "102458" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of research and development (R&D) cost related to new product development projects" ;
    p1z:units "percent" .

apqc:MET102460 a p1z:Metric ;
    skos:prefLabel "Percentage of R&D cost related to product improvements and extensions" ;
    p1z:apqcMetricId "102460" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(100 - Percentage of research and development (R&D) cost related to new product development projects)" ;
    p1z:units "percent" .

apqc:MET102462 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) FTEs as a percentage of total business entity FTEs" ;
    p1z:apqcMetricId "102462" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs who perform research and development (R&D) / Number of business entity FTEs) * 100.0" ;
    p1z:units "percent" .

apqc:MET102526 a p1z:Metric ;
    skos:prefLabel "Percentage of current annual revenue from products/services launched in the preceding 12-month period" ;
    p1z:apqcMetricId "102526" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Percentage of revenue from products/services launched in the last 12-month reporting period" ;
    p1z:units "percent" .

apqc:MET102644 a p1z:Metric ;
    skos:prefLabel "Percentage of employees tasked with at least one innovation goal" ;
    p1z:apqcMetricId "102644" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:StaffProductivity ;
    p1z:formula "Percentage of employees tasked with at least one innovation goal" ;
    p1z:units "percent" .

apqc:MET103115 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) budget per R&D FTE" ;
    p1z:apqcMetricId "103115" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Budget for research and development (R&D) / Number of FTEs who perform research and development (R&D)" ;
    p1z:units "dollars" .

apqc:MET103139 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) cost per $1,000 revenue" ;
    p1z:apqcMetricId "103139" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "R&D cost as a percentage of revenue * 10" ;
    p1z:units "dollars" .

apqc:MET103141 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) cost related to new product development projects per $1,000 revenue" ;
    p1z:apqcMetricId "103141" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Percentage of research and development (R&D) cost related to new product development projects * 0.010) * Costs of research and development (R&D)) / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET103143 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) cost related to product improvements and extensions per $1,000 revenue" ;
    p1z:apqcMetricId "103143" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Percentage of research and development (R&D) cost related to new product development projects * -0.01 + 1) * Costs of research and development (R&D)) / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET103466 a p1z:Metric ;
    skos:prefLabel "Time-to-market in days for existing product/service improvement projects" ;
    p1z:apqcMetricId "103466" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Average time-to-market in days from the start of design and development until the existing product/service improvement project is ready for sale" ;
    p1z:units "days" .

apqc:MET103476 a p1z:Metric ;
    skos:prefLabel "Time-to-market in days for new product/service development projects" ;
    p1z:apqcMetricId "103476" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Average time-to-market in days from the start of design and development until the new product/service development project ready for sale" ;
    p1z:units "days" .

apqc:MET104141 a p1z:Metric ;
    skos:prefLabel "Research and development (R&D) cost as a percentage of revenue" ;
    p1z:apqcMetricId "104141" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "R&D cost as a percentage of revenue" ;
