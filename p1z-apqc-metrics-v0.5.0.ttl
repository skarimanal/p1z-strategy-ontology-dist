    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Total cost to perform the process \"establish internal controls, policies, and procedures\" + Total cost to perform the process \"operate controls and monitor compliance with internal controls policies and procedures\" + Total cost to perform the process \"report on internal controls compliance\") / Total business entity revenue) * 100.0" ;
    p1z:units "percent" .

apqc:MET104015 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"manage internal controls\" per $1 billion revenue" ;
    p1z:apqcMetricId "104015" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total cost to perform the process \"establish internal controls, policies, and procedures\" + Total cost to perform the process \"operate controls and monitor compliance with internal controls policies and procedures\" + Total cost to perform the process \"report on internal controls compliance\") / (Total business entity revenue * 0.000000001)" ;
    p1z:units "dollars" .

apqc:MET104016 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process group \"manage internal controls\" per $1,000 revenue" ;
    p1z:apqcMetricId "104016" ;
