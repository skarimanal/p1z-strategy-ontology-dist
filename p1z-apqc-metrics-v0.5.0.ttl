    p1z:apqcMetricId "111192" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Percentage of digital product team's time dedicated to digital product support" ;
