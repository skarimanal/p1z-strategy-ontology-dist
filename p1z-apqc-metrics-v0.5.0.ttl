apqc:MET101089 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the processes \"perform cost accounting and control\" and \"perform cost management\" per $1 billion revenue" ;
    p1z:apqcMetricId "101089" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of FTEs who perform the processes \"perform cost accounting and control\" and \"perform cost management\" / (Total business entity revenue * .000000001)" ;
    p1z:units "FTEs" .

apqc:MET101172 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process group \"perform planning and management accounting\" per $1 billion revenue" ;
    p1z:apqcMetricId "101172" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process \"perform planning/budgeting/forecasting\" + Number of FTEs who perform the processes \"perform cost accounting and control\" and \"perform cost management\" + Number of FTEs who perform the process \"evaluate and manage financial performance\") / (Total business entity revenue * 0.000000001)" ;
    p1z:units "FTEs" .

apqc:MET101606 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the processes \"perform cost accounting and control\" and \"perform cost management\" per $1,000 revenue" ;
    p1z:apqcMetricId "101606" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Outsourced cost to perform the processes \"perform cost accounting and control\" and \"perform cost management\" / (Total business entity revenue * 0.001)" ;
    p1z:units "dollars" .

apqc:MET102050 a p1z:Metric ;
    skos:prefLabel "Percentage of total finance function FTEs allocated to the process group \"perform planning and management accounting\"" ;
    p1z:apqcMetricId "102050" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of FTEs who perform the process group \"perform planning and management accounting\" / Number of FTEs who perform the function \"manage financial resources\") * 100" ;
    p1z:units "percent" .

apqc:MET103065 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the processes \"perform cost accounting and control\" and \"perform cost management\" per process FTE" ;
    p1z:apqcMetricId "103065" ;
