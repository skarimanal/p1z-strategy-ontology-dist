    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of IT cost allocated to growing and transforming the business" ;
    p1z:units "percent" .

apqc:MET104641 a p1z:Metric ;
    skos:prefLabel "Personnel cost to perform the function \"manage information technology\" per $1,000 revenue" ;
    p1z:apqcMetricId "104641" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total annual IT cost (excluding depreciation/amortization) * Percentage of total IT cost (excluding depreciation/amortization) allocated to IT operating cost * (Percentage of IT operating cost (excluding depreciation/amortization) allocated to internal personnel + Percentage of IT operating cost (excluding depreciation/amortization) allocated to external personnel)*.0001) / (Total business entity revenue * 0.0010)" ;
    p1z:units "dollars" .

apqc:MET104771 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the function \"manage information technology\", including depreciation/amortization, per $1,000 revenue" ;
    p1z:apqcMetricId "104771" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total annual IT cost (including depreciation/amortization) * (Percentage of IT cost (including depreciation/amortization) allocated to hardware + Percentage of IT cost (including depreciation/amortization) allocated to software + Percentage of IT cost (including depreciation/amortization) allocated to data and voice networks) * .01) / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET104772 a p1z:Metric ;
    skos:prefLabel "Overhead cost to perform the function \"manage information technology\", including depreciation/amortization, per $1,000 revenue" ;
    p1z:apqcMetricId "104772" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total annual IT cost (including depreciation/amortization) * Percentage of IT cost (including depreciation/amortization) allocated to facilities and overhead * .01) / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET104773 a p1z:Metric ;
    skos:prefLabel "Other cost to perform the function \"manage information technology\", including depreciation/amortization, per $1,000 revenue" ;
    p1z:apqcMetricId "104773" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "(Total annual IT cost (including depreciation/amortization) * Percentage of IT cost (including depreciation/amortization) allocated to cost other than personnel, systems, overhead, and outsourced * .01) / (Total business entity revenue * .001)" ;
    p1z:units "dollars" .

apqc:MET104945 a p1z:Metric ;
    skos:prefLabel "Number of IT FTEs reporting into the internal IT organization per $1 billion revenue" ;
