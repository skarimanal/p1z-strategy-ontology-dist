    p1z:formula "Cycle time in calendar days (including weekends) from identification of change in risk until changes to risk management policies and procedures are completed and ready for deployment/communication/implementation by the business entity" ;
    p1z:units "days" .

apqc:MET100144 a p1z:Metric ;
    skos:prefLabel "Cycle time in calendar days (including weekends) from the identification of a control violation until the violation is reported/communicated to the control or process owner" ;
    p1z:apqcMetricId "100144" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in calendar days (including weekends) from the identification of a control violation until the violation is reported/communicated to the control or process owner" ;
    p1z:units "days" .

apqc:MET100148 a p1z:Metric ;
    skos:prefLabel "Cycle time in days from reporting of a control violation until investigation is completed and remediation steps/control changes are developed" ;
    p1z:apqcMetricId "100148" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in days from reporting of a control violation until investigation is completed and remediation steps/control changes are developed" ;
    p1z:units "days" .

apqc:MET100899 a p1z:Metric ;
    skos:prefLabel "Number of control violations per 1,000 business entity employees" ;
    p1z:apqcMetricId "100899" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of control violations in last twelve months pertaining to financial reporting/accounting and/or security/access to financial records / (Number of business entity employees * 0.0010)" ;
    p1z:units "control violations" .

apqc:MET101375 a p1z:Metric ;
    skos:prefLabel "Number of primary controls per 1,000 employees" ;
    p1z:apqcMetricId "101375" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "Number of identified primary controls / (Number of business entity employees * 0.0010)" ;
    p1z:units "controls" .

apqc:MET101912 a p1z:Metric ;
    skos:prefLabel "Percentage of total control violations that are new" ;
    p1z:apqcMetricId "101912" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Number of new control violations in last twelve months / Number of control violations in last twelve months pertaining to financial reporting/accounting and/or security/access to financial records) * 100.0" ;
    p1z:units "percent" .

apqc:MET102392 a p1z:Metric ;
    skos:prefLabel "Percentage of primary controls that are automated" ;
    p1z:apqcMetricId "102392" ;
    p1z:metricClass p1zv:OperationalDriver ;
