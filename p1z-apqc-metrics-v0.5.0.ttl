    p1z:apqcMetricId "102904" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Personnel cost to perform the process \"provide sourcing governance and perform category management\" / (Total business entity revenue * 0.001)" ;
    p1z:units "dollars" .

apqc:MET102908 a p1z:Metric ;
