apqc:MET100666 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process \"provide sourcing governance and perform category management\" as a percentage of process group \"procure materials and services\" FTEs" ;
    p1z:apqcMetricId "100666" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "Percentage of process group \"procure materials and services\" FTEs who perform the step 'provide sourcing governance and perform category management' (non-PCF) + Percentage of process group \"procure materials and services\" FTEs who perform the step 'develop sourcing and category management strategies' (non-PCF)" ;
    p1z:units "percent" .

apqc:MET101008 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process \"provide sourcing governance and perform category management\" per $1 billion purchases" ;
    p1z:apqcMetricId "101008" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process group \"procure materials and services\" * Percentage of process group \"procure materials and services\" FTEs who perform the process \"provide sourcing governance and perform category management\" * .01) / (Value of all materials and services purchased * .000000001)" ;
    p1z:units "FTEs" .

apqc:MET101011 a p1z:Metric ;
    skos:prefLabel "Number of FTEs that perform the process \"provide sourcing governance and perform category management\" per $1 billion revenue" ;
    p1z:apqcMetricId "101011" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(Number of FTEs who perform the process group \"procure materials and services\" * Percentage of process group \"procure materials and services\" FTEs who perform the process \"provide sourcing governance and perform category management\" * .01) / (Total business entity revenue * .000000001)" ;
    p1z:units "FTEs" .

