apqc:MET100405 a p1z:Metric ;
    skos:prefLabel "Compounded annual growth rate in earnings before interest, tax, depreciation and amortization over the past three reporting periods" ;
    p1z:apqcMetricId "100405" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(((Earnings before interest, taxes, depreciation and amortization (EBITDA) for the current 12-month period / Earnings before interest, taxes, depreciation and amortization (EBITDA) (three reporting periods prior)) ^ 0.3333) - 1) * 100" ;
    p1z:units "percent" .

apqc:MET100407 a p1z:Metric ;
