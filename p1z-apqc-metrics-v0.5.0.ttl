    p1z:apqcMetricId "107782" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "((Number of days dedicated to formal learning per employee - Average number of days per employee that were dedicated to learning 12 months ago (pre-Covid)) / Average number of days per employee that were dedicated to learning 12 months ago (pre-Covid)) * 100" ;
    p1z:units "percent" .

apqc:MET107786 a p1z:Metric ;
