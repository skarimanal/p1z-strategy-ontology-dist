apqc:MET105617 a p1z:Metric ;
    skos:prefLabel "Outsourced cost to perform the process group \"process payroll\" per $1,000 revenue" ;
    p1z:apqcMetricId "105617" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
