    p1z:units "dollars" .

apqc:MET103266 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the process \"provide sourcing governance and perform category management\" per $100,000 revenue" ;
    p1z:apqcMetricId "103266" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Systems cost to perform the process \"provide sourcing governance and perform category management\" / (Total business entity revenue * 0.00001)" ;
    p1z:units "dollars" .

apqc:MET103271 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the process \"provide sourcing governance and perform category management\" per $100,000 purchases" ;
    p1z:apqcMetricId "103271" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "Systems cost to perform the process \"provide sourcing governance and perform category management\" / (Value of all materials and services purchased * 0.00001)" ;
    p1z:units "dollars" .

apqc:MET103644 a p1z:Metric ;
    skos:prefLabel "Total cost to perform the process \"provide sourcing governance and perform category management\" per $1,000 purchases" ;
    p1z:apqcMetricId "103644" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
