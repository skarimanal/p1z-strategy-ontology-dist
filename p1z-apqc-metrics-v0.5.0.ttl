apqc:MET100571 a p1z:Metric ;
    skos:prefLabel "Cycle time in days from job acceptance until new hire begins in the agreed position" ;
    p1z:apqcMetricId "100571" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CycleTime ;
    p1z:formula "Cycle time in days from job offer acceptance until new hire begins in the agreed position, including time for orientation and initial set-up" ;
