apqc:MET106366 a p1z:Metric ;
    skos:prefLabel "Total cost of manufacturing (without materials) as a percentage of revenue" ;
    p1z:apqcMetricId "106366" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:CostEffectiveness ;
    p1z:formula "((Total cost to manufacture - (Material cost as a percentage of cost of goods sold * Cost of goods sold (COGS) * .01)) / Total business entity revenue) * 100" ;
    p1z:units "percent" .

apqc:MET107443 a p1z:Metric ;
    skos:prefLabel "Percentage change in manufacturing FTEs over the past 12 months" ;
    p1z:apqcMetricId "107443" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:ProcessEfficiency ;
    p1z:formula "(( Number of manufacturing FTEs added/hired in the past 12 months - Number of manufacturing FTEs eliminated/redeployed in the past 12 months) / ((Total number of FTEs for manufacturing - Number of manufacturing FTEs added/hired in the past 12 months + Number of manufacturing FTEs eliminated/redeployed in the past 12 months)^2)^0.5) * 100" ;
    p1z:units "percent" .

