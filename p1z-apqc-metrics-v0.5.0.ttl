    p1z:formula "(Total cost to perform the process \"report time\" + Total cost to perform the process \"manage pay\" + Total cost to perform the process \"process payroll taxes\") / (Total business entity revenue * 0.001)" ;
    p1z:units "dollars" .

apqc:MET103948 a p1z:Metric ;
