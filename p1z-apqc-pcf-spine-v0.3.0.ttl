    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20829 a p1z:Process ;
    skos:prefLabel "Define IT change/release standards" ;
    p1z:apqcId "20829" ;
    p1z:apqcHierarchyId "8.6.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing guidelines for the changed/released IT services and solutions to meet business objectives with optimum utilization." ;
    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20830 a p1z:Process ;
    skos:prefLabel "Assign deployment approval responsibilities" ;
    p1z:apqcId "20830" ;
    p1z:apqcHierarchyId "8.6.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating development approval responsibilities based on defined change standards." ;
    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20831 a p1z:Process ;
    skos:prefLabel "Analyze deployments outcomes" ;
    p1z:apqcId "20831" ;
    p1z:apqcHierarchyId "8.6.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the impact (pros and cons) of IT services deployment." ;
    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20832 a p1z:Process ;
    skos:prefLabel "Plan service and solution implementation" ;
    p1z:apqcId "20832" ;
    p1z:apqcHierarchyId "8.6.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
