@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix p1z:  <https://ontology.pointonezero.com/strategy/core#> .
@prefix apqc: <https://ontology.pointonezero.com/strategy/apqc#> .

<https://ontology.pointonezero.com/strategy/apqc/spine> a owl:Ontology ;
    dct:title "P1Z Scope Instances: APQC PCF Cross-Industry Spine (Levels 1-4)" ;
    owl:versionInfo "0.3.0" ;
    dct:source "APQC Process Classification Framework (PCF), Cross-Industry, Excel Version 8.0, February 2026" ;
    dct:description "APQC PCF cross-industry taxonomy spine as scope instances: 13 categories, 74 process groups, 362 processes, 1353 activities. Levels 1 and 2 are FunctionalDomain instances; levels 3 and 4 are Process instances. The stable 5-digit PCF ID is the canonical key (apqcId, and in each URI); the positional hierarchy number (apqcHierarchyId) is display metadata that may shift between PCF versions. Level-5 tasks live in the companion dormant file, loaded only by consumers that need task-level granularity." ;
    dct:rights "APQC Process Classification Framework (PCF) is an open standard developed by APQC, a nonprofit that promotes benchmarking and best practices worldwide. The PCF is intended to facilitate organizational improvement through process management and benchmarking, regardless of industry, size, or geography. To download the full PCF or industry-specific versions of the PCF, as well as associated measures and benchmarking, please visit www.apqc.org/pcf." .

apqc:PCF10002 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop Vision and Strategy" ;
    p1z:apqcId "10002" ;
    p1z:apqcHierarchyId "1.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing a direction and vision for an organization. This involves defining the business concept and long-term vision, as well as developing the business strategy and managing strategic initiatives. Processes in this category focus on creating a vision, a mission, and strategic objectives, and culminate in creating measures to ensure that the organization is moving in the desired direction." .

apqc:PCF17040 a p1z:FunctionalDomain ;
    skos:prefLabel "Define the business concept and long-term vision" ;
    p1z:apqcId "17040" ;
    p1z:apqcHierarchyId "1.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a conceptual framework of the organization's business activity and strategic vision with long-term applicability. Scout the organization's internal capabilities, as well as the customer's needs and desires, to identify a fit that can be used to advance a conceptual structure of the organization's business activity. Conduct analysis in light of relevant externalities and large-scale shifts in the market landscape." ;
    p1z:parentProcess apqc:PCF10002 .

apqc:PCF10017 a p1z:Process ;
    skos:prefLabel "Assess the external environment" ;
    p1z:apqcId "10017" ;
    p1z:apqcHierarchyId "1.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing all forces, entities, and systems that are external to an organization but can affect its operation. Analyze far-reaching currents in the macroeconomic situation, assess the competition, evaluate technological changes, and identify societal as well as ecological issues of concern. Create a big-picture understanding of externalities, with sufficient depth across individual aspects." ;
    p1z:parentProcess apqc:PCF17040 .

apqc:PCF19945 a p1z:Process ;
    skos:prefLabel "Identify competitors" ;
    p1z:apqcId "19945" ;
    p1z:apqcHierarchyId "1.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying your competitors, their service and/or product. Evaluating competitors strategies to determine their strengths and weaknesses relative to those of your own product or service." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10021 a p1z:Process ;
    skos:prefLabel "Analyze and evaluate competition" ;
    p1z:apqcId "10021" ;
    p1z:apqcHierarchyId "1.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the competitive forces in the marketplace that could potentially affect the organization. Analyze various aspects of business competition including competing firms. Aggregate competitive intelligence, create benchmarks to juxtapose processes and performance metrics, and inject crucial information about the competition into management models to synthesize insights." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF21421 a p1z:Process ;
    skos:prefLabel "Identify potential product or service alternatives" ;
    p1z:apqcId "21421" ;
    p1z:apqcHierarchyId "1.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining if there are other existing products or services in the marketplace, and building the business case to make a go/no go decision based upon substitutions." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10022 a p1z:Process ;
    skos:prefLabel "Identify economic trends" ;
    p1z:apqcId "10022" ;
    p1z:apqcHierarchyId "1.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining large-scale macroeconomic shifts and trends, with medium to long-term relevance for the organization. Vet the immediate and the larger economic ecosystem to identify broad-based movements that affect the organization. In the immediate vicinity, for example, examine the stock price of key vendors/suppliers in the organizational value-chain. In the larger economic ecosystem, analyze according to geographical distribution where factors such as interest rates, taxation structures, oil prices, and unemployment rates are explored." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10023 a p1z:Process ;
    skos:prefLabel "Identify political and regulatory factors" ;
    p1z:apqcId "10023" ;
    p1z:apqcHierarchyId "1.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying areas of concern pertaining to public policy and regulation, established by sovereign or multinational authorities. Examine various regions and geopolitical formations to identify those political and regulatory issues-present or developing-that can potentially affect the organization. Plan for an iterative process, partitioned across regional and geopolitical entities that have a direct bearing on the organization's activities. Assess changes in environmental compliance, product standards, trade barriers, etc." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10027 a p1z:Process ;
    skos:prefLabel "Identify environmental factors" ;
    p1z:apqcId "10027" ;
    p1z:apqcHierarchyId "1.1.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying changes in ecological ecosystems that can be directly or indirectly detrimental to the organization. Analyze ecological factors within the immediate ecosystem for near to middle-term impact. Analyze the ecology, at large, to get a sense of long-term shifts and concerns. Gather analyses from research publications. Speak to subject matter experts. Engage with advocacy groups, lawyers, journalists, and the active populations." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10026 a p1z:Process ;
    skos:prefLabel "Identify social and cultural changes" ;
    p1z:apqcId "10026" ;
    p1z:apqcHierarchyId "1.1.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Distinguishing changes in societal makeup, as well as the cultural composite. Isolate shifts in the societal composition and distribution, as well as the value systems and attributes that bind the organization together. Analyze well-regarded publications--and gather the perspective of public intellectuals and opinion leaders--on relevant issues." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10024 a p1z:Process ;
    skos:prefLabel "Assess new technologies" ;
    p1z:apqcId "10024" ;
    p1z:apqcHierarchyId "1.1.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing developments in technologies presently being used by the business, new technologies that have a potential for the business, and any disruptive innovations. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI).  Conduct a survey of advancement in technologies that are already deployed with inputs from the personnel closely working with them, tracking utility and feasibility for deployment. Arrange for mid- to senior-level management personnel who explore contingent uses to assess new and disruptive technologies. Follow up with desk research, involving physical scoping and viability assessment." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10025 a p1z:Process ;
    skos:prefLabel "Analyze demographics" ;
    p1z:apqcId "10025" ;
    p1z:apqcHierarchyId "1.1.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing statistical data relating to the size, distribution, and composition of relevant populations, as well as their characteristics. Perform quantitative analysis over raw data-sets gathered from well-founded sources such as government census or large, private databases. Consider employing primary research in collecting required statistics. Use comprehensive studies (reports, briefs, and articles) to assist with the analysis, in place of raw data." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF16790 a p1z:Process ;
    skos:prefLabel "Evaluate intellectual property" ;
    p1z:apqcId "16790" ;
    p1z:apqcHierarchyId "1.1.1.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing measures and procedures for identifying various intellectual property threats and concerns." ;
    p1z:parentProcess apqc:PCF10017 .

apqc:PCF10018 a p1z:Process ;
    skos:prefLabel "Survey market and determine customer needs and wants" ;
    p1z:apqcId "10018" ;
    p1z:apqcHierarchyId "1.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Examining the market to identify customer required solutions. Assess the relevant market(s) to determine the products/services that are needed or wanted by customers. Carry out quantitative and qualitative analyses to capture and investigate products/services. Employ creative techniques that allow for a closer appreciation of the customer, and design relevant solutions." ;
    p1z:parentProcess apqc:PCF17040 .

apqc:PCF10028 a p1z:Process ;
    skos:prefLabel "Conduct qualitative/quantitative research and assessments" ;
    p1z:apqcId "10028" ;
    p1z:apqcHierarchyId "1.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Investigating key market features and customer characteristics, using qualitative and quantitative measures to capture relevant aspects. Distill key ingredients that allow the organization to Capture customer needs and wants [19946], and Assess customer needs and wants [19947]. Conduct standardized appraisals by defining selection parameters and setting quotas." ;
    p1z:parentProcess apqc:PCF10018 .

apqc:PCF19946 a p1z:Process ;
    skos:prefLabel "Capture customer needs and wants" ;
    p1z:apqcId "19946" ;
    p1z:apqcHierarchyId "1.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and collecting customers' wants and needs of a product and/or services from a marketing perspective. Identify which consumer needs are important and whether needs are being met by current products/services." ;
    p1z:parentProcess apqc:PCF10018 .

apqc:PCF19947 a p1z:Process ;
    skos:prefLabel "Assess customer needs and wants" ;
    p1z:apqcId "19947" ;
    p1z:apqcHierarchyId "1.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating customer profiles to get a picture of customers and their needs. Identify particular groups of people/organizations that benefit from your product/services and then selling to them." ;
    p1z:parentProcess apqc:PCF10018 .

apqc:PCF10019 a p1z:Process ;
    skos:prefLabel "Assess the internal environment" ;
    p1z:apqcId "10019" ;
    p1z:apqcHierarchyId "1.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Undertaking a review of the organization's in-house skills and resources in order to create a big-picture understanding of internal capacities. Assess the organization's capabilities in order to advance the advantageous and weed out the detrimental aspects. Identify synergic associations within the backdrop of the forces and players active in the market, and take into account all externalities." ;
    p1z:parentProcess apqc:PCF17040 .

apqc:PCF10030 a p1z:Process ;
    skos:prefLabel "Analyze organizational characteristics" ;
    p1z:apqcId "10030" ;
    p1z:apqcHierarchyId "1.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and examining key attributes that differentiate the organization in the market and those that underscore the core of its operations. Consider how the organization functions. Reflect over tangible and intangible aspects in order to spot critical correlations and the interplay between these attributes. Have senior executives conduct the analysis, with input from management and operational personnel." ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF19948 a p1z:Process ;
    skos:prefLabel "Analyze internal operations" ;
    p1z:apqcId "19948" ;
    p1z:apqcHierarchyId "1.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify key elements of operations and measure effectiveness of these elements within internal operations." ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF10031 a p1z:Process ;
    skos:prefLabel "Create baselines for current processes" ;
    p1z:apqcId "10031" ;
    p1z:apqcHierarchyId "1.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing baselines that provide standards for assessing performance levels and allow for a relational benchmarking of current processes. Undertake a survey of archival performance records, conducted in conjunction by the management and the operations personnel. Take into account the organization's internal objectives, particularly for process improvement and enhancement. Understand industry best practices." ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF10032 a p1z:Process ;
    skos:prefLabel "Analyze systems and technology" ;
    p1z:apqcId "10032" ;
    p1z:apqcHierarchyId "1.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the capabilities of technology and process automation systems deployed within the organization in order to direct future associated processes. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Conduct a broad-based survey to examine various aspects associated with such systems and technologies, with the objective of identifying key facets that are of interest. Investigate the intended purpose, purpose served, utility, longevity, remaining service-life, repair or service requirements, etc." ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF10033 a p1z:Process ;
    skos:prefLabel "Analyze financial health" ;
    p1z:apqcId "10033" ;
    p1z:apqcHierarchyId "1.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Appraising the financial state of the organization so that management can create resource allocation strategies. Scrutinize the organization's financials--including balance sheets, statements of income, cash-flows, equity holdings, and liquidity--with the objective of understanding the organization's financial health and capacities. (This analysis directly feeds into Conduct organizational restructuring opportunities [16792] and Define a business concept and long-term vision [17040].)" ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF10034 a p1z:Process ;
    skos:prefLabel "Identify core competencies" ;
    p1z:apqcId "10034" ;
    p1z:apqcHierarchyId "1.1.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining a strategically significant aggregate of competence and capacities that differentiates the organization in the market. Identify distinguishing attributes including unique skills and resources and its brand and services in the marketplace. Have senior executives and management personnel assess competencies in order to further develop these capabilities into distinct commercial value propositions." ;
    p1z:parentProcess apqc:PCF10019 .

apqc:PCF10020 a p1z:Process ;
    skos:prefLabel "Establish strategic vision" ;
    p1z:apqcId "10020" ;
    p1z:apqcHierarchyId "1.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the organization's long-term vision as a strategic positioning and engagement of stakeholders. Institute the vision by creating strategic orientations of all stakeholders. Understand the strategy development frameworks in this context." ;
    p1z:parentProcess apqc:PCF17040 .

apqc:PCF19949 a p1z:Process ;
    skos:prefLabel "Define the strategic vision" ;
    p1z:apqcId "19949" ;
    p1z:apqcHierarchyId "1.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing goals to define organizations vision. Define and document ideas, direction, and activities which enable the organization to reach these goals." ;
    p1z:parentProcess apqc:PCF10020 .

apqc:PCF10035 a p1z:Process ;
    skos:prefLabel "Align stakeholders around strategic vision" ;
    p1z:apqcId "10035" ;
    p1z:apqcHierarchyId "1.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Orienting those entities, associated with the organization that have a direct bearing on its operations and output, in a way that advances its strategic vision. Map all stakeholders in strategic configurations, within the architectural layout of the marketplace, and position the organization relative to them. (This exercise is undertaken by senior strategy personnel, drawing upon the process Define a business concept and long-term vision [17040].)" ;
    p1z:parentProcess apqc:PCF10020 .

apqc:PCF10036 a p1z:Process ;
    skos:prefLabel "Communicate strategic vision to stakeholders" ;
    p1z:apqcId "10036" ;
    p1z:apqcHierarchyId "1.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and executing communication strategies to convey an alignment plan of all organizational stakeholders, which helps the organization realize its vision. Create custom communication strategies and delivery channels with the objective of orienting stakeholders according to the configuration maps created in the process Align stakeholders around a strategic vision [10035]. Have senior strategy personnel closely collaborate with the communications/marketing team." ;
    p1z:parentProcess apqc:PCF10020 .

apqc:PCF16792 a p1z:Process ;
    skos:prefLabel "Conduct organization restructuring opportunities" ;
    p1z:apqcId "16792" ;
    p1z:apqcHierarchyId "1.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the scope and contingencies for restructuring based on market situation and internal realities. Map the market forces over which any and all probabilities can be probed for utility and viability. Once the restructuring options have been analyzed and the due-diligence performed, execute the deal. Consider seeking professional services for assistance in formalizing these opportunities." ;
    p1z:parentProcess apqc:PCF17040 .

apqc:PCF16793 a p1z:Process ;
    skos:prefLabel "Identify restructuring opportunities" ;
    p1z:apqcId "16793" ;
    p1z:apqcHierarchyId "1.1.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying opportunities for restructuring the organization, through an analysis of internal viability and external contingency. Conduct a broad-based survey of the market landscape, taking the large-scale trends and movements into account, to determine the necessity and possibility of restructuring the organization. Review the organization's internal capacities, the readiness of its process frameworks, the robustness of its financials, the capableness of its systems, the resourcefulness of its personnel, etc. for assimilating an extensive overhaul." ;
    p1z:parentProcess apqc:PCF16792 .

apqc:PCF16794 a p1z:Process ;
    skos:prefLabel "Perform due-diligence" ;
    p1z:apqcId "16794" ;
    p1z:apqcHierarchyId "1.1.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Auditing the status quo of the probabilities, before formalizing any restructuring of the organization with another entity. Systematically investigate all entities discerned to be of interest in Identify restructuring opportunities [16793], to verify all tangible and substantial facts. Consider engaging specialist professional services including legal, accounting, and consulting help." ;
    p1z:parentProcess apqc:PCF16792 .

apqc:PCF16795 a p1z:Process ;
    skos:prefLabel "Analyze deal options" ;
    p1z:apqcId "16795" ;
    p1z:apqcHierarchyId "1.1.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining various options shortlisted for assimilating new entities into the organization or dissociating from it. Undertake a piecemeal and comprehensive consideration of each option identified for acquisition, merger, de-merger, and divestment. Consider intangible and non-material aspects of the entities involved and synergic aspects. Consider the assistance of specialist professional services." ;
    p1z:parentProcess apqc:PCF16792 .

apqc:PCF10015 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop business strategy" ;
    p1z:apqcId "10015" ;
    p1z:apqcHierarchyId "1.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing an organization's mission statement, strategy, and business design. Create a concise statement that clearly articulates the mission of the organization, outlining practicable targets to Establish a strategic vision [10020]. Delineate strategic options by matching these alternatives with the organization's internal capabilities. Create an organizational design, and identify goals by developing strategies at the functional and process levels." ;
    p1z:parentProcess apqc:PCF10002 .

apqc:PCF10037 a p1z:Process ;
    skos:prefLabel "Develop overall mission statement" ;
    p1z:apqcId "10037" ;
    p1z:apqcHierarchyId "1.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing an overarching, compact statement that concisely underscores the mission of the organization. Define and communicate a clear and succinct mission statement, which encapsulates how the organization aims to proceed in order to Establish a strategic vision [10020]. Solicit critical inputs from senior management and strategy executives, and collaborate with marketing or personnel from allied functions." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF10044 a p1z:Process ;
    skos:prefLabel "Define current business" ;
    p1z:apqcId "10044" ;
    p1z:apqcHierarchyId "1.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the status quo relating to the de facto core of what the business is. Reflect over the fundamental essence of what the business accomplishes and the manner in which it operates. Look beyond the obvious solution capabilities to delineate capacities that form the basis of the business engine. Involve senior executives and management personnel and possibly professional services providers." ;
    p1z:parentProcess apqc:PCF10037 .

apqc:PCF10045 a p1z:Process ;
    skos:prefLabel "Formulate mission" ;
    p1z:apqcId "10045" ;
    p1z:apqcHierarchyId "1.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining actionable objectives that effectively set a course to fulfill the organization's vision. In this fundamental activity, articulate certain goals or targets in broad but practicable terms to reach long-term objectives." ;
    p1z:parentProcess apqc:PCF10037 .

apqc:PCF10046 a p1z:Process ;
    skos:prefLabel "Communicate mission" ;
    p1z:apqcId "10046" ;
    p1z:apqcHierarchyId "1.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and executing a communication strategy to convey the mission statement. Create a universal communication strategy and appropriate delivery channels, with the objective of leveraging the latter to execute the former. Convey the inherent message of the mission to all stakeholders, including employees, customers, and the public. Ensure collaboration between senior strategy personnel and the communications/marketing team." ;
    p1z:parentProcess apqc:PCF10037 .

apqc:PCF10038 a p1z:Process ;
    skos:prefLabel "Define and evaluate strategic options to achieve the mission" ;
    p1z:apqcId "10038" ;
    p1z:apqcHierarchyId "1.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing sets of strategic decisions designed to drive the organization's long-term objectives. Identify various strategies concerning core functional areas. Appraise strategic options in light of auxiliary decision frameworks that ensure smooth functioning, the advancement of functional efficiencies, and vitality. Involve senior management executives, especially strategy and/or business unit personnel, with need-based consultative assistance from professional services providers." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF10047 a p1z:Process ;
    skos:prefLabel "Define strategic options" ;
    p1z:apqcId "10047" ;
    p1z:apqcHierarchyId "1.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the various options available to achieve the goals highlighted in the mission statement. Delineate (in accordance with a predefined criteria) the various permutations of strategic decisions that would help the organization achieve the objectives outlined in Develop overall mission statement [10037]. Involve senior management and key strategy personnel, with timely help from professional services providers." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF10048 a p1z:Process ;
    skos:prefLabel "Assess and analyze impact of each option" ;
    p1z:apqcId "10048" ;
    p1z:apqcHierarchyId "1.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Scoping and probing to study the impact of strategic options for fulfilling the organization's objectives. Estimate a measure of the impact effectuated by each set of strategic decisions, which comprise Define strategic options [10047]. Closely examine the consequences of each option." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21606 a p1z:Process ;
    skos:prefLabel "Evaluate B2B options" ;
    p1z:apqcId "21606" ;
    p1z:apqcHierarchyId "1.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating future business to business opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of stakeholders and partners to understand potential future impact." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21607 a p1z:Process ;
    skos:prefLabel "Evaluate B2C options" ;
    p1z:apqcId "21607" ;
    p1z:apqcHierarchyId "1.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating future business to customer opportunities against past and current approaches and performance. Gather insights into what competitors and other similar organizations are doing and the needs, goals, and expectations of customers and partners to understand potential future impact." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21608 a p1z:Process ;
    skos:prefLabel "Evaluate partner/alliance options" ;
    p1z:apqcId "21608" ;
    p1z:apqcHierarchyId "1.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating partnership and alliance opportunities to deliver products/services. Understand existing product and market models in use across the markets you serve, evolving trends, and the cost/benefit of potential new/updated partnership/alliance options." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21609 a p1z:Process ;
    skos:prefLabel "Evaluate IP acquisition options" ;
    p1z:apqcId "21609" ;
    p1z:apqcHierarchyId "1.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating intellectual property acquisition options available to scale, modernize, and/or extend product/service reach. Understand the cost, risk, timing and lifecycle value of candidate acquisitions." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21610 a p1z:Process ;
    skos:prefLabel "Evaluate innovation options" ;
    p1z:apqcId "21610" ;
    p1z:apqcHierarchyId "1.2.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating innovation options to advance technology, products/services, and/or operational performance." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21611 a p1z:Process ;
    skos:prefLabel "Evaluate sustainability options" ;
    p1z:apqcId "21611" ;
    p1z:apqcHierarchyId "1.2.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating sustainability requirements, stakeholder expectations, and value proposition for options. Understand the potential activities and changes across environmental, social, and governance, the effort required, cost to implement, and benefits gained. The analysis should consider sustainable product/service lifecycles, operations, infrastructure, performance, and workforce." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21612 a p1z:Process ;
    skos:prefLabel "Evaluate global support options" ;
    p1z:apqcId "21612" ;
    p1z:apqcHierarchyId "1.2.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating options for global support services and functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and customer value." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21613 a p1z:Process ;
    skos:prefLabel "Evaluate shared services options" ;
    p1z:apqcId "21613" ;
    p1z:apqcHierarchyId "1.2.2.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating options for shared services and support functions. This should include structure, scale, adaptability to change, and alternative delivery models to balance cost, performance, and operational efficiencies." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF21614 a p1z:Process ;
    skos:prefLabel "Evaluate lean/continuous improvement options" ;
    p1z:apqcId "21614" ;
    p1z:apqcHierarchyId "1.2.2.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating options to enhance and optimize processes and functional areas. Understand alternatives to strengthen business capabilities, enhance process efficiencies, and advance performance standards." ;
    p1z:parentProcess apqc:PCF10038 .

apqc:PCF10039 a p1z:Process ;
    skos:prefLabel "Set/Develop long-term enterprise strategy" ;
    p1z:apqcId "10039" ;
    p1z:apqcHierarchyId "1.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a strategy for the achievement of business goals over the distant future. Adopt one of the strategic options for realizing its mission over the long term. Enlist senior management executives, comprising strategy and/or business unit personnel." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF16803 a p1z:Process ;
    skos:prefLabel "Develop partner/alliance strategy" ;
    p1z:apqcId "16803" ;
    p1z:apqcHierarchyId "1.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining direction and plan objectives for external relationships and partnering with other companies to deliver product/services. Focus on creating a vision and strategic objectives and culminate in creating measures for the strategic alliance or partnership." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF14189 a p1z:Process ;
    skos:prefLabel "Develop sustainability strategy" ;
    p1z:apqcId "14189" ;
    p1z:apqcHierarchyId "1.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Formulating strategic options that create opportunities for the sustenance and prosperity of the business in the long run. Go beyond business longevity to consider alternate strategies that allow the organizations preservation of vitality over time. Earmark resources and target processes, the former of which are dedicated to the absorption of sustainable practices in the latter." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF16805 a p1z:Process ;
    skos:prefLabel "Develop merger/demerger/acquisition/exit strategy" ;
    p1z:apqcId "16805" ;
    p1z:apqcHierarchyId "1.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a strategy for corporate development. Include providing a framework for evaluating merger and acquisition candidates; and planning for a value creation through merging/demerging with a company, acquiring a company, or exiting from an already merged/acquired company." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF19952 a p1z:Process ;
    skos:prefLabel "Develop innovation strategy" ;
    p1z:apqcId "19952" ;
    p1z:apqcHierarchyId "1.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan and vision to encourage advancements in technology or product/services. Create a roadmap for changing or innovating the business model to make business operations more competitive. Set up new R&D services for changing or bringing new value propositions, services, production processes, and invention of technology not previously used by competitors etc." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF19950 a p1z:Process ;
    skos:prefLabel "Develop global support strategy" ;
    p1z:apqcId "19950" ;
    p1z:apqcHierarchyId "1.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan to deploy support services and support functions throughout the organization globally. Arrange the organizations functional support areas to create efficiencies of scale in the delivery of support services, globally." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF19951 a p1z:Process ;
    skos:prefLabel "Develop shared services strategy" ;
    p1z:apqcId "19951" ;
    p1z:apqcHierarchyId "1.2.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Charting a plan to leverage internal services and support functions throughout the organization. Delineate a framework of parameters and criteria to selectively filter service areas for inclusion among the organizations common resources. Arrange the organizations functional areas to create efficiencies of scale in the delivery of internal services." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF14197 a p1z:Process ;
    skos:prefLabel "Develop Lean/continuous improvement strategy" ;
    p1z:apqcId "14197" ;
    p1z:apqcHierarchyId "1.2.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing strategies for the optimization of processes and the improvement of functional areas in order to improve the bottom line. Create a road map of decision choices that would allow the organization to continuously enhance process efficiencies and advance performance standards." ;
    p1z:parentProcess apqc:PCF10039 .

apqc:PCF10040 a p1z:Process ;
    skos:prefLabel "Coordinate and align cross-functional and process strategies" ;
    p1z:apqcId "10040" ;
    p1z:apqcHierarchyId "1.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Aligning the approach and method of individual units, departments, systems, and operations within the organization, in accordance with the larger strategic course adopted. Employ the organization's strategic path to guide the functions, divisions, and operations. Calibrate the plan and method of each functional area, as well as the processes therein, to Select the long-term business strategy [10039]." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF10041 a p1z:Process ;
    skos:prefLabel "Create organizational design" ;
    p1z:apqcId "10041" ;
    p1z:apqcHierarchyId "1.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Formulating a design for the organization's resources that allow it to meet its objectives. Develop a new framework for molding the organization's various processes into a coherent and seamless whole." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF10049 a p1z:Process ;
    skos:prefLabel "Evaluate breadth and depth of organizational structure" ;
    p1z:apqcId "10049" ;
    p1z:apqcHierarchyId "1.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the structural makeup of the organization, including pertinent features of and associated synergies among constituent elements. Examine the organization's architectural framework, paying close attention to the individual elements, the relations among them, and the conjoint and co-acting forces therein. Analyze functions and processes, as well as work-related positions. Scrutinize various relevant characteristics associated with each of them, depending upon the scale, scope, and type of organization." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10050 a p1z:Process ;
    skos:prefLabel "Perform job-specific roles mapping and value-added analyses" ;
    p1z:apqcId "10050" ;
    p1z:apqcHierarchyId "1.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Appraising job-specific roles within the organizational chart and their hierarchical architecture. Analyze a map of work-related roles within the organizational structure. Examine the value added by the positions associated with jobs to be performed and how they stack up within the organization's operations." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10051 a p1z:Process ;
    skos:prefLabel "Develop role activity diagrams to assess hand-off activity" ;
    p1z:apqcId "10051" ;
    p1z:apqcHierarchyId "1.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the constituent exercises and undertakings within a work-related position for the purpose of effective delegation. Deconstruct job-specific roles into activities and visualize the relations among them, with the objective of assigning responsibilities to the appropriate personnel." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10052 a p1z:Process ;
    skos:prefLabel "Perform organization redesign workshops" ;
    p1z:apqcId "10052" ;
    p1z:apqcHierarchyId "1.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Organizing workshop sessions to adopt organizational redesign. Communicate the organizational structure and mapping of responsibilities against job roles in order to facilitate an effective understanding among personnel. Use a collaborative process that may include participative workshop sessions." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10053 a p1z:Process ;
    skos:prefLabel "Design the relationships between organizational units" ;
    p1z:apqcId "10053" ;
    p1z:apqcHierarchyId "1.2.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Fleshing out the connections and dependencies among the various units of the organization. Delineate the relationship among business units or process frameworks within the organization, in terms of activities, synergies, and shared resources and responsibilities. Formalize relationships among business units so that any mutual coherence is clearly understood and can be attended to." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10054 a p1z:Process ;
    skos:prefLabel "Develop role analysis and activity diagrams for key processes" ;
    p1z:apqcId "10054" ;
    p1z:apqcHierarchyId "1.2.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an understanding of the fit between job roles and organizational processes in order to properly place personnel. Deconstruct key processes into constituent activities, and examine job-related roles. Take cues from Develop role activity diagrams to assess hand-off activity [10051]. Map appropriate positions against these important processes, which in turn expedite the deployment of staff members." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10055 a p1z:Process ;
    skos:prefLabel "Assess organizational implication of feasible alternatives" ;
    p1z:apqcId "10055" ;
    p1z:apqcHierarchyId "1.2.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Probing the repercussions of all practicable organizational design options. Analyze the significance and impact of workable organizational structure options. Closely examine the long-term impact of these frameworks over the functioning of the organization." ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10056 a p1z:Process ;
    skos:prefLabel "Migrate to new organization" ;
    p1z:apqcId "10056" ;
    p1z:apqcHierarchyId "1.2.5.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Embracing and ratifying a new organizational structure. (Assume the new framework to be the best fit through Assess the organizational implications of feasible alternatives [10055].)" ;
    p1z:parentProcess apqc:PCF10041 .

apqc:PCF10042 a p1z:Process ;
    skos:prefLabel "Develop and set organizational objectives" ;
    p1z:apqcId "10042" ;
    p1z:apqcHierarchyId "1.2.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing overall goals for the organization that help in accomplishing its mission. Formulate organization-wide targets in the near to middle term, which will accumulate and propel the organization to realize its long-term objectives, as outlined in Develop an overall mission statement [10037]. Enlist business unit heads or equivalent personnel, in close collaboration with senior management executives." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF19953 a p1z:Process ;
    skos:prefLabel "Identify organizational objectives" ;
    p1z:apqcId "19953" ;
    p1z:apqcHierarchyId "1.2.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and developing strategic objectives that establishes a process to outline expected outcomes and guide employees' efforts." ;
    p1z:parentProcess apqc:PCF10042 .

apqc:PCF19954 a p1z:Process ;
    skos:prefLabel "Establish baseline metrics" ;
    p1z:apqcId "19954" ;
    p1z:apqcHierarchyId "1.2.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing baselines that provide standards for assessing performance. Create metrics and KPI's for various functions/processes/activities based on organizational goals." ;
    p1z:parentProcess apqc:PCF10042 .

apqc:PCF19955 a p1z:Process ;
    skos:prefLabel "Monitor performance against objective" ;
    p1z:apqcId "19955" ;
    p1z:apqcHierarchyId "1.2.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining methodology and frequency of assessment for measuring and monitoring performance of various functions/processes/activities against standard set goals." ;
    p1z:parentProcess apqc:PCF10042 .

apqc:PCF10043 a p1z:Process ;
    skos:prefLabel "Formulate business unit strategies" ;
    p1z:apqcId "10043" ;
    p1z:apqcHierarchyId "1.2.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Charting a strategic course for business units in order to leverage opportunities, sidestep hurdles, and create synergies among each other. Create strategic road maps for the organization's units--in light of their individual resources and requirements, as well as their relationships with other business units--to achieve organizational goals." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF19956 a p1z:Process ;
    skos:prefLabel "Analyze business unit strategies" ;
    p1z:apqcId "19956" ;
    p1z:apqcHierarchyId "1.2.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the performance of a business unit against set organizational goals which are based on pre-defined metrics collected through various business unit operations." ;
    p1z:parentProcess apqc:PCF10043 .

apqc:PCF19957 a p1z:Process ;
    skos:prefLabel "Identify core competency for each business unit" ;
    p1z:apqcId "19957" ;
    p1z:apqcHierarchyId "1.2.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the resources and skills of each business unit based on knowledge and technical capacity. Enable business units to meet customer needs and grow in a competitive marketplace." ;
    p1z:parentProcess apqc:PCF10043 .

apqc:PCF19958 a p1z:Process ;
    skos:prefLabel "Refine business unit strategies in support of organizational strategy" ;
    p1z:apqcId "19958" ;
    p1z:apqcHierarchyId "1.2.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating existing business unit strategy based on the company's strategy and eliminate unwanted/unnecessary resources/elements and re-consider necessary resources to meet the overall company's strategy." ;
    p1z:parentProcess apqc:PCF10043 .

apqc:PCF19959 a p1z:Process ;
    skos:prefLabel "Develop customer experience strategy" ;
    p1z:apqcId "19959" ;
    p1z:apqcHierarchyId "1.2.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a roadmap to meet customer expectations while considering how it will affect the business." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF19960 a p1z:Process ;
    skos:prefLabel "Assess customer experience" ;
    p1z:apqcId "19960" ;
    p1z:apqcHierarchyId "1.2.8.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring customer feedback in regard to product and services effectiveness based on overall satisfaction. The data to be analyzed is collected through surveys, customer responses, and feedbacks based on the delivered products/services." ;
    p1z:parentProcess apqc:PCF19959 .

apqc:PCF19964 a p1z:Process ;
    skos:prefLabel "Design customer experience" ;
    p1z:apqcId "19964" ;
    p1z:apqcHierarchyId "1.2.8.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a design of how customers interact with the business by analyzing data captured through various customer interaction and customer involvement. These will be captured through various channels such as customer satisfaction surveys, feedback forms, product reviews, targeted studies, observational studies, or voice of customer research." ;
    p1z:parentProcess apqc:PCF19959 .

apqc:PCF19971 a p1z:Process ;
    skos:prefLabel "Design customer experience support structure" ;
    p1z:apqcId "19971" ;
    p1z:apqcHierarchyId "1.2.8.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a roadmap for customer experience support with an overall approach, process flow, and impact timeframe." ;
    p1z:parentProcess apqc:PCF19959 .

apqc:PCF19974 a p1z:Process ;
    skos:prefLabel "Develop customer experience roadmap to develop and implement defined capabilities" ;
    p1z:apqcId "19974" ;
    p1z:apqcHierarchyId "1.2.8.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a standard guideline to create and execute the capacities of registering customer experiences in a timely manner. Create a common understanding of what behaviors are required to implement the strategy. Define what talent/skills your organization needs to reach customer experience goals." ;
    p1z:parentProcess apqc:PCF19959 .

apqc:PCF18916 a p1z:Process ;
    skos:prefLabel "Communicate strategies internally and externally" ;
    p1z:apqcId "18916" ;
    p1z:apqcHierarchyId "1.2.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying planned procedures and methods to both internal departments and external stakeholders like customers, suppliers, etc., in an effective manner based on organizational objective." ;
    p1z:parentProcess apqc:PCF10015 .

apqc:PCF10016 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and measure strategic initiatives" ;
    p1z:apqcId "10016" ;
    p1z:apqcHierarchyId "1.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing strategic initiatives, from development through selection, execution, and evaluation. Conduct and oversee strategic projects supporting long-term objectives. Administer programs of strategic significance by developing such initiatives, select the most appropriate projects, and formulate measures to assess their impact." ;
    p1z:parentProcess apqc:PCF10002 .

apqc:PCF10057 a p1z:Process ;
    skos:prefLabel "Develop strategic initiatives" ;
    p1z:apqcId "10057" ;
    p1z:apqcHierarchyId "1.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing strategic projects that help fulfill long-term goals. Develop time-bound projects that are discretionary in nature and lie beyond the scope of the organization's routine operations." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF19975 a p1z:Process ;
    skos:prefLabel "Identify strategic priorities" ;
    p1z:apqcId "19975" ;
    p1z:apqcHierarchyId "1.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a statement of the organization's direction to guide decision making around the allocation of resources. Provide a focus on the organization's overarching goals to ensure coherent and considered action. Strategic objectives are ranked by their importance in achieving the strategic goals. All subsequent operational or tactical planning and resource allocation is based on strategic priorities" ;
    p1z:parentProcess apqc:PCF10057 .

apqc:PCF19976 a p1z:Process ;
    skos:prefLabel "Develop strategic initiatives based on business/customer value" ;
    p1z:apqcId "19976" ;
    p1z:apqcHierarchyId "1.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a statement of the organization's direction based on what is considered \"value\" to the customer or business." ;
    p1z:parentProcess apqc:PCF10057 .

apqc:PCF19977 a p1z:Process ;
    skos:prefLabel "Review with stakeholders" ;
    p1z:apqcId "19977" ;
    p1z:apqcHierarchyId "1.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a process for stakeholder dialog that is integrated into the assessment of business strategies. Report on the evaluation of the business objectives, strategies, subject, or past events." ;
    p1z:parentProcess apqc:PCF10057 .

apqc:PCF10058 a p1z:Process ;
    skos:prefLabel "Evaluate strategic initiatives" ;
    p1z:apqcId "10058" ;
    p1z:apqcHierarchyId "1.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Examining projects of strategic significance that lie outside the purview of the organization's routine operations. Closely analyze strategic initiatives for their applicability and feasibility, given the organization's vision." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF19978 a p1z:Process ;
    skos:prefLabel "Determine business value for each strategic priority" ;
    p1z:apqcId "19978" ;
    p1z:apqcHierarchyId "1.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a standard measure of value to determine the business worth for each of the Identify strategic priorities [19975]. List the effectiveness and utility for every important strategic element based on the benefit it adds to the business." ;
    p1z:parentProcess apqc:PCF10058 .

apqc:PCF19979 a p1z:Process ;
    skos:prefLabel "Determine the customer value for each strategic priority" ;
    p1z:apqcId "19979" ;
    p1z:apqcHierarchyId "1.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the value preposition; the value the customer gets from a product/services for each of your Identify strategic priorities [19975]. Customer value is the satisfaction a consumer feels after making a purchase for goods or services relative to what he/she must give up to receive them." ;
    p1z:parentProcess apqc:PCF10058 .

apqc:PCF10059 a p1z:Process ;
    skos:prefLabel "Select strategic initiatives" ;
    p1z:apqcId "10059" ;
    p1z:apqcHierarchyId "1.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Selecting relevant projects of strategic significance that create opportunities for the organization to realize its long-term objectives, on the basis of their suitability to the organization's constraints and reality. Select from the process Evaluate strategic initiatives [10058], based on their applicability and feasibility for the organization. Enlist senior management, especially strategy personnel." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF19980 a p1z:Process ;
    skos:prefLabel "Prioritize strategic initiatives" ;
    p1z:apqcId "19980" ;
    p1z:apqcHierarchyId "1.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Listing the most effective procedures in the order of most important to the least. Create measures or filter for determining which of many \"strategic initiatives\" is most important to the least important." ;
    p1z:parentProcess apqc:PCF10059 .

apqc:PCF19981 a p1z:Process ;
    skos:prefLabel "Communicate strategic initiatives to business units and stakeholders" ;
    p1z:apqcId "19981" ;
    p1z:apqcHierarchyId "1.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing procedures for communications within the organization which creates the road map for successful understanding of strategic initiatives for both business units and stakeholders (internal and external)." ;
    p1z:parentProcess apqc:PCF10059 .

apqc:PCF10060 a p1z:Process ;
    skos:prefLabel "Establish high-level measures" ;
    p1z:apqcId "10060" ;
    p1z:apqcHierarchyId "1.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising measures to examine strategic projects. Formulate evaluation criteria to assess the strategic initiatives for the level of impact." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF19982 a p1z:Process ;
    skos:prefLabel "Identify business value drivers" ;
    p1z:apqcId "19982" ;
    p1z:apqcHierarchyId "1.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining key indicators or factors responsible for driving business value. Key business value drivers comprise of operational, financial, and sustainability drivers." ;
    p1z:parentProcess apqc:PCF10060 .

apqc:PCF19983 a p1z:Process ;
    skos:prefLabel "Establish baselines for business value drivers" ;
    p1z:apqcId "19983" ;
    p1z:apqcHierarchyId "1.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing baseline measures that provide standards for assessing performance of Identify business value drivers [19982]." ;
    p1z:parentProcess apqc:PCF10060 .

apqc:PCF19984 a p1z:Process ;
    skos:prefLabel "Monitor performance against baselines" ;
    p1z:apqcId "19984" ;
    p1z:apqcHierarchyId "1.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing the progress of activities to ensure they are on-course and on-schedule in meeting the objectives and performance targets against Establish baselines for business value drivers [19983]." ;
    p1z:parentProcess apqc:PCF10060 .

apqc:PCF19507 a p1z:Process ;
    skos:prefLabel "Execute strategic initiatives" ;
    p1z:apqcId "19507" ;
    p1z:apqcHierarchyId "1.3.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Successfully implement strategic initiatives. Execution of strategy is also defined as the process of implementing logical set of connected activities by an organization to make a strategy work." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF21422 a p1z:Process ;
    skos:prefLabel "Review execution of strategic initiatives" ;
    p1z:apqcId "21422" ;
    p1z:apqcHierarchyId "1.3.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Periodic review of initiatives based performance, conditions, and marketplace response." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF21423 a p1z:Process ;
    skos:prefLabel "Refine strategic initiatives and project plans as needed" ;
    p1z:apqcId "21423" ;
    p1z:apqcHierarchyId "1.3.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing required updates to strategic initiatives based upon changes in the marketplace or performance." ;
    p1z:parentProcess apqc:PCF10016 .

apqc:PCF20944 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and maintain business models" ;
    p1z:apqcId "20944" ;
    p1z:apqcHierarchyId "1.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing how an organization creates, delivers and captures value or makes profit. Identify the products or services that a business will sell, its target market, anticipated expenses, and other core aspects of its modus operandi. Revise the plan as required to reflect changing circumstances." ;
    p1z:parentProcess apqc:PCF10002 .

apqc:PCF20945 a p1z:Process ;
    skos:prefLabel "Develop business models" ;
    p1z:apqcId "20945" ;
    p1z:apqcHierarchyId "1.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an economic model that describes the goals of an organization and the business processes needed to achieve those goals. This involves information gathering, securing necessary approvals and authorizations, integrating with preexisting models, including the general business concept [10002] and business strategy [10015], and formally accepting the model as the basis for organization's day-to-day operations." ;
    p1z:parentProcess apqc:PCF20944 .

apqc:PCF20946 a p1z:Process ;
    skos:prefLabel "Assemble business model information" ;
    p1z:apqcId "20946" ;
    p1z:apqcHierarchyId "1.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collecting all relevant materials needed to develop the business model, so that it can adequately model its processes." ;
    p1z:parentProcess apqc:PCF20945 .

apqc:PCF20947 a p1z:Process ;
    skos:prefLabel "Secure appropriate approvals" ;
    p1z:apqcId "20947" ;
    p1z:apqcHierarchyId "1.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining required permissions, licenses and authorizations that legitimize the business, help to mitigate associated risks and safeguard the operations." ;
    p1z:parentProcess apqc:PCF20945 .

apqc:PCF20948 a p1z:Process ;
    skos:prefLabel "Identify integration points with existing models" ;
    p1z:apqcId "20948" ;
    p1z:apqcHierarchyId "1.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring coherence with pre-exsiting models to avoid contradictions between models. Make sure that all models represent the same long-term vision." ;
    p1z:parentProcess apqc:PCF20945 .

apqc:PCF20949 a p1z:Process ;
    skos:prefLabel "Adopt the business model" ;
    p1z:apqcId "20949" ;
    p1z:apqcHierarchyId "1.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Consenting to a particular business model and formally accepting it to serve as the set of guiding principles in operating the company." ;
    p1z:parentProcess apqc:PCF20945 .

apqc:PCF20950 a p1z:Process ;
    skos:prefLabel "Maintain business models" ;
    p1z:apqcId "20950" ;
    p1z:apqcHierarchyId "1.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Revising and updating business models to reflect the changes in the marketed services, product inventory, market behavior, available resources or accrued expenses. Determine how and when to modify the accepted business model in response to incoming feedback." ;
    p1z:parentProcess apqc:PCF20944 .

apqc:PCF20951 a p1z:Process ;
    skos:prefLabel "Establish business model maintenance parameters" ;
    p1z:apqcId "20951" ;
    p1z:apqcHierarchyId "1.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the timeline, procedures and responsibilities for reviewing the business model and for updating it to best serve the organization." ;
    p1z:parentProcess apqc:PCF20950 .

apqc:PCF20952 a p1z:Process ;
    skos:prefLabel "Accept business model feedback parameters" ;
    p1z:apqcId "20952" ;
    p1z:apqcHierarchyId "1.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding the type of responses, reactions, sentiments and insights that are crucial to be taken into consideration with business model maintenance." ;
    p1z:parentProcess apqc:PCF20950 .

apqc:PCF20953 a p1z:Process ;
    skos:prefLabel "Prioritize and manage incoming feedback" ;
    p1z:apqcId "20953" ;
    p1z:apqcHierarchyId "1.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the feedback regarding products, services, processes or resources. Determine which judgments are critical and mandate changes to the current business model to better deliver the desired value" ;
    p1z:parentProcess apqc:PCF20950 .

apqc:PCF20954 a p1z:Process ;
    skos:prefLabel "Update existing models" ;
    p1z:apqcId "20954" ;
    p1z:apqcHierarchyId "1.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Modifying the business models that are presently in use in response to incoming feedback or changing markets to achieve the enterprise business goals." ;
    p1z:parentProcess apqc:PCF20950 .

apqc:PCF20955 a p1z:Process ;
    skos:prefLabel "Establish business model governance" ;
    p1z:apqcId "20955" ;
    p1z:apqcHierarchyId "1.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing a strategy, responsibilities and control mechanisms for managing business models that are timely, efficient and cost-effective." ;
    p1z:parentProcess apqc:PCF20944 .

apqc:PCF10003 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and Manage Products and Services" ;
    p1z:apqcId "10003" ;
    p1z:apqcHierarchyId "2.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Detailing practices and procedures related to the concept of developing and managing products and services. These are reflected in the process groups Govern and manage product/service development program [19696], Generate and define new product/service ideas [19698], and Develop products and services [10062]." .

apqc:PCF19696 a p1z:FunctionalDomain ;
    skos:prefLabel "Govern and manage product/service development program" ;
    p1z:apqcId "19696" ;
    p1z:apqcHierarchyId "2.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Supervising the complete product/service program from innovation until its commercial success. Meeting the customer demand and expectations. Conduct further development and innovation pertaining to business goals." ;
    p1z:parentProcess apqc:PCF10003 .

apqc:PCF10061 a p1z:Process ;
    skos:prefLabel "Manage product and service portfolio" ;
    p1z:apqcId "10061" ;
    p1z:apqcHierarchyId "2.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing a portfolio of product/service offerings to take advantage of shifts in the market expectations, all the while coordinating with the overall business strategy. Revisit the product/service portfolio in light of market opportunities, and overhaul it to capture value created by these opportunities. Identify gaps between current offerings and the market expectations to direct the organization's R&D activity. Create new solutions, and revise or retire existing ones so that the revamped portfolio aligns with Develop a business strategy [10015]." ;
    p1z:parentProcess apqc:PCF19696 .

apqc:PCF10063 a p1z:Process ;
    skos:prefLabel "Evaluate performance of existing products/services against market opportunities" ;
    p1z:apqcId "10063" ;
    p1z:apqcHierarchyId "2.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the capabilities and performance of existing products/services, in light of market opportunities. Examine performance of the existing line of products/services, including measures of profitability, penetration, and value delivered. Identify gaps between existing solutions' portfolio or their performance levels, on the one hand, and the current market demand, available technologies, and/or customer expectations, on the other. Consider opportunities in the present market environment and any relation with the performance. Consider input from professional services providers." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10066 a p1z:Process ;
    skos:prefLabel "Confirm alignment of product/service concepts with business strategy" ;
    p1z:apqcId "10066" ;
    p1z:apqcHierarchyId "2.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking the alignment of product/service portfolio, and its individual offerings, with the organization's overall strategy and planning for the development of new or revised solutions. Conduct reality checks on new product/service concepts prior to committing significant investment to ensure that the revamped solutions' portfolio is in line with the overall business strategy, aligns organizational processes for their development, and creates a plan for assimilating these changes in the organization's offerings. Enlist senior management executives." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10074 a p1z:Process ;
    skos:prefLabel "Prioritize and select new product/service concepts" ;
    p1z:apqcId "10074" ;
    p1z:apqcHierarchyId "2.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Selecting from among the potential new/revised solutions and capitalizing on market opportunities so that they meet the cost and quality prerequisites. Create an index of product/service concepts, and arrange them in order of preference. Base prioritization on adherence to Plan and develop cost and quality targets [10073], and choose options that would comprise the revised solution portfolio." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10073 a p1z:Process ;
    skos:prefLabel "Plan and develop cost and quality targets" ;
    p1z:apqcId "10073" ;
    p1z:apqcHierarchyId "2.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Setting prerequisites for the cost of development and quality standards for the new solutions' portfolio and/or its individual offerings. Set targets for the budget and quality standards for the revamped portfolio of solution offerings. Prepare a plan for the outlay required for revising and adding new product/services. Identify intended levels of quality for these, bearing in mind the existing standards of solutions offered by the organization and its competitors. Enlist senior management executives, particularly those responsible for finance and budgeting, product/service design, manufacturing/processing, delivery, and quality control." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10075 a p1z:Process ;
    skos:prefLabel "Specify development timing targets" ;
    p1z:apqcId "10075" ;
    p1z:apqcHierarchyId "2.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the individual and collective timeframe for realizing new/revised solutions. Create a schedule that clearly demarcates the timeframes designated for the development of every new solution and/or revising each of the existing ones. Create a timetable by setting deadlines for each step in overhauling the product/service portfolio." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10076 a p1z:Process ;
    skos:prefLabel "Plan for product/service offering modifications" ;
    p1z:apqcId "10076" ;
    p1z:apqcHierarchyId "2.1.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a programmatic procedure for changing products/services while paying heed to all stakeholders involved and the prerequisites identified. Create a plan for changing the existing portfolio of solution offerings. Develop a systematic program for the design, processing, and delivery of the new product/service concepts. Construct project-flow diagrams. Identify the stakeholders involved and personnel responsible for each stage, as well as the necessary decisions. Earmark the budgetary outlay, and conduct any strategic planning required." ;
    p1z:parentProcess apqc:PCF10061 .

apqc:PCF10067 a p1z:Process ;
    skos:prefLabel "Manage product and service life cycle" ;
    p1z:apqcId "10067" ;
    p1z:apqcHierarchyId "2.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Manage the introduction and withdrawal of products/services. Administer associated changes, namely measuring the performance of new solution offerings and the revision of master files in the archives." ;
    p1z:parentProcess apqc:PCF19696 .

apqc:PCF16824 a p1z:Process ;
    skos:prefLabel "Develop plan for new product/service development and introduction/launch" ;
    p1z:apqcId "16824" ;
    p1z:apqcHierarchyId "2.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a program and managing a perspective for new product/service introduction and launch." ;
    p1z:parentProcess apqc:PCF10067 .

apqc:PCF10077 a p1z:Process ;
    skos:prefLabel "Introduce new products/services" ;
    p1z:apqcId "10077" ;
    p1z:apqcHierarchyId "2.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Launching revamped product/service portfolio in to the market. Introduction in to the marketplace is done by deploying effective channels for marketing, sales, delivery, and after-sales servicing. Introduce new/revised solution offerings in a concerted effort. Coordinate a cross-functional effort." ;
    p1z:parentProcess apqc:PCF10067 .

apqc:PCF10078 a p1z:Process ;
    skos:prefLabel "Retire outdated products/services" ;
    p1z:apqcId "10078" ;
    p1z:apqcHierarchyId "2.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Removing nonconforming products and services. Withdraw those products/services that do not conform to market realities and are not positioned to take advantage of prevailing opportunities. Coordinate with processing/delivery teams within the organization and key stakeholders in the supply chain. Create mechanisms for continued after-sales servicing, as well as deploy effective public relations efforts in order to preserve the image and goodwill of the organization through the process." ;
    p1z:parentProcess apqc:PCF10067 .

apqc:PCF10079 a p1z:Process ;
    skos:prefLabel "Identify and refine performance indicators" ;
    p1z:apqcId "10079" ;
    p1z:apqcHierarchyId "2.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Attuning the performance measures of products/services to better reflect the revamped portfolio of solution offerings. Revise the parameters used to measure performance, apropos the organization's product/service offerings. (Modify these standards in consideration of the changes made to the portfolio by Introduce new products/services [10077] and Retire outdated products/services [10078].)" ;
    p1z:parentProcess apqc:PCF10067 .

apqc:PCF11423 a p1z:Process ;
    skos:prefLabel "Conduct post launch review" ;
    p1z:apqcId "11423" ;
    p1z:apqcHierarchyId "2.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Learning from either a test or a full production run within the consumer market. Companies use this as an opportunity to both test and react to new products, ideas, or innovations based on the initial reaction of consumers on an individual level. Within this process, analytics are used to determine the relative success of a new product offering. Within this process, companies will launch key analytics to test a products acceptance. They will also review market performance and compare to similar products and against the business case or the financial plan. Companies can also measure the effectiveness of their supply chain network, and can apply what is learned from the post launch review to other new products, processes, and procedures to ensure and enhance the product quality." ;
    p1z:parentProcess apqc:PCF10067 .

apqc:PCF19985 a p1z:Process ;
    skos:prefLabel "Manage patents, copyrights, and regulatory requirements" ;
    p1z:apqcId "19985" ;
    p1z:apqcHierarchyId "2.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the attributes necessary to protect and safeguard intellectual assets, maximize the value of IP assets through streamlined process, and collaboration between departments. Focus on needs to safeguard, critical assets, and assets' value." ;
    p1z:parentProcess apqc:PCF19696 .

apqc:PCF19941 a p1z:Process ;
    skos:prefLabel "Conduct mandatory and elective reviews" ;
    p1z:apqcId "19941" ;
    p1z:apqcHierarchyId "2.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting necessary performance reviews on enforcement of processes and steps to ensure protection. Determine policies and reviews for Manage patents, copyrights, and regulatory requirements [19985]." ;
    p1z:parentProcess apqc:PCF19985 .

apqc:PCF16826 a p1z:Process ;
    skos:prefLabel "Review infringement of patents and copyrights" ;
    p1z:apqcId "16826" ;
    p1z:apqcHierarchyId "2.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing activities in regards to patentability and infringement. The usage of Open Source in commercial product development will be reviewed in regard to licensing, community development, etc." ;
    p1z:parentProcess apqc:PCF19985 .

apqc:PCF16827 a p1z:Process ;
    skos:prefLabel "Determine patent and copyright needs" ;
    p1z:apqcId "16827" ;
    p1z:apqcHierarchyId "2.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the business need for patents and copyrights. The patents and copyrights are managed by Manage copyrights and patents [11062]." ;
    p1z:parentProcess apqc:PCF19985 .

apqc:PCF19697 a p1z:Process ;
    skos:prefLabel "Define product technical documentation management requirements" ;
    p1z:apqcId "19697" ;
    p1z:apqcHierarchyId "2.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining sourcing and procurement requirements for new product technical documentation management. Make sourcing-based decisions that identify the capabilities that will be required in order to launch the new product. This documentation will be used to support the product following entry into service. It is compiled and managed in Manage product and process related data [12082], but the capability to manage and maintain this documentation must be defined and established." ;
    p1z:parentProcess apqc:PCF19985 .

apqc:PCF12771 a p1z:Process ;
    skos:prefLabel "Manage regulatory requirements" ;
    p1z:apqcId "12771" ;
    p1z:apqcHierarchyId "2.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning regulatory activities related to managing industry requirements. Train employees on regulatory requirements. Records for the appropriate regulatory agencies must be maintained and the new product process must be approved by the appropriate regulatory body before it is published to the organization. The submission lifecycle - i.e. creation, review, and approval of the submission and its components must be managed in a collaborative fashion." ;
    p1z:parentProcess apqc:PCF19985 .

apqc:PCF11740 a p1z:Process ;
    skos:prefLabel "Manage product and service master data" ;
    p1z:apqcId "11740" ;
    p1z:apqcHierarchyId "2.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Controlling/authorizing to enable services' and products' data and other critical data of these functions through a well secured storage and accessibility processes backed by siloed applications/IT systems." ;
    p1z:parentProcess apqc:PCF19696 .

apqc:PCF11741 a p1z:Process ;
    skos:prefLabel "Manage materials master lists" ;
    p1z:apqcId "11741" ;
    p1z:apqcHierarchyId "2.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Controlling the details of materials' storage and utilization, supplier details linked to materials, in a defined sequential manner and ensuring regular updates with permissible accessibility." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11742 a p1z:Process ;
    skos:prefLabel "Manage bills of material" ;
    p1z:apqcId "11742" ;
    p1z:apqcHierarchyId "2.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the purchase details/bills through regular and error free updates to applications. Create manual entries wherever necessary and ensure timely review of the laid processes and systems." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11743 a p1z:Process ;
    skos:prefLabel "Manage routings" ;
    p1z:apqcId "11743" ;
    p1z:apqcHierarchyId "2.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Controlling and executing the flow of operations from raw form to finished product in a defined format using industry applications/routing sheets for the specific product/service layout." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11744 a p1z:Process ;
    skos:prefLabel "Manage specifications" ;
    p1z:apqcId "11744" ;
    p1z:apqcHierarchyId "2.1.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Direct, supervise, and control the product/service details necessary to execute the process. Adhere to details and descriptions for product/service through identified or guided parameters towards final outcome in the market with due critical analysis formed on organizational objectives." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11745 a p1z:Process ;
    skos:prefLabel "Manage drawings" ;
    p1z:apqcId "11745" ;
    p1z:apqcHierarchyId "2.1.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the specifications of the product/service and ensure accessibility for product alteration/new product development." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11746 a p1z:Process ;
    skos:prefLabel "Manage product/material classification" ;
    p1z:apqcId "11746" ;
    p1z:apqcHierarchyId "2.1.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Controlling the details of the product and the input materials. Manage classification throughout the production process, and for future accessibility to new product development or product enrichment." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11747 a p1z:Process ;
    skos:prefLabel "Develop and maintain quality/inspection documents" ;
    p1z:apqcId "11747" ;
    p1z:apqcHierarchyId "2.1.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining procedures required to assess the sustainability of defined criterion for product/service delivery to customers. Retain results for further review as a procedural practice." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11748 a p1z:Process ;
    skos:prefLabel "Maintain process specification data" ;
    p1z:apqcId "11748" ;
    p1z:apqcHierarchyId "2.1.4.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Directing and handling data with respect to the procedures followed across different functions and mission critical applications." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11749 a p1z:Process ;
    skos:prefLabel "Manage traceability data" ;
    p1z:apqcId "11749" ;
    p1z:apqcHierarchyId "2.1.4.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and handling data accessed by the permitted touch points. Ensure that no data is accessible to any unnecessary recipient. Data flow should be controlled through secured access and free from unauthorized access." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF11750 a p1z:Process ;
    skos:prefLabel "Review and approve data access requests" ;
    p1z:apqcId "11750" ;
    p1z:apqcHierarchyId "2.1.4.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the requests pertaining to data accessibility. Review the requester details based on internal data security policies and permit data access only if internal policies and data access parameters are met." ;
    p1z:parentProcess apqc:PCF11740 .

apqc:PCF19698 a p1z:FunctionalDomain ;
    skos:prefLabel "Generate and define new product/service ideas" ;
    p1z:apqcId "19698" ;
    p1z:apqcHierarchyId "2.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Identifying and describing new product or service thoughts based on organizational objectives/targets." ;
    p1z:parentProcess apqc:PCF10003 .

apqc:PCF10065 a p1z:Process ;
    skos:prefLabel "Perform discovery research" ;
    p1z:apqcId "10065" ;
    p1z:apqcHierarchyId "2.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Coordinating R&D activity to identify new technologies to integrate into the revamped portfolio of products/services. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Conduct early-stage R&D activity to close gaps between existing solution offerings and changing market expectations. Triangulate appropriate technologies that can support the development of a revised product/service portfolio." ;
    p1z:parentProcess apqc:PCF19698 .

apqc:PCF10070 a p1z:Process ;
    skos:prefLabel "Identify new technologies" ;
    p1z:apqcId "10070" ;
    p1z:apqcHierarchyId "2.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining new technologies to revise the portfolio of solution offerings. Identify recently developed technological advances that can be leveraged in the development or advancement of the organization's product/service portfolio. Enlist senior management in conjunction with personnel responsible for the design, processing, and delivery of products/services. Have the organization's research division(s) carry out the process." ;
    p1z:parentProcess apqc:PCF10065 .

apqc:PCF10071 a p1z:Process ;
    skos:prefLabel "Develop new technologies" ;
    p1z:apqcId "10071" ;
    p1z:apqcHierarchyId "2.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing new technologies from scratch to integrate into a revised portfolio of solutions. Develop new technological processes, models, and/or implements in-house, with the objective of improving existing solutions or creating new ones. Consider market realities, as well as the portfolio of products/services. Assess the results in conjunction with senior executives and personnel responsible for the design, processing, and delivery of these solutions. Engage the R&D function, and consider external sources such as offshore providers, specialized research agencies, and crowdsourcing communities." ;
    p1z:parentProcess apqc:PCF10065 .

apqc:PCF10072 a p1z:Process ;
    skos:prefLabel "Assess feasibility of integrating new leading technologies into product/service concepts" ;
    p1z:apqcId "10072" ;
    p1z:apqcHierarchyId "2.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Appraising the feasibility of integrating new technologies, whether developed as a custom solution or adopted from an external source, into revised portfolio of solution offerings. Examine recently developed technological advances for suitability to incorporate them into the concept of revised and/or new solution offerings. Enlist senior management, in consultation with in-house personnel responsible for the design, processing, and delivery of these solutions, as well as key supply-chain stakeholders." ;
    p1z:parentProcess apqc:PCF10065 .

apqc:PCF19669 a p1z:Process ;
    skos:prefLabel "Generate new product/service concepts" ;
    p1z:apqcId "19669" ;
    p1z:apqcHierarchyId "2.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Producing and defining ideologies for new product/service offerings." ;
    p1z:parentProcess apqc:PCF19698 .

apqc:PCF19986 a p1z:Process ;
    skos:prefLabel "Gather new product/service ideas and requirements" ;
    p1z:apqcId "19986" ;
    p1z:apqcHierarchyId "2.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collecting necessary items, documents, regulatory requirements, etc., based on Generate and define new product/service ideas [19698]" ;
    p1z:parentProcess apqc:PCF19669 .

apqc:PCF19987 a p1z:Process ;
    skos:prefLabel "Analyze new product/service ideas and requirements" ;
    p1z:apqcId "19987" ;
    p1z:apqcHierarchyId "2.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and reviewing the concepts and requirements of Generate and define new product/service ideas [19698]" ;
    p1z:parentProcess apqc:PCF19669 .

apqc:PCF19988 a p1z:Process ;
    skos:prefLabel "Evaluate new product/service inputs and requirements" ;
    p1z:apqcId "19988" ;
    p1z:apqcHierarchyId "2.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and reviewing the required inputs and necessary elements such as automation, technology, hardware installation, regulatory requirements, certifications, etc., for new products/services through defined process and analysis." ;
    p1z:parentProcess apqc:PCF19669 .

apqc:PCF19989 a p1z:Process ;
    skos:prefLabel "Formulate new product/service concepts" ;
    p1z:apqcId "19989" ;
    p1z:apqcHierarchyId "2.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising ideas and elements necessary for thoughts on new product/service development." ;
    p1z:parentProcess apqc:PCF19669 .

apqc:PCF10068 a p1z:Process ;
    skos:prefLabel "Identify potential improvements to existing products and services" ;
    p1z:apqcId "10068" ;
    p1z:apqcHierarchyId "2.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining potential enhancements to current products/services in order to take advantage of a shift in market expectations. Identify how the existing line of products/services may be revised--through enhancements to individual solutions or across-the-board renovations--in order to capitalize on present opportunities in the market." ;
    p1z:parentProcess apqc:PCF19669 .

apqc:PCF19990 a p1z:Process ;
    skos:prefLabel "Define product/service development requirements" ;
    p1z:apqcId "19990" ;
    p1z:apqcHierarchyId "2.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Encompassing the identification and capture of new product/service requirements or potential improvements to current products/services. Collaborating with members of the supply chain to ensure the feasibility of what is being defined in the requirements. For example, a product with manufacturing requirements that supply chain cannot currently fulfill requires a corporate decision to either upgrade manufacturing capabilities or abandon the new product. Enterprise-level effects and needs must be considered. Depending on the nature of the final product or service, these requirements are often defined as a set of abilities, such as availability or reliability, that influence product development decisions." ;
    p1z:parentProcess apqc:PCF19698 .

apqc:PCF11331 a p1z:Process ;
    skos:prefLabel "Define product/service requirements" ;
    p1z:apqcId "11331" ;
    p1z:apqcHierarchyId "2.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining requirements related to the creation of the product/service. Explain potential achievements that could be made." ;
    p1z:parentProcess apqc:PCF19990 .

apqc:PCF16815 a p1z:Process ;
    skos:prefLabel "Define post launch support model" ;
    p1z:apqcId "16815" ;
    p1z:apqcHierarchyId "2.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining SLAs (Service Level Agreement) and service level KPIs (Key Performance Indicator)." ;
    p1z:parentProcess apqc:PCF19990 .

apqc:PCF17389 a p1z:Process ;
    skos:prefLabel "Identify product/service bundling opportunities" ;
    p1z:apqcId "17389" ;
    p1z:apqcHierarchyId "2.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing areas of growth and further development of product/service mix, customization, market based changes, etc., to further demonstrate value to the customer in the competition." ;
    p1z:parentProcess apqc:PCF19990 .

apqc:PCF10062 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop products and services" ;
    p1z:apqcId "10062" ;
    p1z:apqcHierarchyId "2.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing new products/services from scratch, including all activities associated with the design, prototyping, evaluation, and market testing of these planned offerings." ;
    p1z:parentProcess apqc:PCF10003 .

apqc:PCF19993 a p1z:Process ;
    skos:prefLabel "Design and prototype products and services" ;
    p1z:apqcId "19993" ;
    p1z:apqcHierarchyId "2.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Sketching and standardizing product and service based on the market. Analyze the data market competitiveness and innovation attained for the product and service development." ;
    p1z:parentProcess apqc:PCF10062 .

apqc:PCF10083 a p1z:Process ;
    skos:prefLabel "Assign resources to product/service project" ;
    p1z:apqcId "10083" ;
    p1z:apqcHierarchyId "2.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Allocating resources to the design, development, and evaluation of product/service concepts. Allocate funds, personnel, and time for developing the new and/or revised products/services. Begin to design the potential new product/service concepts that have been prioritized and selected for further development." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10084 a p1z:Process ;
    skos:prefLabel "Prepare high-level business case and technical assessment" ;
    p1z:apqcId "10084" ;
    p1z:apqcHierarchyId "2.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing a business-level business case and a technical feasibility assessment in order to move the product/service projects forward. Weigh the costs and benefits of designing, developing, and evaluating the shortlisted product/service concepts. Prepare a business case to justify the product/service projects. Conduct a technical appraisal to ensure that the organization has the technical know-how and resources to further develop these concepts." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10085 a p1z:Process ;
    skos:prefLabel "Develop product/service design specifications" ;
    p1z:apqcId "10085" ;
    p1z:apqcHierarchyId "2.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating design specifications. Create specifications for the design of new or revised product/service concepts as a measure to meet during development. Have the senior functional-level solutioning or design staff create a framework of compliance standards for these products/services." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF16813 a p1z:Process ;
    skos:prefLabel "Develop user experience design specifications" ;
    p1z:apqcId "16813" ;
    p1z:apqcHierarchyId "2.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the usability and user experience of products and the business impact it creates." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF16817 a p1z:Process ;
    skos:prefLabel "Provide warranty-related recommendations" ;
    p1z:apqcId "16817" ;
    p1z:apqcHierarchyId "2.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing warranty plan and pricing specifications for recommendation." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10086 a p1z:Process ;
    skos:prefLabel "Document design specifications" ;
    p1z:apqcId "10086" ;
    p1z:apqcHierarchyId "2.3.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting requirements to meet in the design of new or revised products/services. Specify technical, quality, and costing requirements, as well as ergonomic, safety, and servicing requirements for such products/services. Ensure the information presented can be understood by the personnel executing the design and includes examples, anecdotal references, and illustrations." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10087 a p1z:Process ;
    skos:prefLabel "Conduct mandatory and elective external reviews" ;
    p1z:apqcId "10087" ;
    p1z:apqcHierarchyId "2.3.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting any mandatory and elective appraisals of the product/service design specifications in order to ensure compliance with external standards. Carry out external reviews of specifications created for the development of new product/service designs. Conduct mandatory appraisals such as legal and regulatory, as well as any optional assessments that, for instance, pitch the specifications against industrial benchmarks." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF19995 a p1z:Process ;
    skos:prefLabel "Design products/services" ;
    p1z:apqcId "19995" ;
    p1z:apqcHierarchyId "2.3.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a sketch of the customer focused product/service in Develop and Manage Products and Services [10003]." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10088 a p1z:Process ;
    skos:prefLabel "Build prototypes/proof of concepts" ;
    p1z:apqcId "10088" ;
    p1z:apqcHierarchyId "2.3.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Building prototypes for shortlisted product/service concepts. Develop prototypes for those product/service concepts that have been identified for further development. Provide proof-of-concepts, and test any processes involved. Build prototypes in line with the design specifications already outlined. Enlist the solutioning and/or design staff." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10098 a p1z:Process ;
    skos:prefLabel "Develop and test prototype production and/or service delivery process" ;
    p1z:apqcId "10098" ;
    p1z:apqcHierarchyId "2.3.1.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating the new manufacturing/delivery processes for the new products/services, and testing them to ensure proper functioning. Create the production/delivery process for the prototypes that have been built for the new products/services. Conduct trial-runs to test these processes and their integration with the organization's other processes." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10089 a p1z:Process ;
    skos:prefLabel "Eliminate quality and reliability problems" ;
    p1z:apqcId "10089" ;
    p1z:apqcHierarchyId "2.3.1.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Eliminating any problems relating to utility of the product/service over the course of its expected lifetime. Tweak the prototype in order to comply with the required quality and reliability standards. Further refine the prototype, so it may be subjected to testing." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10090 a p1z:Process ;
    skos:prefLabel "Conduct in-house product/service testing and evaluate feasibility" ;
    p1z:apqcId "10090" ;
    p1z:apqcHierarchyId "2.3.1.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out an in-house appraisal of the prototypes in order to validate design and feasibility. Test the product/service prototypes to confirm their compliance with design and usability standards. Corroborate the viability of the design, and validate the feasibility of their production. Identify any areas for improvement." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10091 a p1z:Process ;
    skos:prefLabel "Identify design/development performance indicators" ;
    p1z:apqcId "10091" ;
    p1z:apqcHierarchyId "2.3.1.13" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying performance parameters. Determine the parameters to measure performance of the design and development of the product/service concepts into prototypes." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF10092 a p1z:Process ;
    skos:prefLabel "Collaborate on design with suppliers and external partners" ;
    p1z:apqcId "10092" ;
    p1z:apqcHierarchyId "2.3.1.14" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Interacting with suppliers and manufactures to determine design decisions. Collaborate with vendors, suppliers, contractors, and subcontractors to verify feasibility of co-producing the prototype's design. Ensure that efforts can be coordinated with other stakeholders in the organization's supply chain ecosystem at the time of manufacturing, producing, or packaging the finished product/service." ;
    p1z:parentProcess apqc:PCF19993 .

apqc:PCF19996 a p1z:Process ;
    skos:prefLabel "Test market for new or revised products and services" ;
    p1z:apqcId "19996" ;
    p1z:apqcHierarchyId "2.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Expanding on the marketplace analysis that took place earlier in the product development lifecycle by testing the market against offerings. The results from this in-depth analysis will help the organization finalize product/service characteristics and technical requirements and also identify any needed changes in the manufacturing and delivery processes that support market delivery. To prepare a detailed market study that accounts for any changes in the global environment, the organization may want to conduct a series of interviews, workshops, and focus groups with potential and existing customers." ;
    p1z:parentProcess apqc:PCF10062 .

apqc:PCF10093 a p1z:Process ;
    skos:prefLabel "Prepare detailed market study" ;
    p1z:apqcId "10093" ;
    p1z:apqcHierarchyId "2.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Composing a detailed study of the market ecosystem in light of new products/services. Conduct a detailed analysis of the targeted market(s) in order to Introduce new products/services [10077]. Examine the competition, market size and growth rate, market trends, customer segments and their characteristics, market influencers, distribution channels, and profitability. Enlist in-house marketing and/or solutioning teams, or outsource to specialized professional services agencies." ;
    p1z:parentProcess apqc:PCF19996 .

apqc:PCF10094 a p1z:Process ;
    skos:prefLabel "Conduct customer tests and interviews" ;
    p1z:apqcId "10094" ;
    p1z:apqcHierarchyId "2.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting both qualitative and quantitative studies to determine the fit between the newly developed products/services and the customers. Conduct external tests of the new product/service, and then refine them to maximize the customer uptake. Gather feedback from prospective customers and targeted populations by conducting surveys, focus groups, interviews, and detailed studies. Enlist professional services such as public relations or market research organizations." ;
    p1z:parentProcess apqc:PCF19996 .

apqc:PCF10095 a p1z:Process ;
    skos:prefLabel "Finalize product/service characteristics and business cases" ;
    p1z:apqcId "10095" ;
    p1z:apqcHierarchyId "2.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Finalizing the characteristics of new products/services by appropriately weighing feedback from prospective customers against a cost-benefit analysis in order to produce a profitable business proposition. Refine the attributes of the newly developed products/services, in light of the feedback and insights collected during Conduct customer tests and interviews [10094]. Revisit the high-level business case to justify the resources assigned to the product/service project against the anticipated benefits." ;
    p1z:parentProcess apqc:PCF19996 .

apqc:PCF10096 a p1z:Process ;
    skos:prefLabel "Finalize technical requirements" ;
    p1z:apqcId "10096" ;
    p1z:apqcHierarchyId "2.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reassessing the technical requirements in light of the final product/service attributes. Revisit the technical assessment to revalidate the organization's capacity for progressing with new product/service projects, in light of the revised product/service characteristics." ;
    p1z:parentProcess apqc:PCF19996 .

apqc:PCF19997 a p1z:Process ;
    skos:prefLabel "Prepare for production/service delivery" ;
    p1z:apqcId "19997" ;
    p1z:apqcHierarchyId "2.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Devising business plans and procedures for manufacturing/operations/production and delivery of services offered by the organization. Further in general terms the total amount of output that the manufacturing department is responsible to produce for each period." ;
    p1z:parentProcess apqc:PCF10062 .

apqc:PCF10099 a p1z:Process ;
    skos:prefLabel "Design and obtain necessary capabilities/materials and equipment" ;
    p1z:apqcId "10099" ;
    p1z:apqcHierarchyId "2.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and/or sourcing the essential machinery needed for creating purpose-built processes, as well as the raw materials, to produce the new products/services. Either design the equipment and materials needed internally, or source from external vendors. Obtain the feedstock or raw materials needed to prepare the finished products, as well as the machinery - hardware and software - needed to arrange production lines, factory operations, assemblies, and manufacturing processes. Revisit the technologies that underpin the new or revised products/services in order to source the right equipment and materials." ;
    p1z:parentProcess apqc:PCF19997 .

apqc:PCF10097 a p1z:Process ;
    skos:prefLabel "Identify requirements for changes to manufacturing/delivery processes" ;
    p1z:apqcId "10097" ;
    p1z:apqcHierarchyId "2.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying any changes that need to be effectuated in the organization's internal processes for manufacturing, and delivering the newly developed products/services. Determine if any changes need to be made to the production and distribution processes, in light of the new products/services. Begin production process planning. Prepare for factory layout planning. Generate shop-floor instructions and changes to the supply chain." ;
    p1z:parentProcess apqc:PCF19997 .

apqc:PCF11418 a p1z:Process ;
    skos:prefLabel "Request engineering/process change" ;
    p1z:apqcId "11418" ;
    p1z:apqcHierarchyId "2.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Requesting changes in the production and/or delivery operations for processing the new or revised products/services. Rectify any problems identified in the manufacturing or delivery processes (through Monitor production runs [11417]). Seek changes in components, repair machinery, optimize production lines, and tweak factory assemblies through a formal notice to the concerned division, known as an engineering change order." ;
    p1z:parentProcess apqc:PCF19997 .

apqc:PCF10100 a p1z:Process ;
    skos:prefLabel "Install and validate production/service delivery process" ;
    p1z:apqcId "10100" ;
    p1z:apqcHierarchyId "2.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Finalizing production process or methodology. Install and initiate the production process to manufacture the new products, using the equipment and machinery already assembled. In the case of new services, implement delivery processes and methodologies. Validate processes for the accuracy of their operation and proper functioning." ;
    p1z:parentProcess apqc:PCF19997 .

apqc:PCF19998 a p1z:Process ;
    skos:prefLabel "Validate launch procedures" ;
    p1z:apqcId "19998" ;
    p1z:apqcHierarchyId "2.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Verifying the measures/processes/techniques through systems and tools involved in the introduction of products and services." ;
    p1z:parentProcess apqc:PCF19997 .

apqc:PCF20089 a p1z:Process ;
    skos:prefLabel "Define warranty claims" ;
    p1z:apqcId "20089" ;
    p1z:apqcHierarchyId "2.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the exact terms and conditions under which specific warranties apply to certain goods or services." ;
    p1z:parentProcess apqc:PCF10062 .

apqc:PCF16893 a p1z:Process ;
    skos:prefLabel "Determine and document warranty policies" ;
    p1z:apqcId "16893" ;
    p1z:apqcHierarchyId "2.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing warranty policies to assure customers that the company will guarantee its warranties that it issues." ;
    p1z:parentProcess apqc:PCF20089 .

apqc:PCF16890 a p1z:Process ;
    skos:prefLabel "Create and manage warranty rules/claim codes for products" ;
    p1z:apqcId "16890" ;
    p1z:apqcHierarchyId "2.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining claims processing and routing rules. Establish and maintain claims processing and routing rules for product warranties, coverage lists, repair, fault, trouble codes, repair time setup, and warranty policy registration. This also includes rolling out the codes and rules, and the improvements/updates to these rules and codes via systematic updates." ;
    p1z:parentProcess apqc:PCF20089 .

apqc:PCF20090 a p1z:Process ;
    skos:prefLabel "Agree on warranty responsibilities with suppliers" ;
    p1z:apqcId "20090" ;
    p1z:apqcHierarchyId "2.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Negotiating with manufacturers and dealers the obligations of each party in upholding warranties." ;
    p1z:parentProcess apqc:PCF20089 .

apqc:PCF20091 a p1z:Process ;
    skos:prefLabel "Define warranty related offerings for customers" ;
    p1z:apqcId "20091" ;
    p1z:apqcHierarchyId "2.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Informing customers about warranties that apply to promoted products or services." ;
    p1z:parentProcess apqc:PCF20089 .

apqc:PCF12673 a p1z:Process ;
    skos:prefLabel "Communicate warranty policies and offerings" ;
    p1z:apqcId "12673" ;
    p1z:apqcHierarchyId "2.3.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating rules and updates via training manuals for new products and training resources." ;
    p1z:parentProcess apqc:PCF20089 .

apqc:PCF20092 a p1z:Process ;
    skos:prefLabel "Develop recall strategy" ;
    p1z:apqcId "20092" ;
    p1z:apqcHierarchyId "2.3.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing procedures to handle recalls of defective products." ;
    p1z:parentProcess apqc:PCF10062 .

apqc:PCF10004 a p1z:FunctionalDomain ;
    skos:prefLabel "Market and Sell Products and Services" ;
    p1z:apqcId "10004" ;
    p1z:apqcHierarchyId "3.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Outlining process groups related to understanding markets, customers, and capabilities; developing marketing strategies; executing marketing plans; developing sales strategies; developing and managing marketing plans; and managing sales partners and alliances." .

apqc:PCF10101 a p1z:FunctionalDomain ;
    skos:prefLabel "Understand markets, customers, and capabilities" ;
    p1z:apqcId "10101" ;
    p1z:apqcHierarchyId "3.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Making sense of the market and customers to identify the right opportunities to be capitalized, given the organization's competencies. Discern trends and shift in the market and customers. Identify the right market opportunities that fit closely with the organization's capabilities and strategy by gathering intelligence on various attributes of different market/customer segments." ;
    p1z:parentProcess apqc:PCF10004 .

apqc:PCF10106 a p1z:Process ;
    skos:prefLabel "Perform customer and market intelligence analysis" ;
    p1z:apqcId "10106" ;
    p1z:apqcHierarchyId "3.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Gathering intelligence on the market and customers. Closely examine the inherent attributes and collective behavior of the various market and customer segments. Track trends in the market. Determine what drives the customers to make purchasing decisions in order to identify opportunities in the market." ;
    p1z:parentProcess apqc:PCF10101 .

apqc:PCF10108 a p1z:Process ;
    skos:prefLabel "Conduct customer and market research" ;
    p1z:apqcId "10108" ;
    p1z:apqcHierarchyId "3.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out research studies to understand the behavior of customers and the realities of the market. Undertake research to understand the market conditions as well as the characteristics, drives, and desires of prospective customers. Gather highly contextualized intelligence through primary and secondary research methods, with the objective of gaining insights over how to best seize a market opportunity. Consider assistance from professional research services." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10109 a p1z:Process ;
    skos:prefLabel "Identify market segments" ;
    p1z:apqcId "10109" ;
    p1z:apqcHierarchyId "3.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying a section of the customer population to target for marketing products/services. Create segments within the customer population for targeted marketing campaigns, which increase the efficacy of marketing outlay. Determine the right customer segments, craft effective marketing messages, and efficiently communicate them. Determine the optimal pricing mix. Consider assistance from professional services for market segmentation studies, with coordination and oversight from the marketing/sales functions." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10110 a p1z:Process ;
    skos:prefLabel "Analyze market and industry trends" ;
    p1z:apqcId "10110" ;
    p1z:apqcHierarchyId "3.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining large-scale shifts and trends, with relevance to the organization's products/services. Vet the industrial and larger market landscape to identify broad-based movements that could have a direct or tangential impact on the uptake of the organization's products/services. Examine, among other things, the market capitalization of similar products, the profitability of organizations offering competing products/services, the stock price of key vendors/suppliers in the organizational value-chain, the rate and scale of innovation activity in the organization's product/service category, the price and availability of raw materials, and the shelf-life of similar products/services. Conduct primary and secondary research, and consider enlisting professional services." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10111 a p1z:Process ;
    skos:prefLabel "Analyze competing organizations, competitive/substitute products/services" ;
    p1z:apqcId "10111" ;
    p1z:apqcHierarchyId "3.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the strengths and weaknesses of competing organizations. Assess competing organizations for offerings, product strategy, marketing and delivery channels, etc. Analyze the usability experience, durability, USP, and other key attributes of competing and substitute products. Gather competitive intelligence, and consider enlisting professional services." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10112 a p1z:Process ;
    skos:prefLabel "Evaluate existing products/services" ;
    p1z:apqcId "10112" ;
    p1z:apqcHierarchyId "3.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Examining the brands owned and products offered in the market. Determine the relative position of the existing products/brands in the marketplace." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10113 a p1z:Process ;
    skos:prefLabel "Assess internal and external business environment" ;
    p1z:apqcId "10113" ;
    p1z:apqcHierarchyId "3.1.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the culture and environment in which you're operating. Analyze how internal decision-making, thought processes, financial circumstances, and more affect the ability to bring new products to market. Survey or analyze the market into which the products would be introduced." ;
    p1z:parentProcess apqc:PCF10106 .

apqc:PCF10107 a p1z:Process ;
    skos:prefLabel "Evaluate and prioritize market opportunities" ;
    p1z:apqcId "10107" ;
    p1z:apqcHierarchyId "3.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Appraising market opportunities by quantifying and subjecting them to prioritization, as well as validation tests. Closely examine the market opportunities that have been identified by Perform customer and market intelligence analysis [10106]. Triangulate those opportunities to capitalize by finding a fit between identified opportunities and the composite of organizational capabilities and business strategy." ;
    p1z:parentProcess apqc:PCF10101 .

apqc:PCF10116 a p1z:Process ;
    skos:prefLabel "Quantify market opportunities" ;
    p1z:apqcId "10116" ;
    p1z:apqcHierarchyId "3.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Attaching quantifiable indicators to opportunities that have been identified in the market. Compute estimated figures of the approximate value that can be captured with the provision of existing products/services (i.e., the extent of financial benefits that can be reaped in the market)." ;
    p1z:parentProcess apqc:PCF10107 .

apqc:PCF10117 a p1z:Process ;
    skos:prefLabel "Determine target segments" ;
    p1z:apqcId "10117" ;
    p1z:apqcHierarchyId "3.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the targeted segment of customers. Deduce those particular customer segments that are to be targeted from among the market segments." ;
    p1z:parentProcess apqc:PCF10107 .

apqc:PCF10118 a p1z:Process ;
    skos:prefLabel "Prioritize opportunities consistent with capabilities and overall business strategy" ;
    p1z:apqcId "10118" ;
    p1z:apqcHierarchyId "3.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an index of market opportunities, and arrange them in order of preference. Prioritize based on the opportunities' adherence to the overall business strategy. Correlate with the competencies and capacities that the organization, as a whole, processes." ;
    p1z:parentProcess apqc:PCF10107 .

apqc:PCF10119 a p1z:Process ;
    skos:prefLabel "Validate opportunities" ;
    p1z:apqcId "10119" ;
    p1z:apqcHierarchyId "3.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Confirming the practicability and reasonableness of the market opportunities that have been identified. Give substance to the real-time feasibility of the market opportunities." ;
    p1z:parentProcess apqc:PCF10107 .

apqc:PCF21615 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop marketing strategy" ;
    p1z:apqcId "21615" ;
    p1z:apqcHierarchyId "3.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Charting a strategic course for marketing products/services. This will include defining the value proposition, creating a mechanism for pricing, and determining the right mix of marketing channels. Create a specific positioning and branding for the organization's offerings. Enlist marketing head to lead, with inputs from the business development and sales functions." ;
    p1z:parentProcess apqc:PCF10004 .

apqc:PCF11168 a p1z:Process ;
    skos:prefLabel "Define offering and customer value proposition" ;
    p1z:apqcId "11168" ;
    p1z:apqcHierarchyId "3.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Refining the attributes of organizational offerings to define their value proposition for the customer. Clearly define the suite of offerings in terms of the value delivered, from the perspective of what the customer desires. Validate the benefits delivered to the customers against target market segments, using techniques such as minimum viable product. Position brands for the respective products/services, in line with their unique value proposition and aligned with customers needs." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF11169 a p1z:Process ;
    skos:prefLabel "Define offering and positioning" ;
    p1z:apqcId "11169" ;
    p1z:apqcHierarchyId "3.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining problem(s) that the organization's products/services solve for the customers, thereby determining how they are positioned in the market. Refine the product/service concepts from the perspective of customers. Succinctly outline the problem the organization's offerings solves for the customers, making a case for why the customer should buy a product or use a service. Define the offering's unique value." ;
    p1z:parentProcess apqc:PCF11168 .

apqc:PCF11170 a p1z:Process ;
    skos:prefLabel "Develop value proposition including brand positioning for target segments" ;
    p1z:apqcId "11170" ;
    p1z:apqcHierarchyId "3.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Boosting the attractiveness of products/services to the targeted customers, and creating a unique brand projection around these features. Identify and enhance those product/service features that reinforce the attractiveness of these offerings, for these segment of customers. Underscore the perceived value delivered to the customers by clearly specifying the relevance and desirability of these products/services. Once it has been clarified how the organization's offerings meet the customer's expectations or deliver specific benefits, position the brands around these benefits." ;
    p1z:parentProcess apqc:PCF11168 .

apqc:PCF11171 a p1z:Process ;
    skos:prefLabel "Validate value proposition with target segments" ;
    p1z:apqcId "11171" ;
    p1z:apqcHierarchyId "3.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating the desirability of the perceived value delivered by the organization's offerings, to the targeted customer segment. Substantiate the value of the benefits accrued to the customers through the organization's offerings. Justify the value proposition in light of the targeted segments by gathering feedback (using teaser demonstrations, surveys, interviews, primary research studies, and customer case studies). Corroborate the benefits of the organization's offerings." ;
    p1z:parentProcess apqc:PCF11168 .

apqc:PCF11445 a p1z:Process ;
    skos:prefLabel "Develop and manage brands" ;
    p1z:apqcId "11445" ;
    p1z:apqcHierarchyId "3.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and overseeing the positioning, value proposition, and governance of brands to ensure a consistent identity, clear differentiation, and alignment with overall marketing direction and business objectives across markets and offerings." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF19640 a p1z:Process ;
    skos:prefLabel "Conduct brand level social sentiment analysis" ;
    p1z:apqcId "19640" ;
    p1z:apqcHierarchyId "3.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing external social and digital feedback related to brands to assess public perception, sentiment trends, and emerging reputation risks or opportunities, and to inform brand positioning and management decisions." ;
    p1z:parentProcess apqc:PCF11445 .

apqc:PCF11446 a p1z:Process ;
    skos:prefLabel "Develop marketing strategy for new and existing brands" ;
    p1z:apqcId "11446" ;
    p1z:apqcHierarchyId "3.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining brand-specific marketing direction, priorities, and strategic choices to support brand introduction, growth, positioning, and ongoing performance within the broader marketing strategy." ;
    p1z:parentProcess apqc:PCF11445 .

apqc:PCF11447 a p1z:Process ;
    skos:prefLabel "Define brand equity position" ;
    p1z:apqcId "11447" ;
    p1z:apqcHierarchyId "3.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the desired brand value, differentiation, and market perception relative to competitors and target audiences, including the attributes and associations the brand is intended to represent." ;
    p1z:parentProcess apqc:PCF11445 .

apqc:PCF11448 a p1z:Process ;
    skos:prefLabel "Assess brand performance management" ;
    p1z:apqcId "11448" ;
    p1z:apqcHierarchyId "3.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating brand performance against defined objectives and expectations to inform brand positioning adjustments, investment decisions, and ongoing brand management actions." ;
    p1z:parentProcess apqc:PCF11445 .

apqc:PCF10123 a p1z:Process ;
    skos:prefLabel "Define pricing strategy" ;
    p1z:apqcId "10123" ;
    p1z:apqcHierarchyId "3.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a pricing strategy and mechanism that aligns with the benefits of the products/services, as perceived by customers. Chart a strategic course and a methodology that can guide the pricing of products/services. Draw heavily from the customer value proposition, and balance the expectations of different divisions inside the organization, while delivering the maximum ROI." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF13169 a p1z:Process ;
    skos:prefLabel "Conduct pricing analysis" ;
    p1z:apqcId "13169" ;
    p1z:apqcHierarchyId "3.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing marketing objectives, consumer demand, product attributes, competitors' pricing, and economic trends to determine optimum prices for the set of products and services that the company offers or intends to offer by delivering maximum ROI." ;
    p1z:parentProcess apqc:PCF10123 .

apqc:PCF10124 a p1z:Process ;
    skos:prefLabel "Establish guidelines for applying pricing and discounting of products/services" ;
    p1z:apqcId "10124" ;
    p1z:apqcHierarchyId "3.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a framework that allows for a uniform methodology while determining the price of individual offerings. Devise a blueprint for establishing the pricing of specific products/services. Create guidelines that factor in the cost of production/servicing, price sensitivity, product lifecycle, and the price of competing/substitute products." ;
    p1z:parentProcess apqc:PCF10123 .

apqc:PCF19999 a p1z:Process ;
    skos:prefLabel "Establish pricing targets" ;
    p1z:apqcId "19999" ;
    p1z:apqcHierarchyId "3.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining optimum prices for individual products or services on the basis of the cost of producing, distributing and marketing the offerings, pricing analysis and general pricing strategy." ;
    p1z:parentProcess apqc:PCF10123 .

apqc:PCF10125 a p1z:Process ;
    skos:prefLabel "Approve pricing strategies/policies and targets" ;
    p1z:apqcId "10125" ;
    p1z:apqcHierarchyId "3.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Confirming the strategy and specifications developed for pricing the organization's products/services. Approve pricing guidelines by vetting the soundness of the methodology and the guidelines' alignment with the value proposition." ;
    p1z:parentProcess apqc:PCF10123 .

apqc:PCF20000 a p1z:Process ;
    skos:prefLabel "Define and manage channel strategy" ;
    p1z:apqcId "20000" ;
    p1z:apqcHierarchyId "3.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing all the activities needed to identify the appropriate channels to market to different customer segments as defined in Determine target segments [10117]. This involves finding channel partners, ensuring that the channels align with organizational strategy for each segment, and the final channel selection process." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF20001 a p1z:Process ;
    skos:prefLabel "Determine channels to be supported" ;
    p1z:apqcId "20001" ;
    p1z:apqcHierarchyId "3.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding which distributors, wholesalers and retailers the company will use to promote its offerings and to distribute its products and services to the target market. Narrowing down which intermediaries the company will use will affect retail prices of individual products, and should therefore be included in the pricing analysis." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF20002 a p1z:Process ;
    skos:prefLabel "Establish channel objectives" ;
    p1z:apqcId "20002" ;
    p1z:apqcHierarchyId "3.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the role that each chosen marketing channels plays in the larger distribution network with respect to the organizational marketing strategy. Determine intermediary costs for shipping, handling, transporting, warehousing, insurance and marketing that incur and accumulate in the distribution channel." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF10127 a p1z:Process ;
    skos:prefLabel "Determine channel role and fit with target segments" ;
    p1z:apqcId "10127" ;
    p1z:apqcHierarchyId "3.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyze the various channels for their relevance to the targeted segments. Identify the channel that can effectively market to the targeted customers in regard to the drives, desires, and characteristics of these populations, their uptake, extent of engagement, frequency of use, and effectiveness in communicating." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF10128 a p1z:Process ;
    skos:prefLabel "Select channels for target segments" ;
    p1z:apqcId "10128" ;
    p1z:apqcHierarchyId "3.2.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Choose the most pertinent marketing channel for the targeted segments (based on Determine channel fit with target segments [10127])." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF20003 a p1z:Process ;
    skos:prefLabel "Identify required channel capabilities" ;
    p1z:apqcId "20003" ;
    p1z:apqcHierarchyId "3.2.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the maximum output rate required from a distribution channel to optimally market and deliver the products and services the company offers or would like to offer. Ideally, a channel should be able to adapt to a certain degree of variability in the demand for the offerings, and able scale up if needed." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF10126 a p1z:Process ;
    skos:prefLabel "Evaluate channel attributes and potential partners" ;
    p1z:apqcId "10126" ;
    p1z:apqcHierarchyId "3.2.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the attributes of all marketing channels, and evaluating the key partners in those channels. Closely examine the various characteristics of all available marketing channels such as the cost of using them, durability of impact, applicability to the organization's products/services, turn-around time, involvement of middlemen, and conversion rate. Analyze key partners in the marketing channels including those who have been associated with the organization; evaluate their capabilities, the scale and scope of their operations, quality of support provided, etc." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF20004 a p1z:Process ;
    skos:prefLabel "Orchestrate seamless customer experience across supported channels" ;
    p1z:apqcId "20004" ;
    p1z:apqcHierarchyId "3.2.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Coordinating marketing and distribution efforts across different channels that integrate well with each other, are in conformance with company values, visual identity and branding, and offer uniform customer service experience that drives customer loyalty and repeat business." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF20005 a p1z:Process ;
    skos:prefLabel "Develop and manage execution roadmap" ;
    p1z:apqcId "20005" ;
    p1z:apqcHierarchyId "3.2.4.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the actions that need to be taken for successful multichannel marketing, the ordering, timing and dependencies of the steps, and the governance mechanism for reviewing and changing the protocol, if needed." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF11458 a p1z:Process ;
    skos:prefLabel "Define and manage channel/store format strategy" ;
    p1z:apqcId "11458" ;
    p1z:apqcHierarchyId "3.2.4.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and overseeing the strategic role, structure, and positioning of marketing channels and customer engagement formats, including how they are used to reach target audiences, deliver brand experiences, and support overall marketing objectives." ;
    p1z:parentProcess apqc:PCF20000 .

apqc:PCF20006 a p1z:Process ;
    skos:prefLabel "Analyze and manage channel performance" ;
    p1z:apqcId "20006" ;
    p1z:apqcHierarchyId "3.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Monitoring marketing and distribution efforts of all channels individually and as a network. Re-distribute or add resources to channels that perform better than expected. Purge or consolidate under-performing channels, and find more promising replacements." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF16573 a p1z:Process ;
    skos:prefLabel "Establish channel-specific measures and targets" ;
    p1z:apqcId "16573" ;
    p1z:apqcHierarchyId "3.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining measurable parameters to be used for comparing the performance of different marketing channels. Decide on benchmarks and values for optimum or desired performance." ;
    p1z:parentProcess apqc:PCF20006 .

apqc:PCF16574 a p1z:Process ;
    skos:prefLabel "Monitor and report performance" ;
    p1z:apqcId "16574" ;
    p1z:apqcHierarchyId "3.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking trends and changes in performance inside individual marketing channels and in channels collectively. Summarize and document results. Alert relevant parties about significant or unexpected deviations from expected behaviors." ;
    p1z:parentProcess apqc:PCF20006 .

apqc:PCF16575 a p1z:Process ;
    skos:prefLabel "Monitor and report events influencing factors" ;
    p1z:apqcId "16575" ;
    p1z:apqcHierarchyId "3.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the factors and circumstances that influence desired outcomes. Communicate core findings to relevant parties." ;
    p1z:parentProcess apqc:PCF20006 .

apqc:PCF16500 a p1z:Process ;
    skos:prefLabel "Analyze channel performance" ;
    p1z:apqcId "16500" ;
    p1z:apqcHierarchyId "3.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting an analysis to review channel performance with respect to chosen metrics, benchmarks and performance targets [16573]. Compare to past performance and forecasts for the channel." ;
    p1z:parentProcess apqc:PCF20006 .

apqc:PCF16501 a p1z:Process ;
    skos:prefLabel "Develop plan for channel improvements" ;
    p1z:apqcId "16501" ;
    p1z:apqcHierarchyId "3.2.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising a course of action to be taken to improve under-performing channels and to promote or expand channels that surpass expectations." ;
    p1z:parentProcess apqc:PCF20006 .

apqc:PCF16848 a p1z:Process ;
    skos:prefLabel "Develop marketing communication strategy" ;
    p1z:apqcId "16848" ;
    p1z:apqcHierarchyId "3.2.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing marketing communications that deliver promotional messages, in a coordinated way, through multiple marketing channels, such as print, radio, television, direct mail, online or mobile advertising, email, social media or personal selling." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF16849 a p1z:Process ;
    skos:prefLabel "Develop customer communication calendar" ;
    p1z:apqcId "16849" ;
    p1z:apqcHierarchyId "3.2.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Timing and scheduling the delivery of marketing messages to maximize their impact on customer purchasing behavior. Integrate individual messages to larger marketing campaigns and to seasonal purchasing patterns." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16850 a p1z:Process ;
    skos:prefLabel "Define public relations (PR) strategy" ;
    p1z:apqcId "16850" ;
    p1z:apqcHierarchyId "3.2.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding how to promote and maintain a favorable public image of the company in the eyes of its employees, customers, investors, suppliers, politicians or the general public. This may involve various means but is frequently conducted through publicity, education, corporate social responsibility, charitable causes or civic engagements." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16851 a p1z:Process ;
    skos:prefLabel "Define direct marketing strategy" ;
    p1z:apqcId "16851" ;
    p1z:apqcHierarchyId "3.2.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising a master plan how to select potential customers or qualified clients for customized offers, and contact them on one-to-one basis through chat, phone, email or regular mail. The strategy would need to take into account that personalizing offers and contacting customers individually is an effective but resource-intensive marketing technique, and that ill-targeted offers risk at angering and alienating the contactees." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16852 a p1z:Process ;
    skos:prefLabel "Define internal marketing communication strategy" ;
    p1z:apqcId "16852" ;
    p1z:apqcHierarchyId "3.2.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a program to promote the objectives, values, products and services of the company to its employees by treating them as potential customers, in order to extend company client base, increase employee engagement or to foster brand advocacy." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16853 a p1z:Process ;
    skos:prefLabel "Identify new media for marketing communication" ;
    p1z:apqcId "16853" ;
    p1z:apqcHierarchyId "3.2.6.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Finding emerging media based on digital or other technologies that would enable the company to increase the speed and volume of marketing communications, to make communications more interactive and to customize promotional messages more easily to the target audience, thus rendering them more effective." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16854 a p1z:Process ;
    skos:prefLabel "Define new media communication strategy" ;
    p1z:apqcId "16854" ;
    p1z:apqcHierarchyId "3.2.6.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a marketing strategy that is maximally effective in a new or emerging media channel by capitalizing on its novel attributes and capabilities." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF16855 a p1z:Process ;
    skos:prefLabel "Define point of sale (POS) communication strategy" ;
    p1z:apqcId "16855" ;
    p1z:apqcHierarchyId "3.2.6.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a framework for coordinated marketing to increase the profitability and increase brand awareness at the point of sale. This may include promotional posters on product shelves or island displays, advertisements in shopping carts, stickers on the floor that lead consumers to the promoted product, multi-buy promotions, coupons on sales receipts, etc." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF18627 a p1z:Process ;
    skos:prefLabel "Define communication guidelines and mechanisms" ;
    p1z:apqcId "18627" ;
    p1z:apqcHierarchyId "3.2.6.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing standardized procedures for effective communication that maximizes ROI, promotes brand awareness and respects customers. In its simplest form, it includes a message (what is to be said), a target (to whom the message is reaching) and a medium or a channel (where the message is to be said)." ;
    p1z:parentProcess apqc:PCF16848 .

apqc:PCF18924 a p1z:Process ;
    skos:prefLabel "Design and manage customer loyalty program" ;
    p1z:apqcId "18924" ;
    p1z:apqcHierarchyId "3.2.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and managing a customer loyalty program. The loyalty program is a key part of marketing, with an elaborate strategy and process for acquiring, retaining, and engaging with members. Members are engaged and acquainted to the loyalty program, thus growing relationship and adding value through the program." ;
    p1z:parentProcess apqc:PCF21615 .

apqc:PCF20007 a p1z:Process ;
    skos:prefLabel "Define customer loyalty program" ;
    p1z:apqcId "20007" ;
    p1z:apqcHierarchyId "3.2.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising procedures and mechanisms to retain existing customers, promote repeat business and increase the likelihood that previous customers to continue to buy products or services from the company. This may be achieved by rewarding customers for repeat business by means of gifts, discounts, redeemable \"points\", or prioritized access to new products, events or services." ;
    p1z:parentProcess apqc:PCF18924 .

apqc:PCF18925 a p1z:Process ;
    skos:prefLabel "Acquire members to customer loyalty program" ;
    p1z:apqcId "18925" ;
    p1z:apqcHierarchyId "3.2.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Convincing customers to register their personal information with the company and be assigned a unique identifier that they use when making purchases. The identifier makes it easier for the company to track customer purchases. Customers are rewarded by various incentives that encourage repeat business [20007]." ;
    p1z:parentProcess apqc:PCF18924 .

apqc:PCF18926 a p1z:Process ;
    skos:prefLabel "Build engagement and relationship with members" ;
    p1z:apqcId "18926" ;
    p1z:apqcHierarchyId "3.2.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Building deeper relationships between a customer and a brand in order to promote customer loyalty and derive repeat business. Besides making frequent purchases, highly engaged customers refer family, friends and colleagues to make purchases as well, consume and re-broadcast promotional materials, provide feedback to the purchases they make and do not support competing brands." ;
    p1z:parentProcess apqc:PCF18924 .

apqc:PCF16633 a p1z:Process ;
    skos:prefLabel "Monitor customer loyalty program benefits to the enterprise and the customer" ;
    p1z:apqcId "16633" ;
    p1z:apqcHierarchyId "3.2.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Surveying and tracking the benefits of customer loyalty programs both for the company and for customers. Compare with comparable loyalty programs instituted in competitor companies. Propose changes as needed to keep up with market trends." ;
    p1z:parentProcess apqc:PCF18924 .

apqc:PCF18927 a p1z:Process ;
    skos:prefLabel "Optimize loyalty program value to both the enterprise and the customer" ;
    p1z:apqcId "18927" ;
    p1z:apqcHierarchyId "3.2.7.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Enhancing the customer loyalty program so that it will yield maximum value both for the company and for the patrons enrolled in the program, increasing customer retention and continued engagement." ;
    p1z:parentProcess apqc:PCF18924 .

apqc:PCF20008 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage marketing plans" ;
    p1z:apqcId "20008" ;
    p1z:apqcHierarchyId "3.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating specific plans to market offerings to customers. This process group includes processes for making budgets, identifying and developing media, pricing products and services, managing packaging, managing marketing content and promotional activities, tracking and responding to customer insight and monitoring measures established within \"develop marketing strategy\". Additionally, in this process group, organizations take action on plans made in earlier processes. Here, marketing and customers are managed and measured along with any supporting materials." ;
    p1z:parentProcess apqc:PCF10004 .

apqc:PCF10148 a p1z:Process ;
    skos:prefLabel "Establish goals, objectives, and measures for products/services by channel/segment" ;
    p1z:apqcId "10148" ;
    p1z:apqcHierarchyId "3.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining what to achieve by marketing. Create qualitative and quantitative targets. Establish metrics to track performance (for individual Market segments [10109] and Channels for target segments [10129]). Enlist the head of marketing to determine marketing priorities and the related measures. (The decision in establishing these goals, objectives, and metrics is founded in Develop marketing strategy [10102] and takes cues from current priorities and organizational strategy.)" ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF10149 a p1z:Process ;
    skos:prefLabel "Establish marketing budgets" ;
    p1z:apqcId "10149" ;
    p1z:apqcHierarchyId "3.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a budget for the organization's marketing efforts, in line with the business-wide strategic outlook. Create a plan to distribute resources for achieving the marketing strategy in light of the overall business strategy. Make cost assumptions; calculate the estimated total revenue from the marketing activities against the costs/expenses of these activities. Forecast the return on investment. Attribute costs to the appropriate marketing activities such as promotional campaigns, advertising, marketing communications, PR campaigns, personnel, and office space. Enlist the financial and marketing functions." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF10155 a p1z:Process ;
    skos:prefLabel "Confirm marketing alignment to business strategy" ;
    p1z:apqcId "10155" ;
    p1z:apqcHierarchyId "3.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring corroboration of the marketing strategy and the organizational strategy. Ensure the organization's marketing strategy/plan aligns with the overall business strategy. Fine-tune the marketing plan according to the organizational strategy." ;
    p1z:parentProcess apqc:PCF10149 .

apqc:PCF10156 a p1z:Process ;
    skos:prefLabel "Determine costs of marketing" ;
    p1z:apqcId "10156" ;
    p1z:apqcHierarchyId "3.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the total cost of marketing the organization's portfolio of products/services. Calculate the total outlay needed for promoting, selling, and delivering the organization's products/services to customers. Account for all costs to acquire customers and sustain a relationship with them. Include the expenses needed for promotional actives, warehousing, transactional costs, and distribution of the organization's offering." ;
    p1z:parentProcess apqc:PCF10149 .

apqc:PCF10157 a p1z:Process ;
    skos:prefLabel "Create marketing budget" ;
    p1z:apqcId "10157" ;
    p1z:apqcHierarchyId "3.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Estimating the outlay required for promoting, selling, and distributing the products/services of the organization. Add up the expenses of all activities necessitated in marketing, such as promotional campaigns, advertising, marketing communications, PR campaigns, employing skilled personnel, and office space." ;
    p1z:parentProcess apqc:PCF10149 .

apqc:PCF17683 a p1z:Process ;
    skos:prefLabel "Determine projected ROI for marketing investment" ;
    p1z:apqcId "17683" ;
    p1z:apqcHierarchyId "3.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Estimating how much profit the company would generate for its expenses on marketing . Forecasted return on investment, used as a metric to gauge the efficiency of marketing, is beneficial in revising marketing budgets and adjusting costs to improve the overall yield." ;
    p1z:parentProcess apqc:PCF10149 .

apqc:PCF20593 a p1z:Process ;
    skos:prefLabel "Develop and manage pricing" ;
    p1z:apqcId "20593" ;
    p1z:apqcHierarchyId "3.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining and maintaining a pricing mechanism based on forecasted sales and that enables a pricing equilibrium for the lifecycles of products/services. Create a pricing mechanism, factoring in attributes relating to the market, customers, sales, and the cost of production. Implement this pricing mechanism over all products/services. Analyze its performance, and adjust accordingly." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF20009 a p1z:Process ;
    skos:prefLabel "Understand resource requirements for each product/service and delivery channel/method" ;
    p1z:apqcId "20009" ;
    p1z:apqcHierarchyId "3.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the production and distribution costs for each product or service, and each channel or method as factors in determining overall pricing." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF18948 a p1z:Process ;
    skos:prefLabel "Determine corporate incentives" ;
    p1z:apqcId "18948" ;
    p1z:apqcHierarchyId "3.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Introducing financial inducements, such as discounts, to distributors, resellers or vendors as a motivation to prioritize selling company's products or services over those of its competitors." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF10163 a p1z:Process ;
    skos:prefLabel "Determine pricing based on volume/unit forecast" ;
    p1z:apqcId "10163" ;
    p1z:apqcHierarchyId "3.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a dynamic pricing mechanism for the organization's offerings that is supported by the number of units in production. Outline a system for determining the optimum price point for each product/service. Based this model on an estimation of the volume of anticipated sales for each offering and variable costs." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF10164 a p1z:Process ;
    skos:prefLabel "Execute pricing plan" ;
    p1z:apqcId "10164" ;
    p1z:apqcHierarchyId "3.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the pricing mechanism to determine prices for all individual offerings in the organizational portfolio. Calculate the prices of all offerings based on the established methodology and/or formulaic structure." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF10165 a p1z:Process ;
    skos:prefLabel "Evaluate pricing performance" ;
    p1z:apqcId "10165" ;
    p1z:apqcHierarchyId "3.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the efficiency of pricing with the objective of identifying any divergence from the equilibrium prices and avoiding any deadweight loss. Gauge the performance of the pricing plan by tracking growth in the revenue and/or customer uptake, secured as a result of new prices. Measure the performance of pricing by periodically checking the profits generated from the sale of each of the organization's offerings against the backdrop of any events that may have influenced the uptake of a certain good/service by the customer base." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF10166 a p1z:Process ;
    skos:prefLabel "Refine pricing as needed" ;
    p1z:apqcId "10166" ;
    p1z:apqcHierarchyId "3.3.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Refining the pricing mechanism to create equitable prices for all products/services with the objective of maximizing the profits and/or customer uptake of these offerings. Reconcile the pricing mechanism in order to achieve equilibrium pricing. Adjust the prices for all of the organization's offerings, using the insights gleaned from examining how much profit or customer uptake is generated by the present pricing strategy." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF11495 a p1z:Process ;
    skos:prefLabel "Implement promotional pricing programs" ;
    p1z:apqcId "11495" ;
    p1z:apqcHierarchyId "3.3.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing schemes that offer lower pricing for a limited time as a promotional and sales incentive when launching a new product or a service." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF11496 a p1z:Process ;
    skos:prefLabel "Implement other retail pricing programs" ;
    p1z:apqcId "11496" ;
    p1z:apqcHierarchyId "3.3.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the optimum consumer pricing for each product or service at the point of sale, based on production and distribution costs and estimated sales volume." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF11497 a p1z:Process ;
    skos:prefLabel "Communicate and implement price changes" ;
    p1z:apqcId "11497" ;
    p1z:apqcHierarchyId "3.3.3.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assigning new prices or pricing adjustments to products or services to replace the original base prices. Update the prices in product catalogs and databases, and disseminate the information through all involved distribution and marketing channels." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF17684 a p1z:Process ;
    skos:prefLabel "Achieve regulatory approval for pricing" ;
    p1z:apqcId "17684" ;
    p1z:apqcHierarchyId "3.3.3.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining internal price approvals and governmental approvals that are required for licensed products and for products that can be reimbursed by the government." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF19645 a p1z:Process ;
    skos:prefLabel "Conduct competitive pricing review (online, offline etc.)" ;
    p1z:apqcId "19645" ;
    p1z:apqcHierarchyId "3.3.3.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing competitor pricing across relevant channels and markets to understand relative price positioning, identify pricing gaps or risks, and inform pricing strategy and adjustments." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF11494 a p1z:Process ;
    skos:prefLabel "Determine customer segment specific pricing" ;
    p1z:apqcId "11494" ;
    p1z:apqcHierarchyId "3.3.3.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining pricing approaches and price levels for specific customer segments based on value propositions, market conditions, and strategic pricing objectives." ;
    p1z:parentProcess apqc:PCF20593 .

apqc:PCF20010 a p1z:Process ;
    skos:prefLabel "Develop and manage promotional activities" ;
    p1z:apqcId "20010" ;
    p1z:apqcHierarchyId "3.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Conceptualizing, testing, and executing product/service/brand promotions. Once a promotion has launched, this process continues as the organization tweaks parts of the promotion or chooses to use ideas or lessons learned during the promotion in future activities. The promotion's performance according to organizational measures is also evaluated in this process. Determine early on whether you need third party help with promotion. Purchase lists, consult with social media experts, hire seasonal staff, or pay for additional research." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF10167 a p1z:Process ;
    skos:prefLabel "Define promotional concepts and objectives" ;
    p1z:apqcId "10167" ;
    p1z:apqcHierarchyId "3.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining a conceptual framework for all promotional activity in order to create an overarching aspiration and ensure consistency. Create a plan for running promotional programs and designing the associated activities in order to increase visibility or sales. Determine how the organization quantifies what it wishes to achieve from these activities, what sort of messages the organization comfortable publicizing, what channels the organization wishes to employ, etc." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10159 a p1z:Process ;
    skos:prefLabel "Develop marketing messages" ;
    p1z:apqcId "10159" ;
    p1z:apqcHierarchyId "3.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing the central messages for a segment of its customers. Craft concise statements that position the value proposition of individual products/services around the pressing concerns in the market, thereby showing how the organization's offerings are the right fit for the customers." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10160 a p1z:Process ;
    skos:prefLabel "Define target audience" ;
    p1z:apqcId "10160" ;
    p1z:apqcHierarchyId "3.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the appropriate audience to direct marketing efforts at. Identify the particular group of customers to target. Discover the appropriate customer groups at a micro-level. Use techniques such as segmentation analysis, whereby the entire population is sliced according to certain demographic or behavioral attributes." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10168 a p1z:Process ;
    skos:prefLabel "Plan and test promotional activities" ;
    p1z:apqcId "10168" ;
    p1z:apqcHierarchyId "3.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a scheme for executing the promotional programs and campaigns, and testing these on sample audiences. Create a program plan, and carry out trials for promotional activities. Develop a scheme for how, when, where, and by whom the promotional schemes and campaigns will be deployed. Design incentives that convince or tempt the consumer to take up the organization's offerings. Conduct focus groups and pilot programs that reach out to a smaller number of people from among the target audiences to validate effectiveness." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10169 a p1z:Process ;
    skos:prefLabel "Execute promotional activities" ;
    p1z:apqcId "10169" ;
    p1z:apqcHierarchyId "3.3.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing promotional programs in the market for reaching out to the desired customer segments. Implement the promotional schemes and campaigns. Create collaterals for the dissemination of information about the product, product line, brand, or company to the target audiences in an effective manner. Leverage relationships with distributors, vendors, and retailers. Consider enlisting professional services such as design, PR, and advertising firms." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10170 a p1z:Process ;
    skos:prefLabel "Evaluate promotional performance metrics" ;
    p1z:apqcId "10170" ;
    p1z:apqcHierarchyId "3.3.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the success of promotional programs through metrics that track the impact of these activities. Examine the performance of promotional activities. Measure the success of these programs through metrics representative of customer uptake, market penetration, sustenance of impact created, revenue growth through offerings marketed, etc. Measure through primary data collection. Analyze through various statistical techniques to generate insights." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10171 a p1z:Process ;
    skos:prefLabel "Refine promotional performance metrics" ;
    p1z:apqcId "10171" ;
    p1z:apqcHierarchyId "3.3.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Fine-tuning promotional activities by employing the insights gleaned from the quantitative, as well as any qualitative, performance evaluations. Change certain attributes of the schemes, campaigns, and programs deployed in order to increase the impact generated, in terms of measures already agreed upon such as customer uptake, market penetration, sustenance of impact created, and revenue growth through offerings marketed." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10172 a p1z:Process ;
    skos:prefLabel "Incorporate learning into future/planned consumer promotions" ;
    p1z:apqcId "10172" ;
    p1z:apqcHierarchyId "3.3.4.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Incorporating the understanding developed by studying promotional activities as well as refining them. Include the best practices and value-enhancing attributes identified in Refine promotional activities [10171] into similarly planned schemes, programs, and campaigns. Adjust promotional activities to further increase the effectiveness of the overall promotional efforts." ;
    p1z:parentProcess apqc:PCF20010 .

apqc:PCF10153 a p1z:Process ;
    skos:prefLabel "Track customer management measures" ;
    p1z:apqcId "10153" ;
    p1z:apqcHierarchyId "3.3.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Collating all customer-centered metrics. The objective is to create a big-picture view of the customers' mindset and their behavior pertaining to the organization's offerings." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF10173 a p1z:Process ;
    skos:prefLabel "Determine customer lifetime value" ;
    p1z:apqcId "10173" ;
    p1z:apqcHierarchyId "3.3.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Estimating customer loyalty and the average contribution made by them to revenues, over their lifespan. Use metrics to quantify the commitment of customers to the offerings of the organization, such as measures of tendency to switch brands/providers, number/proportion of return customers, and the number of customers using multiple substitutable offerings." ;
    p1z:parentProcess apqc:PCF10153 .

apqc:PCF10174 a p1z:Process ;
    skos:prefLabel "Analyze customer revenue trend" ;
    p1z:apqcId "10174" ;
    p1z:apqcHierarchyId "3.3.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the revenue stream generated by the sale of the organization's products/services in order to identify trends therein. Examine data relating to the inflow of revenue from individual/groups of customers in order to identify patterns in the generation and sustenance of receivables. Conduct statistical analysis over the stream of revenue collected and the point of origin associated with each unit of sale through metrics such as the accounting rate of return, the GAAP revenue over a given period, and customer lifetime revenue." ;
    p1z:parentProcess apqc:PCF10153 .

apqc:PCF10175 a p1z:Process ;
    skos:prefLabel "Analyze customer attrition and retention rates" ;
    p1z:apqcId "10175" ;
    p1z:apqcHierarchyId "3.3.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating measures that capture the proportion of customers the organization is able to retain to those it is losing. Compute metrics such as the tendency to switch brands/providers and the proportion of return customers to comprehend the trends within the customer attrition and retention rates." ;
    p1z:parentProcess apqc:PCF10153 .

apqc:PCF10176 a p1z:Process ;
    skos:prefLabel "Analyze customer metrics" ;
    p1z:apqcId "10176" ;
    p1z:apqcHierarchyId "3.3.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Studying all measures of the customer's behavior and conduct toward the organization's offerings in order to glean insight and identify patterns into their decision making. Closely examine all categories of data sets over a customer base. Analyze data points related to customer loyalty, retention, value, conversion, level of satisfaction, attrition, etc. Flesh out measures for an all-encompassing analysis that provides a macro-level picture of the customer's behavior and mindset related to the organization's products/services." ;
    p1z:parentProcess apqc:PCF10153 .

apqc:PCF10177 a p1z:Process ;
    skos:prefLabel "Revise customer strategies, objectives, and plans based on metrics" ;
    p1z:apqcId "10177" ;
    p1z:apqcHierarchyId "3.3.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing and reappraising the strategies, objectives, and plans for all customer-centered processes. Revisit all customer-focused processes and activities--which relate to their acquisition, conversion, and retention--with the objective of revising them in light of customer analysis. Revise accordingly." ;
    p1z:parentProcess apqc:PCF10153 .

apqc:PCF16613 a p1z:Process ;
    skos:prefLabel "Analyze and respond to customer insight" ;
    p1z:apqcId "16613" ;
    p1z:apqcHierarchyId "3.3.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Reviewing and responding to customer feedback. Create tickets to initiate bug fixes or to propose feature updates. Monitor and track progress." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF16627 a p1z:Process ;
    skos:prefLabel "Monitor and respond to social media activity" ;
    p1z:apqcId "16627" ;
    p1z:apqcHierarchyId "3.3.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Following postings on social media to promote offerings, raise brand awareness, interact with customers, increase customer engagement and brand loyalty, respond to queries, gauge sentiment regarding company's products or services, and to derive customer insight." ;
    p1z:parentProcess apqc:PCF16613 .

apqc:PCF16614 a p1z:Process ;
    skos:prefLabel "Analyze customer website activity" ;
    p1z:apqcId "16614" ;
    p1z:apqcHierarchyId "3.3.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining user activity on company, vendor or reseller websites to improve traffic on and to the website, improve user experience on the website to simplify purchasing process and encourage repeat purchases, and to increase the site's visibility in search engine results. Various metrics can be used to measure user activity, such as number of users who are new, returning or unique, time spent on page, session duration, bounce rate, click through rate, conversion rate, and others." ;
    p1z:parentProcess apqc:PCF16613 .

apqc:PCF16615 a p1z:Process ;
    skos:prefLabel "Analyze customer purchase patterns" ;
    p1z:apqcId "16615" ;
    p1z:apqcHierarchyId "3.3.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting analyses to uncover customer purchasing habits. Detect patterns and categorize users based on similar characteristics and behaviors, demographic information, geographic location, search history, etc." ;
    p1z:parentProcess apqc:PCF16613 .

apqc:PCF16616 a p1z:Process ;
    skos:prefLabel "Develop business rules to provide personalized offers" ;
    p1z:apqcId "16616" ;
    p1z:apqcHierarchyId "3.3.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating formulas for personalized offers, purchasing recommendations and targeted advertisements for customers on the basis of previously detected purchase patterns [16615]." ;
    p1z:parentProcess apqc:PCF16613 .

apqc:PCF16617 a p1z:Process ;
    skos:prefLabel "Monitor effectiveness of personalized offers and adjust offers accordingly" ;
    p1z:apqcId "16617" ;
    p1z:apqcHierarchyId "3.3.6.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing how well the targeted offers perform to see whether they result in an increased conversion rate. Reanalyze the purchase patterns or modify those business rules that are produce effective recommendations." ;
    p1z:parentProcess apqc:PCF16613 .

apqc:PCF10154 a p1z:Process ;
    skos:prefLabel "Develop and manage packaging strategy" ;
    p1z:apqcId "10154" ;
    p1z:apqcHierarchyId "3.3.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating, executing, and administering a strategic road map for packaging products/services. Determine how to package products/services into finished offerings that can be directly marketed to prospective customers. Consider physicality, perishability, and shelf-life. Develop a strategy for packaging products/services. Test alternatives. Collect feedback. Refine the option chosen for execution. Have marketing, product development, and supply chain functions work together to develop sound packaging." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF10178 a p1z:Process ;
    skos:prefLabel "Plan packaging strategy" ;
    p1z:apqcId "10178" ;
    p1z:apqcHierarchyId "3.3.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a strategic road map for how to package products/services into desirable solutions while increasing profitability. Create a scheme for how the organization will bundle and wrap its products/services into a presentable and sellable offering. Consider what aspects or components of an offering the organization can extract the maximum revenue from, and reduce the less profitable constituents while maintaining a high perceptible value for the customers. Balance maximizing profit with benefits to the customer." ;
    p1z:parentProcess apqc:PCF10154 .

apqc:PCF10179 a p1z:Process ;
    skos:prefLabel "Test packaging options" ;
    p1z:apqcId "10179" ;
    p1z:apqcHierarchyId "3.3.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Piloting the packaged products/services in the market with a test audience. Create trial runs using techniques such as focus groups of the final product, wrapped and bundled." ;
    p1z:parentProcess apqc:PCF10154 .

apqc:PCF10180 a p1z:Process ;
    skos:prefLabel "Execute packaging strategy" ;
    p1z:apqcId "10180" ;
    p1z:apqcHierarchyId "3.3.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the final packaging. Put into action the packaging strategy in light of the insights accumulated from testing various options." ;
    p1z:parentProcess apqc:PCF10154 .

apqc:PCF10181 a p1z:Process ;
    skos:prefLabel "Refine packaging" ;
    p1z:apqcId "10181" ;
    p1z:apqcHierarchyId "3.3.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Fine-tuning the packaging that has been developed and tested using insights gleaned from feedback." ;
    p1z:parentProcess apqc:PCF10154 .

apqc:PCF21425 a p1z:Process ;
    skos:prefLabel "Develop go-to-market strategy" ;
    p1z:apqcId "21425" ;
    p1z:apqcHierarchyId "3.3.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creation of a plan detailing how a company plans to execute a successful product release and promotion, and ultimately its sale to customers." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF16629 a p1z:Process ;
    skos:prefLabel "Manage product marketing material" ;
    p1z:apqcId "16629" ;
    p1z:apqcHierarchyId "3.3.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating descriptions of products that are promotional and informative in content in order to initiate and increase sales. Marketing content consists of text, and optionally, images." ;
    p1z:parentProcess apqc:PCF20008 .

apqc:PCF16630 a p1z:Process ;
    skos:prefLabel "Manage product images" ;
    p1z:apqcId "16630" ;
    p1z:apqcHierarchyId "3.3.9.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Producing or overseeing the creation or acquisition of photos, images and graphics for a product description, advertisement or a website. Like the copy [18131], product images are chosen and edited to enhance the product description and to convince consumers to purchase the product." ;
    p1z:parentProcess apqc:PCF16629 .

apqc:PCF18130 a p1z:Process ;
    skos:prefLabel "Manage product copy" ;
    p1z:apqcId "18130" ;
    p1z:apqcHierarchyId "3.3.9.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Authoring or overseeing the creation of the textual portion of a product description, advertisement, or web page, including the headline, body, product attributes, and brand or advertiser information. A copy is designed to provide information about the product and to catch and hold the interest of prospective buyers long enough to persuade them to make a purchase. The copy of a website is called its content." ;
    p1z:parentProcess apqc:PCF16629 .

apqc:PCF10103 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop sales strategy" ;
    p1z:apqcId "10103" ;
    p1z:apqcHierarchyId "3.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing concrete plans for guiding and providing support to the sales function. Chart a road map for the sales function, including an analysis of historical sales data to create forecasts for anticipated sales, forming sales targets, forging partnerships with other economic agents to boost sales, devising a budget for this function, and determining metrics to measure customer management activities as well as progress in achieving sales targets." ;
    p1z:parentProcess apqc:PCF10004 .

apqc:PCF10129 a p1z:Process ;
    skos:prefLabel "Develop sales forecast" ;
    p1z:apqcId "10129" ;
    p1z:apqcHierarchyId "3.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing a sales forecast for the organization's portfolio of offerings, bearing in mind the effect of promotional events, and fine-tuning these in the context of the new forecast. Estimate the future demand for the organization's products/services by analyzing historical information and any promotional activity." ;
    p1z:parentProcess apqc:PCF10103 .

apqc:PCF10134 a p1z:Process ;
    skos:prefLabel "Gather current and historic order information" ;
    p1z:apqcId "10134" ;
    p1z:apqcHierarchyId "3.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering all information about sales orders into an index. Create a directory of all sales orders, whether open or those which have been fulfilled. Track what product/service was ordered, the quantity ordered, who ordered it, the delivery date, the shipping method, the unit price and line total, payment terms, and any discount applied." ;
    p1z:parentProcess apqc:PCF10129 .

apqc:PCF10135 a p1z:Process ;
    skos:prefLabel "Analyze sales trends and patterns" ;
    p1z:apqcId "10135" ;
    p1z:apqcHierarchyId "3.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing sales order data to identify patterns in order to capitalize on emerging trends in the industry or the economy. Closely examine the directory of sales orders. Discern any patterns from this index, which is representative of the demand for the organization's offerings. Identify trends among the various segments of the organization's customer base to create forecasts. Glean patterns from this analysis, including the triangulation of segments that are showing the most growth in demand or those that represent the highest decline revenue, industry-wide trends such as decline/boost in overall demand, and any unusual trends that lie outside of the organization's expectations." ;
    p1z:parentProcess apqc:PCF10129 .

apqc:PCF10136 a p1z:Process ;
    skos:prefLabel "Generate sales forecast" ;
    p1z:apqcId "10136" ;
    p1z:apqcHierarchyId "3.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the future demand for the organization's products/services. Use the trends and patterns identified in the sales data to estimate future demand. Use forecast to prepare for future customer demand and to recalibrate the strategic course of functions and business units." ;
    p1z:parentProcess apqc:PCF10129 .

apqc:PCF10137 a p1z:Process ;
    skos:prefLabel "Analyze historical and planned promotions and events" ;
    p1z:apqcId "10137" ;
    p1z:apqcHierarchyId "3.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing promotional activities' effect on the sales orders. Analyze all promotional events and campaigns that the organization has already employed or is planning to deploy." ;
    p1z:parentProcess apqc:PCF10129 .

apqc:PCF10130 a p1z:Process ;
    skos:prefLabel "Develop sales partner/alliance relationships" ;
    p1z:apqcId "10130" ;
    p1z:apqcHierarchyId "3.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Cultivating an alliance of partners by identifying, analyzing, negotiating, and managing partnerships with other economic agents." ;
    p1z:parentProcess apqc:PCF10103 .

apqc:PCF10138 a p1z:Process ;
    skos:prefLabel "Identify alliance opportunities" ;
    p1z:apqcId "10138" ;
    p1z:apqcHierarchyId "3.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying collaboration opportunities for selling, marketing, and distributing the organization's products/services. Determine any scope for partnering with other economic agents, with synergies for the marketing, sales, and/or distribution of the organization's products/services. Identify alliance opportunities that target customer segments who would be interested." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF10139 a p1z:Process ;
    skos:prefLabel "Design alliance programs and methods for selecting and managing relationships" ;
    p1z:apqcId "10139" ;
    p1z:apqcHierarchyId "3.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating the frameworks needed to select alliance partners, and maintaining relationships with them. Create a framework for structured programs that can receive and support multiple alliances. Clearly outline the responsibilities and benefits of the alliance partners. Create frameworks for selecting the right alliance partners, and maintain a relationship with them. Create or repurpose teams of relationship managers and outline a methodology for selecting alliance partners." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF10140 a p1z:Process ;
    skos:prefLabel "Select alliances" ;
    p1z:apqcId "10140" ;
    p1z:apqcHierarchyId "3.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Choosing alliance partners using the selected programs and methodology. Select the most feasible and profitable alliance partners, based on Design alliance programs and methods for selecting and managing relationships [10139] and through a careful scrutiny of the potential alliance." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11465 a p1z:Process ;
    skos:prefLabel "Develop customer trade strategy and customer objectives/targets" ;
    p1z:apqcId "11465" ;
    p1z:apqcHierarchyId "3.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing category management strategies for customers through the use of consumer insights and understanding of customer specifics. Develop consumer and channel insights. Establish long term strategies, objectives and targets across the brand." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11521 a p1z:Process ;
    skos:prefLabel "Define trade programs and funding options" ;
    p1z:apqcId "11521" ;
    p1z:apqcHierarchyId "3.4.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing business-to-business marketing campaigns and financial incentives for wholesalers, dealers, distributors and other intermediaries that the company uses to distribute its products or services." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11466 a p1z:Process ;
    skos:prefLabel "Conduct planning activities for major trade customers" ;
    p1z:apqcId "11466" ;
    p1z:apqcHierarchyId "3.4.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Arranging meetings with trade partners to coordinate logistics, manage critical resources, resolve bottlenecks, and schedule urgent or time-sensitive matters." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF10141 a p1z:Process ;
    skos:prefLabel "Develop partner and alliance management strategies" ;
    p1z:apqcId "10141" ;
    p1z:apqcHierarchyId "3.4.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing strategies for effectively managing, identifying, and countering any possible issues from the alliance partnerships formed. Create a strategic road map for managing the partnerships forged through Design alliance programs and methods for selecting and managing relationships [10139]. Determine where the alliance partnerships are headed, possible problems or pushback from the partners, how these issues might be countered, how these alliance partnerships would evolve in the future, any other business cases where these partnerships might be deployed, etc." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF10142 a p1z:Process ;
    skos:prefLabel "Establish partner and alliance management goals" ;
    p1z:apqcId "10142" ;
    p1z:apqcHierarchyId "3.4.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Setting targets for organizational achievement. This includes what the organization aims to achieve from and how it wishes to manage both the individual partners and the alliance as a whole. Set immediate through long-term goals including revenue targets, market penetration, footfall numbers, and geographical coverage." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF18629 a p1z:Process ;
    skos:prefLabel "Establish partner and alliance agreements" ;
    p1z:apqcId "18629" ;
    p1z:apqcHierarchyId "3.4.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Setting up strategic alliances with key trade partners and ratifying partnership agreements." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11522 a p1z:Process ;
    skos:prefLabel "Develop promotional and category management calendars (trade marketing calendars)" ;
    p1z:apqcId "11522" ;
    p1z:apqcHierarchyId "3.4.2.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Combining scheduled promotional, category management and trade marketing events into unified timetables. Update the calendars. Register new events." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11523 a p1z:Process ;
    skos:prefLabel "Create strategic and tactical sales plans by customer" ;
    p1z:apqcId "11523" ;
    p1z:apqcHierarchyId "3.4.2.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing long term customer sales plans to assess current sales and to determine future sales objectives, strategies for achieving the goals, and available resources." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF11468 a p1z:Process ;
    skos:prefLabel "Communicate planning information to customer teams" ;
    p1z:apqcId "11468" ;
    p1z:apqcHierarchyId "3.4.2.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Sending invitations and distributing information about upcoming events to customer teams and other involved entities." ;
    p1z:parentProcess apqc:PCF10130 .

apqc:PCF10131 a p1z:Process ;
    skos:prefLabel "Establish overall sales budgets" ;
    p1z:apqcId "10131" ;
    p1z:apqcHierarchyId "3.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Setting up a financial plan for the sales function. Calculate the estimated sales revenue and costs, which helps in calculating the overall net profit. Create a sound plan for resource outlay by comparing the forecast with historical data." ;
    p1z:parentProcess apqc:PCF10103 .

apqc:PCF17682 a p1z:Process ;
    skos:prefLabel "Calculate product market share" ;
    p1z:apqcId "17682" ;
    p1z:apqcHierarchyId "3.4.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining the percentage of total sales volume in the market for a particular product." ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10143 a p1z:Process ;
    skos:prefLabel "Calculate product revenue" ;
    p1z:apqcId "10143" ;
    p1z:apqcHierarchyId "3.4.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Estimating revenue from the sale of products/services. Approximate the anticipated sale of products/services and multiply it by the selling price of the respective offering. (This represents the total amount of money that the organization receives from the sale of its portfolio of offerings.)" ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10144 a p1z:Process ;
    skos:prefLabel "Determine variable costs" ;
    p1z:apqcId "10144" ;
    p1z:apqcHierarchyId "3.4.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the variable costs of production. Approximate those costs that depend on the volume of products/services produced by the organization." ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10145 a p1z:Process ;
    skos:prefLabel "Determine overhead and fixed costs" ;
    p1z:apqcId "10145" ;
    p1z:apqcHierarchyId "3.4.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the overhead costs associated with selling the organization's products/services. Determine fixed costs that are not directly related to the volume of products/services processed or the sale of these offerings (e.g., expense over machinery and equipment)." ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10146 a p1z:Process ;
    skos:prefLabel "Calculate net profit" ;
    p1z:apqcId "10146" ;
    p1z:apqcHierarchyId "3.4.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the net income. Calculate the organization's profitability by accounting for Determine overhead and fixed costs [10145] and Determine variable costs [10144]." ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10147 a p1z:Process ;
    skos:prefLabel "Create budget" ;
    p1z:apqcId "10147" ;
    p1z:apqcHierarchyId "3.4.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan in measurable terms for the financial outlay that best captures resource allocation for the sales forecast. Consider the outlay of capital, HR, raw materials, and provisions needed to reach sales targets." ;
    p1z:parentProcess apqc:PCF10131 .

apqc:PCF10132 a p1z:Process ;
    skos:prefLabel "Establish sales goals and measures" ;
    p1z:apqcId "10132" ;
    p1z:apqcHierarchyId "3.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing specific quantitative and qualitative measures of realizing sales targets. Create sales targets by analyzing historical sales data and comparing the forecasts to results, in light of customer and market intelligence. Examine the performance of sales personnel in light of market opportunities. Based on this review, establish sales targets along with metrics to quantify these goals, corresponding with the overall business strategy." ;
    p1z:parentProcess apqc:PCF10103 .

apqc:PCF10133 a p1z:Process ;
    skos:prefLabel "Establish customer management measures" ;
    p1z:apqcId "10133" ;
    p1z:apqcHierarchyId "3.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Identifying the appropriate measures that can represent key attributes of the customer management function. Select measures to track customer activity, feedback, satisfaction, organizational responsiveness to customer needs, and general data on how the organization is managing customer accounts, leads, and contacts. Build on customer and market intelligence to identify metrics gauging aspects related to customer management. Select measures based on the nature of the business, the type and size of customer base, strategic goals, and the model used to structure sales and customer relationships." ;
    p1z:parentProcess apqc:PCF10103 .

apqc:PCF10105 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage sales plans" ;
    p1z:apqcId "10105" ;
    p1z:apqcHierarchyId "3.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Selling products/services. Set appropriate customer expectations. Work with customers using the same schedule that product/service development, production, and customer service functions follow. Manage sales personnel and sales partnerships/alliances." ;
    p1z:parentProcess apqc:PCF10004 .

apqc:PCF10182 a p1z:Process ;
    skos:prefLabel "Manage leads/opportunities" ;
    p1z:apqcId "10182" ;
    p1z:apqcHierarchyId "3.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Generating leads of prospective customers to grow the organization's business. Identify viable customers based on customer and market research. Discover leads through IT applications, cold calling, reference/network development, or other sales and business development techniques. Employ a scoring model qualify the prospective customers into leads, and prioritize them." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF10188 a p1z:Process ;
    skos:prefLabel "Identify potential customers" ;
    p1z:apqcId "10188" ;
    p1z:apqcHierarchyId "3.5.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying people who can be converted into customers. Leverage personal and professional networks, business research over databases and directories, and secondary research." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF10189 a p1z:Process ;
    skos:prefLabel "Identify/receive leads/opportunities" ;
    p1z:apqcId "10189" ;
    p1z:apqcHierarchyId "3.5.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Qualifying the prospective customers into credible leads by gauging their behavior against the organization's offering. Triangulate leads to increase the efficiency of sales and marketing efforts. Build a detailed profile of the prospects. Determine what products/services they already use, if they have decision-making authority, their views on the products/services they already use, how prone they are to switch, if the organization's solution better in some attributes than those prospects currently use, etc." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF18115 a p1z:Process ;
    skos:prefLabel "Validate and qualify leads/opportunities" ;
    p1z:apqcId "18115" ;
    p1z:apqcHierarchyId "3.5.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing the set of potential customers and sales opportunities. Approve the leads that meet company requirements on new businesses." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF11773 a p1z:Process ;
    skos:prefLabel "Match opportunities to business strategy" ;
    p1z:apqcId "11773" ;
    p1z:apqcHierarchyId "3.5.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning sales leads with business objectives." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF18116 a p1z:Process ;
    skos:prefLabel "Develop opportunity win plans" ;
    p1z:apqcId "18116" ;
    p1z:apqcHierarchyId "3.5.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating plans about how to close leads and win sales opportunities." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF20011 a p1z:Process ;
    skos:prefLabel "Manage opportunity pipeline" ;
    p1z:apqcId "20011" ;
    p1z:apqcHierarchyId "3.5.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Overseeing and planning the acquisition of new customers." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF10209 a p1z:Process ;
    skos:prefLabel "Determine sales resource allocation" ;
    p1z:apqcId "10209" ;
    p1z:apqcHierarchyId "3.5.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning the distribution of personnel across various sales functions. Match the capabilities of individual employees with the skill sets needed for specific roles. Seek assistance from HR." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF10184 a p1z:Process ;
    skos:prefLabel "Manage customer sales calls" ;
    p1z:apqcId "10184" ;
    p1z:apqcHierarchyId "3.5.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the entire sales process, from using leads to open sales to closing sales and creating records. Govern all sales activities. Make sales calls based on leads and preparatory work (drafting terms of the sale, creating proposals, suggesting prices, etc.). Close the sale, along with any administrative activities related to data entry and the processing of the sale." ;
    p1z:parentProcess apqc:PCF10182 .

apqc:PCF10183 a p1z:Process ;
    skos:prefLabel "Manage customers and accounts" ;
    p1z:apqcId "10183" ;
    p1z:apqcHierarchyId "3.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the customer's expectations, with the intent of responsibly increasing the sale of the organization's products/services. Create a systematic method for governing sales, using sales forecasts and customer management measures. Develop a blueprint to manage relationships with customers and the data it holds on them, as well as the sale of its products/services to these customers. Devise a recipe for handling the organization's key customers in order to manage their expectations with tact and responsibility while maximizing revenue." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF20013 a p1z:Process ;
    skos:prefLabel "Select key customers/accounts" ;
    p1z:apqcId "20013" ;
    p1z:apqcHierarchyId "3.5.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Choosing principal clients that are vital for the company." ;
    p1z:parentProcess apqc:PCF10183 .

apqc:PCF11173 a p1z:Process ;
    skos:prefLabel "Develop sales/key account plan" ;
    p1z:apqcId "11173" ;
    p1z:apqcHierarchyId "3.5.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan for managing the accounts of key customers in order to better maintain relationships with them. Chart a scheme for managing sales. Create a plan for administering accounts of the significant and most important customers of the organization. Coordinate the accounts of principal clients." ;
    p1z:parentProcess apqc:PCF10183 .

apqc:PCF20014 a p1z:Process ;
    skos:prefLabel "Manage sales/key account plan" ;
    p1z:apqcId "20014" ;
    p1z:apqcHierarchyId "3.5.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling the accounts of important clients." ;
    p1z:parentProcess apqc:PCF10183 .

apqc:PCF11174 a p1z:Process ;
    skos:prefLabel "Manage customer relationships" ;
    p1z:apqcId "11174" ;
    p1z:apqcHierarchyId "3.5.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the organization's relationship with its customers, by systematically coordinating interactions over multiple touch points, on a regular basis. Coordinate the organization's efforts to reach out to its customers. Create and manage effective touch points for interactions from the customers, which could include emails, social-media interactions, newsletters, and direct conversations." ;
    p1z:parentProcess apqc:PCF10183 .

apqc:PCF14208 a p1z:Process ;
    skos:prefLabel "Manage customer master data" ;
    p1z:apqcId "14208" ;
    p1z:apqcHierarchyId "3.5.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the corpus of data relating all customers acquired over time. Manage the storage, maintenance, access, revision, and usage of all data on customers. Ensure its security, and determine legitimate use cases that are beneficial to the organization." ;
    p1z:parentProcess apqc:PCF10183 .

apqc:PCF11779 a p1z:Process ;
    skos:prefLabel "Develop and manage sales proposals, bids, and quotes" ;
    p1z:apqcId "11779" ;
    p1z:apqcHierarchyId "3.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Understanding and refining the customer requirements as provided in a RFP (Request for Proposal) or RFI (Request for Information).  When compiling the response, they must take into consideration whether the requirements are a match with the strategic or tactical plans of the organization and whether they are able to submit a bid/proposal that is competitive based on an understanding of the offerings of other competing organizations. The next step will be to define the pricing and scheduling of the proposed solution and determine whether the proposal will be profitable for the company if accepted. The bid is then submitted and a notification of whether or not it was successful is received." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF11781 a p1z:Process ;
    skos:prefLabel "Receive Request For Proposal (RFP)/Request For Quote (RFQ)" ;
    p1z:apqcId "11781" ;
    p1z:apqcHierarchyId "3.5.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Accepting procurement proposals." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11780 a p1z:Process ;
    skos:prefLabel "Refine customer requirements" ;
    p1z:apqcId "11780" ;
    p1z:apqcHierarchyId "3.5.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Clarifying the details about procurement requests, such as the scope, timeline, data sources, type and characteristics and evaluation criteria for the goods or services to be delivered, and any additional terms, conditions or special requirements." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11782 a p1z:Process ;
    skos:prefLabel "Review RFP/RFQ request" ;
    p1z:apqcId "11782" ;
    p1z:apqcHierarchyId "3.5.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating individual price and delivery solicitations for their strengths and weaknesses. Analyze how closely the submitted bids respond to the requirements outlined in the RFPs." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11783 a p1z:Process ;
    skos:prefLabel "Perform competitive analysis" ;
    p1z:apqcId "11783" ;
    p1z:apqcHierarchyId "3.5.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Comparing the proposals submitted by different bidders in terms of cost, efficiency and value." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11784 a p1z:Process ;
    skos:prefLabel "Validate with strategy/business plans" ;
    p1z:apqcId "11784" ;
    p1z:apqcHierarchyId "3.5.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the business strategy, forecasted performance, financing and cash flow of the proposals." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11785 a p1z:Process ;
    skos:prefLabel "Understand customer business and requirements" ;
    p1z:apqcId "11785" ;
    p1z:apqcHierarchyId "3.5.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deepening knowledge about the customer's field of operation and business needs." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF20015 a p1z:Process ;
    skos:prefLabel "Develop solution and delivery approach" ;
    p1z:apqcId "20015" ;
    p1z:apqcHierarchyId "3.5.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan with detailed steps about how produce and deliver the goods or services." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11787 a p1z:Process ;
    skos:prefLabel "Identify staffing requirements" ;
    p1z:apqcId "11787" ;
    p1z:apqcHierarchyId "3.5.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the needs for internal resources and vacancies." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11788 a p1z:Process ;
    skos:prefLabel "Develop pricing and scheduling estimates" ;
    p1z:apqcId "11788" ;
    p1z:apqcHierarchyId "3.5.3.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing predicted delivery costs, fees and timelines." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11789 a p1z:Process ;
    skos:prefLabel "Conduct profitability analysis" ;
    p1z:apqcId "11789" ;
    p1z:apqcHierarchyId "3.5.3.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing profitability data. Analyze systematically all relevant metrics and parameters. Report findings and make recommendations for changes to operational strategies." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF20016 a p1z:Process ;
    skos:prefLabel "Manage internal reviews" ;
    p1z:apqcId "20016" ;
    p1z:apqcHierarchyId "3.5.3.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing the internal review process." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF20017 a p1z:Process ;
    skos:prefLabel "Manage internal approvals" ;
    p1z:apqcId "20017" ;
    p1z:apqcHierarchyId "3.5.3.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining required company-internal authorizations." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11790 a p1z:Process ;
    skos:prefLabel "Submit/present bid/proposal/quote to customer" ;
    p1z:apqcId "11790" ;
    p1z:apqcHierarchyId "3.5.3.13" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Delivering the proposal to the potential client." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF20018 a p1z:Process ;
    skos:prefLabel "Revise bid/proposal/quote" ;
    p1z:apqcId "20018" ;
    p1z:apqcHierarchyId "3.5.3.14" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Amending bids, proposals or quotes with more accurate time, cost or delivery estimates." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF11793 a p1z:Process ;
    skos:prefLabel "Manage notification outcome" ;
    p1z:apqcId "11793" ;
    p1z:apqcHierarchyId "3.5.3.15" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling proposals depending on whether they were accepted or rejected." ;
    p1z:parentProcess apqc:PCF11779 .

apqc:PCF10185 a p1z:Process ;
    skos:prefLabel "Manage sales orders" ;
    p1z:apqcId "10185" ;
    p1z:apqcHierarchyId "3.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Taking, receiving, processing, and acknowledging new customer orders or amendments to outstanding customer orders. Monitoring status from order receipt to customer delivery/customer invoicing." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF10194 a p1z:Process ;
    skos:prefLabel "Accept and validate sales orders" ;
    p1z:apqcId "10194" ;
    p1z:apqcHierarchyId "3.5.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Receiving and confirming orders from customers. Verify that no extra expenses have to be disbursed on part of the organization for labor or inventory when processing the order." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10195 a p1z:Process ;
    skos:prefLabel "Collect and maintain account information" ;
    p1z:apqcId "10195" ;
    p1z:apqcHierarchyId "3.5.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Collecting and maintaining all account information. Collect information about the purchase, servicing, return, and/or commitment of any products/services on part of the organization to its customers. Bring together information from various organizational divisions, and update periodically." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10196 a p1z:Process ;
    skos:prefLabel "Determine availability" ;
    p1z:apqcId "10196" ;
    p1z:apqcHierarchyId "3.5.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Ascertaining the volume or scale of products/services to provide to customers to fulfill sales orders. Check the finished products stored in warehouses, the production capacity, and (in the case of services) the processing speed, as well as work force availability." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10197 a p1z:Process ;
    skos:prefLabel "Determine fulfillment process" ;
    p1z:apqcId "10197" ;
    p1z:apqcHierarchyId "3.5.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Devising a blueprint for order fulfillment. Create a schematic flow encompassing all activities to deliver orders to the customers. Outline a procedure for satisfying these orders by answering questions about what needs to happen in sequence to realize an order." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10199 a p1z:Process ;
    skos:prefLabel "Process back orders and updates" ;
    p1z:apqcId "10199" ;
    p1z:apqcHierarchyId "3.5.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Processing any unfulfilled orders, and updating the status of any orders that have been accepted and are being attended to. Deliver on any purchase orders that remain unserviced due to temporary unavailability of the product/service. Manage any updates to the sales orders. Revise their status in the order system." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10200 a p1z:Process ;
    skos:prefLabel "Handle sales order inquiries including post-order fulfillment transactions" ;
    p1z:apqcId "10200" ;
    p1z:apqcHierarchyId "3.5.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Attending to any queries received from the customers, even after a sales order has been serviced. Deploy ad hoc personnel for managing these enquiries." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF11518 a p1z:Process ;
    skos:prefLabel "Provide product tracking" ;
    p1z:apqcId "11518" ;
    p1z:apqcHierarchyId "3.5.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing visibility into the status and progress of products associated with customer orders to support order fulfillment, customer communication, and issue resolution." ;
    p1z:parentProcess apqc:PCF10185 .

apqc:PCF10187 a p1z:Process ;
    skos:prefLabel "Manage sales partners and alliances" ;
    p1z:apqcId "10187" ;
    p1z:apqcHierarchyId "3.5.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the organization's partners and alliances, with the objective of maximizing revenue. Train partners regarding the organization's portfolio of products/services. Craft sales forecasts. Examine their performance. Manage all data held by the organization on these partners." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF10211 a p1z:Process ;
    skos:prefLabel "Provide sales and product/service training to sales partners/alliances" ;
    p1z:apqcId "10211" ;
    p1z:apqcHierarchyId "3.5.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Imparting guidance and instruction to sales partners/alliances concerning products/services. Distribute literature about the organization's products/services. Conduct workshops. Disseminate useful media content to engage and enlighten partners. Create communities through group engagements." ;
    p1z:parentProcess apqc:PCF10187 .

apqc:PCF18641 a p1z:Process ;
    skos:prefLabel "Provide marketing materials to sales partners/alliances" ;
    p1z:apqcId "18641" ;
    p1z:apqcHierarchyId "3.5.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Distributing marketing materials and sales brochures to entities that the company partners with." ;
    p1z:parentProcess apqc:PCF10187 .

apqc:PCF10214 a p1z:Process ;
    skos:prefLabel "Evaluate partner/alliance results" ;
    p1z:apqcId "10214" ;
    p1z:apqcHierarchyId "3.5.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the performance of its partners/alliances in selling its products/services. Use metrics such as growth in revenue generated, conversion rate, and total outreach to customers for assessing the performance results." ;
    p1z:parentProcess apqc:PCF10187 .

apqc:PCF14209 a p1z:Process ;
    skos:prefLabel "Manage sales partner/alliance master data" ;
    p1z:apqcId "14209" ;
    p1z:apqcHierarchyId "3.5.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the repository of data relating to the organization's partners/alliances over time. Store, maintain, access, revise, and use all data on partners/alliances. Manage data. Ensure its security. Determine legitimate use cases that are beneficial to the organization." ;
    p1z:parentProcess apqc:PCF10187 .

apqc:PCF21427 a p1z:Process ;
    skos:prefLabel "Perform sales at physical outlets" ;
    p1z:apqcId "21427" ;
    p1z:apqcHierarchyId "3.5.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Execution of sales at physical / brick and mortar locations." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF21428 a p1z:Process ;
    skos:prefLabel "Perform field sales" ;
    p1z:apqcId "21428" ;
    p1z:apqcHierarchyId "3.5.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Execution of sales within field/remote locations.  This could be any location that is not part of a headquarters location." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF21429 a p1z:Process ;
    skos:prefLabel "Perform digital sales" ;
    p1z:apqcId "21429" ;
    p1z:apqcHierarchyId "3.5.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Execution of sales in an online environment." ;
    p1z:parentProcess apqc:PCF10105 .

apqc:PCF20022 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Supply Chain for Physical Products" ;
    p1z:apqcId "20022" ;
    p1z:apqcHierarchyId "4.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Performing supply chain activities include planning supply chain, procuring materials and services, and managing logistics." .

apqc:PCF10215 a p1z:FunctionalDomain ;
    skos:prefLabel "Plan for and align supply chain resources" ;
    p1z:apqcId "10215" ;
    p1z:apqcHierarchyId "4.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies for production and materials. Handle the demand for the products of the organization. Develop plans for handling materials. Develop and administer the schedule for master production. Plan for distribution requirements and its constraints by reviewing and assessing distribution policies and performance and by establishing quality standards and procedures." ;
    p1z:parentProcess apqc:PCF20022 .

apqc:PCF10221 a p1z:Process ;
    skos:prefLabel "Develop production and materials strategies" ;
    p1z:apqcId "10221" ;
    p1z:apqcHierarchyId "4.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies for production processes, as well as the process of managing materials. Define production and supply constraints. Design a blueprint of the workplace. Establish rules and regulations regarding the employees, outsourcing of services, and the expenditure to be incurred on the manufacturing capital." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10229 a p1z:Process ;
    skos:prefLabel "Define manufacturing goals" ;
    p1z:apqcId "10229" ;
    p1z:apqcHierarchyId "4.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating quantifiable strategic objectives for each manufacturing segment in conjunction with sales projections." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10230 a p1z:Process ;
    skos:prefLabel "Define labor and materials policies" ;
    p1z:apqcId "10230" ;
    p1z:apqcHierarchyId "4.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Setting up internal rules and regulations regarding the employees and the materials." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10231 a p1z:Process ;
    skos:prefLabel "Define outsourcing policies" ;
    p1z:apqcId "10231" ;
    p1z:apqcHierarchyId "4.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating rules and regulations regarding contracting out of a business process to another party in order to reduce costs." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10232 a p1z:Process ;
    skos:prefLabel "Define capital expense policies" ;
    p1z:apqcId "10232" ;
    p1z:apqcHierarchyId "4.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing rules and regulations pertaining to the expenditure incurred in acquiring or upgrading the existing stock of manufacturing capital." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10233 a p1z:Process ;
    skos:prefLabel "Define capacities" ;
    p1z:apqcId "10233" ;
    p1z:apqcHierarchyId "4.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the manufacturing and processing capacities of the organization. Delineate the capabilities required for optimizing output with available resources. Analyze capabilities possessed by the organization concerning the raw materials required and the process necessitated for producing finished products." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10234 a p1z:Process ;
    skos:prefLabel "Define production network and supply constraints" ;
    p1z:apqcId "10234" ;
    p1z:apqcHierarchyId "4.1.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining limitations in the ability of the organization's supply chain to deliver a new stock, and creating a network of production stakeholders. Frame and manage relationships within the flow of manufacturing and processing operations. Identify probable supply issues." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF14193 a p1z:Process ;
    skos:prefLabel "Define production process" ;
    p1z:apqcId "14193" ;
    p1z:apqcHierarchyId "4.1.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the scheme of processing inventory into finished products/services. This includes the use of raw materials, machinery, skill sets, and knowledge to create new offerings." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF19551 a p1z:Process ;
    skos:prefLabel "Define standard operating procedures" ;
    p1z:apqcId "19551" ;
    p1z:apqcHierarchyId "4.1.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing or prescribing methods to be followed routinely for the performance of designated operations or in designated situations. This may include step-by-step instructions to help workers carry out complex routine operations. The goal is to improve efficiency, quality, and uniformity of performance, while reducing miscommunication, failure, or rework." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF14194 a p1z:Process ;
    skos:prefLabel "Define production workplace layout and infrastructure" ;
    p1z:apqcId "14194" ;
    p1z:apqcHierarchyId "4.1.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining the floor plans for the processing facility that is meant for delivering finished products/services. Identify the totality of infrastructure needed for using this space in the manufacturing process, including machinery, factory floors, offices, and furniture." ;
    p1z:parentProcess apqc:PCF10221 .

apqc:PCF10222 a p1z:Process ;
    skos:prefLabel "Manage demand for products" ;
    p1z:apqcId "10222" ;
    p1z:apqcHierarchyId "4.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Forecasting demand for products using secondary research and customer feedback. Refine these forecasts. Inspect the approach used in creating forecasts, and determine its accuracy." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10235 a p1z:Process ;
    skos:prefLabel "Develop baseline demand forecasts" ;
    p1z:apqcId "10235" ;
    p1z:apqcHierarchyId "4.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify the bedrock levels of market demand anticipated for the organization's products/services. Estimate future demand for product and services using historical data, analysis of the market environment and any externalities, etc. to create ex ante approximations. This includes operation planning." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10236 a p1z:Process ;
    skos:prefLabel "Collaborate demand with customers" ;
    p1z:apqcId "10236" ;
    p1z:apqcHierarchyId "4.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Working closely with the organization's customers to understand their drives and behavior, with the objective of estimating future demand. Reach out to customers through various means to understand their behavior patterns, usage elasticity, and degree of variability--and ultimately determine demand for each offering." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10237 a p1z:Process ;
    skos:prefLabel "Develop demand consensus forecast" ;
    p1z:apqcId "10237" ;
    p1z:apqcHierarchyId "4.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Arriving at a consensus over the forecasted levels of demand for products/services. Consensus is achieved by juxtaposing decisions developed in the baseline forecast with those reached at by collaborating with customers. Enlist senior-level decision makers of the sales and marketing functions." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10238 a p1z:Process ;
    skos:prefLabel "Determine available to promise" ;
    p1z:apqcId "10238" ;
    p1z:apqcHierarchyId "4.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify the volume of products/services that may be committed for delivery to fulfill sales. Figure out the amount of stock available. Forecast its volumes." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10239 a p1z:Process ;
    skos:prefLabel "Monitor activity against demand forecast and revise forecast" ;
    p1z:apqcId "10239" ;
    p1z:apqcHierarchyId "4.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Picking out any activity that deviates from the forecast, and adjusting it. Closely track and study the levels of demand as they emerge. Refine the consensus forecast as needed." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10240 a p1z:Process ;
    skos:prefLabel "Evaluate and revise demand forecasting approach" ;
    p1z:apqcId "10240" ;
    p1z:apqcHierarchyId "4.1.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the methodology used to estimate future demand. Refine it in light of current market realities and demand." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10241 a p1z:Process ;
    skos:prefLabel "Measure demand forecast accuracy" ;
    p1z:apqcId "10241" ;
    p1z:apqcHierarchyId "4.1.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Calculating and inspecting the accuracy of demand forecasts. Use metrics to check the reliability of the forecasts created." ;
    p1z:parentProcess apqc:PCF10222 .

apqc:PCF10223 a p1z:Process ;
    skos:prefLabel "Create materials plan" ;
    p1z:apqcId "10223" ;
    p1z:apqcHierarchyId "4.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing a scheme that allows for advance planning for the availability of raw materials and spares. Start with an unconstrained plan, and refine based on supply chain realities by identifying critical materials required for production, checking material specifications, and collaborating with all vendors over the supply." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10242 a p1z:Process ;
    skos:prefLabel "Create unconstrained plan" ;
    p1z:apqcId "10242" ;
    p1z:apqcHierarchyId "4.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan for raw materials and other inventory items in order to meet market demand. Ensure the availability of all inventory items such as raw materials and spares. Create a blueprint in line with Define labor and materials policies [10230]." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF10243 a p1z:Process ;
    skos:prefLabel "Collaborate with supplier and contract manufacturers" ;
    p1z:apqcId "10243" ;
    p1z:apqcHierarchyId "4.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collaborating with vendors and contractual manufacturers with the objective of ensuring a continual supply of raw materials and spares. Leverage long-term connections/relationships with various suppliers, and cultivate new ones. Track the activities of all vendors. Receive regular updates to prepare for any fluctuations in supply." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF10244 a p1z:Process ;
    skos:prefLabel "Identify critical materials and supplier capacity" ;
    p1z:apqcId "10244" ;
    p1z:apqcHierarchyId "4.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying principal materials needed for the manufacturing process and the levels of supply that may be ensured for them. Determine the essential and crucial inventory items required for the smooth functioning of all manufacturing processes. Estimate the average, peak, and baseline capacities of various vendors and suppliers. Establish the capability of individual suppliers from the market and the vendors." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF10245 a p1z:Process ;
    skos:prefLabel "Monitor material specifications" ;
    p1z:apqcId "10245" ;
    p1z:apqcHierarchyId "4.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Observing and surveying all inventory items in order to check for the veracity of their specifications. Monitor various attributes and characteristics for respective inventory items such as density, volume, and size, as well as contextualized specifications particular to the respective materials." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF10246 a p1z:Process ;
    skos:prefLabel "Generate constrained plan" ;
    p1z:apqcId "10246" ;
    p1z:apqcHierarchyId "4.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Generating a bounded plan that takes stock of the actual supply chain scenario. Take stock of all information collected while creating an inventory supply plan." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF14196 a p1z:Process ;
    skos:prefLabel "Define production balance and control" ;
    p1z:apqcId "14196" ;
    p1z:apqcHierarchyId "4.1.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining an equitable volume for the production of products/services that adheres to an equilibrium value, and creating a scheme of control for processing items. Create schematics for systematically planning, coordinating, and directing the manufacturing activities in line with the production balance determined." ;
    p1z:parentProcess apqc:PCF10223 .

apqc:PCF10224 a p1z:Process ;
    skos:prefLabel "Create and manage master production schedule" ;
    p1z:apqcId "10224" ;
    p1z:apqcHierarchyId "4.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Taking care of the master production plan. The master production includes creation and implementation of the site-level production plan, as well as management of the inventory that is currently in the production process." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF20023 a p1z:Process ;
    skos:prefLabel "Model production network to enable simulation and optimization" ;
    p1z:apqcId "20023" ;
    p1z:apqcHierarchyId "4.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create representative logical system that provides the framework to attain strategic objectives based on resources, product volumes, and processes. Provides the general sequential flow and capacity requirement relationships among raw materials, parts, resources, finished products, and product families." ;
    p1z:parentProcess apqc:PCF10224 .

apqc:PCF20024 a p1z:Process ;
    skos:prefLabel "Create master production schedule" ;
    p1z:apqcId "20024" ;
    p1z:apqcHierarchyId "4.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating  the plan for internal activities such as production, inventory, and staffing. Include forecasted quantity of items to produce based on inputs from sales planning, demand planning/forecasting, and supply chain partners." ;
    p1z:parentProcess apqc:PCF10224 .

apqc:PCF17041 a p1z:Process ;
    skos:prefLabel "Maintain master production schedule" ;
    p1z:apqcId "17041" ;
    p1z:apqcHierarchyId "4.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supervising and overseeing the plan for internal activities such as production, inventory, and staffing. Set the quantity of items to produce each week of a short-range planning horizon." ;
    p1z:parentProcess apqc:PCF10224 .

apqc:PCF17042 a p1z:Process ;
    skos:prefLabel "Plan distribution requirements" ;
    p1z:apqcId "17042" ;
    p1z:apqcHierarchyId "4.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Maintaining master data of finished products and inventory. Identify the requirements of finished products at the destination, as well as partner requirements. Calculate the consolidation at source. Manage replenishment planning. Create and administer a dispatch plan. Calculate load plans for destinations and partners. Manage the cost of supplying these products. Ensure effective utilization of capacity." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10252 a p1z:Process ;
    skos:prefLabel "Maintain master data" ;
    p1z:apqcId "10252" ;
    p1z:apqcHierarchyId "4.1.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Maintaining and preserving the master data plan for distribution requirements. Create a systematic collection of facts and figures regarding the distribution of the inventories. Maintain policies, processes, and tools covering the distribution function." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10253 a p1z:Process ;
    skos:prefLabel "Determine finished goods inventory requirements at destination" ;
    p1z:apqcId "10253" ;
    p1z:apqcHierarchyId "4.1.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Interact with the concerned person at the destination to validate the requirements and to avoid any miscommunication of information." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF19555 a p1z:Process ;
    skos:prefLabel "Determine product storage facility requirements" ;
    p1z:apqcId "19555" ;
    p1z:apqcHierarchyId "4.1.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate constraints, needs, parameters, and conditions for physical storage and retrieval of components or products for future use or shipment in a storage facility within a certain timeframe." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10254 a p1z:Process ;
    skos:prefLabel "Calculate requirements at destination" ;
    p1z:apqcId "10254" ;
    p1z:apqcHierarchyId "4.1.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Interact with the concerned authority at the destination to reach a specific figure that correctly represents requirements." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10255 a p1z:Process ;
    skos:prefLabel "Calculate consolidation at source" ;
    p1z:apqcId "10255" ;
    p1z:apqcHierarchyId "4.1.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the aggregate volume of products/services consolidated at the source. Calculate the number of finished products that are ready to be delivered to the customers, particularly at one date." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10256 a p1z:Process ;
    skos:prefLabel "Manage collaborative replenishment planning" ;
    p1z:apqcId "10256" ;
    p1z:apqcHierarchyId "4.1.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the plan for collaborative replenishment of goods. Replenish inventory by creating a plan in case of faulty production." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10258 a p1z:Process ;
    skos:prefLabel "Calculate and optimize destination dispatch plan" ;
    p1z:apqcId "10258" ;
    p1z:apqcHierarchyId "4.1.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Estimating the timing and duration of the delivery of the inventory from the source to the destination. Plan the logistic details of all the distribution routes and activities." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10259 a p1z:Process ;
    skos:prefLabel "Manage dispatch plan attainment" ;
    p1z:apqcId "10259" ;
    p1z:apqcHierarchyId "4.1.5.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Accomplishing the dispatch plan. Strictly follow the schedule, and adjust for deviations. Coordinate with the concerned authorities at various destinations." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10260 a p1z:Process ;
    skos:prefLabel "Calculate and optimize destination load plans" ;
    p1z:apqcId "10260" ;
    p1z:apqcHierarchyId "4.1.5.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the plans for delivering loads to destinations. Create a systematic plan that specifies the load plans for every single destination." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10261 a p1z:Process ;
    skos:prefLabel "Manage partner load plan" ;
    p1z:apqcId "10261" ;
    p1z:apqcHierarchyId "4.1.5.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the load plan for partners. Manage the delivery, and dispatch from the source to the partners." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10262 a p1z:Process ;
    skos:prefLabel "Manage cost of supply" ;
    p1z:apqcId "10262" ;
    p1z:apqcHierarchyId "4.1.5.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing all expenses to provide products/services in the market. Estimate the overall cost of supplying of products/inventory, including the cost distributing it through various partners and channels. Consider the cost of all the logistical processes that occur from the moment a product is ready to be dispatched to the time it reaches the destination." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10263 a p1z:Process ;
    skos:prefLabel "Manage capacity utilization" ;
    p1z:apqcId "10263" ;
    p1z:apqcHierarchyId "4.1.5.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining the capacity utilization of the organization's production process. Realize the extent to which an enterprise uses its installed productive capacity (i.e., the relationship between output and the potential output if capacity was fully used)." ;
    p1z:parentProcess apqc:PCF17042 .

apqc:PCF10226 a p1z:Process ;
    skos:prefLabel "Establish distribution planning constraints" ;
    p1z:apqcId "10226" ;
    p1z:apqcHierarchyId "4.1.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Instituting the constraints for planning of distribution process. Create a plan that specifies every element in the distribution process from the blueprint of the distribution centers to how and when the inventory would reach the distribution centers." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10267 a p1z:Process ;
    skos:prefLabel "Establish distribution center layout constraints" ;
    p1z:apqcId "10267" ;
    p1z:apqcHierarchyId "4.1.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Instituting the constraints for creating a layout for distribution center. Consider factors such as the number of customers, demand forecasting, product groups, condition of product conservation, warehousing, and transportation management." ;
    p1z:parentProcess apqc:PCF10226 .

apqc:PCF10268 a p1z:Process ;
    skos:prefLabel "Establish inventory management constraints" ;
    p1z:apqcId "10268" ;
    p1z:apqcHierarchyId "4.1.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining any problems that might be faced while managing inventory. Identify problems and possible issues in managing the warehousing of the raw materials, spares, and other items of inventory. Take stock of inventory needs, and determine the exact quantity of the inventory needed in the near future." ;
    p1z:parentProcess apqc:PCF10226 .

apqc:PCF10269 a p1z:Process ;
    skos:prefLabel "Establish transportation management constraints" ;
    p1z:apqcId "10269" ;
    p1z:apqcHierarchyId "4.1.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying any potential constraints while deciding on the dispatch and delivery plan from the source to the various distribution centers. Decide how the inventory will be transported , which and how many transportation means to use, what route to take, etc." ;
    p1z:parentProcess apqc:PCF10226 .

apqc:PCF19558 a p1z:Process ;
    skos:prefLabel "Establish storage management constraints" ;
    p1z:apqcId "19558" ;
    p1z:apqcHierarchyId "4.1.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining potential constraints for physical storage and retrieval of components or products in a storage facility within a certain timeframe. Consider factors such as the building shape, height, capacity, door locations, lift equipment, automation, etc." ;
    p1z:parentProcess apqc:PCF10226 .

apqc:PCF10227 a p1z:Process ;
    skos:prefLabel "Review distribution planning policies" ;
    p1z:apqcId "10227" ;
    p1z:apqcHierarchyId "4.1.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Revisiting and refurbishing the policies for planning the distribution process. Asses the distribution strategies, including how the products are to be made available and sent to different distributors. Set guidelines regarding relationships between the sources and the distribution centers." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10264 a p1z:Process ;
    skos:prefLabel "Review distribution network" ;
    p1z:apqcId "10264" ;
    p1z:apqcHierarchyId "4.1.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the system that defines how the products/inventory would reach from the source (i.e., manufacturer) to the destination (i.e., retailer/distributer)." ;
    p1z:parentProcess apqc:PCF10227 .

apqc:PCF10265 a p1z:Process ;
    skos:prefLabel "Establish sourcing relationships" ;
    p1z:apqcId "10265" ;
    p1z:apqcHierarchyId "4.1.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing relationships with transportation/distribution sources in order to ensure an effective distribution network and strategy. Screen and evaluate various sources available to pick out the best among them." ;
    p1z:parentProcess apqc:PCF10227 .

apqc:PCF10266 a p1z:Process ;
    skos:prefLabel "Establish dynamic deployment policies" ;
    p1z:apqcId "10266" ;
    p1z:apqcHierarchyId "4.1.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating strategic guidelines on the availability of the products at all the distribution centers. Create a dynamic network to ensure availability at all times, even in cases of defaults." ;
    p1z:parentProcess apqc:PCF10227 .

apqc:PCF10368 a p1z:Process ;
    skos:prefLabel "Develop quality standards and procedures" ;
    p1z:apqcId "10368" ;
    p1z:apqcHierarchyId "4.1.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing standards and procedures for maintaining the quality of products/services. Establish desired quality targets. Create standardized procedures for the quality. Ensure quality specifications are effectively communicated." ;
    p1z:parentProcess apqc:PCF10215 .

apqc:PCF10371 a p1z:Process ;
    skos:prefLabel "Establish quality targets" ;
    p1z:apqcId "10371" ;
    p1z:apqcHierarchyId "4.1.8.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining specific qualitative and quantitative target figures." ;
    p1z:parentProcess apqc:PCF10368 .

apqc:PCF10372 a p1z:Process ;
    skos:prefLabel "Develop standard testing procedures" ;
    p1z:apqcId "10372" ;
    p1z:apqcHierarchyId "4.1.8.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating standard procedures for testing the quality of products/services. Describe the steps of key processes to help ensure consistent and quality output. Define the routine instructions for performing the quality testing activity." ;
    p1z:parentProcess apqc:PCF10368 .

apqc:PCF10373 a p1z:Process ;
    skos:prefLabel "Communicate quality specifications" ;
    p1z:apqcId "10373" ;
    p1z:apqcHierarchyId "4.1.8.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating the desired quality specifications to the manufacturing units, as well as the distribution centers, to avoid any misunderstanding or misinterpretation." ;
    p1z:parentProcess apqc:PCF10368 .

apqc:PCF10216 a p1z:FunctionalDomain ;
    skos:prefLabel "Procure materials and services" ;
    p1z:apqcId "10216" ;
    p1z:apqcHierarchyId "4.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a plan for procuring materials and services. Develop strategies for sourcing materials and services. Choose the most appropriate suppliers, and develop contracts with them. Order the materials and services as per the requirements. Manage relationships with suppliers." ;
    p1z:parentProcess apqc:PCF20022 .

apqc:PCF10277 a p1z:Process ;
    skos:prefLabel "Provide sourcing governance" ;
    p1z:apqcId "10277" ;
    p1z:apqcHierarchyId "4.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies for procuring materials and services from various sources, and for managing and evaluating categories. Establish a procurement process that describes the approach for obtaining products and purchasing activities. Evaluate the sources. Create sourcing relationships in order to continuously improve. Re-evaluate purchasing activities." ;
    p1z:parentProcess apqc:PCF10216 .

apqc:PCF10281 a p1z:Process ;
    skos:prefLabel "Develop procurement plan" ;
    p1z:apqcId "10281" ;
    p1z:apqcHierarchyId "4.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan for procuring materials and services. Plan what to buy, when, and from what sources. Include project requirements, the procurement team, the justification for the procurement, a timeline of events, and an explanation of the supplier selection process. Outline specific actions to start and complete purchases in order to adhere to best practices." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10282 a p1z:Process ;
    skos:prefLabel "Clarify purchasing requirements" ;
    p1z:apqcId "10282" ;
    p1z:apqcHierarchyId "4.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the purchasing requirements for materials and services. Specify the exact inventory required for the production process. Create a specific quotation for all the sources in order to avoid any duplication or overlap." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10283 a p1z:Process ;
    skos:prefLabel "Establish materials management contingency plans" ;
    p1z:apqcId "10283" ;
    p1z:apqcHierarchyId "4.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a strategy to deal with issues projected to arise during implementation of the inventory plan. Identify how to react to issues that arise and require changes to the inventory plan, such as a vendor failing to deliver materials on time. Collaborate with production and suppliers to prepare solutions to projected problems." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10284 a p1z:Process ;
    skos:prefLabel "Match needs to supply capabilities" ;
    p1z:apqcId "10284" ;
    p1z:apqcHierarchyId "4.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Synchronizing the requirements of materials and services and the capacity of suppliers for providing these materials and services. Revamp the procurement needs of the company in consideration of the capabilities of the suppliers." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10285 a p1z:Process ;
    skos:prefLabel "Analyze organization\u2019s spend profile" ;
    p1z:apqcId "10285" ;
    p1z:apqcHierarchyId "4.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Evaluating the spend profile of the organization. Collect, cleanse, classify, and analyze the procurement data with the purpose of reducing procurement costs, improving efficiency, and monitoring compliance." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10286 a p1z:Process ;
    skos:prefLabel "Seek opportunities to improve efficiency and value" ;
    p1z:apqcId "10286" ;
    p1z:apqcHierarchyId "4.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Seeking the most efficient sourcing and procurement opportunities." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF21616 a p1z:Process ;
    skos:prefLabel "Collaborate with suppliers to align with long term business goals" ;
    p1z:apqcId "21616" ;
    p1z:apqcHierarchyId "4.2.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collaborating with the suppliers of materials and services in order to determine new opportunities for sourcing, share market insights, manage risk, identify and align supplier capabilities with long-term business goals." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF10287 a p1z:Process ;
    skos:prefLabel "Collaborate with suppliers to identify sourcing opportunities" ;
    p1z:apqcId "10287" ;
    p1z:apqcHierarchyId "4.2.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collaborating with the suppliers of materials and services in order to determine new opportunities for sourcing." ;
    p1z:parentProcess apqc:PCF10277 .

apqc:PCF16636 a p1z:Process ;
    skos:prefLabel "Develop category plan" ;
    p1z:apqcId "16636" ;
    p1z:apqcHierarchyId "4.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining sourcing strategies and plans for categories of materials or services to optimize cost, supply continuity, value, and alignment with organizational requirements and market conditions." ;
    p1z:parentProcess apqc:PCF10216 .

apqc:PCF11470 a p1z:Process ;
    skos:prefLabel "Analyze category/product positioning and performance" ;
    p1z:apqcId "11470" ;
    p1z:apqcHierarchyId "4.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the position and performance of sourcing categories or products based on spend, supplier dynamics, market conditions, and value contribution to inform category planning decisions." ;
    p1z:parentProcess apqc:PCF16636 .

apqc:PCF16637 a p1z:Process ;
    skos:prefLabel "Forecast demand for each category by market" ;
    p1z:apqcId "16637" ;
    p1z:apqcHierarchyId "4.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Forecasting demand for sourcing categories across relevant markets or consumption channels to support planning, supplier strategy, and capacity alignment." ;
    p1z:parentProcess apqc:PCF16636 .

apqc:PCF16638 a p1z:Process ;
    skos:prefLabel "Assign revenue and margin targets to each category" ;
    p1z:apqcId "16638" ;
    p1z:apqcHierarchyId "4.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing revenue, cost, and margin targets for sourcing categories to guide category strategy, sourcing decisions, and performance evaluation." ;
    p1z:parentProcess apqc:PCF16636 .

apqc:PCF10278 a p1z:Process ;
    skos:prefLabel "Select suppliers and develop/maintain contracts" ;
    p1z:apqcId "10278" ;
    p1z:apqcHierarchyId "4.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Evaluating supplier options to select the most effective and efficient suppliers. Validate selected suppliers. Establish and manage supplier contracts." ;
    p1z:parentProcess apqc:PCF10216 .

apqc:PCF10288 a p1z:Process ;
    skos:prefLabel "Select suppliers" ;
    p1z:apqcId "10288" ;
    p1z:apqcHierarchyId "4.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the pros and cons of various suppliers. Choose the most appropriate and cost-effective suppliers on the basis of their material quality, delivery schedules, and costs." ;
    p1z:parentProcess apqc:PCF10278 .

apqc:PCF10289 a p1z:Process ;
    skos:prefLabel "Certify and validate suppliers" ;
    p1z:apqcId "10289" ;
    p1z:apqcHierarchyId "4.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating the supply sources, and provide certification as an official supplier." ;
    p1z:parentProcess apqc:PCF10278 .

apqc:PCF10290 a p1z:Process ;
    skos:prefLabel "Negotiate and establish contracts" ;
    p1z:apqcId "10290" ;
    p1z:apqcHierarchyId "4.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Legally binding suppliers with the company. Negotiate contracts individually with all the suppliers that include the promised material delivery, the delivery dates and duration, etc." ;
    p1z:parentProcess apqc:PCF10278 .

apqc:PCF10291 a p1z:Process ;
    skos:prefLabel "Manage contracts" ;
    p1z:apqcId "10291" ;
    p1z:apqcHierarchyId "4.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping contracts up-to-date with routine evaluation. Maintain order and discipline with the contracts in order to avoid any loss of information and mishaps." ;
    p1z:parentProcess apqc:PCF10278 .

apqc:PCF10279 a p1z:Process ;
    skos:prefLabel "Order materials and services" ;
    p1z:apqcId "10279" ;
    p1z:apqcHierarchyId "4.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and approving requisitions and distributing purchase orders accordingly. Hasten the procurement process to satisfy internal needs." ;
    p1z:parentProcess apqc:PCF10216 .

apqc:PCF10292 a p1z:Process ;
    skos:prefLabel "Process/Review requisitions" ;
    p1z:apqcId "10292" ;
    p1z:apqcHierarchyId "4.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling operations related to processing/reviewing the requisitions. Establish and maintain procedures for the initiation, authorization, and processing of purchase requirements to procure products/services." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10293 a p1z:Process ;
    skos:prefLabel "Approve requisitions" ;
    p1z:apqcId "10293" ;
    p1z:apqcHierarchyId "4.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Approving requisitions for materials and services. Examine distributor-specific requests, and validate them individually." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10294 a p1z:Process ;
    skos:prefLabel "Solicit supplier quotes" ;
    p1z:apqcId "10294" ;
    p1z:apqcHierarchyId "4.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Requesting quotes from suppliers. Use a request for quotation (RFQ) to invite suppliers into a bidding process for specific products/services." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10295 a p1z:Process ;
    skos:prefLabel "Create/Distribute purchase orders" ;
    p1z:apqcId "10295" ;
    p1z:apqcHierarchyId "4.2.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and placing the orders for purchasing materials and services from suppliers. Analyze vendor quotes. Choose the most cost-effective vendors. Create vendor-specific orders. Distribute them in order to initiate the purchasing process." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10296 a p1z:Process ;
    skos:prefLabel "Expedite orders and satisfy inquiries" ;
    p1z:apqcId "10296" ;
    p1z:apqcHierarchyId "4.2.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Accelerating the purchase orders in order to fulfill the internal needs (for raw materials) depicted through inquiries." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10297 a p1z:Process ;
    skos:prefLabel "Reconcile purchase orders" ;
    p1z:apqcId "10297" ;
    p1z:apqcHierarchyId "4.2.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Verify that purchase orders are filled as expected: verify that items and quantities are delivered as expected, based on purchase order details and goods receipts." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10298 a p1z:Process ;
    skos:prefLabel "Research/Resolve order exceptions" ;
    p1z:apqcId "10298" ;
    p1z:apqcHierarchyId "4.2.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and resolving any exceptions. Address the internal needs/inquiries for materials that cannot be procured immediately. Research inquiries that require the need of exceptional materials." ;
    p1z:parentProcess apqc:PCF10279 .

apqc:PCF10280 a p1z:Process ;
    skos:prefLabel "Manage suppliers" ;
    p1z:apqcId "10280" ;
    p1z:apqcHierarchyId "4.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Collecting and analyzing new information in order to track and rate suppliers and build relationships." ;
    p1z:parentProcess apqc:PCF10216 .

apqc:PCF10299 a p1z:Process ;
    skos:prefLabel "Monitor/Manage supplier information" ;
    p1z:apqcId "10299" ;
    p1z:apqcHierarchyId "4.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Create and maintain vendor master files. Examining procurement and vendor performance. Report delivery timing and the quality of the materials procured through different vendors.  This data must align with vendor master file, see PCFID 10869." ;
    p1z:parentProcess apqc:PCF10280 .

apqc:PCF10300 a p1z:Process ;
    skos:prefLabel "Prepare/Analyze procurement and supplier performance" ;
    p1z:apqcId "10300" ;
    p1z:apqcHierarchyId "4.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assisting the production and inventory processes through the information and reports created. Use the information and metrics of the procurement and vendor performance to enhance or improve the production process." ;
    p1z:parentProcess apqc:PCF10280 .

apqc:PCF10301 a p1z:Process ;
    skos:prefLabel "Support inventory and production processes" ;
    p1z:apqcId "10301" ;
    p1z:apqcHierarchyId "4.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Support inventory and production processes by analyzing impact of procurement decisions and collaborating to constantly improve. (For example, perhaps minimum order requirements could be negotiated to be lower, to reduce excessive inventory and make production more flexible.)" ;
    p1z:parentProcess apqc:PCF10280 .

apqc:PCF10302 a p1z:Process ;
    skos:prefLabel "Monitor quality of product delivered" ;
    p1z:apqcId "10302" ;
    p1z:apqcHierarchyId "4.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Track the performance of the suppliers on product quality. Use this information to further improve sourcing and supplier performance." ;
    p1z:parentProcess apqc:PCF10280 .

apqc:PCF10217 a p1z:FunctionalDomain ;
    skos:prefLabel "Produce/Assemble/Test product" ;
    p1z:apqcId "10217" ;
    p1z:apqcHierarchyId "4.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Processing and delivering the finished goods manufactured by the organization. Schedule the production of products. Execute the product production activities. Perform tests to oversee and ensure quality of production. Maintain records of the production process. Track lots." ;
    p1z:parentProcess apqc:PCF20022 .

apqc:PCF10303 a p1z:Process ;
    skos:prefLabel "Schedule production" ;
    p1z:apqcId "10303" ;
    p1z:apqcHierarchyId "4.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Scheduling the production of final products. Generate a detailed schedule plan. Create and release production orders and lots. Schedule the planned and unplanned maintenance orders." ;
    p1z:parentProcess apqc:PCF10217 .

apqc:PCF19563 a p1z:Process ;
    skos:prefLabel "Model and simulate plant" ;
    p1z:apqcId "19563" ;
    p1z:apqcHierarchyId "4.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a representation of plant facilities to optimize material flow, resource utilization, and logistics for all levels of plant planning from global production facilities, through local plants, to specific lines and enabling the comparison of production\ufffdalternatives,." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10306 a p1z:Process ;
    skos:prefLabel "Generate line level plan" ;
    p1z:apqcId "10306" ;
    p1z:apqcHierarchyId "4.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Initiating the line-level plan for production. Break down the production schedule into specific lines, specifying the various objectives the production schedule." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10307 a p1z:Process ;
    skos:prefLabel "Generate detailed schedule" ;
    p1z:apqcId "10307" ;
    p1z:apqcHierarchyId "4.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Broadening the line-level plan. Specify all the individual production processes, along with the timing and the duration to come up with a working schedule that tracks the whole process and any deviations that might occur." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10308 a p1z:Process ;
    skos:prefLabel "Schedule production orders and create lots" ;
    p1z:apqcId "10308" ;
    p1z:apqcHierarchyId "4.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a schedule to commence production of orders received, and creating lots to consolidate the processing. Plan when the production orders are to be initiated by commencing the operations for processing products/services. Specify which materials to produce, where to produce them, which operations will facilitate this, and on which date production is to start. Define the size of production lots, demarcating the durations of batch production." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10315 a p1z:Process ;
    skos:prefLabel "Plan for preventive maintenance" ;
    p1z:apqcId "10315" ;
    p1z:apqcHierarchyId "4.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Scheduling planned maintenance of the production equipment." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10316 a p1z:Process ;
    skos:prefLabel "Request unplanned maintenance" ;
    p1z:apqcId "10316" ;
    p1z:apqcHierarchyId "4.3.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Scheduling requested maintenance in order to address breakdowns where repairs or corrective remedies are needed immediately. Create a scheme for undertaking unplanned maintenance work on equipment/machinery that has come to be in urgent need for it. Express turnaround to redress using specialized personnel." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10309 a p1z:Process ;
    skos:prefLabel "Release production orders and create lots" ;
    p1z:apqcId "10309" ;
    p1z:apqcHierarchyId "4.3.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Initiating the delivery of production orders, and creating lots. Communicate the order that specifies which material to produce, where to produce it, which operations to require, and on which date production takes place. Define how to settle the order costs. Create production lots, which is a particular production unit of an assembly that is planned and manufactured." ;
    p1z:parentProcess apqc:PCF10303 .

apqc:PCF10304 a p1z:Process ;
    skos:prefLabel "Produce/Assemble product" ;
    p1z:apqcId "10304" ;
    p1z:apqcHierarchyId "4.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Manufacturing the product. Convert the raw materials to develop consumer-ready products. Manage the raw materials to implement the detailed production schedule. Reproduce defectives to establish and remediate cause. Ensure production optimization and benchmark performance." ;
    p1z:parentProcess apqc:PCF10217 .

apqc:PCF10310 a p1z:Process ;
    skos:prefLabel "Manage raw material inventory" ;
    p1z:apqcId "10310" ;
    p1z:apqcHierarchyId "4.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the inventory of raw materials. Manage the total cost of all component parts in stock but not yet used. Manage the cost of the direct materials (i.e., materials incorporated into the final product) and indirect materials (i.e., materials not incorporated into the final product but consumed during the production process)." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF10311 a p1z:Process ;
    skos:prefLabel "Execute detailed line schedule" ;
    p1z:apqcId "10311" ;
    p1z:apqcHierarchyId "4.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing the detailed line production schedule on the ground level." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF10319 a p1z:Process ;
    skos:prefLabel "Report maintenance issues" ;
    p1z:apqcId "10319" ;
    p1z:apqcHierarchyId "4.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recording and reporting any deviations or issues in the maintenance schedule, in the performance to the production management team, and for unplanned maintenance." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF10313 a p1z:Process ;
    skos:prefLabel "Rerun defective items" ;
    p1z:apqcId "10313" ;
    p1z:apqcHierarchyId "4.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reproducing the items produced defectively. Assess the produced items by conducting quality and standardization tests in order to diagnose any discrepancies. Reproduce defective items." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF19566 a p1z:Process ;
    skos:prefLabel "Monitor and optimize production process" ;
    p1z:apqcId "19566" ;
    p1z:apqcHierarchyId "4.3.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Integrating different resources in the production process: material, personnel, equipment, robotics, etc. Includes automating and controlling the plant, performing advanced process control and real-time optimization. This activity also includes managing plant alarms and alerts." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF10314 a p1z:Process ;
    skos:prefLabel "Assess production performance" ;
    p1z:apqcId "10314" ;
    p1z:apqcHierarchyId "4.3.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing and benchmarking the production process to judge its effectiveness and efficiency. Create production metrics to numerically calculate the performance of the production process." ;
    p1z:parentProcess apqc:PCF10304 .

apqc:PCF10369 a p1z:Process ;
    skos:prefLabel "Perform quality testing" ;
    p1z:apqcId "10369" ;
    p1z:apqcHierarchyId "4.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Executing tests to evaluate the quality of the products manufactured. Calibrate the test equipment. Conduct the actual tests. Record the results and outcomes of the quality test conducted." ;
    p1z:parentProcess apqc:PCF10217 .

apqc:PCF10318 a p1z:Process ;
    skos:prefLabel "Calibrate test equipment" ;
    p1z:apqcId "10318" ;
    p1z:apqcHierarchyId "4.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Regulating the equipment used for performing quality tests. Assess correspondence between the quality testing equipment and the desired quality standards. Ensure the calibration standard is more accurate than the instrument being tested." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF10374 a p1z:Process ;
    skos:prefLabel "Perform testing using the standard testing procedure" ;
    p1z:apqcId "10374" ;
    p1z:apqcHierarchyId "4.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Performing testing using calibrated equipment and in consent with the standard testing procedure, including testing time." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF20956 a p1z:Process ;
    skos:prefLabel "Manage quality samples" ;
    p1z:apqcId "20956" ;
    p1z:apqcHierarchyId "4.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Selecting a set of elements from a product lot to draw conclusions or make inferences about the quality of the product lot from which the sample is drawn. Sampling is frequently used because gathering data on every product produced by a company is often impossible, impractical, or too costly to collect." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF10375 a p1z:Process ;
    skos:prefLabel "Record test results" ;
    p1z:apqcId "10375" ;
    p1z:apqcHierarchyId "4.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting the results and outcomes of the quality tests. Track the performance of the production process. Record/Document it to evaluate the qualitative efficiency of the production process. Use electronic devices and software in order to ensure effectiveness in recording the results and outcomes of the test." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF12045 a p1z:Process ;
    skos:prefLabel "Track and analyze non-conformance trends" ;
    p1z:apqcId "12045" ;
    p1z:apqcHierarchyId "4.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing and monitoring the occurrences of problems with a process or product. It is important that nonconformance occurrences are tracked in a standardized way so the data can easily be reviewed to assess the impact of the problem. Ongoing analysis of trends in nonconformance gives an organization the ability to make process changes to reduce the incidence and cost of nonconformances." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF12046 a p1z:Process ;
    skos:prefLabel "Perform root cause analysis" ;
    p1z:apqcId "12046" ;
    p1z:apqcHierarchyId "4.3.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Using a technique that helps people answer the question of why a problem occurred in the first place. It seeks to identify the origin of a problem using a specific set of steps, with associated tools, to find the primary cause of the problem to determine what happened, why, and how to reduce the likelihood that it will happen again." ;
    p1z:parentProcess apqc:PCF10369 .

apqc:PCF10370 a p1z:Process ;
    skos:prefLabel "Maintain production records and manage lot traceability" ;
    p1z:apqcId "10370" ;
    p1z:apqcHierarchyId "4.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Perpetuating the production records by systematically documenting and using it to ensure the effective management of lots. Determine the lot numbering system and its use. (The lot number enables tracking of the constituent parts, as well as labor and equipment records involved in the manufacturing of a product. It enables manufacturers and to perform quality control checks, calculate expiration dates, and issue corrections of their production output.)" ;
    p1z:parentProcess apqc:PCF10217 .

apqc:PCF10376 a p1z:Process ;
    skos:prefLabel "Determine lot numbering system" ;
    p1z:apqcId "10376" ;
    p1z:apqcHierarchyId "4.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Allotting an identification number to a particular quantity or lot of material manufactured. Assign lot numbers on the basis of specific production units, material similarity, etc. Place lot numbers on the outside of packaging." ;
    p1z:parentProcess apqc:PCF10370 .

apqc:PCF10377 a p1z:Process ;
    skos:prefLabel "Determine lot use" ;
    p1z:apqcId "10377" ;
    p1z:apqcHierarchyId "4.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the use of production lots. Define where, how, and when to use a specific production lot." ;
    p1z:parentProcess apqc:PCF10370 .

apqc:PCF10219 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage logistics and warehousing" ;
    p1z:apqcId "10219" ;
    p1z:apqcHierarchyId "4.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Administering and overseeing all activities related to logistics and warehousing. Outline and establish a strategy for the logistics function. Plan and administer the flow of inbound materials. Administer the operational activities of warehousing and outbound transportation. Manage reverse logistics including returns and exchanges." ;
    p1z:parentProcess apqc:PCF20022 .

apqc:PCF10338 a p1z:Process ;
    skos:prefLabel "Provide logistics governance" ;
    p1z:apqcId "10338" ;
    p1z:apqcHierarchyId "4.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Outlining the strategy for managing logistics. Translate customer requirements logistic requirements. Create an efficient logistic network and outsourcing portions of logistics activities. Design a logistics strategy that optimizes transportation costs and schedule. Define key performance indicators." ;
    p1z:parentProcess apqc:PCF10219 .

apqc:PCF10343 a p1z:Process ;
    skos:prefLabel "Translate customer service requirements into logistics requirements" ;
    p1z:apqcId "10343" ;
    p1z:apqcHierarchyId "4.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the requirements for managing the flow of things between the point of origin and the point of consumption by assessing the service requirements of the customers." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF10344 a p1z:Process ;
    skos:prefLabel "Design logistics network" ;
    p1z:apqcId "10344" ;
    p1z:apqcHierarchyId "4.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a network for logistical activities. Create a network of entities through which materials and information flow, encompassing all related activities associated with the flow of transformation of products." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF10345 a p1z:Process ;
    skos:prefLabel "Communicate outsourcing needs" ;
    p1z:apqcId "10345" ;
    p1z:apqcHierarchyId "4.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying outsourcing needs within the organization, with the objective of sourcing the assistance required. Define the portion of logistical activities that can be transferred to outside suppliers. Assess third-party agencies to carefully select the most appropriate agencies for outsourcing. Convey these needs to management or the appropriate authority." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF10346 a p1z:Process ;
    skos:prefLabel "Develop and maintain delivery service policy" ;
    p1z:apqcId "10346" ;
    p1z:apqcHierarchyId "4.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing rules and regulations, as well as the terms and conditions regarding the delivery of service by the company. Develop a delivery plan that specifies what, how, when, and in which way to deliver services to the customer." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF10347 a p1z:Process ;
    skos:prefLabel "Optimize transportation schedules and costs" ;
    p1z:apqcId "10347" ;
    p1z:apqcHierarchyId "4.4.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Optimizing the schedule and costs of transportation services. Design a logistics strategy by strategically creating delivery routes and systems, which optimizes the overall transportation schedules and costs. Evaluate different transportation sources in order to select the most appropriate and cost-effective sources." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF10348 a p1z:Process ;
    skos:prefLabel "Define key performance measures" ;
    p1z:apqcId "10348" ;
    p1z:apqcHierarchyId "4.4.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing measures for evaluating the performance of the logistics strategy of the organization. Establish key performance indicators, including the logistics performance index, delivery in full, and delivery on time." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF16905 a p1z:Process ;
    skos:prefLabel "Define reverse logistics strategy" ;
    p1z:apqcId "16905" ;
    p1z:apqcHierarchyId "4.4.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establish a strategy that includes rules and regulations for the physical handling, information processing, and disposition of product and packaging returned by the buyer to the seller or an intermediary. Include return approval, transportation coordination, advance communication, product tracking, receipt, disposition of the return, and processing warranty claims in the strategy." ;
    p1z:parentProcess apqc:PCF10338 .

apqc:PCF20936 a p1z:Process ;
    skos:prefLabel "Plan and manage inbound material flow" ;
    p1z:apqcId "20936" ;
    p1z:apqcHierarchyId "4.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and executing a strategy for all the internal activities related to the flow/transfer of inbound materials. This process includes planning inbound material receipts, managing inbound material flow, monitoring inbound delivery performance, managing the flow of returned products, controlling the quality of returned parts, and salvaging or repairing returned products." ;
    p1z:parentProcess apqc:PCF10219 .

apqc:PCF10349 a p1z:Process ;
    skos:prefLabel "Plan inbound material receipts" ;
    p1z:apqcId "10349" ;
    p1z:apqcHierarchyId "4.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the receipts of inbound materials. Create a plan accounting for the materials procured from the source of supply and the materials delivered to the distribution center or the warehouse." ;
    p1z:parentProcess apqc:PCF20936 .

apqc:PCF10350 a p1z:Process ;
    skos:prefLabel "Manage inbound material flow" ;
    p1z:apqcId "10350" ;
    p1z:apqcHierarchyId "4.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing all the internal activities related to the flow/transfer of materials. Manage materials being delivered to distribution center or warehouse. Gauge the time taken for delivery and if the delivery process is on time." ;
    p1z:parentProcess apqc:PCF20936 .

apqc:PCF10351 a p1z:Process ;
    skos:prefLabel "Monitor inbound delivery performance" ;
    p1z:apqcId "10351" ;
    p1z:apqcHierarchyId "4.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing the performance of an inbound delivery system. Check the present delivery system's efficiency, cost effectiveness, and adherence to a delivery schedule." ;
    p1z:parentProcess apqc:PCF20936 .

apqc:PCF10352 a p1z:Process ;
    skos:prefLabel "Manage flow of returned products" ;
    p1z:apqcId "10352" ;
    p1z:apqcHierarchyId "4.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking and taking care of the products that have been internally returned either because of their deficiency or in cases of incorrect delivery." ;
    p1z:parentProcess apqc:PCF20936 .

apqc:PCF20109 a p1z:Process ;
    skos:prefLabel "Manage disposition of returned products" ;
    p1z:apqcId "20109" ;
    p1z:apqcHierarchyId "4.4.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining if a returned product can be salvaged or repaired. Salvage or repair is dependent upon the product, the condition of the product, or the availability of a like item." ;
    p1z:parentProcess apqc:PCF20936 .

apqc:PCF10340 a p1z:Process ;
    skos:prefLabel "Operate warehousing" ;
    p1z:apqcId "10340" ;
    p1z:apqcHierarchyId "4.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Tracking the inventory deployment. Accept and store products. Ship the products. Measure the accuracy of the inventory. Assess the performance of the outsourced logistics activities." ;
    p1z:parentProcess apqc:PCF10219 .

apqc:PCF10353 a p1z:Process ;
    skos:prefLabel "Manage and track inventory deployment" ;
    p1z:apqcId "10353" ;
    p1z:apqcHierarchyId "4.4.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking the logistical act of delivering or releasing an inventory item or entity to targeted end users. Track how much inventory has been deployed at all the distribution centers, individually." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10354 a p1z:Process ;
    skos:prefLabel "Receive, inspect, and store inbound deliveries" ;
    p1z:apqcId "10354" ;
    p1z:apqcHierarchyId "4.4.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating the incoming inbound materials/products. Accept the delivery of these materials and the subsequent storage. Track them at the warehouse/distribution center." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10355 a p1z:Process ;
    skos:prefLabel "Track product availability" ;
    p1z:apqcId "10355" ;
    p1z:apqcHierarchyId "4.4.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping track of the availability of different materials/products at the warehouse and distribution centers." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10356 a p1z:Process ;
    skos:prefLabel "Pick, pack, and ship product for delivery" ;
    p1z:apqcId "10356" ;
    p1z:apqcHierarchyId "4.4.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Packing and shipping the product to deliver to the customer. Take care of the internal and external packaging of the products in order to ensure safe transportation of the products from the warehouse to delivery locations. Notify the ERP system and/or Accounts Receivable Dept." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10357 a p1z:Process ;
    skos:prefLabel "Track inventory accuracy" ;
    p1z:apqcId "10357" ;
    p1z:apqcHierarchyId "4.4.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring any discrepancies between electronic records that represent the inventory and the physical state of the inventory. Look for discrepancies such as phantom inventory, which includes products that an inventory accounting system considers to be available at the storage location but are not actually available." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10358 a p1z:Process ;
    skos:prefLabel "Track third-party logistics storage and shipping performance" ;
    p1z:apqcId "10358" ;
    p1z:apqcHierarchyId "4.4.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping a track on the storage and shipping performance of third-party agencies. Monitor logistics storage and shipping performance for third-party agencies. Use measures such as a logistics scoreboard, activity-based costing, economic value analysis, and balanced scorecards." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10359 a p1z:Process ;
    skos:prefLabel "Manage physical finished goods inventory" ;
    p1z:apqcId "10359" ;
    p1z:apqcHierarchyId "4.4.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Administering the movement of the finished products that are processed by the organization through its warehouses. Track goods through the use of systems such as barcodes in order to monitor the volumes available, quantity of out-flowing goods, remaining shelf life of the product, etc.--ultimately, to best manage the warehouse capacity." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF20957 a p1z:Process ;
    skos:prefLabel "Manage warehouse transfers" ;
    p1z:apqcId "20957" ;
    p1z:apqcHierarchyId "4.4.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Shipping items from one warehouse to another in a multi-warehouse environment. A warehouse transfer is typically handled electronically in a system designed to replicate the physical processes involved with transferring items from one warehouse to another." ;
    p1z:parentProcess apqc:PCF10340 .

apqc:PCF10341 a p1z:Process ;
    skos:prefLabel "Operate outbound transportation" ;
    p1z:apqcId "10341" ;
    p1z:apqcHierarchyId "4.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a plan that specifies the schedule and system for transportation and delivery of the outbound products, as well as tracking the performance of the carrier delivery system. Conduct vehicle management and processing of all carrier-related documents." ;
    p1z:parentProcess apqc:PCF10219 .

apqc:PCF10360 a p1z:Process ;
    skos:prefLabel "Plan, transport, and deliver outbound product" ;
    p1z:apqcId "10360" ;
    p1z:apqcHierarchyId "4.4.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Organizing the transportation and delivery of outbound products. Plan and organize the transportation, shipping, and delivery of the end products. Create a plan that specifies dispatch and delivery of the product to its destination, as well the transportation." ;
    p1z:parentProcess apqc:PCF10341 .

apqc:PCF10361 a p1z:Process ;
    skos:prefLabel "Track carrier delivery performance" ;
    p1z:apqcId "10361" ;
    p1z:apqcHierarchyId "4.4.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring delivery performance when carrying products from the warehouse/distribution centers to the retailers or end consumers. Create a performance metrics based on the key performance indicators." ;
    p1z:parentProcess apqc:PCF10341 .

apqc:PCF10362 a p1z:Process ;
    skos:prefLabel "Manage transportation fleet" ;
    p1z:apqcId "10362" ;
    p1z:apqcHierarchyId "4.4.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Taking care of a range of functions related to the means of transport used for delivering the end products. Manage vehicle financing, vehicle maintenance, vehicle telematics (tracking and diagnostics), driver management, speed management, fuel management, and health and safety management." ;
    p1z:parentProcess apqc:PCF10341 .

apqc:PCF10363 a p1z:Process ;
    skos:prefLabel "Process and audit carrier invoices and documents" ;
    p1z:apqcId "10363" ;
    p1z:apqcHierarchyId "4.4.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Organizing and inspecting all account statements and any other documentation for the carriers used in delivery. Create, manage, and inspect all documents related to the financial, regulatory, and administrative accounts of all the carriers/freights. Generate receipts for all freight transactions." ;
    p1z:parentProcess apqc:PCF10341 .

apqc:PCF21617 a p1z:Process ;
    skos:prefLabel "Deliver last mile delivery services" ;
    p1z:apqcId "21617" ;
    p1z:apqcHierarchyId "4.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating specific service requirements for individual customers. Determine and schedule resource to fulfill these requirements. Provide service to specific individual customers. Ensure the quality of service delivery." ;
    p1z:parentProcess apqc:PCF10219 .

apqc:PCF21618 a p1z:Process ;
    skos:prefLabel "Confirm specific last mile delivery service requirements for individual customer" ;
    p1z:apqcId "21618" ;
    p1z:apqcHierarchyId "4.4.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Acquiring or soliciting information about specific service requirements for individual customers through the customer service function. Obtain information about customer specific requests, process these requests, and create customer profiles to generate a service order." ;
    p1z:parentProcess apqc:PCF21617 .

apqc:PCF21622 a p1z:Process ;
    skos:prefLabel "Identify and schedule resources to meet last mile delivery requirements" ;
    p1z:apqcId "21622" ;
    p1z:apqcHierarchyId "4.4.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and scheduling the resources required to fulfill customer service requirements. Create a detailed schedule about the service orders and development of these service orders." ;
    p1z:parentProcess apqc:PCF21617 .

apqc:PCF21625 a p1z:Process ;
    skos:prefLabel "Provide last mile delivery service to specific customers" ;
    p1z:apqcId "21625" ;
    p1z:apqcHierarchyId "4.4.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Dispatching resources for managing and fulfilling daily service requirements. Manage the progress of order fulfillment. Complete order blocks." ;
    p1z:parentProcess apqc:PCF21617 .

apqc:PCF21629 a p1z:Process ;
    skos:prefLabel "Ensure quality of last mile delivery" ;
    p1z:apqcId "21629" ;
    p1z:apqcHierarchyId "4.4.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Guaranteeing the quality of service provided to customers. Identify the successful and unsuccessful orders along with the service failures. Collect customer feedback. Process the feedback to ensure the quality of service in the future." ;
    p1z:parentProcess apqc:PCF21617 .

apqc:PCF20025 a p1z:FunctionalDomain ;
    skos:prefLabel "Deliver Services" ;
    p1z:apqcId "20025" ;
    p1z:apqcHierarchyId "5.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Offering services to customers. This is the act of providing service delivery as a core business practice and covers identifying strategies for performing service delivery, managing resources, and delivering services to the customer." .

apqc:PCF20026 a p1z:FunctionalDomain ;
    skos:prefLabel "Establish service delivery governance and strategies" ;
    p1z:apqcId "20026" ;
    p1z:apqcHierarchyId "5.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating rules and regulations for service delivery to the customer. Establish a system to manage performance, delivery, and direction of service delivery. Engage with the customer for satisfaction feedback. Define goals, policies, processes, and workplace layout and infrastructure as a part of the service delivery strategy." ;
    p1z:parentProcess apqc:PCF20025 .

apqc:PCF20027 a p1z:Process ;
    skos:prefLabel "Establish service delivery governance" ;
    p1z:apqcId "20027" ;
    p1z:apqcHierarchyId "5.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing service delivery governance through a system that manages performance, development, and direction. Allow for customer feedback on delivery satisfaction." ;
    p1z:parentProcess apqc:PCF20026 .

apqc:PCF20028 a p1z:Process ;
    skos:prefLabel "Set up and maintain service delivery governance and management system" ;
    p1z:apqcId "20028" ;
    p1z:apqcHierarchyId "5.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing a system for which to manage customer needs and a structure for which to facilitate service delivery to fulfill those needs." ;
    p1z:parentProcess apqc:PCF20027 .

apqc:PCF20029 a p1z:Process ;
    skos:prefLabel "Manage service delivery performance" ;
    p1z:apqcId "20029" ;
    p1z:apqcHierarchyId "5.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting and implementing performance measures to ensure successful delivery of service to the customer." ;
    p1z:parentProcess apqc:PCF20027 .

apqc:PCF20030 a p1z:Process ;
    skos:prefLabel "Manage service delivery development and direction" ;
    p1z:apqcId "20030" ;
    p1z:apqcHierarchyId "5.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing guidance of resources to ensure that the development and direction of service delivery is in line with customer needs." ;
    p1z:parentProcess apqc:PCF20027 .

apqc:PCF20031 a p1z:Process ;
    skos:prefLabel "Solicit feedback from customer on service delivery satisfaction" ;
    p1z:apqcId "20031" ;
    p1z:apqcHierarchyId "5.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Engaging the customer post delivery to gauge the effectiveness of services rendered in order to improve on key delivery functions going forward." ;
    p1z:parentProcess apqc:PCF20027 .

apqc:PCF20032 a p1z:Process ;
    skos:prefLabel "Develop service delivery strategies" ;
    p1z:apqcId "20032" ;
    p1z:apqcHierarchyId "5.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Constructing strategies that identify goals, policies, processes, and procedures in relation to service delivery. Review and validate strategies. Define the workplace layout and infrastructure." ;
    p1z:parentProcess apqc:PCF20026 .

apqc:PCF20033 a p1z:Process ;
    skos:prefLabel "Define service delivery goals" ;
    p1z:apqcId "20033" ;
    p1z:apqcHierarchyId "5.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning organization practices to meet the needs of the customer by creating service delivery goals." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20034 a p1z:Process ;
    skos:prefLabel "Define labor policies" ;
    p1z:apqcId "20034" ;
    p1z:apqcHierarchyId "5.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining labor policies for resources and ensuring that those policies meet the needs of the organization, the customer, and government regulations." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20035 a p1z:Process ;
    skos:prefLabel "Evaluate resource availability" ;
    p1z:apqcId "20035" ;
    p1z:apqcHierarchyId "5.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the needs of the customer and providing the necessary resources to meet those requirements." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20036 a p1z:Process ;
    skos:prefLabel "Define service delivery network and supply constraints" ;
    p1z:apqcId "20036" ;
    p1z:apqcHierarchyId "5.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and understanding the limitations imposed upon service delivery network and supply." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20037 a p1z:Process ;
    skos:prefLabel "Define service delivery process" ;
    p1z:apqcId "20037" ;
    p1z:apqcHierarchyId "5.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defanging policies and procedures that focus on meeting the needs and expectations of the customer within the working parameters of the organization." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20038 a p1z:Process ;
    skos:prefLabel "Review and validate service delivery procedures" ;
    p1z:apqcId "20038" ;
    p1z:apqcHierarchyId "5.1.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Revisioning service delivery procedures that fall short of performance parameters. Realign procedures with specified expectations in order to provide successful service delivery." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20039 a p1z:Process ;
    skos:prefLabel "Define service delivery workplace layout and infrastructure" ;
    p1z:apqcId "20039" ;
    p1z:apqcHierarchyId "5.1.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a workplace that best serves the needs of the organization and customer through strategic layout and infrastructure." ;
    p1z:parentProcess apqc:PCF20032 .

apqc:PCF20040 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage service delivery resources" ;
    p1z:apqcId "20040" ;
    p1z:apqcHierarchyId "5.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Understanding the demands on resources and creating a plan to enable the delivery of services via those resources." ;
    p1z:parentProcess apqc:PCF20025 .

apqc:PCF20041 a p1z:Process ;
    skos:prefLabel "Manage service delivery resource demand" ;
    p1z:apqcId "20041" ;
    p1z:apqcHierarchyId "5.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Ensuring necessary resources are maintained through monitoring pipeline, developing forecasts, and collaborating with customers. Determine skills needed for service deliver and forecast customer orders. Monitor forecasted orders and modify if where needed. Measure forecast accuracy." ;
    p1z:parentProcess apqc:PCF20040 .

apqc:PCF20042 a p1z:Process ;
    skos:prefLabel "Monitor pipeline" ;
    p1z:apqcId "20042" ;
    p1z:apqcHierarchyId "5.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking potential opportunities as they move through the various stages of the pipeline." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20043 a p1z:Process ;
    skos:prefLabel "Develop baseline forecasts" ;
    p1z:apqcId "20043" ;
    p1z:apqcHierarchyId "5.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the demand anticipated for the organization's services. Estimate future demand for services using historical data, analysis of the market environment, and external data." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20044 a p1z:Process ;
    skos:prefLabel "Collaborate with customers" ;
    p1z:apqcId "20044" ;
    p1z:apqcHierarchyId "5.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing a collaborative meeting in which to engage the customer to understand the scope of their needs and constructing solutions based on need and constraints." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20045 a p1z:Process ;
    skos:prefLabel "Develop consensus forecast" ;
    p1z:apqcId "20045" ;
    p1z:apqcHierarchyId "5.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Arriving at a consensus over the forecasted levels of demand for services by analyzing baseline forecasts and customer input." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20046 a p1z:Process ;
    skos:prefLabel "Determine availability of skills to deliver on current and forecast customer orders" ;
    p1z:apqcId "20046" ;
    p1z:apqcHierarchyId "5.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying what skillset is necessary for the delivery of opportunities. Determine the forecast of customer orders based upon those skillsets and the resources available." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20047 a p1z:Process ;
    skos:prefLabel "Monitor activity against forecast and revise forecast" ;
    p1z:apqcId "20047" ;
    p1z:apqcHierarchyId "5.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing all activities necessary to deliver services to customer. Revise forecast to account for any issues that may arise. This could be changes in market trend, resource changes, etc." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20048 a p1z:Process ;
    skos:prefLabel "Evaluate and revise forecasting approach" ;
    p1z:apqcId "20048" ;
    p1z:apqcHierarchyId "5.2.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing potential problems in the current forecast and making the necessary changes to align the forecast meet demand." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20049 a p1z:Process ;
    skos:prefLabel "Measure forecast accuracy" ;
    p1z:apqcId "20049" ;
    p1z:apqcHierarchyId "5.2.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing forecasting against actuals to determine accuracy. Modify forecasting to align with actual need." ;
    p1z:parentProcess apqc:PCF20041 .

apqc:PCF20050 a p1z:Process ;
    skos:prefLabel "Create and manage resource plan" ;
    p1z:apqcId "20050" ;
    p1z:apqcHierarchyId "5.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the need for and creating a resource plan. Understand resource demand and align with capacity, skills, and capabilities. Enlist suppliers and partners to supplement needed skills and capabilities. Monitor and manage capabilities and skills with an eye on critical resources and supplier capacity." ;
    p1z:parentProcess apqc:PCF20040 .

apqc:PCF20051 a p1z:Process ;
    skos:prefLabel "Define and manage skills taxonomy" ;
    p1z:apqcId "20051" ;
    p1z:apqcHierarchyId "5.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the skills needed to perform services to be delivered. Classify and organize these skills requirements." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF20052 a p1z:Process ;
    skos:prefLabel "Create resource plan" ;
    p1z:apqcId "20052" ;
    p1z:apqcHierarchyId "5.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan to ensure that all resources are available to carry out services required for the customer. This can include physical resources and personnel." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF20053 a p1z:Process ;
    skos:prefLabel "Match resource demand with capacity, skills, and capabilities" ;
    p1z:apqcId "20053" ;
    p1z:apqcHierarchyId "5.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Matching demand with skills and capability. Enlisting suppliers and partners to help with demand when needed." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF20054 a p1z:Process ;
    skos:prefLabel "Collaborate with suppliers and partners to supplement skills and capabilities" ;
    p1z:apqcId "20054" ;
    p1z:apqcHierarchyId "5.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding organizational need to enlist suppliers to provide resources for gaps in skills and capabilities. Identify where additional skills are needed and collaborate with third parties to fill those demands." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF20055 a p1z:Process ;
    skos:prefLabel "Identify critical resources and supplier capacity" ;
    p1z:apqcId "20055" ;
    p1z:apqcHierarchyId "5.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Realizing critical resources required to perform and carry out customer needs. Engage with suppliers to fulfill those needs, if necessary. Identify supplier threshold for performing those needs." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF20056 a p1z:Process ;
    skos:prefLabel "Monitor and manage resource capacity and availability" ;
    p1z:apqcId "20056" ;
    p1z:apqcHierarchyId "5.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Directing and managing workforce needs. Ensure that resources are at full capacity. Monitor that all resources are able to skilled in their respective rolls. Make sure that necessary resources are available to provide the needed services." ;
    p1z:parentProcess apqc:PCF20050 .

apqc:PCF12127 a p1z:Process ;
    skos:prefLabel "Enable service delivery resources" ;
    p1z:apqcId "12127" ;
    p1z:apqcHierarchyId "5.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Instituting training to enable resources to provide service delivery to the customer. Develop a training plan. Create materials that provide for operation and technical training. Schedule, perform, and evaluate training." ;
    p1z:parentProcess apqc:PCF20040 .

apqc:PCF12128 a p1z:Process ;
    skos:prefLabel "Develop service delivery training plan" ;
    p1z:apqcId "12128" ;
    p1z:apqcHierarchyId "5.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF12129 a p1z:Process ;
    skos:prefLabel "Develop training materials" ;
    p1z:apqcId "12129" ;
    p1z:apqcHierarchyId "5.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing materials necessary to provide comprehensive training for the skills or behavior needed to deliver services. This can be any number for formats such as classroom or computer based training." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF12131 a p1z:Process ;
    skos:prefLabel "Manage training schedule" ;
    p1z:apqcId "12131" ;
    p1z:apqcHierarchyId "5.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing training to the employee within a manageable timeframe to meet the needs of both the individual and the organization." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF12132 a p1z:Process ;
    skos:prefLabel "Deliver operations training" ;
    p1z:apqcId "12132" ;
    p1z:apqcHierarchyId "5.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Educating service delivery personnel on all aspects of the operations process of the organization." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF12133 a p1z:Process ;
    skos:prefLabel "Deliver technical training" ;
    p1z:apqcId "12133" ;
    p1z:apqcHierarchyId "5.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that all personnel are trained on all technical aspects of service delivery to include compliance with constraints on how advanced technologies including artificial intelligence (AI) are used." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF20057 a p1z:Process ;
    skos:prefLabel "Perform skill and capability testing" ;
    p1z:apqcId "20057" ;
    p1z:apqcHierarchyId "5.2.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Verifying that training provided to the person was successful through the administration testing and the application of skills for practical use." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF12135 a p1z:Process ;
    skos:prefLabel "Evaluate training effectiveness" ;
    p1z:apqcId "12135" ;
    p1z:apqcHierarchyId "5.2.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Eliciting feedback from various sources to evaluate the training provided. This can be achieved through testing and the practical application of skills. Additionally, manager or student feedback can be garnered to evaluate training effectiveness." ;
    p1z:parentProcess apqc:PCF12127 .

apqc:PCF21634 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage and Operate Service Delivery System" ;
    p1z:apqcId "21634" ;
    p1z:apqcHierarchyId "5.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing and operating the systems, resources, and processes used to deliver services to customers, including planning, startup, ongoing operations, and service assurance." ;
    p1z:parentProcess apqc:PCF20025 .

apqc:PCF21635 a p1z:Process ;
    skos:prefLabel "Perform service delivery system planning" ;
    p1z:apqcId "21635" ;
    p1z:apqcHierarchyId "5.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning the service delivery system by defining service requirements, capacity, resources, and delivery approaches needed to support effective and reliable service provision." ;
    p1z:parentProcess apqc:PCF21634 .

apqc:PCF21636 a p1z:Process ;
    skos:prefLabel "Perform service delivery system startup" ;
    p1z:apqcId "21636" ;
    p1z:apqcHierarchyId "5.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and activating the service delivery system, including preparing resources, processes, and controls required to begin delivering services." ;
    p1z:parentProcess apqc:PCF21634 .

apqc:PCF21637 a p1z:Process ;
    skos:prefLabel "Operate service delivery system" ;
    p1z:apqcId "21637" ;
    p1z:apqcHierarchyId "5.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing day-to-day service delivery activities using the established service delivery system to meet service commitments, performance expectations, and customer needs." ;
    p1z:parentProcess apqc:PCF21634 .

apqc:PCF21638 a p1z:Process ;
    skos:prefLabel "Assure service delivery system service" ;
    p1z:apqcId "21638" ;
    p1z:apqcHierarchyId "5.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring and assuring service delivery system performance to maintain service quality, reliability, and compliance with defined service standards and expectations." ;
    p1z:parentProcess apqc:PCF21634 .

apqc:PCF20058 a p1z:FunctionalDomain ;
    skos:prefLabel "Deliver service to customer" ;
    p1z:apqcId "20058" ;
    p1z:apqcHierarchyId "5.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Rendering service to the customer by initiating, executing, and completing tasks associated with service delivery." ;
    p1z:parentProcess apqc:PCF20025 .

apqc:PCF20059 a p1z:Process ;
    skos:prefLabel "Initiate service delivery" ;
    p1z:apqcId "20059" ;
    p1z:apqcHierarchyId "5.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Collaborating with the customer to understand service needs. Review, understand, and modify the delivery scope with the organization needs of the customer in mind. Confirm readiness and identify, select, and assign resources. Plan for service delivery." ;
    p1z:parentProcess apqc:PCF20058 .

apqc:PCF20060 a p1z:Process ;
    skos:prefLabel "Review contract and agreed terms" ;
    p1z:apqcId "20060" ;
    p1z:apqcHierarchyId "5.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Meeting with the customer, partner, and/or supplier to review the terms of the solutions contract and agree on the terms set forth." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20061 a p1z:Process ;
    skos:prefLabel "Understand customer requirements and define refine approach" ;
    p1z:apqcId "20061" ;
    p1z:apqcHierarchyId "5.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Taking the customer requirements for a solution and applying those requirements to a refined approach for service." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20062 a p1z:Process ;
    skos:prefLabel "Modify/revise and approve project plan" ;
    p1z:apqcId "20062" ;
    p1z:apqcHierarchyId "5.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Updating the project plan to align with the new solution approach agreed upon with the customer." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20063 a p1z:Process ;
    skos:prefLabel "Review customer business objectives" ;
    p1z:apqcId "20063" ;
    p1z:apqcHierarchyId "5.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning the customer business objectives with the agreed service delivery solution." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20064 a p1z:Process ;
    skos:prefLabel "Confirm environmental readiness" ;
    p1z:apqcId "20064" ;
    p1z:apqcHierarchyId "5.4.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Confirming that the organization has the recourses necessary to meet the expectations for the solution for service delivery." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20065 a p1z:Process ;
    skos:prefLabel "Identify, select, and assign resources" ;
    p1z:apqcId "20065" ;
    p1z:apqcHierarchyId "5.4.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, selecting, and assigning resources required to deliver service to the customer. Ensure that all objectives are established and met, and the all rules of engagement have been identified and communicated." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20068 a p1z:Process ;
    skos:prefLabel "Plan for service delivery" ;
    p1z:apqcId "20068" ;
    p1z:apqcHierarchyId "5.4.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a plan of action to successfully render a solution for service delivery." ;
    p1z:parentProcess apqc:PCF20059 .

apqc:PCF20069 a p1z:Process ;
    skos:prefLabel "Execute service delivery" ;
    p1z:apqcId "20069" ;
    p1z:apqcHierarchyId "5.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Carrying out service delivery to the customer by creating and deploying the necessary solution. Analyze need and create a solution. Validate the solution and make changes if needed. Obtain approval to build/buy solution and then deploy solution to customer." ;
    p1z:parentProcess apqc:PCF20058 .

apqc:PCF20070 a p1z:Process ;
    skos:prefLabel "Analyze environment and customer needs" ;
    p1z:apqcId "20070" ;
    p1z:apqcHierarchyId "5.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the needs of the customer and providing the necessary resources to meet those requirements within the scope of the organization." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20071 a p1z:Process ;
    skos:prefLabel "Define solution" ;
    p1z:apqcId "20071" ;
    p1z:apqcHierarchyId "5.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan of action to provide service delivery to the customer through a possible solution. This solution should be in response to a collaborative effort made by the organization and the customer to meet service delivery needs." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20072 a p1z:Process ;
    skos:prefLabel "Validate solution" ;
    p1z:apqcId "20072" ;
    p1z:apqcHierarchyId "5.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating that the proposed solution is feasible and provides the needed services for the customer." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20073 a p1z:Process ;
    skos:prefLabel "Identify changes" ;
    p1z:apqcId "20073" ;
    p1z:apqcHierarchyId "5.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Realizing issues within the original drafted solution and providing changes to correct those issues." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20074 a p1z:Process ;
    skos:prefLabel "Obtain approval to proceed" ;
    p1z:apqcId "20074" ;
    p1z:apqcHierarchyId "5.4.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gaining approval from all avenues to proceed with providing solutions for service delivery." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20075 a p1z:Process ;
    skos:prefLabel "Make build/buy solution" ;
    p1z:apqcId "20075" ;
    p1z:apqcHierarchyId "5.4.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Constructing or purchasing solutions necessary to provide service delivery." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20076 a p1z:Process ;
    skos:prefLabel "Deploy solution" ;
    p1z:apqcId "20076" ;
    p1z:apqcHierarchyId "5.4.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing the customer with promised services and solutions." ;
    p1z:parentProcess apqc:PCF20069 .

apqc:PCF20077 a p1z:Process ;
    skos:prefLabel "Complete service delivery" ;
    p1z:apqcId "20077" ;
    p1z:apqcHierarchyId "5.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Implementing final steps to complete service delivery to the customer. Evaluate success through project review, complete finance activities, and confirm delivery. Release resources and manage completion by harvesting knowledge and systems by archiving records." ;
    p1z:parentProcess apqc:PCF20058 .

apqc:PCF20078 a p1z:Process ;
    skos:prefLabel "Conduct service delivery/project review and evaluate success" ;
    p1z:apqcId "20078" ;
    p1z:apqcHierarchyId "5.4.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing the entire service delivery process to evaluate the success of the project from beginning to end." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20079 a p1z:Process ;
    skos:prefLabel "Complete/finalize financial management activities" ;
    p1z:apqcId "20079" ;
    p1z:apqcHierarchyId "5.4.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Insuring all payments are received and all activates therein are completed." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20080 a p1z:Process ;
    skos:prefLabel "Confirm delivery according to contract terms" ;
    p1z:apqcId "20080" ;
    p1z:apqcHierarchyId "5.4.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Confirming that the organization has satisfied all terms of the delivery contract set forth in collaboration between the organization and customer." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20081 a p1z:Process ;
    skos:prefLabel "Release resources" ;
    p1z:apqcId "20081" ;
    p1z:apqcHierarchyId "5.4.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Discharging leveraged resources from service delivery commitments upon completion. Returning resources to the resource pool." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20082 a p1z:Process ;
    skos:prefLabel "Manage service delivery completion" ;
    p1z:apqcId "20082" ;
    p1z:apqcHierarchyId "5.4.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that all aspects of the service delivery process are completed both internally and externally." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20083 a p1z:Process ;
    skos:prefLabel "Harvest knowledge" ;
    p1z:apqcId "20083" ;
    p1z:apqcHierarchyId "5.4.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Garnering feedback from all avenues to collect a knowledge base concerning services rendered." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20084 a p1z:Process ;
    skos:prefLabel "Archive records and update systems" ;
    p1z:apqcId "20084" ;
    p1z:apqcHierarchyId "5.4.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Completing and archiving all records associated with requested services. Update all necessary systems to reflect those changes." ;
    p1z:parentProcess apqc:PCF20077 .

apqc:PCF20085 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Customer Service" ;
    p1z:apqcId "20085" ;
    p1z:apqcHierarchyId "6.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing interactions with current customers after the delivery of products and services. This includes developing and planning customer service practices with a focus on handling inquiries after sales, feedback, warranties, recalls, and other related processes." .

apqc:PCF10378 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop customer service strategy" ;
    p1z:apqcId "10378" ;
    p1z:apqcHierarchyId "6.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Defining a plan that removes customer obstacles by gathering operational insight and competitive insight, as well as improving soft skills and forward resolution for employees. Develop customer segmentation. Define rules and regulations for customer service. Establish service levels for customers." ;
    p1z:parentProcess apqc:PCF20085 .

apqc:PCF20086 a p1z:Process ;
    skos:prefLabel "Define customer service requirements across the enterprise" ;
    p1z:apqcId "20086" ;
    p1z:apqcHierarchyId "6.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the customer service requirements across the organization, including the needs and expectations of different customer segments. Additionally this includes defining a set of behaviors, skills, and policies needed to provide customer service effectively across the enterprise." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF20087 a p1z:Process ;
    skos:prefLabel "Define customer service experience" ;
    p1z:apqcId "20087" ;
    p1z:apqcHierarchyId "6.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Communicating how customer service interactions are handled including what is expected when engaging the customer. Relate service level expectations to the workforce. Ensure positive customer experience." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF20088 a p1z:Process ;
    skos:prefLabel "Define and manage customer service channel strategy" ;
    p1z:apqcId "20088" ;
    p1z:apqcHierarchyId "6.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Define the channels and communication methods that will be used to deliver customer service, including phone, email, chat, social media, and in-person interactions." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF10382 a p1z:Process ;
    skos:prefLabel "Define customer service policies and procedures" ;
    p1z:apqcId "10382" ;
    p1z:apqcHierarchyId "6.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop policies and procedures for delivering customer service, including handling customer complaints, resolving issues, and maintaining customer records." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF10383 a p1z:Process ;
    skos:prefLabel "Establish target service level for each customer segment" ;
    p1z:apqcId "10383" ;
    p1z:apqcHierarchyId "6.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining and implementing levels for customer services. Benchmark certain customer service practices, and base customer level services on those benchmarks. Create a service level agreement, which is an agreement designed to create a common understanding about services, priorities, and responsibilities." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF21707 a p1z:Process ;
    skos:prefLabel "Identify and define customer service strategy integrations" ;
    p1z:apqcId "21707" ;
    p1z:apqcHierarchyId "6.1.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Define how the customer service strategy will integrate with other departments like marketing, sales, and product development to ensure a seamless customer experience." ;
    p1z:parentProcess apqc:PCF10378 .

apqc:PCF10379 a p1z:FunctionalDomain ;
    skos:prefLabel "Plan and manage customer service contacts" ;
    p1z:apqcId "10379" ;
    p1z:apqcHierarchyId "6.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Planning and administering workforce operations for customer service provision by taking care of customer services requests/inquiries, as well as the complaints." ;
    p1z:parentProcess apqc:PCF20085 .

apqc:PCF10387 a p1z:Process ;
    skos:prefLabel "Plan and manage customer service workforce" ;
    p1z:apqcId "10387" ;
    p1z:apqcHierarchyId "6.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and administering the workforce deployed for the customer service process. Forecast the customer workforce needs to correctly schedule the workforce. Track the utility of the workforce deployed. Examine the interactions between the customer and customer service representatives to achieve high quality." ;
    p1z:parentProcess apqc:PCF10379 .

apqc:PCF10390 a p1z:Process ;
    skos:prefLabel "Forecast volume of customer service contacts" ;
    p1z:apqcId "10390" ;
    p1z:apqcHierarchyId "6.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Projecting the total workforce required to service customer service inquiries in order to effectively predict the volume of vendor contracts required. Estimate the number of the customer service contracts in an agreed-upon time frame in order to strategically maintain the workforce necessitated for customer inquires. Analyze historical data around customer service contracts, the universe of customer inquiries, frequency of inquiries, servicing capability (per head) of the employees, etc." ;
    p1z:parentProcess apqc:PCF10387 .

apqc:PCF10391 a p1z:Process ;
    skos:prefLabel "Schedule customer service workforce" ;
    p1z:apqcId "10391" ;
    p1z:apqcHierarchyId "6.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deploying the workforce to manage customer service contracts. Create a systematic summary of the operations and service required, as well as the specific amount of workforce that is to be deployed to the customer service operations. Ensure workforce is directly proportional to the estimated forecast of customer service contracts." ;
    p1z:parentProcess apqc:PCF10387 .

apqc:PCF10392 a p1z:Process ;
    skos:prefLabel "Track workforce utilization" ;
    p1z:apqcId "10392" ;
    p1z:apqcHierarchyId "6.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking the utilization of workforce deployed for managing customer service operations. Monitor the utility of the workforce deployed for managing customer service operations in order to evaluate its efficiency and cost effectiveness. Calculate the overall labor effectiveness, which measures the utility, performance, and quality of the workforce." ;
    p1z:parentProcess apqc:PCF10387 .

apqc:PCF10393 a p1z:Process ;
    skos:prefLabel "Monitor and evaluate quality of customer interactions with customer service representatives" ;
    p1z:apqcId "10393" ;
    p1z:apqcHierarchyId "6.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking and determining the quality of interactions between the customer and customer representatives. Use technology, including artificial intelligence (AI), to record and effectively assess customer representatives' interactions." ;
    p1z:parentProcess apqc:PCF10387 .

apqc:PCF10388 a p1z:Process ;
    skos:prefLabel "Manage customer service problems, requests, and inquiries" ;
    p1z:apqcId "10388" ;
    p1z:apqcHierarchyId "6.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Handling the requests and inquiries from customers that seek information regarding the organization's products/services. Obtain the customer requests online and by phone. Direct these requests to higher-level representatives. Approve requests, and respond to customers." ;
    p1z:parentProcess apqc:PCF10379 .

apqc:PCF10394 a p1z:Process ;
    skos:prefLabel "Receive customer problems, requests, and inquiries" ;
    p1z:apqcId "10394" ;
    p1z:apqcHierarchyId "6.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Receiving requests for information from customers over multiple channels. Receive various requests and inquiries from customers regarding products/services. Accept these inquiries through channels such as email, telephone, online forms, text messages, social media, and in person. Supply dedicated equipment, systems, and personnel." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF13482 a p1z:Process ;
    skos:prefLabel "Analyze problems, requests, and inquiries" ;
    p1z:apqcId "13482" ;
    p1z:apqcHierarchyId "6.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing various requests and inquiries from customers regarding products/services. Provide answers and offerings to satisfy the customer's needs." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF10395 a p1z:Process ;
    skos:prefLabel "Resolve customer problems, requests, and inquiries" ;
    p1z:apqcId "10395" ;
    p1z:apqcHierarchyId "6.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Routing customer inquiries in order to service them with the most apposite response. Direct customer inquires to the best suited personnel or system. Have a system or procedure capable of efficiently channeling these requests." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF10396 a p1z:Process ;
    skos:prefLabel "Respond to customer problems, requests, and inquiries" ;
    p1z:apqcId "10396" ;
    p1z:apqcHierarchyId "6.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Responding to customer requests by email, conversation, interactive voice response, mail, etc. with the most appropriate reply. Instill a robust process to locate the right information for a solution to a customer's problem." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF16928 a p1z:Process ;
    skos:prefLabel "Identify and capture upsell/cross-sell opportunities" ;
    p1z:apqcId "16928" ;
    p1z:apqcHierarchyId "6.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Utilizing customer inquiries as opportunities to either provide a comparable service to the one in question, offer additional complimentary service, or suggest a service that is better than what was initially offered." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF16937 a p1z:Process ;
    skos:prefLabel "Deliver opportunity to sales team" ;
    p1z:apqcId "16937" ;
    p1z:apqcHierarchyId "6.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing possible sales leads to the sales team in an effort to garner more business opportunities." ;
    p1z:parentProcess apqc:PCF10388 .

apqc:PCF10389 a p1z:Process ;
    skos:prefLabel "Manage customer complaints" ;
    p1z:apqcId "10389" ;
    p1z:apqcHierarchyId "6.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Obtaining customer complaints online or by phone. Direct these complaints to higher-level representatives as appropriate. Resolve them. Respond to customers." ;
    p1z:parentProcess apqc:PCF10379 .

apqc:PCF10397 a p1z:Process ;
    skos:prefLabel "Receive customer complaints" ;
    p1z:apqcId "10397" ;
    p1z:apqcHierarchyId "6.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Receiving any complaints or grievances from customers for the organization's products/services. Receive objections, complaints, and criticism from customers regarding products/services through email, telephone, online forms, text messages, social media, in person, etc. Dedicate equipment, systems, and personnel." ;
    p1z:parentProcess apqc:PCF10389 .

apqc:PCF10398 a p1z:Process ;
    skos:prefLabel "Route customer complaints" ;
    p1z:apqcId "10398" ;
    p1z:apqcHierarchyId "6.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Routing any complaints or grievances received from customers in order to address them in the most appropriate manner. Direct complaints to the best suited personnel or system. Implement a system or procedure capable of efficiently channeling the various objections, complaints, and criticism from customers over the offerings provided by the organization." ;
    p1z:parentProcess apqc:PCF10389 .

apqc:PCF10399 a p1z:Process ;
    skos:prefLabel "Resolve customer complaints" ;
    p1z:apqcId "10399" ;
    p1z:apqcHierarchyId "6.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Resolving any customer complaints that are deemed to be sound and reasonable. Redress any objections, grievances, and complaints received from customers regarding the offerings provided by the organization. Identify the legitimate complaints, where the situation needs to be appropriately corrected. Deploy personnel who can rectify the issue within a stipulated time frame." ;
    p1z:parentProcess apqc:PCF10389 .

apqc:PCF10400 a p1z:Process ;
    skos:prefLabel "Respond to customer complaints" ;
    p1z:apqcId "10400" ;
    p1z:apqcHierarchyId "6.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Responding to customer complaints including all activities necessitated to service any objections, complaints, or grievances with the most appropriate reply. Source the right information to formulate a response that eases the discomfort being experienced by the customer. (Closely coordinate with Resolve customer complaints [10399].)" ;
    p1z:parentProcess apqc:PCF10389 .

apqc:PCF19072 a p1z:Process ;
    skos:prefLabel "Analyze customer complaints and response/redressal" ;
    p1z:apqcId "19072" ;
    p1z:apqcHierarchyId "6.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing complaint logs to provide input for continuous service improvement and customer profiling." ;
    p1z:parentProcess apqc:PCF10389 .

apqc:PCF20094 a p1z:Process ;
    skos:prefLabel "Process returns" ;
    p1z:apqcId "20094" ;
    p1z:apqcHierarchyId "6.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Acquiring returns and identify if the returns are scraped or salvaged." ;
    p1z:parentProcess apqc:PCF10379 .

apqc:PCF10364 a p1z:Process ;
    skos:prefLabel "Authorize return" ;
    p1z:apqcId "10364" ;
    p1z:apqcHierarchyId "6.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Approving and carrying forward the requests by the customers to return the product. This is part of the process of returning a product in order to receive a refund, replacement, or repair during the product's warranty period." ;
    p1z:parentProcess apqc:PCF20094 .

apqc:PCF20095 a p1z:Process ;
    skos:prefLabel "Process return and record reason" ;
    p1z:apqcId "20095" ;
    p1z:apqcHierarchyId "6.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Notating the reason for the return of the product." ;
    p1z:parentProcess apqc:PCF20094 .

apqc:PCF12840 a p1z:Process ;
    skos:prefLabel "Report incidents and risks to regulatory bodies" ;
    p1z:apqcId "12840" ;
    p1z:apqcHierarchyId "6.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Notifying all stakeholders, legal, and industry regulatory bodies of the incidents and risks related to a return or recall, if needed." ;
    p1z:parentProcess apqc:PCF10379 .

apqc:PCF12658 a p1z:FunctionalDomain ;
    skos:prefLabel "Service products after sales" ;
    p1z:apqcId "12658" ;
    p1z:apqcHierarchyId "6.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Assigning post-sales policies and paying claims on purchased products.  This is a process that is an administrative function focused on creating rules (claim codes). This group ensures that claims are valid and are processed quickly.  As well as to quickly determine responsibility for claim settlement." ;
    p1z:parentProcess apqc:PCF20085 .

apqc:PCF20605 a p1z:Process ;
    skos:prefLabel "Register products" ;
    p1z:apqcId "20605" ;
    p1z:apqcHierarchyId "6.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Filing product registrations." ;
    p1z:parentProcess apqc:PCF12658 .

apqc:PCF12669 a p1z:Process ;
    skos:prefLabel "Process warranty claims" ;
    p1z:apqcId "12669" ;
    p1z:apqcHierarchyId "6.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Identifying, investigating, and processes warranty claims. This process includes: receipt and validation of a warranty claim; definition and diagnosis /root cause analysis of an issue and recommendation for corrective action; the determination of responsibility for settlement of the claim; the transaction being approved or denied; and the originator being notified and payment authorized. In the case of a recurring event, further investigation (definition and diagnosis or root cause analysis) is performed, and a recommendation for corrective action is made and implemented in production/design. It ends when the claim is closed." ;
    p1z:parentProcess apqc:PCF12658 .

apqc:PCF20096 a p1z:Process ;
    skos:prefLabel "Receive warranty claim" ;
    p1z:apqcId "20096" ;
    p1z:apqcHierarchyId "6.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Receiving incoming warranty claims. Route claim to correct department. Document claim." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF12671 a p1z:Process ;
    skos:prefLabel "Validate warranty claim" ;
    p1z:apqcId "12671" ;
    p1z:apqcHierarchyId "6.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that the claim falls within the parameters of the warranty in question. After validation is made, the claim must be investigated." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20097 a p1z:Process ;
    skos:prefLabel "Investigate warranty issues" ;
    p1z:apqcId "20097" ;
    p1z:apqcHierarchyId "6.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing investigational and analysis of warranty claims. This involves notification and definition of a warranty issue, includes the scheduling of a field service agent to perform further investigation; the request and receipt of defective parts; and diagnosis/root cause analysis. This concludes with the receipt of the result and recommendation for corrective action." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20101 a p1z:Process ;
    skos:prefLabel "Determine responsible party" ;
    p1z:apqcId "20101" ;
    p1z:apqcHierarchyId "6.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying responsible party for a claim. There is no negotiation with the supplier at this point. There can be multiple warranties applicable to the same part: a new part warranty, a new product warranty (for the product the part is installed on), and a supplier warranty from the company that last repaired the part. The information required for this decision would be the output of Receive component/part and analyze fault [19728].\"" ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20102 a p1z:Process ;
    skos:prefLabel "Manage pre-authorizations" ;
    p1z:apqcId "20102" ;
    p1z:apqcHierarchyId "6.3.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Authorizing claims prior to submittal." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF12668 a p1z:Process ;
    skos:prefLabel "Approve or reject warranty claim" ;
    p1z:apqcId "12668" ;
    p1z:apqcHierarchyId "6.3.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Following Defining issue [20098], an approval or rejection with be made against the warranty claim. If it is deemed that the claim falls within the warranty parameters, the claim will be approved. If the claim is deemed to fall outside warranty parameters, the claim with be rejected." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20103 a p1z:Process ;
    skos:prefLabel "Notify originator of approve/reject decision" ;
    p1z:apqcId "20103" ;
    p1z:apqcHierarchyId "6.3.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Contacting the originator of whether the warranty claim has been approved or rejected." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20104 a p1z:Process ;
    skos:prefLabel "Authorize payment" ;
    p1z:apqcId "20104" ;
    p1z:apqcHierarchyId "6.3.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Allowing for a payment to be made to the claimant." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20105 a p1z:Process ;
    skos:prefLabel "Close claim" ;
    p1z:apqcId "20105" ;
    p1z:apqcHierarchyId "6.3.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Archiving and closing the warranty claim after a final decision has been made to either approve or reject." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF12667 a p1z:Process ;
    skos:prefLabel "Reconcile warranty transaction disposition" ;
    p1z:apqcId "12667" ;
    p1z:apqcHierarchyId "6.3.2.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assuring that the warranty transaction has been completed." ;
    p1z:parentProcess apqc:PCF12669 .

apqc:PCF20106 a p1z:Process ;
    skos:prefLabel "Manage supplier recovery" ;
    p1z:apqcId "20106" ;
    p1z:apqcHierarchyId "6.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the recovery of costs from suppliers for individual claims." ;
    p1z:parentProcess apqc:PCF12658 .

apqc:PCF20107 a p1z:Process ;
    skos:prefLabel "Create supplier recovery claims" ;
    p1z:apqcId "20107" ;
    p1z:apqcHierarchyId "6.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Raising a supplier recovery claim. This is based off the decision made in Receive investigation result/recommendation for corrective action [20100]." ;
    p1z:parentProcess apqc:PCF20106 .

apqc:PCF20108 a p1z:Process ;
    skos:prefLabel "Negotiate recoveries with suppliers" ;
    p1z:apqcId "20108" ;
    p1z:apqcHierarchyId "6.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Arranging the returns of recalled products to suppliers." ;
    p1z:parentProcess apqc:PCF20106 .

apqc:PCF10218 a p1z:Process ;
    skos:prefLabel "Service products" ;
    p1z:apqcId "10218" ;
    p1z:apqcHierarchyId "6.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Validating specific service requirements for individual customers. Determine and schedule resource to fulfill these requirements. Provide service to specific individual customers. Ensure the quality of service delivery." ;
    p1z:parentProcess apqc:PCF12658 .

apqc:PCF10320 a p1z:Process ;
    skos:prefLabel "Confirm specific service requirements for individual customer" ;
    p1z:apqcId "10320" ;
    p1z:apqcHierarchyId "6.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Acquiring or soliciting information about specific service requirements for individual customers through the customer service function. Obtain information about customer specific requests, process these requests, and create customer profiles to generate a service order." ;
    p1z:parentProcess apqc:PCF10218 .

apqc:PCF10321 a p1z:Process ;
    skos:prefLabel "Identify and schedule resources to meet service requirements" ;
    p1z:apqcId "10321" ;
    p1z:apqcHierarchyId "6.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and scheduling the resources required to fulfill customer service requirements. Create a detailed schedule about the service orders and development of these service orders." ;
    p1z:parentProcess apqc:PCF10218 .

apqc:PCF10322 a p1z:Process ;
    skos:prefLabel "Provide service to specific customers" ;
    p1z:apqcId "10322" ;
    p1z:apqcHierarchyId "6.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Dispatching resources for managing and fulfilling daily service requirements. Manage the progress of order fulfillment. Complete order blocks." ;
    p1z:parentProcess apqc:PCF10218 .

apqc:PCF10323 a p1z:Process ;
    skos:prefLabel "Ensure quality of service" ;
    p1z:apqcId "10323" ;
    p1z:apqcHierarchyId "6.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Guaranteeing the quality of service provided to customers. Identify the successful and unsuccessful orders along with the service failures. Collect customer feedback. Process the feedback to ensure the quality of service in the future." ;
    p1z:parentProcess apqc:PCF10218 .

apqc:PCF20110 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage product recalls and regulatory audits" ;
    p1z:apqcId "20110" ;
    p1z:apqcHierarchyId "6.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Removing defective products from the distribution chain. Participate in audits from watchdog agencies." ;
    p1z:parentProcess apqc:PCF20085 .

apqc:PCF20111 a p1z:Process ;
    skos:prefLabel "Initiate recall" ;
    p1z:apqcId "20111" ;
    p1z:apqcHierarchyId "6.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Commencing the removal process of defective products." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20112 a p1z:Process ;
    skos:prefLabel "Assess the likelihood and consequences of occurrence of any hazards" ;
    p1z:apqcId "20112" ;
    p1z:apqcHierarchyId "6.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing risk analysis. Identify all dangers, evaluate how probable they are, and what kinds of negative results or or adverse side effect they carry." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20113 a p1z:Process ;
    skos:prefLabel "Manage recall related communications" ;
    p1z:apqcId "20113" ;
    p1z:apqcHierarchyId "6.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling communications that are related to product recalls." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20114 a p1z:Process ;
    skos:prefLabel "Submit regulatory reports" ;
    p1z:apqcId "20114" ;
    p1z:apqcHierarchyId "6.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and delivering reports to regulatory agencies to provide details about handling product recalls." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20115 a p1z:Process ;
    skos:prefLabel "Monitor and audit recall effectiveness" ;
    p1z:apqcId "20115" ;
    p1z:apqcHierarchyId "6.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the effectiveness of product recalls." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20116 a p1z:Process ;
    skos:prefLabel "Manage recall termination" ;
    p1z:apqcId "20116" ;
    p1z:apqcHierarchyId "6.4.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Ending product recalls, communicating to the public and filing reports." ;
    p1z:parentProcess apqc:PCF20110 .

apqc:PCF20595 a p1z:FunctionalDomain ;
    skos:prefLabel "Evaluate customer service operations and customer satisfaction" ;
    p1z:apqcId "20595" ;
    p1z:apqcHierarchyId "6.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Calculating and assessing the operational activities of the customer service function. Evaluation is achieved through the customer requests/inquiries handling process, the customer complaint handling process, and product and services quality. Examine activities to ensure high levels of customer service." ;
    p1z:parentProcess apqc:PCF20085 .

apqc:PCF10401 a p1z:Process ;
    skos:prefLabel "Measure customer satisfaction with customer problems, requests, and inquiries handling" ;
    p1z:apqcId "10401" ;
    p1z:apqcHierarchyId "6.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating satisfaction levels of customers by effectively evaluating the process of handling requests/inquiries of customers. Effectively calculate the performance of customer-requests/inquiries handling and resolution. Obtain information regarding requests/inquiries handling and resolution through customer feedback. Use it to explore new ideas and opportunities for enhanced customer requests/inquiries handling and resolution process." ;
    p1z:parentProcess apqc:PCF20595 .

apqc:PCF11687 a p1z:Process ;
    skos:prefLabel "Solicit customer feedback on customer service experience" ;
    p1z:apqcId "11687" ;
    p1z:apqcHierarchyId "6.5.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an avenue for which the customer can provide feedback on their experience with how their inquiry, problem, or request was handled." ;
    p1z:parentProcess apqc:PCF10401 .

apqc:PCF11688 a p1z:Process ;
    skos:prefLabel "Analyze customer service data and identify improvement opportunities" ;
    p1z:apqcId "11688" ;
    p1z:apqcHierarchyId "6.5.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Reviewing customer service feedback to identify areas in which improvements can be made. Engage with management to discuss issues." ;
    p1z:parentProcess apqc:PCF10401 .

apqc:PCF18126 a p1z:Process ;
    skos:prefLabel "Provide customer feedback to product management on customer service experience" ;
    p1z:apqcId "18126" ;
    p1z:apqcHierarchyId "6.5.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Handing over data to management to analyze common issues in regards to customer service." ;
    p1z:parentProcess apqc:PCF10401 .

apqc:PCF10402 a p1z:Process ;
    skos:prefLabel "Measure customer satisfaction with customer- complaint handling and resolution" ;
    p1z:apqcId "10402" ;
    p1z:apqcHierarchyId "6.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Measuring the satisfaction level of customers as pertains to how their complaints are handled and resolved. This process element requires the organization to estimate the customers level of fulfillment with the process reconciling their complaints and towards the objective of ensuring customer retention. The feedback received can be used to develop concepts for new opportunities to boost the level of customer satisfaction." ;
    p1z:parentProcess apqc:PCF20595 .

apqc:PCF11236 a p1z:Process ;
    skos:prefLabel "Solicit customer feedback on complaint handling and resolution" ;
    p1z:apqcId "11236" ;
    p1z:apqcHierarchyId "6.5.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Requesting customer feedback on the process of handling and resolving customer complaints. Obtain information about the effectiveness and performance of the customer complaint handling process from the customers through various means (e.g., online and by phone)." ;
    p1z:parentProcess apqc:PCF10402 .

apqc:PCF11237 a p1z:Process ;
    skos:prefLabel "Analyze customer complaint data and identify improvement opportunities" ;
    p1z:apqcId "11237" ;
    p1z:apqcHierarchyId "6.5.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the information obtained through handling and resolving complaints for development/improvement opportunities. Categorize the customer complaints data on the basis of speed, accuracy, courtesy, price, product choice, availability, hours, location, etc. Determine complaint patterns in order to diagnose areas needing enhancement." ;
    p1z:parentProcess apqc:PCF10402 .

apqc:PCF11689 a p1z:Process ;
    skos:prefLabel "Identify common customer complaints" ;
    p1z:apqcId "11689" ;
    p1z:apqcHierarchyId "6.5.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining complaint patterns in order to identify common issues. Document common problems for correction." ;
    p1z:parentProcess apqc:PCF10402 .

apqc:PCF10403 a p1z:Process ;
    skos:prefLabel "Measure customer satisfaction with products and services" ;
    p1z:apqcId "10403" ;
    p1z:apqcHierarchyId "6.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Calculating satisfaction levels of customers with products/services. Obtain customer feedback on products/services, as well as the effectiveness of the advertising campaigns. Examine this information to reach meaningful conclusions, which could then be used to enhance the customer service operations." ;
    p1z:parentProcess apqc:PCF20595 .

apqc:PCF11238 a p1z:Process ;
    skos:prefLabel "Gather and solicit post-sale customer feedback on products and services" ;
    p1z:apqcId "11238" ;
    p1z:apqcHierarchyId "6.5.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining customer feedback/review on the quality and utility derived from the products/services after the sale is complete. Use techniques such as surveys, feedback boxes, and user activity and usability tests." ;
    p1z:parentProcess apqc:PCF10403 .

apqc:PCF11239 a p1z:Process ;
    skos:prefLabel "Solicit post-sale customer feedback on promotion effectiveness" ;
    p1z:apqcId "11239" ;
    p1z:apqcHierarchyId "6.5.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the influence of promotions on purchasing behavior. Use techniques such as surveys and product recognition tests, questionnaires or feedback flyers, and toll-free numbers in order to encourage customer interaction after the sale." ;
    p1z:parentProcess apqc:PCF10403 .

apqc:PCF20117 a p1z:Process ;
    skos:prefLabel "Solicit customer feedback on cross-channel experience" ;
    p1z:apqcId "20117" ;
    p1z:apqcHierarchyId "6.5.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Engaging with the customer to understand their cross-channel experience. Find out what channels were effective and what areas need improvement." ;
    p1z:parentProcess apqc:PCF10403 .

apqc:PCF11240 a p1z:Process ;
    skos:prefLabel "Analyze product and service satisfaction data and identify improvement opportunities" ;
    p1z:apqcId "11240" ;
    p1z:apqcHierarchyId "6.5.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the information collected on customer satisfaction levels with products/services in order to determine areas for improvement. Examine the data and information extracted from the customer feedback and reviews to measure the satisfaction levels of the customers. Identify opportunities that could enhance the customer satisfaction levels and the overall customer service strategy." ;
    p1z:parentProcess apqc:PCF10403 .

apqc:PCF11241 a p1z:Process ;
    skos:prefLabel "Provide feedback and insights to appropriate teams (product design/development, marketing, manufacturing)" ;
    p1z:apqcId "11241" ;
    p1z:apqcHierarchyId "6.5.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing feedback from customers on products/services to the product management team. Analyze information collected through Gather and solicit post-sale customer feedback on products/services [11238]. Share with the product management team for consideration while improving existing offerings or developing new products/services." ;
    p1z:parentProcess apqc:PCF10403 .

apqc:PCF12672 a p1z:Process ;
    skos:prefLabel "Evaluate and manage warranty performance" ;
    p1z:apqcId "12672" ;
    p1z:apqcHierarchyId "6.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing the cost and effectiveness of warranties." ;
    p1z:parentProcess apqc:PCF20595 .

apqc:PCF20118 a p1z:Process ;
    skos:prefLabel "Measure customer satisfaction with warranty handling and resolution" ;
    p1z:apqcId "20118" ;
    p1z:apqcHierarchyId "6.5.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating how satisfied customers are with how product warranties are managed and resolved." ;
    p1z:parentProcess apqc:PCF12672 .

apqc:PCF12676 a p1z:Process ;
    skos:prefLabel "Monitor and report on warranty management metrics" ;
    p1z:apqcId "12676" ;
    p1z:apqcHierarchyId "6.5.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Comparing warranties by using applicable metrics to see how they are handled and resolved. Develop and submit reports that summarize significant conclusions." ;
    p1z:parentProcess apqc:PCF12672 .

apqc:PCF20119 a p1z:Process ;
    skos:prefLabel "Identify improvement opportunities" ;
    p1z:apqcId "20119" ;
    p1z:apqcHierarchyId "6.5.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining how warranties and warranty management can be made better and more efficient." ;
    p1z:parentProcess apqc:PCF12672 .

apqc:PCF12674 a p1z:Process ;
    skos:prefLabel "Identify opportunities to eliminate warranty waste" ;
    p1z:apqcId "12674" ;
    p1z:apqcHierarchyId "6.5.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Finding ways to phase out unused or seldom used warranties." ;
    p1z:parentProcess apqc:PCF12672 .

apqc:PCF20120 a p1z:Process ;
    skos:prefLabel "Investigate fraudulent claims" ;
    p1z:apqcId "20120" ;
    p1z:apqcHierarchyId "6.5.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing and assessing claims that contain deliberately incorrect information or that have been submitted with the goal to deceive the system." ;
    p1z:parentProcess apqc:PCF12672 .

apqc:PCF20121 a p1z:Process ;
    skos:prefLabel "Evaluate recall performance" ;
    p1z:apqcId "20121" ;
    p1z:apqcHierarchyId "6.5.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing customer service feedback to identify areas in which improvements can be made. Engage with management to discuss issues." ;
    p1z:parentProcess apqc:PCF20595 .

apqc:PCF10007 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and Manage Human Resources" ;
    p1z:apqcId "10007" ;
    p1z:apqcHierarchyId "7.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Delivering processes traditionally defined as \"human resources\". Process groups include those related to developing and maintaining workforce strategy, recruiting employees, developing and counseling employees, managing employee relations, rewarding and retaining employees, redeploying and retiring employees, managing employee information, and managing employee communications." .

apqc:PCF17043 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage human resources (HR) planning, policies, and strategies" ;
    p1z:apqcId "17043" ;
    p1z:apqcHierarchyId "7.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies for the HR function. Create and implement strategies for managing the work force. Supervise and enhance the strategies, plans, and policies supporting the HR function. Developing models for managing competency levels of the HR of the organization." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF20958 a p1z:Process ;
    skos:prefLabel "Develop human resources strategy" ;
    p1z:apqcId "20958" ;
    p1z:apqcHierarchyId "7.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a long-term plan that strategically aligns human resources with the company's goals. The HR function's focus is to ensure the organization has the necessary talent and capabilities to achieve its objectives, sustain its competitive advantage, and reduce employee turnover." ;
    p1z:parentProcess apqc:PCF17043 .

apqc:PCF10418 a p1z:Process ;
    skos:prefLabel "Identify strategic HR needs" ;
    p1z:apqcId "10418" ;
    p1z:apqcHierarchyId "7.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Strategically defining the current and future needs for developing an efficient HR strategy." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF10419 a p1z:Process ;
    skos:prefLabel "Define HR and business function roles and accountability" ;
    p1z:apqcId "10419" ;
    p1z:apqcHierarchyId "7.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the charge and duty of the HR function by defining its responsibility areas, as well as ensuring its accountability. Establish the HR function by laying out the roles and responsibilities for this function and the rules and regulations guiding HR. Define the goals and objectives of the HR, as well as a mission and vision for this function. Create a mechanism involving a set of policies, code of conduct, and institutional procedure to ensure HR accountability." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF21430 a p1z:Process ;
    skos:prefLabel "Determine HR function roles and structure" ;
    p1z:apqcId "21430" ;
    p1z:apqcHierarchyId "7.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the roles that are required to execute the HR function.  This process also examines the organizational structure required to support the organization." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF21431 a p1z:Process ;
    skos:prefLabel "Determine HR delivery model" ;
    p1z:apqcId "21431" ;
    p1z:apqcHierarchyId "7.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining how an organization's human resources department offers services to and interacts with employees." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF10420 a p1z:Process ;
    skos:prefLabel "Determine HR costs" ;
    p1z:apqcId "10420" ;
    p1z:apqcHierarchyId "7.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ascertaining the costs and expenses of the HR function. Identify and report HR investments using, for example, a cost approach or a present value of future earnings approach." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF10421 a p1z:Process ;
    skos:prefLabel "Establish HR measures" ;
    p1z:apqcId "10421" ;
    p1z:apqcHierarchyId "7.1.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the performance of HR function. Lay out the course of HR procedures that would formulate a plan of action needed to fulfill strategic HR needs. Deploy measures such as hiring policies, leave management, internal code of conducts, and compensation structure." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF10422 a p1z:Process ;
    skos:prefLabel "Communicate HR strategies" ;
    p1z:apqcId "10422" ;
    p1z:apqcHierarchyId "7.1.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying the strategies of HR function to employees and management. Effectively explain the vision, plans, and anticipated benefits of the HR strategy to employees, as well as the public. Develop statements and messages that are easy to read, informative, and relevant to the audience." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF10432 a p1z:Process ;
    skos:prefLabel "Develop strategy for HR systems/technologies/tools" ;
    p1z:apqcId "10432" ;
    p1z:apqcHierarchyId "7.1.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a strategy for the use of systems/technologies/tools in operating the HR function. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Create a strategy concerning the use and utility of HR support tools and technologies. Decide what specific tools to use and in what quantity. Determine the levels of technology required for the HR management." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF20606 a p1z:Process ;
    skos:prefLabel "Manage employer branding" ;
    p1z:apqcId "20606" ;
    p1z:apqcHierarchyId "7.1.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating, maintaining and communicating company's reputation and values to keep current employees and attract potential hires." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF21639 a p1z:Process ;
    skos:prefLabel "Design the employee experience" ;
    p1z:apqcId "21639" ;
    p1z:apqcHierarchyId "7.1.1.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing the intended end-to-end employee experience across key moments in the employee lifecycle to support engagement, performance, retention, and alignment with organizational culture and workforce objectives." ;
    p1z:parentProcess apqc:PCF20958 .

apqc:PCF17045 a p1z:Process ;
    skos:prefLabel "Develop and implement workforce planning, policies, and strategies" ;
    p1z:apqcId "17045" ;
    p1z:apqcHierarchyId "7.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and executing strategies and policies for smooth administration of workforce. Determine and gather skill requirements. Plan the requirements for employee resourcing per unit. Create compensation, succession, HR program, and employee diversity plans. Develop and administer policies for HR. Develop benefits for employees. Create models for work force strategies." ;
    p1z:parentProcess apqc:PCF17043 .

apqc:PCF21693 a p1z:Process ;
    skos:prefLabel "Perform strategic workforce planning" ;
    p1z:apqcId "21693" ;
    p1z:apqcHierarchyId "7.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the current and future skill requirements of the organization with regard to the overall corporate strategy of the organization and market conditions. Identify and establish the minimum skills needed for the requisite HR needs." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10425 a p1z:Process ;
    skos:prefLabel "Develop total compensation and rewards strategy" ;
    p1z:apqcId "10425" ;
    p1z:apqcHierarchyId "7.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a plan that specifies the combination of wages, salaries, and benefits the employees receive in exchange for work. Define the total amount of compensation, in addition to the manner in which the compensation is paid and the purposes for which employees can receive bonuses, salary increases, incentives and non-monetary rewards." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10426 a p1z:Process ;
    skos:prefLabel "Develop succession plan" ;
    p1z:apqcId "10426" ;
    p1z:apqcHierarchyId "7.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and implementing the plan for continuation of key positions within the organization. Identify internal people with the potential to fill key business leadership positions. Provide critical development experiences to employees who can move into important roles. Engage leaders to support the development of high-potential leaders." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF16938 a p1z:Process ;
    skos:prefLabel "Develop high performers/leadership programs" ;
    p1z:apqcId "16938" ;
    p1z:apqcHierarchyId "7.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a program that incorporates incentives and compensation put forth by the organization to recognize high performing workers and excellence in leadership." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10427 a p1z:Process ;
    skos:prefLabel "Develop diversity, equity, and inclusion plan" ;
    p1z:apqcId "10427" ;
    p1z:apqcHierarchyId "7.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing the plan for ensuring a diverse work force. Develop and hire employees with varying characteristics including, but not limited to, religious and political beliefs, gender, ethnicity, education, socioeconomic background, sexual orientation, and geographic location." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF21433 a p1z:Process ;
    skos:prefLabel "Implement diversity, equity, and inclusion plan" ;
    p1z:apqcId "21433" ;
    p1z:apqcHierarchyId "7.1.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Execution of diversity, equity, and inclusion plans within an organization.  Often called a DEI plan." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF11623 a p1z:Process ;
    skos:prefLabel "Design talent acquisition program" ;
    p1z:apqcId "11623" ;
    p1z:apqcHierarchyId "7.1.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a program to entice prospective resources to engage with the organization for a position of employment." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF11622 a p1z:Process ;
    skos:prefLabel "Design talent development program" ;
    p1z:apqcId "11622" ;
    p1z:apqcHierarchyId "7.1.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying skills, knowledge, and attributes that need enhancement in order to perform a job. Develop the appropriate training programs. These programs can be computer-based, classroom, or on-the-job training, etc." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10428 a p1z:Process ;
    skos:prefLabel "Develop other HR programs" ;
    p1z:apqcId "10428" ;
    p1z:apqcHierarchyId "7.1.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating HR programs and services such as employee engagements programs to promote positive employee behavior. Create a variety of programs and services to support employees' professional and personal needs at work and at home." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10429 a p1z:Process ;
    skos:prefLabel "Develop HR policies" ;
    p1z:apqcId "10429" ;
    p1z:apqcHierarchyId "7.1.2.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating rules and regulations that govern the HR function. Develop a policy plan that serves as a guideline for setting rules and regulations that help in achieving the HR goals and objectives." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10430 a p1z:Process ;
    skos:prefLabel "Administer HR policies" ;
    p1z:apqcId "10430" ;
    p1z:apqcHierarchyId "7.1.2.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring rules and regulations are followed and are flexible enough to accommodate indispensable deviations." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10431 a p1z:Process ;
    skos:prefLabel "Plan employee benefits" ;
    p1z:apqcId "10431" ;
    p1z:apqcHierarchyId "7.1.2.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning benefits in kind (also called fringe benefits, perquisites, or perks). Include various types of non-wage compensations provided to employees in addition to normal wages or salaries." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10433 a p1z:Process ;
    skos:prefLabel "Develop workforce strategy models" ;
    p1z:apqcId "10433" ;
    p1z:apqcHierarchyId "7.1.2.13" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing models for effectively strategizing the work force of the organization. Develop a model that specifies the organization's overall approach for maximizing the performance of its work force by defining the goals, objectives, and expectations of the work force. Manage all aspects of performance required for the work force to function, including recruitment, selection, retention, and professional development." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF20122 a p1z:Process ;
    skos:prefLabel "Implement workforce strategy models" ;
    p1z:apqcId "20122" ;
    p1z:apqcHierarchyId "7.1.2.14" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing models for effectively strategizing the work force of the organization. Carry out all aspects of performance required for the work force to function, including recruitment, selection, retention, and professional development." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF21432 a p1z:Process ;
    skos:prefLabel "Manage job families" ;
    p1z:apqcId "21432" ;
    p1z:apqcHierarchyId "7.1.2.15" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing a group of similar individual or teams with similar education, skills, training, or experience." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10447 a p1z:Process ;
    skos:prefLabel "Develop and maintain job descriptions" ;
    p1z:apqcId "10447" ;
    p1z:apqcHierarchyId "7.1.2.16" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating descriptions for job requisitions. Define the normal components of a job description, such as the overall position description with general areas of responsibility listed, essential functions of the job described with a couple of examples of each, required knowledge, skills, abilities, required education and experience, a description of the physical demands, and a description of the work environment." ;
    p1z:parentProcess apqc:PCF17045 .

apqc:PCF10417 a p1z:Process ;
    skos:prefLabel "Monitor and update HR strategies, plans, and policies" ;
    p1z:apqcId "10417" ;
    p1z:apqcHierarchyId "7.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Supervising the HR and workforce strategy, plans, and policies in order to refurbish them whenever needed. Determine the performance of HR and workforce plans and policies by measuring the objective achievement rate and its contribution to the overall business strategy. Ensure that information about these plans and strategies is effectively communicated to various stakeholders. Incorporate any suggestions by these stakeholders when revising HR and workforce plans and policies." ;
    p1z:parentProcess apqc:PCF17043 .

apqc:PCF10434 a p1z:Process ;
    skos:prefLabel "Measure realization of HR objectives" ;
    p1z:apqcId "10434" ;
    p1z:apqcHierarchyId "7.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the accomplishment of HR and workforce goals and objectives. Evaluate the effectiveness of the HR function by estimating the present rate of achievement of the established objectives. Use metrics to determine if the objectives are being realized. Leverage measures such as turnover, training, return on human capital, costs of labor, and expenses per employee." ;
    p1z:parentProcess apqc:PCF10417 .

apqc:PCF10435 a p1z:Process ;
    skos:prefLabel "Measure contribution of HR to business strategy" ;
    p1z:apqcId "10435" ;
    p1z:apqcHierarchyId "7.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the role of the HR function in implementing the organizational strategy. Measure the correlation between the HR and workforce performance and the overall business strategy. Calculate the amount of contribution of the HR function to the overall business growth." ;
    p1z:parentProcess apqc:PCF10417 .

apqc:PCF10436 a p1z:Process ;
    skos:prefLabel "Communicate HR plans and provide updates to stakeholders" ;
    p1z:apqcId "10436" ;
    p1z:apqcHierarchyId "7.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying the plans for HR function to stakeholders. Ensure that the HR plans and strategy are effectively communicated to the people who can affect or be affected by the organization's actions, objectives, and policies such as the creditors, shareholders, employees, and suppliers. Provide regular updates to these stakeholders to ensure effective communication." ;
    p1z:parentProcess apqc:PCF10417 .

apqc:PCF10438 a p1z:Process ;
    skos:prefLabel "Review and revise HR plans" ;
    p1z:apqcId "10438" ;
    p1z:apqcHierarchyId "7.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reassessing the strategies, plans, and policies of the HR function, with the objective of revising them. Revisit the schematic plans for the HR function. Taking stock of any suggestions or feedback from the stakeholders, revamp the blueprint of HR strategies and plans." ;
    p1z:parentProcess apqc:PCF10417 .

apqc:PCF17046 a p1z:Process ;
    skos:prefLabel "Develop competency management models" ;
    p1z:apqcId "17046" ;
    p1z:apqcHierarchyId "7.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing the tools for managing the competency levels of HR. Design a model for integrating HR planning with business planning. Assess current HR capacity based on the competencies against the capacity needed to achieve the vision, mission, and business goals of the organization. Consider factors such as employee development, career path, compensation policies, and performance management." ;
    p1z:parentProcess apqc:PCF17043 .

apqc:PCF10410 a p1z:FunctionalDomain ;
    skos:prefLabel "Recruit, source, and select employees" ;
    p1z:apqcId "10410" ;
    p1z:apqcHierarchyId "7.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining and handling employee requirements. Recruit or source the candidates as per the requirements. Screen and select the most appropriate candidates. Take care of the newly hired and re-hired employees. Maintain records of information for all applicants." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF21698 a p1z:Process ;
    skos:prefLabel "Manage employee requisitions" ;
    p1z:apqcId "21698" ;
    p1z:apqcHierarchyId "7.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling the requirements for new employees. Create and open job requisitions by clearly defining the job descriptions. Post these requirements internally and externally, and modify them as appropriate. Manage the dates of the whole requisition process." ;
    p1z:parentProcess apqc:PCF10410 .

apqc:PCF10445 a p1z:Process ;
    skos:prefLabel "Align staffing plan to work force plan and business unit strategies/resource needs" ;
    p1z:apqcId "10445" ;
    p1z:apqcHierarchyId "7.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a correspondence between the plan for hiring new employees and the desired employee requirements. Staff an adequate amount of people with the appropriate skills to effectively accomplish its legislative, regulatory, service, and production requirements." ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10446 a p1z:Process ;
    skos:prefLabel "Open job requisitions" ;
    p1z:apqcId "10446" ;
    p1z:apqcHierarchyId "7.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing specific job requisitions, and ensuring their accessibility. Create and open a job requisition to fill the vacant positions within the organization. Clearly describe the job title, department, fill date, and the requisite skills and qualifications for the job." ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF21697 a p1z:Process ;
    skos:prefLabel "Approve job requisition" ;
    p1z:apqcId "21697" ;
    p1z:apqcHierarchyId "7.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing and authorizing requests to fill positions to ensure alignment with workforce plans, budget constraints, and organizational approval requirements" ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10448 a p1z:Process ;
    skos:prefLabel "Post job requisitions" ;
    p1z:apqcId "10448" ;
    p1z:apqcHierarchyId "7.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Posting and advertising job descriptions. Display open job descriptions internally and externally. Use public portals, online portals, and websites to upload these requisitions in order for applications to be received." ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10450 a p1z:Process ;
    skos:prefLabel "Modify job requisitions" ;
    p1z:apqcId "10450" ;
    p1z:apqcHierarchyId "7.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Making the necessary alterations to job requisitions. Revamp or revise the job requisitions in case a position is filled or is not vacant anymore, as well as in case of any new openings. (It involves Manage the internal/external job posting websites [10449] to make the necessary changes.)" ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10451 a p1z:Process ;
    skos:prefLabel "Notify hiring manager" ;
    p1z:apqcId "10451" ;
    p1z:apqcHierarchyId "7.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Informing and communicating with the hiring manager. Notify the manager responsible for the hiring process in cases of any new position openings or changes." ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10452 a p1z:Process ;
    skos:prefLabel "Manage requisition dates" ;
    p1z:apqcId "10452" ;
    p1z:apqcHierarchyId "7.2.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and managing the dates for the employee requisition process." ;
    p1z:parentProcess apqc:PCF21698 .

apqc:PCF10440 a p1z:Process ;
    skos:prefLabel "Recruit/Source candidates" ;
    p1z:apqcId "10440" ;
    p1z:apqcHierarchyId "7.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Recruiting new candidates for deployment across various functional areas inside the organization. Select methods for sourcing new employees. Manage relationships with third-party agencies. Stage recruitment fairs and drives. Manage employee referral programs." ;
    p1z:parentProcess apqc:PCF10410 .

apqc:PCF10453 a p1z:Process ;
    skos:prefLabel "Determine recruitment methods and channels" ;
    p1z:apqcId "10453" ;
    p1z:apqcHierarchyId "7.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the methods and channels for recruitments in order to maximize the amount of candidate availability. Use channels such as headhunting, job postings, job portals, networking websites, and media advertising. Choose from the various methods of recruitment such as internal/external third-party sourcing." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF10454 a p1z:Process ;
    skos:prefLabel "Perform recruiting activities/events" ;
    p1z:apqcId "10454" ;
    p1z:apqcHierarchyId "7.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Organizing and executing recruiting activities and events. Activities and events include on-campus hiring, refresher courses, information sessions, career fairs, etc. to increase the coverage of the sourcing in order to ensure that the most deserving and appropriate candidates are hired." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF21699 a p1z:Process ;
    skos:prefLabel "Develop and maintain candidate pool" ;
    p1z:apqcId "21699" ;
    p1z:apqcHierarchyId "7.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Cultivating relationships with potential job candidates even when there are no immediate openings. Building the talent pipeline for potential future hiring needs." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF10455 a p1z:Process ;
    skos:prefLabel "Manage recruitment vendors" ;
    p1z:apqcId "10455" ;
    p1z:apqcHierarchyId "7.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining relationships with recruitment vendors (suppliers). Create and maintain relationships with third-party agencies such as staffing and firms to expand. Use these relationships to implement the sourcing process effectively." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF17047 a p1z:Process ;
    skos:prefLabel "Manage employee referral programs" ;
    p1z:apqcId "17047" ;
    p1z:apqcHierarchyId "7.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and managing a recruiting strategy where current employees are rewarded for referring qualified candidates for employment." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF17048 a p1z:Process ;
    skos:prefLabel "Manage recruitment channels" ;
    p1z:apqcId "17048" ;
    p1z:apqcHierarchyId "7.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining internal and external channels for recruiting. Extract the best out of every recruitment channel. Manage all the processes related to all the sourcing channels including maintaining career pages on the organization website." ;
    p1z:parentProcess apqc:PCF10440 .

apqc:PCF20123 a p1z:Process ;
    skos:prefLabel "Screen and select candidates" ;
    p1z:apqcId "20123" ;
    p1z:apqcHierarchyId "7.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and selecting potential employees through interviews, tests, etc." ;
    p1z:parentProcess apqc:PCF10410 .

apqc:PCF10456 a p1z:Process ;
    skos:prefLabel "Identify and deploy candidate selection tools" ;
    p1z:apqcId "10456" ;
    p1z:apqcHierarchyId "7.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and implementing tools for the selection of candidates. Recognize candidate selection tools such as screening, telephone interviews, hiring manager interviews, drug testing, and skills assessment. Effectively deploy these tools to check if the candidates fit in the workplace or not, as well as to ensure workplace safety." ;
    p1z:parentProcess apqc:PCF20123 .

apqc:PCF10457 a p1z:Process ;
    skos:prefLabel "Interview candidates" ;
    p1z:apqcId "10457" ;
    p1z:apqcHierarchyId "7.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the candidates by their performance in the interviews. Conduct HR interview, technical interview, hiring manager interview, etc. Understand the mindset of the candidate, and comprehend his/her personal and professional lives." ;
    p1z:parentProcess apqc:PCF20123 .

apqc:PCF10458 a p1z:Process ;
    skos:prefLabel "Test candidates" ;
    p1z:apqcId "10458" ;
    p1z:apqcHierarchyId "7.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the candidates through tests. Prepare tools such as aptitude, technical, and grammar tests. Test the skills of the candidate through a written, oral, or computerized test." ;
    p1z:parentProcess apqc:PCF20123 .

apqc:PCF10459 a p1z:Process ;
    skos:prefLabel "Select and reject candidates" ;
    p1z:apqcId "10459" ;
    p1z:apqcHierarchyId "7.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Approving the deserving candidates, and rejecting the others. Examining the performance of candidates. Ensure candidates would fit well with the organization. (Assess performance from Interview candidates [10457] and Test candidates [10458].)" ;
    p1z:parentProcess apqc:PCF20123 .

apqc:PCF10443 a p1z:Process ;
    skos:prefLabel "Manage new hire/re-hire" ;
    p1z:apqcId "10443" ;
    p1z:apqcHierarchyId "7.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and making job offers to the selected candidates. Fairly negotiate the job offers. Agree on terms with the candidate to complete the hiring process." ;
    p1z:parentProcess apqc:PCF10410 .

apqc:PCF10463 a p1z:Process ;
    skos:prefLabel "Draw up and make offer" ;
    p1z:apqcId "10463" ;
    p1z:apqcHierarchyId "7.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Compiling job-related information for the selected candidates in order to make up a job. Include information about the job description, reporting relationship, salary, bonus potential, benefits, and vacation allotment." ;
    p1z:parentProcess apqc:PCF10443 .

apqc:PCF10464 a p1z:Process ;
    skos:prefLabel "Negotiate offer" ;
    p1z:apqcId "10464" ;
    p1z:apqcHierarchyId "7.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Negotiating an offer with selected candidates. Discuss the job offer with the candidate to ensure a mutual understanding." ;
    p1z:parentProcess apqc:PCF10443 .

apqc:PCF10465 a p1z:Process ;
    skos:prefLabel "Hire candidate" ;
    p1z:apqcId "10465" ;
    p1z:apqcHierarchyId "7.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Wrapping up the process for hiring candidates. Agree to all hiring terms and conditions. Have the candidate accept and sign the job offer." ;
    p1z:parentProcess apqc:PCF10443 .

apqc:PCF10444 a p1z:Process ;
    skos:prefLabel "Manage applicant information" ;
    p1z:apqcId "10444" ;
    p1z:apqcHierarchyId "7.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and maintaining a system for managing the information of applicants. Create records for all candidates who apply. Maintain and track information through the use applicant-tracking systems." ;
    p1z:parentProcess apqc:PCF10410 .

apqc:PCF10460 a p1z:Process ;
    skos:prefLabel "Obtain candidate background information" ;
    p1z:apqcId "10460" ;
    p1z:apqcHierarchyId "7.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting a background investigation on the candidates with the objective of gathering and compiling criminal, commercial, medical, and financial information." ;
    p1z:parentProcess apqc:PCF10444 .

apqc:PCF10466 a p1z:Process ;
    skos:prefLabel "Create applicant record" ;
    p1z:apqcId "10466" ;
    p1z:apqcHierarchyId "7.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and documenting the records of all applicants. Manage all individual applicants, including hires and non-hires. Maintain records to avoid any duplication and promote efficiency." ;
    p1z:parentProcess apqc:PCF10444 .

apqc:PCF10467 a p1z:Process ;
    skos:prefLabel "Manage/Track applicant data" ;
    p1z:apqcId "10467" ;
    p1z:apqcHierarchyId "7.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping track of all the information about the candidates who apply for jobs. Use applicant-tracking systems that can be accessed online as a central location and database for recruitment efforts." ;
    p1z:parentProcess apqc:PCF10444 .

apqc:PCF10468 a p1z:Process ;
    skos:prefLabel "Archive and retain records of non-hires" ;
    p1z:apqcId "10468" ;
    p1z:apqcHierarchyId "7.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Retaining and storing the records of the candidates who were rejected and not hired to ensure future availability in case the need arises. Create a centralized repository of profiles. Label these records in order to readily identify them. Add remarks for any future consideration." ;
    p1z:parentProcess apqc:PCF10444 .

apqc:PCF20599 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage employee onboarding, training, and development" ;
    p1z:apqcId "20599" ;
    p1z:apqcHierarchyId "7.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Assisting employees in developing their capabilities, and providing them counseling services. Handle the orientation and deployment of the employees. Administer the performance of employees. Administer the development and enhancement of the employees. Provide training and development programs for employees." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF10469 a p1z:Process ;
    skos:prefLabel "Manage employee onboarding" ;
    p1z:apqcId "10469" ;
    p1z:apqcHierarchyId "7.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and maintaining various employee on-boarding programs typically known as induction programs in order to ensure that the new employees are effectively introduced to the organization and its existing employees. Examine and evaluate the performance of these induction programs. Execute these programs on the ground level." ;
    p1z:parentProcess apqc:PCF20599 .

apqc:PCF10474 a p1z:Process ;
    skos:prefLabel "Develop employee onboarding program" ;
    p1z:apqcId "10474" ;
    p1z:apqcHierarchyId "7.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and maintaining a mechanism through which new employees acquire the necessary knowledge, skills, and behaviors to become effective organizational members and insiders. Conduct formal meetings, lectures, videos, printed materials, and/or computer-based orientations to introduce newcomers to their new jobs and the organization." ;
    p1z:parentProcess apqc:PCF10469 .

apqc:PCF17050 a p1z:Process ;
    skos:prefLabel "Implement employee onboarding program" ;
    p1z:apqcId "17050" ;
    p1z:apqcHierarchyId "7.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Bringing the employee on-boarding program into effect. Implement Develop employee onboarding program [10474]. Conduct training sessions and employee engagement programs." ;
    p1z:parentProcess apqc:PCF10469 .

apqc:PCF11243 a p1z:Process ;
    skos:prefLabel "Monitor and update employee onboarding program" ;
    p1z:apqcId "11243" ;
    p1z:apqcHierarchyId "7.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing the performance and effectiveness of employee on-boarding program. Examine the performance of on-boarding program through feedback and reviews from the new employees. Create web and written forms. Obtain information through face-to-face discussions." ;
    p1z:parentProcess apqc:PCF10469 .

apqc:PCF10470 a p1z:Process ;
    skos:prefLabel "Manage employee performance" ;
    p1z:apqcId "10470" ;
    p1z:apqcHierarchyId "7.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Defining individual performance objectives. Review performance in order to provide appraisals. Evaluate the efficiency and effectiveness of the current performance program. Update it regularly." ;
    p1z:parentProcess apqc:PCF20599 .

apqc:PCF10479 a p1z:Process ;
    skos:prefLabel "Define employee performance objectives" ;
    p1z:apqcId "10479" ;
    p1z:apqcHierarchyId "7.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the objectives for employee performance. Establish key performance objectives and measures such as customer-focus objectives, financially focused objectives, and employee growth objectives." ;
    p1z:parentProcess apqc:PCF10470 .

apqc:PCF21434 a p1z:Process ;
    skos:prefLabel "Review employee performance" ;
    p1z:apqcId "21434" ;
    p1z:apqcHierarchyId "7.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Execution of employee reviews/performance on a frequent basis. May include ongoing feedback and coaching activities." ;
    p1z:parentProcess apqc:PCF10470 .

apqc:PCF21435 a p1z:Process ;
    skos:prefLabel "Document employee performance" ;
    p1z:apqcId "21435" ;
    p1z:apqcHierarchyId "7.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Document the results of both formal reviews to include both positive and negative feedback and commentary. May include acknowledgement by involved parties." ;
    p1z:parentProcess apqc:PCF10470 .

apqc:PCF10481 a p1z:Process ;
    skos:prefLabel "Monitor and update performance program" ;
    p1z:apqcId "10481" ;
    p1z:apqcHierarchyId "7.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and revamping performance programs, including the instruments used to measure employee performance standards. Review and upgrade these performance programs to avoid any deprivations and ensure effectiveness." ;
    p1z:parentProcess apqc:PCF10470 .

apqc:PCF21700 a p1z:Process ;
    skos:prefLabel "Manage employee career development" ;
    p1z:apqcId "21700" ;
    p1z:apqcHierarchyId "7.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing employee development guidelines. Lay out career paths and plans for individual employees. Manage the development of their skills to enhance their skills, ability, and knowledge." ;
    p1z:parentProcess apqc:PCF20599 .

apqc:PCF10487 a p1z:Process ;
    skos:prefLabel "Define employee development guidelines" ;
    p1z:apqcId "10487" ;
    p1z:apqcHierarchyId "7.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the guidelines for development of employees. Design development policies and procedures to identify areas of growth for employees, either in their current position or in preparation for future roles. Include topics related to knowledge and skill development." ;
    p1z:parentProcess apqc:PCF21700 .

apqc:PCF10488 a p1z:Process ;
    skos:prefLabel "Develop employee career plans and career paths" ;
    p1z:apqcId "10488" ;
    p1z:apqcHierarchyId "7.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a future career path for the employees that encourages them to explore and gather information." ;
    p1z:parentProcess apqc:PCF21700 .

apqc:PCF17051 a p1z:Process ;
    skos:prefLabel "Manage employee skill and competency development" ;
    p1z:apqcId "17051" ;
    p1z:apqcHierarchyId "7.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the development of employee skills. Conduct training, coaching and mentoring, job-rotation and cross training, lateral moves, etc. Maintain records of employee skills and competencies." ;
    p1z:parentProcess apqc:PCF21700 .

apqc:PCF21701 a p1z:Process ;
    skos:prefLabel "Establish succession plans" ;
    p1z:apqcId "21701" ;
    p1z:apqcHierarchyId "7.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing plans to ensure continuity in critical roles by identifying potential successors and preparing them for future leadership or specialist positions." ;
    p1z:parentProcess apqc:PCF21700 .

apqc:PCF10473 a p1z:Process ;
    skos:prefLabel "Develop and train employees" ;
    p1z:apqcId "10473" ;
    p1z:apqcHierarchyId "7.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Establish organizational development needs for employees. Creating a link between employee and organizational development needs." ;
    p1z:parentProcess apqc:PCF20599 .

apqc:PCF21706 a p1z:Process ;
    skos:prefLabel "Align organizational development needs to employees" ;
    p1z:apqcId "21706" ;
    p1z:apqcHierarchyId "7.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the skills, competencies, and knowledge required by the organization to achieve its strategic goals and ensuring employees' growth directly contributes to achieving those goals." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF16940 a p1z:Process ;
    skos:prefLabel "Define employees competencies and skills" ;
    p1z:apqcId "16940" ;
    p1z:apqcHierarchyId "7.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the skills, knowledge, abilities, and attributes needed to achieve the desired core capabilities and competencies of the organization." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF10491 a p1z:Process ;
    skos:prefLabel "Align learning programs with competencies and skills" ;
    p1z:apqcId "10491" ;
    p1z:apqcHierarchyId "7.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning the learning programs with the core capabilities and competencies of the organization. Contextualize the training programs so that employees can expand their knowledge base and add new skills in line with the core competencies of the organization." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF10492 a p1z:Process ;
    skos:prefLabel "Establish training needs by analysis of required and available skills" ;
    p1z:apqcId "10492" ;
    p1z:apqcHierarchyId "7.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the training necessitated by business processes, using an examination of skill sets that are needed by the organization and those already possessed. Examine the various skills required by individual employees. Design training in light of the availability of resources to provide specific segments of training." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF10493 a p1z:Process ;
    skos:prefLabel "Develop, conduct, and manage employee training programs" ;
    p1z:apqcId "10493" ;
    p1z:apqcHierarchyId "7.3.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating, implementing, and managing the programs for training employees. Create and design sessions on the basis of the needs and the availability of the skills. Conduct the sessions in person or virtually. Manage all aspects related to the training programs. Consider including literacy training, interpersonal skills training, technical training, problem-solving training, diversity or sensitivity training, etc." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF20125 a p1z:Process ;
    skos:prefLabel "Manage examinations and certifications" ;
    p1z:apqcId "20125" ;
    p1z:apqcHierarchyId "7.3.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing identified training programs for employees. Engage with industries to provide certifications, administer certification test, and maintain active certification." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF21436 a p1z:Process ;
    skos:prefLabel "Monitor and evaluate learning programs" ;
    p1z:apqcId "21436" ;
    p1z:apqcHierarchyId "7.3.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Oversight of the organization's learning programs.  This process also includes the effectiveness of these programs." ;
    p1z:parentProcess apqc:PCF10473 .

apqc:PCF17052 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage employee relations" ;
    p1z:apqcId "17052" ;
    p1z:apqcHierarchyId "7.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Assisting general management in developing, maintaining, and improving employee relationships. This is accomplished through communication, performance management, processing grievances, and/or dispute. Interpret and convey organizational policies." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF10483 a p1z:Process ;
    skos:prefLabel "Manage labor relations" ;
    p1z:apqcId "10483" ;
    p1z:apqcHierarchyId "7.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing labor relations, the collective bargaining process, and the relationships between the labor and management. Take care of employee grievances." ;
    p1z:parentProcess apqc:PCF17052 .

apqc:PCF10484 a p1z:Process ;
    skos:prefLabel "Manage collective bargaining process" ;
    p1z:apqcId "10484" ;
    p1z:apqcHierarchyId "7.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing any negotiations between an employer and a group of employees that determine the conditions of employment. Engage employees to reach agreements in regulating working conditions." ;
    p1z:parentProcess apqc:PCF17052 .

apqc:PCF10485 a p1z:Process ;
    skos:prefLabel "Manage labor management partnerships" ;
    p1z:apqcId "10485" ;
    p1z:apqcHierarchyId "7.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling partnerships between labor and management. Develop a lasting two-way relationship that is beneficial for the labor, management, and the organization." ;
    p1z:parentProcess apqc:PCF17052 .

apqc:PCF10531 a p1z:Process ;
    skos:prefLabel "Manage employee grievances" ;
    p1z:apqcId "10531" ;
    p1z:apqcHierarchyId "7.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Taking care or resolving any complaint raised by an employee by procedures provided for in a collective agreement, an employment contract, or by other mechanisms established by an employer." ;
    p1z:parentProcess apqc:PCF17052 .

apqc:PCF21437 a p1z:Process ;
    skos:prefLabel "Monitor legal and regulatory environment" ;
    p1z:apqcId "21437" ;
    p1z:apqcHierarchyId "7.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Awareness of the employee legislature that is in place for the organization.  The regulatory environment could include areas, regions, countries, or technologies (around AI, for example)." ;
    p1z:parentProcess apqc:PCF17052 .

apqc:PCF10412 a p1z:FunctionalDomain ;
    skos:prefLabel "Reward and retain employees" ;
    p1z:apqcId "10412" ;
    p1z:apqcHierarchyId "7.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating frameworks for rewarding and recognizing employees with the objective of retaining them. Create and manage programs for provision of rewards, recognition, and motivation. Manage and administer the benefits for employees. Help assist and retain employees. Administer payroll to employees." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF21438 a p1z:Process ;
    skos:prefLabel "Develop and manage reward, recognition, and motivation programs" ;
    p1z:apqcId "21438" ;
    p1z:apqcHierarchyId "7.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a salary/compensation structure and plan; developing a benefits and reward plan; develop commission plan; performing competitive analyses of benefits and rewards; identifying compensation requirements based on compensation, benefits, and HR policies; administering compensation, commission, and rewards to employees; and rewarding and motivating employees." ;
    p1z:parentProcess apqc:PCF10412 .

apqc:PCF10498 a p1z:Process ;
    skos:prefLabel "Develop salary/compensation structure and plan" ;
    p1z:apqcId "10498" ;
    p1z:apqcHierarchyId "7.5.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating the framework for the provision of salary/compensation to employees. Break down the salary structure into different components such as fixed pay, variable pay, bonus, and allowances such medical allowance, and rent allowance, etc. Develop, adjust, and maintain a pay structure." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10499 a p1z:Process ;
    skos:prefLabel "Develop benefits and rewards plan" ;
    p1z:apqcId "10499" ;
    p1z:apqcHierarchyId "7.5.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan for provision of rewards, commission, and benefits to employees. Plan health benefits, retirement benefits, wellness plans, and non-monetary benefits, etc." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10500 a p1z:Process ;
    skos:prefLabel "Perform competitive analysis of benefits and rewards" ;
    p1z:apqcId "10500" ;
    p1z:apqcHierarchyId "7.5.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing and evaluating the organization's benefits and rewards plan. Compare/Benchmark the benefits and employees plan with other organizations to adhere to industry standard practices." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10501 a p1z:Process ;
    skos:prefLabel "Identify compensation requirements based on financial, benefits, and HR policies" ;
    p1z:apqcId "10501" ;
    p1z:apqcHierarchyId "7.5.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the employee requirements for compensation on the basis of the financial, benefits, and HR policies of the organization. Recognize individual compensation requirements regarding the financial policies of the organization. Consider the benefits plan and overall HR policies while selecting compensation requirements." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10502 a p1z:Process ;
    skos:prefLabel "Administer compensation and rewards to employees" ;
    p1z:apqcId "10502" ;
    p1z:apqcHierarchyId "7.5.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the provision of compensations and rewards to the employees while maintaining consistency with the compensation and benefits plan. Follow the compensation and benefits plan rigorously in order to avoid any discrepancies." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10503 a p1z:Process ;
    skos:prefLabel "Reward and motivate employees" ;
    p1z:apqcId "10503" ;
    p1z:apqcHierarchyId "7.5.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Rewarding and stimulating the performance efforts of employees. Create methods for motivating employees. Spur extrinsic and intrinsic motivation." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10510 a p1z:Process ;
    skos:prefLabel "Review engagement and retention indicators" ;
    p1z:apqcId "10510" ;
    p1z:apqcHierarchyId "7.5.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reassessing the indicators for retention and motivation of employees. Monitor the indicators that signal the levels of motivation and retention. Regularly update and upgrade indicators to avoid depreciation and ensure high efficiency." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10511 a p1z:Process ;
    skos:prefLabel "Review compensation plan" ;
    p1z:apqcId "10511" ;
    p1z:apqcHierarchyId "7.5.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing existing compensation plans and making changes necessary to continue to retain employees." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF21708 a p1z:Process ;
    skos:prefLabel "Review benefits and rewards plan" ;
    p1z:apqcId "21708" ;
    p1z:apqcHierarchyId "7.5.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating benefits and rewards plans to assess effectiveness, alignment with workforce needs, and consistency with organizational reward and recognition objectives." ;
    p1z:parentProcess apqc:PCF21438 .

apqc:PCF10495 a p1z:Process ;
    skos:prefLabel "Manage and administer benefits" ;
    p1z:apqcId "10495" ;
    p1z:apqcHierarchyId "7.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing and ensuring benefits enrollment by the employees. Process any benefit claims made by the employees. Balance the estimated amount and entitled amount of benefits." ;
    p1z:parentProcess apqc:PCF10412 .

apqc:PCF10504 a p1z:Process ;
    skos:prefLabel "Deliver employee benefits program" ;
    p1z:apqcId "10504" ;
    p1z:apqcHierarchyId "7.5.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the programs that specify employee benefits, other than salary provided, such as those concerning medical care, death, and disability." ;
    p1z:parentProcess apqc:PCF10495 .

apqc:PCF10505 a p1z:Process ;
    skos:prefLabel "Administer benefit enrollment" ;
    p1z:apqcId "10505" ;
    p1z:apqcHierarchyId "7.5.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling the employee enrollment for obtaining benefits. Manage employee enrollment and eligibility, including work and life status/event changes. Encourage employees to enroll for benefits." ;
    p1z:parentProcess apqc:PCF10495 .

apqc:PCF10506 a p1z:Process ;
    skos:prefLabel "Process benefits claims" ;
    p1z:apqcId "10506" ;
    p1z:apqcHierarchyId "7.5.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Processing any formal requests or demands made by the employees claiming that they have earned some benefits. Includes escalation to management." ;
    p1z:parentProcess apqc:PCF10495 .

apqc:PCF10507 a p1z:Process ;
    skos:prefLabel "Perform benefit reconciliation" ;
    p1z:apqcId "10507" ;
    p1z:apqcHierarchyId "7.5.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out reconciliation of benefits delivered to employees. Compare the estimated benefit requirement made by the employee and the actual amount of benefits the employee is entitled to receive." ;
    p1z:parentProcess apqc:PCF10495 .

apqc:PCF21439 a p1z:Process ;
    skos:prefLabel "Manage employee assistance and retention" ;
    p1z:apqcId "21439" ;
    p1z:apqcHierarchyId "7.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing activities centered around delivering programs to support work/life balance for employees; developing family support systems; reviewing retention and motivation indicators; and reviewing compensation plans." ;
    p1z:parentProcess apqc:PCF10412 .

apqc:PCF10508 a p1z:Process ;
    skos:prefLabel "Deliver programs to support work/life balance for employees" ;
    p1z:apqcId "10508" ;
    p1z:apqcHierarchyId "7.5.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing programs that prompt proper balance between work (i.e., career and ambition) and lifestyle (i.e., health, pleasure, leisure, family, and spiritual development/meditation). Account for dependent care, flexible working arrangements, leaves of absence, on-the-job training, etc." ;
    p1z:parentProcess apqc:PCF21439 .

apqc:PCF10509 a p1z:Process ;
    skos:prefLabel "Develop employee and family support systems" ;
    p1z:apqcId "10509" ;
    p1z:apqcHierarchyId "7.5.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a support structure that aligns with local and federal laws that allow for support for families. This could include things like maternity leave, care for a family member, or in some cases, extended sick leave." ;
    p1z:parentProcess apqc:PCF21439 .

apqc:PCF10497 a p1z:Process ;
    skos:prefLabel "Administer Payroll" ;
    p1z:apqcId "10497" ;
    p1z:apqcHierarchyId "7.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the sum of all financial records of salaries for an employee, including wages, bonuses, and deductions. Use a payroll management system to deal with the financial aspects of employees' salaries, allowances, deductions, gross pay, net pay, etc. Generate pay slips for a specific period." ;
    p1z:parentProcess apqc:PCF10412 .

apqc:PCF10530 a p1z:Process ;
    skos:prefLabel "Manage/Collect employee suggestions and perform employee research" ;
    p1z:apqcId "10530" ;
    p1z:apqcHierarchyId "7.5.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Procuring and handling suggestions from employees, and performing research on employees. Manage and analyze the programs that help the organization to tap into employee ideas for improving the organization's processes and/or products. Use surveys, focus groups, and other data-gathering methods to find out the attitudes, opinions, and feelings of members of an organization." ;
    p1z:parentProcess apqc:PCF10412 .

apqc:PCF10413 a p1z:FunctionalDomain ;
    skos:prefLabel "Redeploy and retire employees" ;
    p1z:apqcId "10413" ;
    p1z:apqcHierarchyId "7.6" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing employee mobility and retirement. Manage the process of employee promotion and demotion. Administer separation, retirement, and leaves of absence. Outplace employees. Deploy personnel. Relocate employees in order to manage assignments." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF10512 a p1z:Process ;
    skos:prefLabel "Manage promotion and demotion process" ;
    p1z:apqcId "10512" ;
    p1z:apqcHierarchyId "7.6.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Administering the process of promoting and demoting employees. Design a system for advancing or demoting an employee's rank or position. Leverage techniques such as horizontal promotion, vertical promotion, dry promotion, and involuntary/voluntary demotion." ;
    p1z:parentProcess apqc:PCF10413 .

apqc:PCF10513 a p1z:Process ;
    skos:prefLabel "Manage separation" ;
    p1z:apqcId "10513" ;
    p1z:apqcHierarchyId "7.6.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the process of employee separation, including leaves of absence, resignations, discharges, and layoffs. Inform the employee of the termination. Complete paperwork for continuation of benefits. Enter employment status change into system." ;
    p1z:parentProcess apqc:PCF10413 .

apqc:PCF10514 a p1z:Process ;
    skos:prefLabel "Manage retirement" ;
    p1z:apqcId "10514" ;
    p1z:apqcHierarchyId "7.6.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing and administering instances where a person stops employment completely." ;
    p1z:parentProcess apqc:PCF10513 .

apqc:PCF10515 a p1z:Process ;
    skos:prefLabel "Manage leave of absence" ;
    p1z:apqcId "10515" ;
    p1z:apqcHierarchyId "7.6.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the period of time that an employee must be away from their primary job, while maintaining the status of employee (i.e., paid and unpaid leave of absence but not vacations, holidays, hiatuses, sabbaticals, and work-from-home programs)." ;
    p1z:parentProcess apqc:PCF10513 .

apqc:PCF21710 a p1z:Process ;
    skos:prefLabel "Manage offboarding" ;
    p1z:apqcId "21710" ;
    p1z:apqcHierarchyId "7.6.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating activities related to employee departures, including transitions, knowledge transfer, and administrative actions, to support orderly and compliant workforce exits." ;
    p1z:parentProcess apqc:PCF10513 .

apqc:PCF10516 a p1z:Process ;
    skos:prefLabel "Develop and implement employee outplacement" ;
    p1z:apqcId "10516" ;
    p1z:apqcHierarchyId "7.6.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Helping former employees transition to new jobs or to re-orient themselves in the job market. Deliver help through one-on-one sessions or in a group format. Provide guidance in career evaluation, resume writing, interview preparation, developing networks, and job searching." ;
    p1z:parentProcess apqc:PCF10513 .

apqc:PCF17055 a p1z:Process ;
    skos:prefLabel "Relocate employees and manage assignments" ;
    p1z:apqcId "17055" ;
    p1z:apqcHierarchyId "7.6.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the relocation of employees in order to carry out assignments. Manage internal business processes to transfer employees, their families, and/or entire departments of a business to a new location." ;
    p1z:parentProcess apqc:PCF10413 .

apqc:PCF10520 a p1z:Process ;
    skos:prefLabel "Manage expatriates" ;
    p1z:apqcId "10520" ;
    p1z:apqcHierarchyId "7.6.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Manage employees who are sent to live abroad or hired from abroad for a defined time period." ;
    p1z:parentProcess apqc:PCF17055 .

apqc:PCF17056 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage employee information and analytics" ;
    p1z:apqcId "17056" ;
    p1z:apqcHierarchyId "7.7" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the employee reporting processes, employee inquiry process, employee information and data, and the HR information systems. Create and administer the employee metrics. Develop and handle the time and attendance systems. Refurbish the indicators for employee retention and motivation." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF10522 a p1z:Process ;
    skos:prefLabel "Manage reporting processes" ;
    p1z:apqcId "10522" ;
    p1z:apqcHierarchyId "7.7.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Providing information and reports regarding employees to management." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF10523 a p1z:Process ;
    skos:prefLabel "Manage employee inquiry process" ;
    p1z:apqcId "10523" ;
    p1z:apqcHierarchyId "7.7.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Handling instances where an employee believes that he/she has been inappropriately treated or he/she desires clarification. Encourage employees to inquire when needed. Record and clarify the issues for which the enquiry has been made." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF10524 a p1z:Process ;
    skos:prefLabel "Manage and maintain employee data" ;
    p1z:apqcId "10524" ;
    p1z:apqcHierarchyId "7.7.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Capturing and updating employee information and data and information on the employees." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF10525 a p1z:Process ;
    skos:prefLabel "Manage human resource information systems" ;
    p1z:apqcId "10525" ;
    p1z:apqcHierarchyId "7.7.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Administering and maintaining HR information systems that take care of activities related to HR, accounting, management, and payroll." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF10526 a p1z:Process ;
    skos:prefLabel "Develop and manage employee measures" ;
    p1z:apqcId "10526" ;
    p1z:apqcHierarchyId "7.7.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and maintaining performance metrics for employees. Create and manage a strategic system of data and statistics to accurately gauge each employee's information. Consider productivity metrics, efficiency metrics, training metrics, etc." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF10527 a p1z:Process ;
    skos:prefLabel "Develop and manage time and attendance systems" ;
    p1z:apqcId "10527" ;
    p1z:apqcHierarchyId "7.7.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing and maintaining systems for managing the time and attendance of employees. Routinely upgrade the process and systems that track when employees start and stop work, the department where the work is performed, attendance in addition to tracking meals and breaks, the type of work performed, and the number of items produced." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF21441 a p1z:Process ;
    skos:prefLabel "Develop workforce analytics" ;
    p1z:apqcId "21441" ;
    p1z:apqcHierarchyId "7.7.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Understand, develop, and gather workforce data in support of stakeholder requirements." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF21442 a p1z:Process ;
    skos:prefLabel "Determine stakeholder requirements" ;
    p1z:apqcId "21442" ;
    p1z:apqcHierarchyId "7.7.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collect and manage requirements from various enterprise stakeholders about workforce analytics." ;
    p1z:parentProcess apqc:PCF21441 .

apqc:PCF21443 a p1z:Process ;
    skos:prefLabel "Identify research questions" ;
    p1z:apqcId "21443" ;
    p1z:apqcHierarchyId "7.7.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Summarize stakeholder requirements into discrete research questions in support of workforce analytics." ;
    p1z:parentProcess apqc:PCF21441 .

apqc:PCF21444 a p1z:Process ;
    skos:prefLabel "Select workforce analysis methodology" ;
    p1z:apqcId "21444" ;
    p1z:apqcHierarchyId "7.7.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Consider stakeholder requirements, research questions, and organizations standards around research to select appropriate research methodology in support of workforce analytics." ;
    p1z:parentProcess apqc:PCF21441 .

apqc:PCF21445 a p1z:Process ;
    skos:prefLabel "Identify workforce data sources" ;
    p1z:apqcId "21445" ;
    p1z:apqcHierarchyId "7.7.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify appropriate data sources for workforce analytics data while considering organizational standards for data sources." ;
    p1z:parentProcess apqc:PCF21441 .

apqc:PCF21446 a p1z:Process ;
    skos:prefLabel "Gather workforce data" ;
    p1z:apqcId "21446" ;
    p1z:apqcHierarchyId "7.7.7.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collect and procure, as needed, workforce data from internal and external data sources in support of workforce analytics." ;
    p1z:parentProcess apqc:PCF21441 .

apqc:PCF21447 a p1z:Process ;
    skos:prefLabel "Implement workforce analytics" ;
    p1z:apqcId "21447" ;
    p1z:apqcHierarchyId "7.7.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Transform, develop, and communicate workforce data into analytics in support of organizational requirements." ;
    p1z:parentProcess apqc:PCF17056 .

apqc:PCF21448 a p1z:Process ;
    skos:prefLabel "Transform workforce analysis data" ;
    p1z:apqcId "21448" ;
    p1z:apqcHierarchyId "7.7.8.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Logically and statistically validate collected or purchased data in support of analytics needs" ;
    p1z:parentProcess apqc:PCF21447 .

apqc:PCF21449 a p1z:Process ;
    skos:prefLabel "Develop insights into workforce analytics outcomes" ;
    p1z:apqcId "21449" ;
    p1z:apqcHierarchyId "7.7.8.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Synthesize insights from workforce analytics data" ;
    p1z:parentProcess apqc:PCF21447 .

apqc:PCF21450 a p1z:Process ;
    skos:prefLabel "Communicate workforce analysis outcomes" ;
    p1z:apqcId "21450" ;
    p1z:apqcHierarchyId "7.7.8.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Summarize, package, and distribute results of workforce analysis." ;
    p1z:parentProcess apqc:PCF21447 .

apqc:PCF21451 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage employee communication" ;
    p1z:apqcId "21451" ;
    p1z:apqcHierarchyId "7.8" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating an effective plan that initiates and promotes communication and engagement among the employees and between employees and management." ;
    p1z:parentProcess apqc:PCF10007 .

apqc:PCF10529 a p1z:Process ;
    skos:prefLabel "Develop employee communication plan" ;
    p1z:apqcId "10529" ;
    p1z:apqcHierarchyId "7.8.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan for managing communication among employees. Inform employees of direction. Counter resistance with change management approaches. Seek specific areas of input to the decision-making process. Seek varying degrees of involvement and co-creation." ;
    p1z:parentProcess apqc:PCF21451 .

apqc:PCF16944 a p1z:Process ;
    skos:prefLabel "Conduct employee engagement surveys" ;
    p1z:apqcId "16944" ;
    p1z:apqcHierarchyId "7.8.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Questioning employees to ascertain overall workplace satisfaction." ;
    p1z:parentProcess apqc:PCF21451 .

apqc:PCF10532 a p1z:Process ;
    skos:prefLabel "Deliver employee communications" ;
    p1z:apqcId "10532" ;
    p1z:apqcHierarchyId "7.8.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the communication plan for employees. Initiate dialogues and engagement by monitoring the exchange of ideas and opinions, the development of personal relationships, etc." ;
    p1z:parentProcess apqc:PCF21451 .

apqc:PCF20607 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Information Technology (IT)" ;
    p1z:apqcId "20607" ;
    p1z:apqcHierarchyId "8.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing process groups relevant to the business of information technology within an organization. The process groups include \"Develop and manage IT customer relationships\", \"Develop and manage IT business strategy\", \" Develop and manage IT resilience and risk\", \" Manage information\", \" Develop and manage services/solutions\", \"Deploy services/solutions\", and \" Create and manage support services/solutions\"." .

apqc:PCF20608 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage IT customer relationships" ;
    p1z:apqcId "20608" ;
    p1z:apqcHierarchyId "8.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and administering relationships with IT customers. Understanding customer needs including high-level business requirements for IT transformation. Plan for and communicate IT services along with establishing IT service levels, providing transformation guidance, and performance analysis that foster IT customer relationships." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20609 a p1z:Process ;
    skos:prefLabel "Understand IT customer needs" ;
    p1z:apqcId "20609" ;
    p1z:apqcHierarchyId "8.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the customer communities along with current IT operational capabilities and usage." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20610 a p1z:Process ;
    skos:prefLabel "Understand IT customer communities" ;
    p1z:apqcId "20610" ;
    p1z:apqcHierarchyId "8.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Interacting with IT customers to understand the IT needs through a collaborative community through involvement, connection, and informed communication." ;
    p1z:parentProcess apqc:PCF20609 .

apqc:PCF20611 a p1z:Process ;
    skos:prefLabel "Assess IT customer operational capabilities" ;
    p1z:apqcId "20611" ;
    p1z:apqcHierarchyId "8.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate the ability of the group of staff dependent on information technology, to align resources and critical processes according to organizational vision being able to deliver effectively and efficiently." ;
    p1z:parentProcess apqc:PCF20609 .

apqc:PCF20612 a p1z:Process ;
    skos:prefLabel "Identify IT customer transformation needs" ;
    p1z:apqcId "20612" ;
    p1z:apqcHierarchyId "8.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying changing needs of staff dependent on information technology based on continuous improvement to deliver results according to organizational goals. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20613 a p1z:Process ;
    skos:prefLabel "Understand business requirements for IT capabilities" ;
    p1z:apqcId "20613" ;
    p1z:apqcHierarchyId "8.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding business requirements for the existing IT environment as well as future IT needs." ;
    p1z:parentProcess apqc:PCF20612 .

apqc:PCF20614 a p1z:Process ;
    skos:prefLabel "Understand IT landscape" ;
    p1z:apqcId "20614" ;
    p1z:apqcHierarchyId "8.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the complete logical structure and working of the organization's IT landscape. Assess the configuration of hardware and software (IT Assets) across the organization that supports overall business operations." ;
    p1z:parentProcess apqc:PCF20612 .

apqc:PCF20615 a p1z:Process ;
    skos:prefLabel "Develop IT visioning" ;
    p1z:apqcId "20615" ;
    p1z:apqcHierarchyId "8.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing goals to define IT vision. Define and document ideas, direction, and activities which enable information technology to reach these goals." ;
    p1z:parentProcess apqc:PCF20612 .

apqc:PCF20616 a p1z:Process ;
    skos:prefLabel "Outline IT service expectations" ;
    p1z:apqcId "20616" ;
    p1z:apqcHierarchyId "8.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a roadmap to meet organizational expectations from information technology services while considering how it will affect the business." ;
    p1z:parentProcess apqc:PCF20612 .

apqc:PCF20617 a p1z:Process ;
    skos:prefLabel "Plan and communicate IT services" ;
    p1z:apqcId "20617" ;
    p1z:apqcHierarchyId "8.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and design an organized and curated collection of all IT-related services that can be performed by, for, or within the organization. Maintain and convey information about deliverables, prices, contact points, and processes for requesting an information technology service." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20618 a p1z:Process ;
    skos:prefLabel "Manage IT customer expectations" ;
    p1z:apqcId "20618" ;
    p1z:apqcHierarchyId "8.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing customer expectations of the existing IT environment while considering how it will affect the business." ;
    p1z:parentProcess apqc:PCF20617 .

apqc:PCF20619 a p1z:Process ;
    skos:prefLabel "Define future IT services" ;
    p1z:apqcId "20619" ;
    p1z:apqcHierarchyId "8.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the expected demand and usage of information technology services to meet organization's future business goals. Gather necessary information about the processes, resource requirements, and structures pertaining to planned business growth." ;
    p1z:parentProcess apqc:PCF20617 .

apqc:PCF20620 a p1z:Process ;
    skos:prefLabel "Determine IT performance indicators" ;
    p1z:apqcId "20620" ;
    p1z:apqcHierarchyId "8.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining IT KPIs crucial to the organization's success. Measure indicators such as IT costs as percentage of revenue, IT maintenance ratio, and system downtime in an effort to evaluate the performance of IT across the organization." ;
    p1z:parentProcess apqc:PCF20617 .

apqc:PCF20621 a p1z:Process ;
    skos:prefLabel "Create IT marketing messages" ;
    p1z:apqcId "20621" ;
    p1z:apqcHierarchyId "8.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing concise statements that position the value proposition around the pressing concerns of the internal IT user base, thereby showing how the IT offerings are the right fit for a segment of IT customers." ;
    p1z:parentProcess apqc:PCF20617 .

apqc:PCF20622 a p1z:Process ;
    skos:prefLabel "Create IT service marketing plan" ;
    p1z:apqcId "20622" ;
    p1z:apqcHierarchyId "8.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a marketing strategy for IT offerings to customers. Plan processes for making budgets; identifying and developing media; and managing marketing content and promotional activities." ;
    p1z:parentProcess apqc:PCF20617 .

apqc:PCF20623 a p1z:Process ;
    skos:prefLabel "Provide IT transformation guidance" ;
    p1z:apqcId "20623" ;
    p1z:apqcHierarchyId "8.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the necessity of IT transformation for the business. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Collect and analyze customer requirements. Identify opportunities and prioritize outcomes. Develop and support business case for transformation. Develop transformation plan and roadmap." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20624 a p1z:Process ;
    skos:prefLabel "Develop IT transformation plans" ;
    p1z:apqcId "20624" ;
    p1z:apqcHierarchyId "8.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a robust plan to replace or upgrade an organization's information technology systems. Understanding the business need of IT transformation from current to an expected state for the business. Developing a strategic plan for IT operating model, governance, service delivery, and workforce transformation." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20625 a p1z:Process ;
    skos:prefLabel "Collect IT customer requirements" ;
    p1z:apqcId "20625" ;
    p1z:apqcHierarchyId "8.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying existing or potential IT gaps between the expected business performance levels and current business outcomes." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20937 a p1z:Process ;
    skos:prefLabel "Analyze IT customer requirements" ;
    p1z:apqcId "20937" ;
    p1z:apqcHierarchyId "8.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing identified IT gaps to plan for remediation efforts to allow outcomes to meet established performance levels." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20626 a p1z:Process ;
    skos:prefLabel "Identify and prioritize IT opportunities" ;
    p1z:apqcId "20626" ;
    p1z:apqcHierarchyId "8.1.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying IT opportunities on the basis of collection and analysis of IT customer requirements, then prioritize the identified IT opportunities on the basis of their importance." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20627 a p1z:Process ;
    skos:prefLabel "Facilitate solution design activities" ;
    p1z:apqcId "20627" ;
    p1z:apqcHierarchyId "8.1.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing a plan of action to provide solution to IT customers. The solution design should be based on the collection and analysis of IT customer requirements." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20628 a p1z:Process ;
    skos:prefLabel "Prioritize IT outcomes" ;
    p1z:apqcId "20628" ;
    p1z:apqcHierarchyId "8.1.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Prioritizing IT outcomes based on need, effectiveness, and efficiency." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20629 a p1z:Process ;
    skos:prefLabel "Develop business cases" ;
    p1z:apqcId "20629" ;
    p1z:apqcHierarchyId "8.1.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create a business case with value proposition indicating current situation, proposed solution, financial analysis, and measurable benefits to the IT customers." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20630 a p1z:Process ;
    skos:prefLabel "Support business case" ;
    p1z:apqcId "20630" ;
    p1z:apqcHierarchyId "8.1.4.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting business case with supporting research, business analysis, and background information on IT transformation." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20631 a p1z:Process ;
    skos:prefLabel "Develop transformation roadmap" ;
    p1z:apqcId "20631" ;
    p1z:apqcHierarchyId "8.1.4.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a blueprint for execution of IT transformation from the existing state to the planned organizational structure based on the value proposition and projected business growth." ;
    p1z:parentProcess apqc:PCF20623 .

apqc:PCF20632 a p1z:Process ;
    skos:prefLabel "Develop and manage IT service levels" ;
    p1z:apqcId "20632" ;
    p1z:apqcHierarchyId "8.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining service levels for the provision of IT services and solutions. Design and maintain the IT services and solution catalogue, as well as service level agreements. Evaluate the performance of IT service level agreements. Communicate the results to the management." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20633 a p1z:Process ;
    skos:prefLabel "Understand IT service requirements" ;
    p1z:apqcId "20633" ;
    p1z:apqcHierarchyId "8.1.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understand requirements related to information technology services considering enterprise-level effects and understand potential achievements in the business environment." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20634 a p1z:Process ;
    skos:prefLabel "Forecast IT service demand" ;
    p1z:apqcId "20634" ;
    p1z:apqcHierarchyId "8.1.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Forecasting demand for IT services using current business growth, research, and customer feedback. Refine these forecasts, inspect the approach used in creating forecasts, and determine its accuracy." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20635 a p1z:Process ;
    skos:prefLabel "Maintain IT services catalog" ;
    p1z:apqcId "20635" ;
    p1z:apqcHierarchyId "8.1.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintain information about IT deliverables, prices, contact points, and processes for requesting a service." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20636 a p1z:Process ;
    skos:prefLabel "Define service level agreement" ;
    p1z:apqcId "20636" ;
    p1z:apqcHierarchyId "8.1.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing and maintaining commitment of service by performance evaluation of IT services and communicate the results to the management." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20637 a p1z:Process ;
    skos:prefLabel "Maintain IT customer contracts" ;
    p1z:apqcId "20637" ;
    p1z:apqcHierarchyId "8.1.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining and documenting commitment of service to staff for information technology contracts including providing software or hardware solution through communication channels like phone, email, and on-site services." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20638 a p1z:Process ;
    skos:prefLabel "Negotiate and establish service level agreements" ;
    p1z:apqcId "20638" ;
    p1z:apqcHierarchyId "8.1.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establish a service level agreement, which is a negotiated agreement designed to create a common understanding about services, priorities, and responsibilities." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20640 a p1z:Process ;
    skos:prefLabel "Develop and maintain improvement processes" ;
    p1z:apqcId "20640" ;
    p1z:apqcHierarchyId "8.1.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying the improvement opportunities for the business and level of IT services. Leverage the results obtained from the performance metrics of the business and IT service levels to identify and recognize any opportunities that would improve or enhance the efficiency of the business and IT service-level structure. Communicate these opportunities to management in order for the improvements to take effect." ;
    p1z:parentProcess apqc:PCF20632 .

apqc:PCF20641 a p1z:Process ;
    skos:prefLabel "Manage IT customer relationships" ;
    p1z:apqcId "20641" ;
    p1z:apqcHierarchyId "8.1.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the IT relationship with its customers by systematically coordinating interactions over multiple touch points on a regular basis. Coordinate the IT's efforts to reach out to its customers, which include emails, social-media interactions, newsletters, and direct conversations." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20642 a p1z:Process ;
    skos:prefLabel "Establish relationship management mechanisms" ;
    p1z:apqcId "20642" ;
    p1z:apqcHierarchyId "8.1.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create mechanisms for effective public relationship in order to preserve the image and goodwill of the organization through the process." ;
    p1z:parentProcess apqc:PCF20641 .

apqc:PCF20643 a p1z:Process ;
    skos:prefLabel "Understand IT customer strategy" ;
    p1z:apqcId "20643" ;
    p1z:apqcHierarchyId "8.1.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the strategy for staff dependent on information technology. Create a plan to create services and solutions, conduct daily operations, and train new employees." ;
    p1z:parentProcess apqc:PCF20641 .

apqc:PCF20644 a p1z:Process ;
    skos:prefLabel "Understand IT customer environment" ;
    p1z:apqcId "20644" ;
    p1z:apqcHierarchyId "8.1.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding the environment of staff dependent on information technology. Assess and evaluate services and solutions used by customers to conduct daily operations, and train new employees." ;
    p1z:parentProcess apqc:PCF20641 .

apqc:PCF20645 a p1z:Process ;
    skos:prefLabel "Communicate IT capabilities" ;
    p1z:apqcId "20645" ;
    p1z:apqcHierarchyId "8.1.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying the goals and objectives of the IT function and how it contributes to the overall business objectives to staff and departments across the organization." ;
    p1z:parentProcess apqc:PCF20641 .

apqc:PCF20646 a p1z:Process ;
    skos:prefLabel "Manage IT requirements" ;
    p1z:apqcId "20646" ;
    p1z:apqcHierarchyId "8.1.6.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the IT requirements for business objectives. Identify the requirements of hardware and software equipment to store, retrieve, transmit, and manipulate data related to business operations. Consider factors such as functional, design, growth phases, and delivery schedule while managing IT requirements." ;
    p1z:parentProcess apqc:PCF20641 .

apqc:PCF20648 a p1z:Process ;
    skos:prefLabel "Analyze service performance" ;
    p1z:apqcId "20648" ;
    p1z:apqcHierarchyId "8.1.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Proactively manage IT service levels against IT customer requirements." ;
    p1z:parentProcess apqc:PCF20608 .

apqc:PCF20649 a p1z:Process ;
    skos:prefLabel "Assess SLA compliance" ;
    p1z:apqcId "20649" ;
    p1z:apqcHierarchyId "8.1.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gather data from each service target defined in an SLA for a time segment or review period to evaluate an overall performance percentage." ;
    p1z:parentProcess apqc:PCF20648 .

apqc:PCF20650 a p1z:Process ;
    skos:prefLabel "Triage SLA compliance issues" ;
    p1z:apqcId "20650" ;
    p1z:apqcHierarchyId "8.1.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Prioritizing SLA compliance issues and plan for remediation." ;
    p1z:parentProcess apqc:PCF20648 .

apqc:PCF20647 a p1z:Process ;
    skos:prefLabel "Collect feedback about IT products and services" ;
    p1z:apqcId "20647" ;
    p1z:apqcHierarchyId "8.1.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collecting customer feedback about IT products and services effectiveness based on overall satisfaction. The data is collected through surveys, customer responses, and feedbacks based on the delivered products/services." ;
    p1z:parentProcess apqc:PCF20648 .

apqc:PCF20938 a p1z:Process ;
    skos:prefLabel "Synthesize and distribute IT performance information" ;
    p1z:apqcId "20938" ;
    p1z:apqcHierarchyId "8.1.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing stakeholders with collected IT performance measures for further development based on evaluation." ;
    p1z:parentProcess apqc:PCF20648 .

apqc:PCF20652 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage IT business strategy" ;
    p1z:apqcId "20652" ;
    p1z:apqcHierarchyId "8.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Handling the business of IT. Create a organization-wide strategy for the IT function. Define the organization's IT architecture. Manage the IT portfolio. Research and innovate in the field of IT. Assess and convey the performance and the value of the IT function." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20653 a p1z:Process ;
    skos:prefLabel "Define business technology and governance strategy" ;
    p1z:apqcId "20653" ;
    p1z:apqcHierarchyId "8.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the need of technology in business and systematic implementation of IT investments. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). It comprises of assessing competitive technology components to ensure structural analysis, development, usage and security of technology for efficient business operations." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20654 a p1z:Process ;
    skos:prefLabel "Build and maintain IT strategic intelligence" ;
    p1z:apqcId "20654" ;
    p1z:apqcHierarchyId "8.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Building and maintaining intelligence towards changing organizational goals, supporting management, and operational or functional levels of the business. It is the ability to understand business trends that present threats or opportunities for IT in an organization." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20655 a p1z:Process ;
    skos:prefLabel "Monitor and map current and emerging technologies" ;
    p1z:apqcId "20655" ;
    p1z:apqcHierarchyId "8.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring and evaluating existing and forthcoming technologies to meet the current and future growth plans for business operations." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20656 a p1z:Process ;
    skos:prefLabel "Define and communicate digital transformation strategy" ;
    p1z:apqcId "20656" ;
    p1z:apqcHierarchyId "8.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the integration of digital technology into business operations and service delivery, and convey the strategy to different segments of business. It is always backed by continuous improvement followed by periodic review and change per requirement of the business." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20657 a p1z:Process ;
    skos:prefLabel "Develop IT strategic alignment" ;
    p1z:apqcId "20657" ;
    p1z:apqcHierarchyId "8.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing the process of aligning the organization's business divisions and staff members with the organization's planned objectives for IT." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20658 a p1z:Process ;
    skos:prefLabel "Articulate IT alignment principles" ;
    p1z:apqcId "20658" ;
    p1z:apqcHierarchyId "8.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Systematic approach to clearly communicate and operate the usage of information technology as it relates to business objectives." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20659 a p1z:Process ;
    skos:prefLabel "Maintain IT strategic alignment" ;
    p1z:apqcId "20659" ;
    p1z:apqcHierarchyId "8.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining alignment of the organization's business divisions and staff members with the organization's planned objectives for IT." ;
    p1z:parentProcess apqc:PCF20653 .

apqc:PCF20660 a p1z:Process ;
    skos:prefLabel "Manage IT portfolio strategy" ;
    p1z:apqcId "20660" ;
    p1z:apqcHierarchyId "8.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Strategy for systematic management of IT investments, projects, and activities. Analyze and examine the value of the IT portfolio and allocate resources based on business objectives." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20661 a p1z:Process ;
    skos:prefLabel "Establish and validate IT value criteria" ;
    p1z:apqcId "20661" ;
    p1z:apqcHierarchyId "8.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and certify the standards to determine the value of the investments, projects, and activities of IT function for the overall business objectives." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20662 a p1z:Process ;
    skos:prefLabel "Determine IT portfolio investment balance" ;
    p1z:apqcId "20662" ;
    p1z:apqcHierarchyId "8.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining the uninvested amount out of the total approved amount for overall IT management, IT investments, projects, and activities." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20663 a p1z:Process ;
    skos:prefLabel "Evaluate proposed IT investment projects" ;
    p1z:apqcId "20663" ;
    p1z:apqcHierarchyId "8.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Evaluating IT investment projects to achieve overall business objectives in regard to implementation, efficiency, and profitability." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20664 a p1z:Process ;
    skos:prefLabel "Prioritize IT projects" ;
    p1z:apqcId "20664" ;
    p1z:apqcHierarchyId "8.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Listing the IT projects in the order of most important to the least. Determining which of many IT projects are most important or critical to business operations." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20665 a p1z:Process ;
    skos:prefLabel "Align IT resources to strategic priorities" ;
    p1z:apqcId "20665" ;
    p1z:apqcHierarchyId "8.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning physical IT resources like software, IT infrastructure, networks, and non-physical resources like technology expertise, to strategic objectives ranked by their importance in achieving the strategic goals." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20667 a p1z:Process ;
    skos:prefLabel "Align IT portfolio to business objectives" ;
    p1z:apqcId "20667" ;
    p1z:apqcHierarchyId "8.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning IT investments, projects, and activities to achieve overall business objectives." ;
    p1z:parentProcess apqc:PCF20660 .

apqc:PCF20668 a p1z:Process ;
    skos:prefLabel "Define and maintain enterprise architecture" ;
    p1z:apqcId "20668" ;
    p1z:apqcHierarchyId "8.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Outlining and maintaining the organization's IT architecture. Establish the IT architecture definition and framework. Ensure the relevance of IT. Create and confirm the approach for IT maintenance. Create rules and regulations to guide IT architecture. Authenticate and finalize all IT related research and innovation that takes place within the organization." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20670 a p1z:Process ;
    skos:prefLabel "Create and publish enterprise architecture principles" ;
    p1z:apqcId "20670" ;
    p1z:apqcHierarchyId "8.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and publishing high level statements of the fundamental values (principles) based on the organization's objectives that guide Information Technology decision-making and activities, and are the foundation for enterprise architecture." ;
    p1z:parentProcess apqc:PCF20668 .

apqc:PCF20671 a p1z:Process ;
    skos:prefLabel "Establish and operate enterprise architecture governance" ;
    p1z:apqcId "20671" ;
    p1z:apqcHierarchyId "8.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and operating a structure by which an enterprise defines appropriate strategies and ensures development alignment with those strategies. Create and establish the rules, regulations, policies, and standards that will govern the individual components of the IT architecture, as well as the architecture in its entirety." ;
    p1z:parentProcess apqc:PCF20668 .

apqc:PCF20672 a p1z:Process ;
    skos:prefLabel "Research technologies to innovate IT services and solutions" ;
    p1z:apqcId "20672" ;
    p1z:apqcHierarchyId "8.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Systematically investigating and studying materials and sources relevant to the IT function. Reach meaningful insights and conclusions in the form of new ideas and innovation for delivering IT services and solutions." ;
    p1z:parentProcess apqc:PCF20668 .

apqc:PCF20673 a p1z:Process ;
    skos:prefLabel "Provide input to definition and prioritization of IT projects" ;
    p1z:apqcId "20673" ;
    p1z:apqcHierarchyId "8.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyze the value driven through IT projects and redefine and/or reprioritize. Evaluate planning, organizing, and implementation of IT projects based on research outcomes and business objectives." ;
    p1z:parentProcess apqc:PCF20668 .

apqc:PCF20674 a p1z:Process ;
    skos:prefLabel "Define IT service management strategy" ;
    p1z:apqcId "20674" ;
    p1z:apqcHierarchyId "8.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Defining perspective, position, plans, and patterns needed to execute designing, delivering, managing, and improving the way information technology is used within an organization." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20675 a p1z:Process ;
    skos:prefLabel "Establish IT service management strategy and goals" ;
    p1z:apqcId "20675" ;
    p1z:apqcHierarchyId "8.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing strategy for designing, delivering, managing, and improving the way information technology be used in the organization. The goal of IT Service Management is to ensure that the right processes, people, and technology are in place to meet business goals." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20676 a p1z:Process ;
    skos:prefLabel "Identify IT service operating and process requirements" ;
    p1z:apqcId "20676" ;
    p1z:apqcHierarchyId "8.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying operating and process requirement for designing, delivering, managing, and improving the way information technology be used in the organization." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20677 a p1z:Process ;
    skos:prefLabel "Define IT service catalog" ;
    p1z:apqcId "20677" ;
    p1z:apqcHierarchyId "8.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and design an organized and curated collection of all IT-related services that can be performed by, for, or within the organization." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20678 a p1z:Process ;
    skos:prefLabel "Establish IT service management framework" ;
    p1z:apqcId "20678" ;
    p1z:apqcHierarchyId "8.2.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create a layered structure for IT service management framework ensuring right processes, people, and technology are in place to meet business goals." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20679 a p1z:Process ;
    skos:prefLabel "Define and implement IT service management" ;
    p1z:apqcId "20679" ;
    p1z:apqcHierarchyId "8.2.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and implementing activities involved in designing, creating, delivering, supporting, and managing the lifecycle of information technology services within an organization." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20680 a p1z:Process ;
    skos:prefLabel "Define and deploy support service management process tools and methods" ;
    p1z:apqcId "20680" ;
    p1z:apqcHierarchyId "8.2.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing services for providing support to users of IT services and solutions. Define the plethora of services along with tools and methods by which the organization assists users of computers, software products, or other electronic/mechanical products." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20681 a p1z:Process ;
    skos:prefLabel "Monitor and report IT performance" ;
    p1z:apqcId "20681" ;
    p1z:apqcHierarchyId "8.2.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supervising, analyzing, and reporting performance of information technology to ensure they are on-course and on-schedule in meeting the organizational objectives and performance targets." ;
    p1z:parentProcess apqc:PCF20674 .

apqc:PCF20682 a p1z:Process ;
    skos:prefLabel "Control IT management system" ;
    p1z:apqcId "20682" ;
    p1z:apqcHierarchyId "8.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Regulating the IT management system through performance measures, governance, analysis, and monitoring through a variety of analytic tools. Evaluate IT finances, resource, services, projects, and value for report out." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20683 a p1z:Process ;
    skos:prefLabel "Determine IT performance measures" ;
    p1z:apqcId "20683" ;
    p1z:apqcHierarchyId "8.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining measures for evaluating the performance of IT services in the organization. Establish key performance indicators, including the IT services performance index." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20684 a p1z:Process ;
    skos:prefLabel "Define IT control points and assurance procedures governance model" ;
    p1z:apqcId "20684" ;
    p1z:apqcHierarchyId "8.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a governance model with its own structure and functions from where full or partial control can be exercised over the entire IT management system. Specify evaluation and quality control procedures in the structure." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20685 a p1z:Process ;
    skos:prefLabel "Monitor and analyze overall IT performance" ;
    p1z:apqcId "20685" ;
    p1z:apqcHierarchyId "8.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring and analyzing information technology performance measures to ensure timely completion, and that quality assurance is met at all steps of IT services." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20686 a p1z:Process ;
    skos:prefLabel "Monitor and analyze IT financial performance" ;
    p1z:apqcId "20686" ;
    p1z:apqcHierarchyId "8.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Checking and analyzing predetermined financial targets and timelines of IT management system. Monitoring their profitability, feasibility, and consistency. Study the revenues generated." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20687 a p1z:Process ;
    skos:prefLabel "Monitor and analyze IT value and benefits" ;
    p1z:apqcId "20687" ;
    p1z:apqcHierarchyId "8.2.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining and analyzing the value and benefits of IT service management to ensure benefits outweigh incurred costs." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20688 a p1z:Process ;
    skos:prefLabel "Optimize IT resource allocation" ;
    p1z:apqcId "20688" ;
    p1z:apqcHierarchyId "8.2.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create process to assign and manage IT assets that support organization's strategic goals." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20689 a p1z:Process ;
    skos:prefLabel "Manage IT projects and services interdependencies" ;
    p1z:apqcId "20689" ;
    p1z:apqcHierarchyId "8.2.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Manage capabilities required for the successful delivery of information technology projects, which, by extension, affect the success of the overall IT services." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20690 a p1z:Process ;
    skos:prefLabel "Report IT service and project performance" ;
    p1z:apqcId "20690" ;
    p1z:apqcHierarchyId "8.2.5.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Process of collecting, analyzing, and reporting information regarding the performance of IT services and projects." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20692 a p1z:Process ;
    skos:prefLabel "Select, deploy, and operate IT performance analytics tools" ;
    p1z:apqcId "20692" ;
    p1z:apqcHierarchyId "8.2.5.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Select, establish, and operate analytics tool to analyze data and extract actionable and commercially relevant information on IT performance to evaluate or increase performance." ;
    p1z:parentProcess apqc:PCF20682 .

apqc:PCF20693 a p1z:Process ;
    skos:prefLabel "Manage IT value portfolio" ;
    p1z:apqcId "20693" ;
    p1z:apqcHierarchyId "8.2.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and establishing the value portfolio. Defining, analyzing, and examining the value of projects, investments, and activities of the IT function." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20694 a p1z:Process ;
    skos:prefLabel "Assess performance against IT service and project value criteria" ;
    p1z:apqcId "20694" ;
    p1z:apqcHierarchyId "8.2.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Process of evaluating performance to collect and analyze IT services and projects. Ensure expected IT service and project value based on established criteria." ;
    p1z:parentProcess apqc:PCF20693 .

apqc:PCF20695 a p1z:Process ;
    skos:prefLabel "Quantify value of IT service and project portfolio investments" ;
    p1z:apqcId "20695" ;
    p1z:apqcHierarchyId "8.2.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate the value of the investments, projects, and activities of IT function by assigning it a quantifiable value with a profitable return to business operations." ;
    p1z:parentProcess apqc:PCF20693 .

apqc:PCF20696 a p1z:Process ;
    skos:prefLabel "Communicate business technology value contribution" ;
    p1z:apqcId "20696" ;
    p1z:apqcHierarchyId "8.2.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying the value addition through adopting technology targeting towards integrated profitable business operations." ;
    p1z:parentProcess apqc:PCF20693 .

apqc:PCF20697 a p1z:Process ;
    skos:prefLabel "Determine and implement IT portfolio adjustments" ;
    p1z:apqcId "20697" ;
    p1z:apqcHierarchyId "8.2.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and implementing IT investments, projects, and activities based on trending technological advancements in the existing environment in order to achieve overall business objectives." ;
    p1z:parentProcess apqc:PCF20693 .

apqc:PCF20699 a p1z:Process ;
    skos:prefLabel "Define and manage technology innovation" ;
    p1z:apqcId "20699" ;
    p1z:apqcHierarchyId "8.2.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Outline and manage the innovation of technology within the organization. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Research and understand emerging future technological concepts and capabilities. Plan for IT innovation investments. Plan and execute viable innovation projects." ;
    p1z:parentProcess apqc:PCF20652 .

apqc:PCF20700 a p1z:Process ;
    skos:prefLabel "Establish selection criteria for research initiatives" ;
    p1z:apqcId "20700" ;
    p1z:apqcHierarchyId "8.2.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the standard for selecting IT research initiatives to align with organizational criteria for implementing future technologies." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20701 a p1z:Process ;
    skos:prefLabel "Analyze emerging technology concepts" ;
    p1z:apqcId "20701" ;
    p1z:apqcHierarchyId "8.2.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing new and future technologies relevant to the organization's vision of its IT capabilities." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20702 a p1z:Process ;
    skos:prefLabel "Identify technology concepts and capabilities" ;
    p1z:apqcId "20702" ;
    p1z:apqcHierarchyId "8.2.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identification of conceptual elements that define the benefits of technology to business." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20703 a p1z:Process ;
    skos:prefLabel "Execute IT research projects" ;
    p1z:apqcId "20703" ;
    p1z:apqcHierarchyId "8.2.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement information technology research projects that focus on meeting the goals of the organization's IT services and capabilities." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20939 a p1z:Process ;
    skos:prefLabel "Evaluate IT research project outcomes" ;
    p1z:apqcId "20939" ;
    p1z:apqcHierarchyId "8.2.7.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing IT research projects based on defined outcome expectations." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20704 a p1z:Process ;
    skos:prefLabel "Identify and promote viable concepts" ;
    p1z:apqcId "20704" ;
    p1z:apqcHierarchyId "8.2.7.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine project viability. Promote relevant IT innovations that meet business objectives." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20705 a p1z:Process ;
    skos:prefLabel "Develop and plan IT investment projects" ;
    p1z:apqcId "20705" ;
    p1z:apqcHierarchyId "8.2.7.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop and plan long-term allocation of funds for information technology endeavors to meet business goals." ;
    p1z:parentProcess apqc:PCF20699 .

apqc:PCF20706 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage IT resilience and risk" ;
    p1z:apqcId "20706" ;
    p1z:apqcHierarchyId "8.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Develop and include the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat to IT and cybersecurity. Build a dynamic, strategic, and integrated approach to managing IT and cyber risks, compliance obligations, and resilience, while ensuring alignment with global standards and frameworks." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20707 a p1z:Process ;
    skos:prefLabel "Develop IT compliance, risk, and security strategy" ;
    p1z:apqcId "20707" ;
    p1z:apqcHierarchyId "8.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Ensuring that the organization effectively manages IT and cybersecurity risks by developing rules, standards, and strategies that safeguard the confidentiality, integrity, and availability of IT and OT assets. Establish compliance objectives, align with recognized cybersecurity frameworks, and integrate IT and OT risk management to create a unified approach." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20708 a p1z:Process ;
    skos:prefLabel "Determine and evaluate IT regulatory and audit requirements" ;
    p1z:apqcId "20708" ;
    p1z:apqcHierarchyId "8.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and evaluating IT regulatory and audit requirements. Train employees on regulatory and audit requirements. Records for the appropriate regulatory and audit agencies must be maintained and the new product process must be approved by the appropriate regulatory body before it is published to the organization." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20940 a p1z:Process ;
    skos:prefLabel "Understand business unit risk tolerance" ;
    p1z:apqcId "20940" ;
    p1z:apqcHierarchyId "8.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understand the risk tolerance levels of individual business units, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20709 a p1z:Process ;
    skos:prefLabel "Establish IT risk tolerance" ;
    p1z:apqcId "20709" ;
    p1z:apqcHierarchyId "8.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine the specific maximum risk to take in quantitative terms for each relevant risk sub-category, including strategic, operational, financial, and compliance risks." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20710 a p1z:Process ;
    skos:prefLabel "Establish risk ownership" ;
    p1z:apqcId "20710" ;
    p1z:apqcHierarchyId "8.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establish an individual or a group who is ultimately accountable for ensuring that IT risks are managed appropriately." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20711 a p1z:Process ;
    skos:prefLabel "Establish and maintain risk management roles" ;
    p1z:apqcId "20711" ;
    p1z:apqcHierarchyId "8.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine and maintain roles that are specialized in each risk areas and coordinating all risk management activities for IT function with due escalation structure." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20712 a p1z:Process ;
    skos:prefLabel "Establish compliance objectives" ;
    p1z:apqcId "20712" ;
    p1z:apqcHierarchyId "8.3.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing compliance objectives which ensures that the organization has systems of internal controls that adequately measure and manage IT risk." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20941 a p1z:Process ;
    skos:prefLabel "Identify systems to support compliance" ;
    p1z:apqcId "20941" ;
    p1z:apqcHierarchyId "8.3.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and adopting information technology solutions to support changing regulatory compliance. Safeguard compliance and manage risk by outlining the risk policies and procedures." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20713 a p1z:Process ;
    skos:prefLabel "Identify and evaluate IT risk" ;
    p1z:apqcId "20713" ;
    p1z:apqcHierarchyId "8.3.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a timely and continuous process to identify and evaluate activities that might hinder IT operations or an IT project's goals." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20714 a p1z:Process ;
    skos:prefLabel "Evaluate IT-related risks resiliency" ;
    p1z:apqcId "20714" ;
    p1z:apqcHierarchyId "8.3.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Assess IT-related risk resilience strategies to ensure that the organization effectively manages its risk." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20715 a p1z:Process ;
    skos:prefLabel "Create IT risk mitigation strategies and approaches" ;
    p1z:apqcId "20715" ;
    p1z:apqcHierarchyId "8.3.1.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing activities to improve performance opportunities and lessen threats in IT. Evolve strategies and policies to attain organizational objectives." ;
    p1z:parentProcess apqc:PCF20707 .

apqc:PCF20716 a p1z:Process ;
    skos:prefLabel "Develop IT resilience strategy" ;
    p1z:apqcId "20716" ;
    p1z:apqcHierarchyId "8.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing resilience strategies across IT and cybersecurity functions to proactively avoid risks and disruptions. Identify critical risks, prioritize them based on business needs, and establish mitigation approaches to ensure the organization\u2019s ability to adapt and recover from cyber and IT-related threats." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20717 a p1z:Process ;
    skos:prefLabel "Determine IT delivery resiliency" ;
    p1z:apqcId "20717" ;
    p1z:apqcHierarchyId "8.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining resilience strategies to ensure that IT effectively manages it's delivery process to mitigate risk." ;
    p1z:parentProcess apqc:PCF20716 .

apqc:PCF20718 a p1z:Process ;
    skos:prefLabel "Determine critical IT risks" ;
    p1z:apqcId "20718" ;
    p1z:apqcHierarchyId "8.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining risks that could disrupt objectives of IT including physical, security, data, network, and cybersecurity." ;
    p1z:parentProcess apqc:PCF20716 .

apqc:PCF20719 a p1z:Process ;
    skos:prefLabel "Prioritize IT risks" ;
    p1z:apqcId "20719" ;
    p1z:apqcHierarchyId "8.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Prioritize potential IT risks based on business need to ensure overall IT stability." ;
    p1z:parentProcess apqc:PCF20716 .

apqc:PCF20720 a p1z:Process ;
    skos:prefLabel "Establish mitigation approaches for IT risks" ;
    p1z:apqcId "20720" ;
    p1z:apqcHierarchyId "8.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing activities to improve opportunities and lessen threats for IT." ;
    p1z:parentProcess apqc:PCF20716 .

apqc:PCF20721 a p1z:Process ;
    skos:prefLabel "Control IT risk, compliance, and security" ;
    p1z:apqcId "20721" ;
    p1z:apqcHierarchyId "8.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Ensuring effective control over IT and cybersecurity risks, compliance obligations, and security measures. Formulate and execute guidelines in line with regulatory bodies and organizational security objectives. Implement proactive measures such as threat intelligence, vulnerability management, and OT-specific controls to safeguard the organization\u2019s IT and OT environments. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20722 a p1z:Process ;
    skos:prefLabel "Evaluate enterprise regulatory and compliance obligations" ;
    p1z:apqcId "20722" ;
    p1z:apqcHierarchyId "8.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluation of dynamic, strategic, and integrated approach to manage regulatory requirements and compliance obligations." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20723 a p1z:Process ;
    skos:prefLabel "Analyze IT security threat impact" ;
    p1z:apqcId "20723" ;
    p1z:apqcHierarchyId "8.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the impact of threats to critical IT assets across different departments and functions in the organization in terms of quantifiable results." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20724 a p1z:Process ;
    skos:prefLabel "Create and maintain IT compliance requirements" ;
    p1z:apqcId "20724" ;
    p1z:apqcHierarchyId "8.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop and maintain IT compliance standards. Maintaining requirements set forth by such directives as GRCP, PMI RMP, CGRC, CGEIT, CRMA." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20942 a p1z:Process ;
    skos:prefLabel "Create and maintain IT security policies, standards, and procedures" ;
    p1z:apqcId "20942" ;
    p1z:apqcHierarchyId "8.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop and maintain an architecture for securing and ensuring the privacy of data flows throughout the organization. Create, test, evaluate, and implement IT security policies to ensure the safe use of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20725 a p1z:Process ;
    skos:prefLabel "Develop and deploy risk management training" ;
    p1z:apqcId "20725" ;
    p1z:apqcHierarchyId "8.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop and implement training in regard to managing IT risks, understanding criticality, impact, and opportunities associated with business objectives." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20726 a p1z:Process ;
    skos:prefLabel "Establish risk reporting capabilities and responsibilities" ;
    p1z:apqcId "20726" ;
    p1z:apqcHierarchyId "8.3.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing processes to communicate IT risk to the organization." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20727 a p1z:Process ;
    skos:prefLabel "Establish communication standards" ;
    p1z:apqcId "20727" ;
    p1z:apqcHierarchyId "8.3.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing standards for communications within the organization which creates the road map for successful understanding of strategic initiatives for both business units and information technology services." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20728 a p1z:Process ;
    skos:prefLabel "Conduct IT risk and threat assessments" ;
    p1z:apqcId "20728" ;
    p1z:apqcHierarchyId "8.3.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate IT risk and threat assessments by way of IT assets, information security, and breach points within the organization." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20729 a p1z:Process ;
    skos:prefLabel "Monitor and manage IT activity risk" ;
    p1z:apqcId "20729" ;
    p1z:apqcHierarchyId "8.3.3.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring and managing risks related to IT adoption within the organization." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20730 a p1z:Process ;
    skos:prefLabel "Identify, supervise and monitor IT risk mitigation measures" ;
    p1z:apqcId "20730" ;
    p1z:apqcHierarchyId "8.3.3.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and supervising a blueprint of measures for managing risk in IT. Monitor actions to enhance opportunities and reduce threats to project objectives." ;
    p1z:parentProcess apqc:PCF20721 .

apqc:PCF20731 a p1z:Process ;
    skos:prefLabel "Plan and manage IT continuity" ;
    p1z:apqcId "20731" ;
    p1z:apqcHierarchyId "8.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Planning and managing the organization\u2019s ability to recover from exposure to internal and external threats, with a focus on IT and cybersecurity. Ensure that continuity plans address cyber-specific scenarios, including ransomware attacks and other evolving threats, while maintaining uninterrupted operations of critical IT and OT services." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20732 a p1z:Process ;
    skos:prefLabel "Evaluate IT continuity" ;
    p1z:apqcId "20732" ;
    p1z:apqcHierarchyId "8.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating IT business needs and IT's ability to recover from internal or external threat exposure." ;
    p1z:parentProcess apqc:PCF20731 .

apqc:PCF20733 a p1z:Process ;
    skos:prefLabel "Identify IT continuity gaps" ;
    p1z:apqcId "20733" ;
    p1z:apqcHierarchyId "8.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the limitations of the IT organization's ability to remediate disruptions in IT services." ;
    p1z:parentProcess apqc:PCF20731 .

apqc:PCF20734 a p1z:Process ;
    skos:prefLabel "Manage IT business continuity" ;
    p1z:apqcId "20734" ;
    p1z:apqcHierarchyId "8.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Integrating the disciplines of Emergency Response, Crisis Management, Disaster Recovery (technology continuity) and Business Continuity for IT." ;
    p1z:parentProcess apqc:PCF20731 .

apqc:PCF20735 a p1z:Process ;
    skos:prefLabel "Develop and manage IT security, privacy, and data protection" ;
    p1z:apqcId "20735" ;
    p1z:apqcHierarchyId "8.3.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and deploying an architecture for securing and ensuring the privacy of data flows throughout the organization. Develop and implement protocols and policies to protect IT and OT environments, aligned with global standards. Incorporate modern security paradigms, such as Zero Trust Architecture, to ensure the safe use of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20736 a p1z:Process ;
    skos:prefLabel "Assess IT regulatory and confidentiality requirements and policies" ;
    p1z:apqcId "20736" ;
    p1z:apqcHierarchyId "8.3.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate principles or rules employed in controlling, directing, or managing IT services. Assessing requirements and policies related to confidentiality." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20737 a p1z:Process ;
    skos:prefLabel "Create IT security, privacy, and data protection risk governance" ;
    p1z:apqcId "20737" ;
    p1z:apqcHierarchyId "8.3.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and managing organization's approach to governing IT security and ensuring the privacy of data flows throughout the organization. Establish and manage tools to support the governance process in order to avoid misuse of information and breach of organizational privacy." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20738 a p1z:Process ;
    skos:prefLabel "Define IT data security and privacy policies, standards, and procedures" ;
    p1z:apqcId "20738" ;
    p1z:apqcHierarchyId "8.3.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining and establishing policies, regulations, standards, and procedures for IT data security and privacy." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20739 a p1z:Process ;
    skos:prefLabel "Review and monitor physical and logical IT data security measures" ;
    p1z:apqcId "20739" ;
    p1z:apqcHierarchyId "8.3.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, examining, and reviewing physical and logical IT data security measures such as hardware security (smart cards), cryptographic protocols, and access control." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20740 a p1z:Process ;
    skos:prefLabel "Review and monitor application security controls" ;
    p1z:apqcId "20740" ;
    p1z:apqcHierarchyId "8.3.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, examining, and reviewing security control for IT applications. Test, analyze, and implement security protocols in order to safeguard IT applications." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20741 a p1z:Process ;
    skos:prefLabel "Review and monitor IT physical environment security controls" ;
    p1z:apqcId "20741" ;
    p1z:apqcHierarchyId "8.3.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and examining security controls for physical environment of information technology such as business facilities, equipment, and resources." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20742 a p1z:Process ;
    skos:prefLabel "Monitor/analyze network intrusion detection data and resolve threats" ;
    p1z:apqcId "20742" ;
    p1z:apqcHierarchyId "8.3.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring and evaluating network intrusion detection for any malicious activity or policy violations. Identify the gaps in order to resolve threats and enhance existing network security." ;
    p1z:parentProcess apqc:PCF20735 .

apqc:PCF20743 a p1z:Process ;
    skos:prefLabel "Conduct and analyze IT compliance assessments" ;
    p1z:apqcId "20743" ;
    p1z:apqcHierarchyId "8.3.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate and analyze the IT environment for the compliance of industry regulations and government legislation. Ensure that IT capability and resources meet the set standards." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20744 a p1z:Process ;
    skos:prefLabel "Conduct projects to enhance IT compliance and remediate risk" ;
    p1z:apqcId "20744" ;
    p1z:apqcHierarchyId "8.3.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting projects in order to enhance set standards, established guidelines, and risk preventive measures for IT risk and resilience." ;
    p1z:parentProcess apqc:PCF20743 .

apqc:PCF20745 a p1z:Process ;
    skos:prefLabel "Conduct IT compliance control auditing of internal and external services" ;
    p1z:apqcId "20745" ;
    p1z:apqcHierarchyId "8.3.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examine compliance control systems and tools implemented for internal and external IT services." ;
    p1z:parentProcess apqc:PCF20743 .

apqc:PCF20746 a p1z:Process ;
    skos:prefLabel "Perform IT compliance reporting" ;
    p1z:apqcId "20746" ;
    p1z:apqcHierarchyId "8.3.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Execute IT compliance reporting in order to review processes, standards, regulations, and laws are followed as laid out by the regulatory bodies." ;
    p1z:parentProcess apqc:PCF20743 .

apqc:PCF20747 a p1z:Process ;
    skos:prefLabel "Identify and escalate IT compliance issues and remediation requirements" ;
    p1z:apqcId "20747" ;
    p1z:apqcHierarchyId "8.3.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify and escalate issues related to IT compliance to ensure that corrective measures are taken." ;
    p1z:parentProcess apqc:PCF20743 .

apqc:PCF20748 a p1z:Process ;
    skos:prefLabel "Support external audits and reports" ;
    p1z:apqcId "20748" ;
    p1z:apqcHierarchyId "8.3.6.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting audits and reports through external resources. This process requires the organization to follow all the regulations set forth by external auditors." ;
    p1z:parentProcess apqc:PCF20743 .

apqc:PCF20749 a p1z:Process ;
    skos:prefLabel "Develop and execute IT resilience and continuity operations" ;
    p1z:apqcId "20749" ;
    p1z:apqcHierarchyId "8.3.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and execute a process to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat in IT. Maintain continuous IT operations to protect employees, assets, and overall brand equity." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20750 a p1z:Process ;
    skos:prefLabel "Conduct IT resilience improvement projects" ;
    p1z:apqcId "20750" ;
    p1z:apqcHierarchyId "8.3.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting projects to improve the strategy and process for rapidly adapting to any threat in IT." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20751 a p1z:Process ;
    skos:prefLabel "Develop, document, and maintain IT business continuity planning" ;
    p1z:apqcId "20751" ;
    p1z:apqcHierarchyId "8.3.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop, document, and maintain plans to ensure uninterrupted operations of critical IT services (for example, ransomware recovery). Determine resources such as specialized personnel, equipment, support infrastructure, third-party access, legal and financial aspects." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20752 a p1z:Process ;
    skos:prefLabel "Implement and enforce change control procedures" ;
    p1z:apqcId "20752" ;
    p1z:apqcHierarchyId "8.3.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement and enforce procedures and policies in order to control changes in IT services and solutions. Manage changes in a rational and predictable manner for optimum resource utilization." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20753 a p1z:Process ;
    skos:prefLabel "Execute recurring IT service provider business continuity" ;
    p1z:apqcId "20753" ;
    p1z:apqcHierarchyId "8.3.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Review and implement resources (including external parties) necessary to support uninterrupted operations of critical IT services." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20754 a p1z:Process ;
    skos:prefLabel "Provide IT resilience training" ;
    p1z:apqcId "20754" ;
    p1z:apqcHierarchyId "8.3.7.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conduct and manage employee training programs on IT resilience so that prospective risks can be avoided." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20755 a p1z:Process ;
    skos:prefLabel "Execute recurring IT business operations continuity" ;
    p1z:apqcId "20755" ;
    p1z:apqcHierarchyId "8.3.7.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement regular resources supporting uninterrupted operations of critical IT services." ;
    p1z:parentProcess apqc:PCF20749 .

apqc:PCF20756 a p1z:Process ;
    skos:prefLabel "Manage IT user identity and authorization" ;
    p1z:apqcId "20756" ;
    p1z:apqcHierarchyId "8.3.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "The process of identifying, authenticating, and authorizing IT users to have access to applications, systems, IT components, or networks by associating user rights and restrictions with established identities." ;
    p1z:parentProcess apqc:PCF20706 .

apqc:PCF20757 a p1z:Process ;
    skos:prefLabel "Support integration of identity and authorization policies" ;
    p1z:apqcId "20757" ;
    p1z:apqcHierarchyId "8.3.8.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and implement policies that integrate authorization policies with authorized profiles of users meant to access network resources." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20758 a p1z:Process ;
    skos:prefLabel "Manage IT user directory" ;
    p1z:apqcId "20758" ;
    p1z:apqcHierarchyId "8.3.8.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing directory of user profiles and access requirements across different levels in the organization's IT network." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20759 a p1z:Process ;
    skos:prefLabel "Manage IT user authorization" ;
    p1z:apqcId "20759" ;
    p1z:apqcHierarchyId "8.3.8.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the process of authorizing IT users to access applications, systems, IT components, or networks by associating user rights." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20760 a p1z:Process ;
    skos:prefLabel "Manage IT user authentication mechanisms" ;
    p1z:apqcId "20760" ;
    p1z:apqcHierarchyId "8.3.8.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and manage the process to authenticate IT users from user directory based on the internal policies." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20761 a p1z:Process ;
    skos:prefLabel "Audit IT user identity and authorization systems" ;
    p1z:apqcId "20761" ;
    p1z:apqcHierarchyId "8.3.8.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examine the processes responsible for reviewing IT user identity and authorization." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20762 a p1z:Process ;
    skos:prefLabel "Respond to IT information security and network breaches" ;
    p1z:apqcId "20762" ;
    p1z:apqcHierarchyId "8.3.8.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Address any form of unauthorized network breach such as unauthorized access or usage of data, applications, services, networks, and/or devices. Identify the root cause and take corrective measures to resolve the breach." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20763 a p1z:Process ;
    skos:prefLabel "Conduct penetration testing" ;
    p1z:apqcId "20763" ;
    p1z:apqcHierarchyId "8.3.8.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conduct penetration testing (pen test) through an authorized stimulated attack to identify security weakness in an IT environment by evaluating the system or network with various harmful techniques." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20764 a p1z:Process ;
    skos:prefLabel "Audit integration of user identity and authorization systems" ;
    p1z:apqcId "20764" ;
    p1z:apqcHierarchyId "8.3.8.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing the processes responsible for integration of user identity and access authorization in order to confirm that all the required regulations are followed." ;
    p1z:parentProcess apqc:PCF20756 .

apqc:PCF20765 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage information" ;
    p1z:apqcId "20765" ;
    p1z:apqcHierarchyId "8.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies to manage the organization's information and content. Outline the architecture for information. Administer information resources. Administer the management of data and content." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20766 a p1z:Process ;
    skos:prefLabel "Define business information and analytics strategy" ;
    p1z:apqcId "20766" ;
    p1z:apqcHierarchyId "8.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Create an organization-wide strategy for the IT function by combining skills, technologies, applications, and processes in order to attain organizations objectives. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF20765 .

apqc:PCF20767 a p1z:Process ;
    skos:prefLabel "Establish data, information, and analytic objectives" ;
    p1z:apqcId "20767" ;
    p1z:apqcHierarchyId "8.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing strategies for securing and ensuring the privacy of data flows throughout the organization. Create protocols and guidelines for individual IT components. Outline analytic objectives in order to avoid misuse of information." ;
    p1z:parentProcess apqc:PCF20766 .

apqc:PCF20768 a p1z:Process ;
    skos:prefLabel "Establish data, information, and analytic governance" ;
    p1z:apqcId "20768" ;
    p1z:apqcHierarchyId "8.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a set of guidelines that ensure effective and efficient use of IT. Define data, information, and analytic governance to reach the organization's goal." ;
    p1z:parentProcess apqc:PCF20766 .

apqc:PCF20769 a p1z:Process ;
    skos:prefLabel "Access IT data/analytic capabilities" ;
    p1z:apqcId "20769" ;
    p1z:apqcHierarchyId "8.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the request for data accessibility and analysis. Review the details based on internal data security policies and permit data access only if internal policies and data access parameters are met." ;
    p1z:parentProcess apqc:PCF20766 .

apqc:PCF20770 a p1z:Process ;
    skos:prefLabel "Define and maintain business information architecture" ;
    p1z:apqcId "20770" ;
    p1z:apqcHierarchyId "8.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating strategies to manage the organization's information and content. Outline the architecture for information collection and communication. Administer information resources, data management and content." ;
    p1z:parentProcess apqc:PCF20765 .

apqc:PCF20771 a p1z:Process ;
    skos:prefLabel "Determine enterprise business information requirements" ;
    p1z:apqcId "20771" ;
    p1z:apqcHierarchyId "8.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining strategies to manage the enterprise wide flow of business information and content. Outline the required architecture for information resources." ;
    p1z:parentProcess apqc:PCF20770 .

apqc:PCF20772 a p1z:Process ;
    skos:prefLabel "Define enterprise data models" ;
    p1z:apqcId "20772" ;
    p1z:apqcHierarchyId "8.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Define different ways of representation, usage, and identification of data with independent or interdependent sources across the organization." ;
    p1z:parentProcess apqc:PCF20770 .

apqc:PCF20773 a p1z:Process ;
    skos:prefLabel "Identify and understand external data sources" ;
    p1z:apqcId "20773" ;
    p1z:apqcHierarchyId "8.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and understanding external sources of data in relevance of reliability, security, and authenticity." ;
    p1z:parentProcess apqc:PCF20770 .

apqc:PCF20774 a p1z:Process ;
    skos:prefLabel "Establish data ownership and stewardship responsibilities" ;
    p1z:apqcId "20774" ;
    p1z:apqcHierarchyId "8.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing entities responsible for data accuracy, integrity, and timeliness that can authorize or deny access to certain data. Develop data utilizing governance processes to ensure fitness of data elements." ;
    p1z:parentProcess apqc:PCF20770 .

apqc:PCF20775 a p1z:Process ;
    skos:prefLabel "Maintain and evolve enterprise data and information architecture" ;
    p1z:apqcId "20775" ;
    p1z:apqcHierarchyId "8.4.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and maintaining the process of designing, creating, deploying, and managing strategies to maintain enterprise data and information architecture." ;
    p1z:parentProcess apqc:PCF20770 .

apqc:PCF20776 a p1z:Process ;
    skos:prefLabel "Define and execute business information lifecycle planning and control" ;
    p1z:apqcId "20776" ;
    p1z:apqcHierarchyId "8.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop and implement strategies to plan and manage the flow of an information system's data from creation and initial storage to the time when it becomes obsolete and deleted." ;
    p1z:parentProcess apqc:PCF20765 .

apqc:PCF20777 a p1z:Process ;
    skos:prefLabel "Define and maintain enterprise information policies, standards, and procedures" ;
    p1z:apqcId "20777" ;
    p1z:apqcHierarchyId "8.4.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining and establishing policies for information and setting information standards and procedures. Establish policies to regulate the creation, use, storage, access, communication, and dissemination of information." ;
    p1z:parentProcess apqc:PCF20776 .

apqc:PCF20778 a p1z:Process ;
    skos:prefLabel "Implement and execute data administration responsibilities" ;
    p1z:apqcId "20778" ;
    p1z:apqcHierarchyId "8.4.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing and executing strategies for processes and technologies that support the collection, managing, and storing of data." ;
    p1z:parentProcess apqc:PCF20776 .

apqc:PCF20779 a p1z:Process ;
    skos:prefLabel "Manage business information" ;
    p1z:apqcId "20779" ;
    p1z:apqcHierarchyId "8.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating strategies to administer information and content. Understand the needs of the organization for information and content management. Realize the role of IT services for implementing the overall business strategy. Assess the implications of new technologies for managing information and content. Identify and prioritize the most effective and efficient actions for managing information and content." ;
    p1z:parentProcess apqc:PCF20765 .

apqc:PCF20780 a p1z:Process ;
    skos:prefLabel "Monitor and control business information" ;
    p1z:apqcId "20780" ;
    p1z:apqcHierarchyId "8.4.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the rules, diction, and logic that make up the framework of the organization's information architecture. Monitoring and controlling information attributes that flow through the IT framework." ;
    p1z:parentProcess apqc:PCF20779 .

apqc:PCF20781 a p1z:Process ;
    skos:prefLabel "Maintain business information feeds and repositories" ;
    p1z:apqcId "20781" ;
    p1z:apqcHierarchyId "8.4.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintain information feedstock along with IT hardware and software needed for storage, access, and retrieval of business information." ;
    p1z:parentProcess apqc:PCF20779 .

apqc:PCF20782 a p1z:Process ;
    skos:prefLabel "Perform internal usage audits" ;
    p1z:apqcId "20782" ;
    p1z:apqcHierarchyId "8.4.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Verification of information access and usage through regular reports on organizational performance." ;
    p1z:parentProcess apqc:PCF20779 .

apqc:PCF20783 a p1z:Process ;
    skos:prefLabel "Implement and administer business information access" ;
    p1z:apqcId "20783" ;
    p1z:apqcHierarchyId "8.4.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement and manage the process for accessing information including issues related to copyright, open source, privacy, and security." ;
    p1z:parentProcess apqc:PCF20779 .

apqc:PCF20784 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage services/solutions" ;
    p1z:apqcId "20784" ;
    p1z:apqcHierarchyId "8.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Designing and maintaining the IT services/solutions catalogue. Evaluate the performance of IT services/solutions. Communicate the results to the management." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20785 a p1z:Process ;
    skos:prefLabel "Develop service/solution and integration strategy" ;
    p1z:apqcId "20785" ;
    p1z:apqcHierarchyId "8.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing service/solution along with creating a strategy that provides a base for delivering service/solution aligned with overall business needs. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI). Conduct research within the services/solutions field for development and integration." ;
    p1z:parentProcess apqc:PCF20784 .

apqc:PCF20786 a p1z:Process ;
    skos:prefLabel "Determine IT service/solution development" ;
    p1z:apqcId "20786" ;
    p1z:apqcHierarchyId "8.5.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the development of IT service/solution. Analyze the pros and cons of IT service/solution and it's methods on the basis of their cost effectiveness and development value." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20787 a p1z:Process ;
    skos:prefLabel "Define IT service/solution development processes/standards" ;
    p1z:apqcId "20787" ;
    p1z:apqcHierarchyId "8.5.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the methods and processes as the foundation for developing new IT platforms, components, software, and explore new standards for better IT usage in the organization." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20788 a p1z:Process ;
    skos:prefLabel "Identify, deploy, and support development methodologies and tools" ;
    p1z:apqcId "20788" ;
    p1z:apqcHierarchyId "8.5.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and implementing techniques and tools for development based on overall value addition to the IT environment." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20789 a p1z:Process ;
    skos:prefLabel "Establish service component criteria" ;
    p1z:apqcId "20789" ;
    p1z:apqcHierarchyId "8.5.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing standards for selection of IT service components." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20790 a p1z:Process ;
    skos:prefLabel "Understand and select reusable service components" ;
    p1z:apqcId "20790" ;
    p1z:apqcHierarchyId "8.5.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding and selecting reusable service components so that they can be cost-effective and efficient." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20791 a p1z:Process ;
    skos:prefLabel "Maintain service component portfolio" ;
    p1z:apqcId "20791" ;
    p1z:apqcHierarchyId "8.5.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and establishing service component portfolio by defining investments, and activities. Analyze and examine the value of the service component portfolio, and allocate resources towards it." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20792 a p1z:Process ;
    skos:prefLabel "Establish development standards exception governance" ;
    p1z:apqcId "20792" ;
    p1z:apqcHierarchyId "8.5.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating standards and procedures for developing IT services/solutions outside of defined business parameters." ;
    p1z:parentProcess apqc:PCF20785 .

apqc:PCF20793 a p1z:Process ;
    skos:prefLabel "Manage service/solution lifecycle planning" ;
    p1z:apqcId "20793" ;
    p1z:apqcHierarchyId "8.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Executing life-cycle planning for IT services and solutions. Develop new requirements and feature-function enhancements. Create and design a life cycle plan that addresses the current and future state of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20784 .

apqc:PCF20794 a p1z:Process ;
    skos:prefLabel "Monitor and track emerging technology capabilities" ;
    p1z:apqcId "20794" ;
    p1z:apqcHierarchyId "8.5.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Perform a systematic investigation to new and future technology capabilities for future upgrades." ;
    p1z:parentProcess apqc:PCF20793 .

apqc:PCF20795 a p1z:Process ;
    skos:prefLabel "Identify IT services/solutions" ;
    p1z:apqcId "20795" ;
    p1z:apqcHierarchyId "8.5.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying processes and supporting procedures that are performed by an organization to design, plan, deliver, operate, and control information technology services/solutions offered to customers." ;
    p1z:parentProcess apqc:PCF20793 .

apqc:PCF20796 a p1z:Process ;
    skos:prefLabel "Determine IT service/solution approach" ;
    p1z:apqcId "20796" ;
    p1z:apqcHierarchyId "8.5.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining an approach to create a base for delivering IT service/solution aligned with overall business needs while maintaining a tight control on delivery and costs." ;
    p1z:parentProcess apqc:PCF20793 .

apqc:PCF20797 a p1z:Process ;
    skos:prefLabel "Define IT solution lifecycle" ;
    p1z:apqcId "20797" ;
    p1z:apqcHierarchyId "8.5.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining solutions to satisfy business needs. IT solution lifecycle provides a means to address the full life cycle of an information technology solution and addresses the current and future state of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20793 .

apqc:PCF20798 a p1z:Process ;
    skos:prefLabel "Develop IT service/solution \"sunset\" plans" ;
    p1z:apqcId "20798" ;
    p1z:apqcHierarchyId "8.5.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing plans to retire IT service/solution resources when the service/solution is no longer feasible." ;
    p1z:parentProcess apqc:PCF20793 .

apqc:PCF20799 a p1z:Process ;
    skos:prefLabel "Develop and manage service/solution architecture" ;
    p1z:apqcId "20799" ;
    p1z:apqcHierarchyId "8.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating the architecture for the IT services and solutions. Assess architecture and business constraints in order to understand integration requirements. Promote existing architecture. Manage exceptions." ;
    p1z:parentProcess apqc:PCF20784 .

apqc:PCF20800 a p1z:Process ;
    skos:prefLabel "Assess IT application and infrastructure architecture constraints" ;
    p1z:apqcId "20800" ;
    p1z:apqcHierarchyId "8.5.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing limitations in IT application and infrastructure architecture that may hinder expected performance." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20801 a p1z:Process ;
    skos:prefLabel "Assess business constraints on IT service/solution" ;
    p1z:apqcId "20801" ;
    p1z:apqcHierarchyId "8.5.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate business limitations that may hinder IT service/solution performance." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20802 a p1z:Process ;
    skos:prefLabel "Determine IT component integration requirements" ;
    p1z:apqcId "20802" ;
    p1z:apqcHierarchyId "8.5.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the requirements to integrate IT components such as hardware, software, database, telecommunication, and network." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20803 a p1z:Process ;
    skos:prefLabel "Identify opportunities for IT component reuse" ;
    p1z:apqcId "20803" ;
    p1z:apqcHierarchyId "8.5.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identification of opportunities for reusing IT components so that they can be cost-effective and efficient." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20804 a p1z:Process ;
    skos:prefLabel "Promote adoption of existing service/solution architecture" ;
    p1z:apqcId "20804" ;
    p1z:apqcHierarchyId "8.5.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Encouraging acceptance of existing IT service/solution architecture in the organization." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20805 a p1z:Process ;
    skos:prefLabel "Develop and maintain service/solution architectures" ;
    p1z:apqcId "20805" ;
    p1z:apqcHierarchyId "8.5.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and maintaining a services and solutions architecture over a network that can be revised as needed or even eliminated in case of inefficiencies." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20806 a p1z:Process ;
    skos:prefLabel "Assess IT service/solution architecture conformance" ;
    p1z:apqcId "20806" ;
    p1z:apqcHierarchyId "8.5.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing functional compliance of the IT service/solution architecture. Safeguard compliance with guidelines for the architecture." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20807 a p1z:Process ;
    skos:prefLabel "Manage architectural exceptions" ;
    p1z:apqcId "20807" ;
    p1z:apqcHierarchyId "8.5.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and resolving any architectural exceptions. Address the internal inquiries related to architecture that cannot be addressed immediately. Research inquiries that require the need of exceptional methods." ;
    p1z:parentProcess apqc:PCF20799 .

apqc:PCF20808 a p1z:Process ;
    skos:prefLabel "Execute IT service/solution creation and testing" ;
    p1z:apqcId "20808" ;
    p1z:apqcHierarchyId "8.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding customer requirements. Design the IT services and solutions based on the requirements. Develop components for providing the requirements. Train resources to provide support. Test the IT services and solutions in advance. Confirm the customer experience post-sale." ;
    p1z:parentProcess apqc:PCF20784 .

apqc:PCF20809 a p1z:Process ;
    skos:prefLabel "Execute IT service/solution development lifecycle" ;
    p1z:apqcId "20809" ;
    p1z:apqcHierarchyId "8.5.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing an information system, aiming to produce a high quality system that meets or exceeds customer expectations, reaches completion within time and cost estimates, and is inexpensive to maintain and cost-effective to enhance." ;
    p1z:parentProcess apqc:PCF20808 .

apqc:PCF20817 a p1z:Process ;
    skos:prefLabel "Perform service/solution maintenance and testing" ;
    p1z:apqcId "20817" ;
    p1z:apqcHierarchyId "8.5.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Engaging in all aspects of service/solution maintenance and testing includes all preventative, routine, and corrective activates. Ensure that IT service/solution are functioning properly and regulations where applicable." ;
    p1z:parentProcess apqc:PCF20784 .

apqc:PCF20818 a p1z:Process ;
    skos:prefLabel "Execute IT service/solution maintenance lifecycle" ;
    p1z:apqcId "20818" ;
    p1z:apqcHierarchyId "8.5.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing IT service/solution maintenance lifecycle in order to reduce maintenance costs and increase reliability of IT infrastructure concerning service/solution related problems." ;
    p1z:parentProcess apqc:PCF20817 .

apqc:PCF20824 a p1z:FunctionalDomain ;
    skos:prefLabel "Deploy services/solutions" ;
    p1z:apqcId "20824" ;
    p1z:apqcHierarchyId "8.6" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Executing IT services/solutions by creating a strategy for deployment. Plan and execute the changes. Plan and administer the release of its IT services and solutions." ;
    p1z:parentProcess apqc:PCF20607 .

apqc:PCF20825 a p1z:Process ;
    skos:prefLabel "Develop and manage service/solution deployment strategy" ;
    p1z:apqcId "20825" ;
    p1z:apqcHierarchyId "8.6.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and implementing a strategy for the deployment of IT service/solution. Define all of the activities that make the IT function available for use. Establish the change policies for IT services and solutions. Define the deployment process, procedures, and tools. Select the most feasible and practical methodologies for the deployment process." ;
    p1z:parentProcess apqc:PCF20824 .

apqc:PCF20826 a p1z:Process ;
    skos:prefLabel "Assess IT deployment business impact" ;
    p1z:apqcId "20826" ;
    p1z:apqcHierarchyId "8.6.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate the impact of IT deployment (products/services) on the business. Compare pre and post development performance, behavior of resources, and cost to assess organizational benefit." ;
    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20827 a p1z:Process ;
    skos:prefLabel "Establish IT deployment policies" ;
    p1z:apqcId "20827" ;
    p1z:apqcHierarchyId "8.6.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
