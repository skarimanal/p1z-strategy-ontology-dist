    p1z:parentProcess apqc:PCF20825 .

apqc:PCF20828 a p1z:Process ;
    skos:prefLabel "Define and create deployment procedure workflow" ;
    p1z:apqcId "20828" ;
    p1z:apqcHierarchyId "8.6.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
