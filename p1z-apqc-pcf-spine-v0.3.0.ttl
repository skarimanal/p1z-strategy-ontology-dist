    p1z:parentProcess apqc:PCF20824 .

apqc:PCF20841 a p1z:Process ;
    skos:prefLabel "Asses IT change/release impact" ;
    p1z:apqcId "20841" ;
    p1z:apqcHierarchyId "8.6.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the impact of IT change/release on the business." ;
    p1z:parentProcess apqc:PCF20840 .

apqc:PCF20842 a p1z:Process ;
    skos:prefLabel "Confirm change/release compliance" ;
    p1z:apqcId "20842" ;
    p1z:apqcHierarchyId "8.6.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
