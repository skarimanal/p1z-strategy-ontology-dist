    p1z:parentProcess apqc:PCF20824 .

apqc:PCF20833 a p1z:Process ;
    skos:prefLabel "Assess IT deployment risk" ;
    p1z:apqcId "20833" ;
    p1z:apqcHierarchyId "8.6.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
