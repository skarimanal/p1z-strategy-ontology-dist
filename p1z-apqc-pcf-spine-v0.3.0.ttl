apqc:PCF20845 a p1z:Process ;
    skos:prefLabel "Create and communicate deployment schedule" ;
    p1z:apqcId "20845" ;
    p1z:apqcHierarchyId "8.6.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
