apqc:PCF20836 a p1z:Process ;
    skos:prefLabel "Plan and align user testing and resources" ;
    p1z:apqcId "20836" ;
    p1z:apqcHierarchyId "8.6.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
