    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20840 a p1z:Process ;
    skos:prefLabel "Manage change deployment control" ;
    p1z:apqcId "20840" ;
    p1z:apqcHierarchyId "8.6.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
