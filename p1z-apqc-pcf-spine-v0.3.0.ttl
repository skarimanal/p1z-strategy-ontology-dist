    p1z:apqcId "10916" ;
    p1z:apqcHierarchyId "9.8.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining roles, responsibilities, and accountabilities for effectiveness and proficiency of operations and reliability of financial reporting." ;
    p1z:parentProcess apqc:PCF10762 .

apqc:PCF11250 a p1z:Process ;
    skos:prefLabel "Define business process objectives and risks" ;
    p1z:apqcId "11250" ;
    p1z:apqcHierarchyId "9.8.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
