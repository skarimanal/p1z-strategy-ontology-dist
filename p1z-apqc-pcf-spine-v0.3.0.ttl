    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20834 a p1z:Process ;
    skos:prefLabel "Define implementation schedule and roll-out sequence" ;
    p1z:apqcId "20834" ;
    p1z:apqcHierarchyId "8.6.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
