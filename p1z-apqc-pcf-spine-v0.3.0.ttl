    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20837 a p1z:Process ;
    skos:prefLabel "Develop IT training" ;
    p1z:apqcId "20837" ;
    p1z:apqcHierarchyId "8.6.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and manage employee training programs by considering the need and availability of these programs. Manage all aspects related to the training programs." ;
    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20838 a p1z:Process ;
    skos:prefLabel "Create implementation communications" ;
    p1z:apqcId "20838" ;
    p1z:apqcHierarchyId "8.6.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating change implementation in IT services and solutions communications with employees and stakeholders." ;
    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20839 a p1z:Process ;
    skos:prefLabel "Manage IT roll-back procedures" ;
    p1z:apqcId "20839" ;
    p1z:apqcHierarchyId "8.6.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
