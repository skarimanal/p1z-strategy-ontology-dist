    p1z:apqcHierarchyId "8.6.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Strategizing and executing changes in IT solutions and services. Create a plan for deploying the changes. Communicate with stakeholders about the changes. Administer and implement the changes. Train the resources who will be affected by these changes. Install changes and verify their effect." ;
    p1z:parentProcess apqc:PCF20824 .

apqc:PCF20859 a p1z:Process ;
