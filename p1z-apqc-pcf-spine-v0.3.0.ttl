    p1z:parentProcess apqc:PCF10762 .

apqc:PCF21574 a p1z:Process ;
    skos:prefLabel "Operate controls and monitor compliance with internal controls policies and procedures" ;
    p1z:apqcId "21574" ;
    p1z:apqcHierarchyId "9.8.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
