    p1z:apqcId "20871" ;
    p1z:apqcHierarchyId "8.7.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining locations and types of IT services and solutions which need to be delivered." ;
    p1z:parentProcess apqc:PCF20867 .

apqc:PCF20872 a p1z:Process ;
    skos:prefLabel "Define IT service delivery sourcing strategy" ;
    p1z:apqcId "20872" ;
    p1z:apqcHierarchyId "8.7.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a strategy for sourcing delivery of IT services and solutions. Examine the pros and cons of various sources that can support the delivery process. Select the most feasible and cost-effective sources." ;
    p1z:parentProcess apqc:PCF20867 .

apqc:PCF20873 a p1z:Process ;
    skos:prefLabel "Define and develop service support strategy" ;
    p1z:apqcId "20873" ;
    p1z:apqcHierarchyId "8.7.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and creating a strategy for provision of support to users of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20874 a p1z:Process ;
    skos:prefLabel "Assess business objectives and IT service support delivery" ;
    p1z:apqcId "20874" ;
    p1z:apqcHierarchyId "8.7.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the goals of IT service support delivery and how it aligns to contribute to the overall business objectives." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20875 a p1z:Process ;
    skos:prefLabel "Define IT service support portfolio" ;
    p1z:apqcId "20875" ;
    p1z:apqcHierarchyId "8.7.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining different IT support services and solutions such as remote support and cloud support. Include planned IT initiatives and ongoing IT services (such as application support)." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20876 a p1z:Process ;
    skos:prefLabel "Create and maintain IT support model" ;
    p1z:apqcId "20876" ;
    p1z:apqcHierarchyId "8.7.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Design and maintaining an IT support model that defines the processes and procedures needed to support users of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20877 a p1z:Process ;
    skos:prefLabel "Develop IT support service sourcing strategy" ;
    p1z:apqcId "20877" ;
    p1z:apqcHierarchyId "8.7.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a strategy for sourcing resources to support users of IT services and solutions. Establish sources that will make use of e-mail, live support software online, or a tool where users can log a call or incident in order to retrieve IT support." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20878 a p1z:Process ;
    skos:prefLabel "Establish support service framework" ;
    p1z:apqcId "20878" ;
    p1z:apqcHierarchyId "8.7.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an agenda for the rules and regulations of support service that deal with providing support to users of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20879 a p1z:Process ;
    skos:prefLabel "Provide service support tools and technology" ;
    p1z:apqcId "20879" ;
    p1z:apqcHierarchyId "8.7.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing the tools and techniques to support users of IT services and solutions, and choosing the most appropriate tools and techniques. Evaluate the pros and cons of all the methodologies and tools available. Choose the most efficient and effective methodology." ;
    p1z:parentProcess apqc:PCF20873 .

apqc:PCF20880 a p1z:Process ;
    skos:prefLabel "Plan and manage service delivery control" ;
    p1z:apqcId "20880" ;
    p1z:apqcHierarchyId "8.7.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine and manage service delivery flow across different business functions. Understand the level of services needed by different stakeholders. Identify major service delivery touch points and criticality associated. Ensure timely communication with users." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20881 a p1z:Process ;
    skos:prefLabel "Plan operational activities for IT service delivery" ;
    p1z:apqcId "20881" ;
    p1z:apqcHierarchyId "8.7.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning different delivery services for operational activities within the IT function. Use service delivery systems to manage the IT service delivery services." ;
    p1z:parentProcess apqc:PCF20880 .

apqc:PCF20888 a p1z:Process ;
    skos:prefLabel "Develop and manage infrastructure resource planning" ;
    p1z:apqcId "20888" ;
    p1z:apqcHierarchyId "8.7.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and managing the resources required for administration of infrastructure. Manage the IT inventory and assets to meet organization's IT resource capacity." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20889 a p1z:Process ;
    skos:prefLabel "Develop IT service delivery strategy" ;
    p1z:apqcId "20889" ;
    p1z:apqcHierarchyId "8.7.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a strategy for delivering IT services and solutions. Establish the sourcing strategy. Establish the delivery process procedures and tools. Examine and choose the most effective methodologies and tools." ;
    p1z:parentProcess apqc:PCF20888 .

apqc:PCF20890 a p1z:Process ;
    skos:prefLabel "Assess IT infrastructure business objectives" ;
    p1z:apqcId "20890" ;
    p1z:apqcHierarchyId "8.7.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the goals and objectives of IT infrastructure and how it contributes to the overall business objectives." ;
    p1z:parentProcess apqc:PCF20888 .

apqc:PCF20891 a p1z:Process ;
    skos:prefLabel "Determine ongoing IT infrastructure capabilities" ;
    p1z:apqcId "20891" ;
    p1z:apqcHierarchyId "8.7.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining existing IT infrastructure capabilities. Identify the gaps and needs in order to enhance the existing IT infrastructure to meet growth objectives." ;
    p1z:parentProcess apqc:PCF20888 .

apqc:PCF20892 a p1z:Process ;
    skos:prefLabel "Plan IT infrastructure change" ;
    p1z:apqcId "20892" ;
    p1z:apqcHierarchyId "8.7.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify the gaps and needs of existing IT infrastructure. Plan and develop strategies to upgrade/replace existing IT infrastructure." ;
    p1z:parentProcess apqc:PCF20888 .

apqc:PCF20893 a p1z:Process ;
    skos:prefLabel "Plan and budget IT license usage volumes" ;
    p1z:apqcId "20893" ;
    p1z:apqcHierarchyId "8.7.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan associated with usage volumes of IT licenses. Develop a framework to govern the licensing of an IT services along with identified usage volumes. Determine the amount of investment in IT license usage volumes and how would the license volumes be financed." ;
    p1z:parentProcess apqc:PCF20888 .

apqc:PCF20895 a p1z:Process ;
    skos:prefLabel "Define service support planning" ;
    p1z:apqcId "20895" ;
    p1z:apqcHierarchyId "8.7.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Develop strategies and methodologies to provide service support. Examine service levels, support complexity, stakeholder requirements to offer service support." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20896 a p1z:Process ;
    skos:prefLabel "Understand IT support demand patterns" ;
    p1z:apqcId "20896" ;
    p1z:apqcHierarchyId "8.7.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate criticality catered by the IT support and expectations to resolve raised or identified issues. Determine the usual requests received for IT support for each area of IT operations. Ensure resolution to every identified or reported issue within specified SLAs." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20897 a p1z:Process ;
    skos:prefLabel "Determine required support resource levels, responsibilities, and capabilities" ;
    p1z:apqcId "20897" ;
    p1z:apqcHierarchyId "8.7.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining levels of required support resources along with their responsibilities, and capabilities to resolve IT issues. Evaluate and ensure that support resources are fulfilling their responsibilities n a timely manner." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20898 a p1z:Process ;
    skos:prefLabel "Maintain service support knowledge repository" ;
    p1z:apqcId "20898" ;
    p1z:apqcHierarchyId "8.7.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Create and maintain service support knowledge repository. Store, maintain, access, revise, and use knowledge for IT services. Review knowledge trends and implement knowledge transfer methodologies for competitive advantage." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20943 a p1z:Process ;
    skos:prefLabel "Maintain service support learning" ;
    p1z:apqcId "20943" ;
    p1z:apqcHierarchyId "8.7.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining and transfer of knowledge towards service support with the change/upgrade in technology over a stipulated period. Ensure IT staff is well trained and tested on the new learning of service support." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20899 a p1z:Process ;
    skos:prefLabel "Communicate service support needs" ;
    p1z:apqcId "20899" ;
    p1z:apqcHierarchyId "8.7.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conveying service support needs within the organization, with the objective of providing required support services. Define processes and procedures needed to support users of IT services and solutions. Convey these procedures to appropriate governing authority." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20900 a p1z:Process ;
    skos:prefLabel "Define IT escalation mechanisms" ;
    p1z:apqcId "20900" ;
    p1z:apqcHierarchyId "8.7.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining mechanisms to report for a higher degree of decision making depending on the criticality of IT escalations. Define the processes and procedures needed to follow for IT escalation at different levels. Convey the mechanisms within the organization." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20901 a p1z:Process ;
    skos:prefLabel "Manage IT service support resources" ;
    p1z:apqcId "20901" ;
    p1z:apqcHierarchyId "8.7.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing resources required for administration of IT service support. Establish sources that will make use of e-mail, live support software online, or a tool where users can log a call or incident in order to retrieve IT support." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20902 a p1z:Process ;
    skos:prefLabel "Coordinate with external support providers" ;
    p1z:apqcId "20902" ;
    p1z:apqcHierarchyId "8.7.5.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a strategy that will make use of multiple resources to coordinate with external support providers in order to make the support services work more smoother." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20903 a p1z:Process ;
    skos:prefLabel "Triage IT service delivery incidents" ;
    p1z:apqcId "20903" ;
    p1z:apqcHierarchyId "8.7.5.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Sorting the incidents of IT service delivery in certain order so that the services could be delivered based on the criticality." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20904 a p1z:Process ;
    skos:prefLabel "Monitor IT service support performance" ;
    p1z:apqcId "20904" ;
    p1z:apqcHierarchyId "8.7.5.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining methodology and frequency of assessment for measuring and monitoring performance of various processes and activities of IT service support against standard set goals." ;
    p1z:parentProcess apqc:PCF20895 .

apqc:PCF20905 a p1z:Process ;
    skos:prefLabel "Develop and manage service delivery operations" ;
    p1z:apqcId "20905" ;
    p1z:apqcHierarchyId "8.7.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and managing different delivery services using service delivery systems for operational activities within the IT function in order to achieve organizations goal." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20906 a p1z:Process ;
    skos:prefLabel "Operate and monitor online systems" ;
    p1z:apqcId "20906" ;
    p1z:apqcHierarchyId "8.7.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Operating and defining methodology of assessment for measuring and monitoring performance of online systems against its expected result." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20907 a p1z:Process ;
    skos:prefLabel "Run and monitor batch job schedule" ;
    p1z:apqcId "20907" ;
    p1z:apqcHierarchyId "8.7.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Operate and monitor the application of scheduling batch jobs to be run in the background at a certain date and time." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20908 a p1z:Process ;
    skos:prefLabel "Manage service delivery workloads" ;
    p1z:apqcId "20908" ;
    p1z:apqcHierarchyId "8.7.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyze and manage workload needs in relation to service delivery. Plan resources and mechanism around those workload needs so that services could be delivered smoothly." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20909 a p1z:Process ;
    skos:prefLabel "Manage infrastructure performance and capacity" ;
    p1z:apqcId "20909" ;
    p1z:apqcHierarchyId "8.7.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the performance and capacity of infrastructure by using key performance indicators to routinely track the performance and capacity levels. Review performance. Evaluate the efficiency and effectiveness of the infrastructure." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20910 a p1z:Process ;
    skos:prefLabel "Respond to unplanned operational issues" ;
    p1z:apqcId "20910" ;
    p1z:apqcHierarchyId "8.7.6.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Addressing to an issue in operational activities within the IT function, that occur outside of normal routine or preventative maintenance." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20911 a p1z:Process ;
    skos:prefLabel "Produce and distribute output media" ;
    p1z:apqcId "20911" ;
    p1z:apqcHierarchyId "8.7.6.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify and introduce resources to display output in a viewable form to key decision makers and evaluators." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20912 a p1z:Process ;
    skos:prefLabel "Monitor IT infrastructure security" ;
    p1z:apqcId "20912" ;
    p1z:apqcHierarchyId "8.7.6.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, examining, and recognizing any flaw or breach in security of IT infrastructure. Ensure that protocols and guidelines for individual IT components are being followed and there is no misuse of information and breach of individual or organizational privacy." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20913 a p1z:Process ;
    skos:prefLabel "Manage IT infrastructure/data recovery" ;
    p1z:apqcId "20913" ;
    p1z:apqcHierarchyId "8.7.6.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing resources of IT infrastructure and their recovery capacity. Manage storage, computer hardware, software, and infrastructure resources that can be stored as inventory or provided by the organization as needed. Managing backup/recovery for IT services and solutions. Use a backup system or application." ;
    p1z:parentProcess apqc:PCF20905 .

apqc:PCF20914 a p1z:Process ;
    skos:prefLabel "Manage infrastructure resource administration" ;
    p1z:apqcId "20914" ;
    p1z:apqcHierarchyId "8.7.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the resources required for administration of IT infrastructure. Manage the IT inventory and assets. Take care of the organization's IT resource capacity." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20915 a p1z:Process ;
    skos:prefLabel "Manage infrastructure configuration" ;
    p1z:apqcId "20915" ;
    p1z:apqcHierarchyId "8.7.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and tracking individual configuration items, documenting functional capabilities and interdependencies of IT infrastructure. Determining the gaps and needs in order to enhance existing infrastructure configuration." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20916 a p1z:Process ;
    skos:prefLabel "Perform infrastructure component maintenance" ;
    p1z:apqcId "20916" ;
    p1z:apqcHierarchyId "8.7.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and maintaining all aspects of infrastructure component maintenance. Ensure that all components of an IT infrastructure are functioning properly as per the expectation. Maintenance includes all preventative, routine, and corrective measures." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20917 a p1z:Process ;
    skos:prefLabel "Install/configure/upgrade infrastructure components" ;
    p1z:apqcId "20917" ;
    p1z:apqcHierarchyId "8.7.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Installing/configuring/upgrading all the components required for operational activities within IT infrastructure. Ensure that all components of an IT infrastructure are functioning properly and updated to latest version/technology." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20918 a p1z:Process ;
    skos:prefLabel "Maintain IT asset records" ;
    p1z:apqcId "20918" ;
    p1z:apqcHierarchyId "8.7.7.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining the complete list of IT items or resources available with the organization with the details on date of purchase, licenses, deployment and SLAs." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20919 a p1z:Process ;
    skos:prefLabel "Administer IT licenses/user agreements" ;
    p1z:apqcId "20919" ;
    p1z:apqcHierarchyId "8.7.7.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering and overseeing the terms and policies associated with licensing the IT intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20920 a p1z:Process ;
    skos:prefLabel "Provide IT infrastructure service and capabilities" ;
    p1z:apqcId "20920" ;
    p1z:apqcHierarchyId "8.7.7.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing all the infrastructure services and capabilities required for operational activities within the IT function supporting overall business objectives." ;
    p1z:parentProcess apqc:PCF20914 .

apqc:PCF20921 a p1z:Process ;
    skos:prefLabel "Operate IT user support" ;
    p1z:apqcId "20921" ;
    p1z:apqcHierarchyId "8.7.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing systematic user support functionality and capability through defined procedures. Determine, record, and monitor user requests. Execute issue/request resolution. Utilize escalation path when needed. Resolve issue/request." ;
    p1z:parentProcess apqc:PCF20866 .

apqc:PCF20922 a p1z:Process ;
    skos:prefLabel "Triage IT issues/requests" ;
    p1z:apqcId "20922" ;
    p1z:apqcHierarchyId "8.7.8.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate and assign IT issues/requests accordingly to allow for the correct routing of IT issues to the relevant support teams." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF20923 a p1z:Process ;
    skos:prefLabel "Provide IT resolution capabilities" ;
    p1z:apqcId "20923" ;
    p1z:apqcHierarchyId "8.7.8.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing the necessary skills and competencies required to efficiently provide IT resolution through the support structure." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF20925 a p1z:Process ;
    skos:prefLabel "Manage IT user requests" ;
    p1z:apqcId "20925" ;
    p1z:apqcHierarchyId "8.7.8.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an effective plan and structure to address and resolve requests of IT users. Determine, record, and monitor user requests. Obtain information about the effectiveness and performance of the user request handling process from the IT users through various means." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF20926 a p1z:Process ;
    skos:prefLabel "Escalate IT requests" ;
    p1z:apqcId "20926" ;
    p1z:apqcHierarchyId "8.7.8.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Follow processes and procedures to escalate IT requests to required levels for resolution or effective decision making when necessary." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF20927 a p1z:Process ;
    skos:prefLabel "Resolve IT issues/requests" ;
    p1z:apqcId "20927" ;
    p1z:apqcHierarchyId "8.7.8.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a structure to resolve issues/requests of IT services using different mechanisms." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF20928 a p1z:Process ;
    skos:prefLabel "Execute IT continuity and recovery action" ;
    p1z:apqcId "20928" ;
    p1z:apqcHierarchyId "8.7.8.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Successfully implement preventive measures to manage IT risk of exposure to internal and external threats. Integrating the disciplines of Emergency Response, Crisis Management, Disaster Recovery (technology continuity) and Business Continuity for IT." ;
    p1z:parentProcess apqc:PCF20921 .

apqc:PCF17058 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Financial Resources" ;
    p1z:apqcId "17058" ;
    p1z:apqcHierarchyId "9.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Overseeing key back-office processes for organizations. This category includes process groups related to planning and management accounting, revenue accounting, general accounting and reporting, fixed-asset project accounting, payroll, accounts payable and expense reimbursements, treasury operations, internal controls, tax management, international funds/consolidation, and global trade services." .

apqc:PCF10728 a p1z:FunctionalDomain ;
    skos:prefLabel "Perform planning and management accounting" ;
    p1z:apqcId "10728" ;
    p1z:apqcHierarchyId "9.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining different stages of the planning process and accounting. Classify, determine, analyze, interpret, and communicate information to make up-to-date business decisions for better management and control functions." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF21694 a p1z:Process ;
    skos:prefLabel "Develop and manage financial resources strategy" ;
    p1z:apqcId "21694" ;
    p1z:apqcHierarchyId "9.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring the effective allocation, utilization, and sustainability of financial assets. Activities include analyzing internal and external financial drivers; identifying long-term funding needs; evaluating investment, capital, and liquidity requirements; and defining guiding financial principles that support enterprise objectives." ;
    p1z:parentProcess apqc:PCF10728 .

apqc:PCF10738 a p1z:Process ;
    skos:prefLabel "Perform planning/budgeting/forecasting" ;
    p1z:apqcId "10738" ;
    p1z:apqcHierarchyId "9.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Allocating funds to meet future and current financial goals. Led by the chief financial officer, have the finance function plan, budget, and forecast in order to determine and describe long and short-term financial goals." ;
    p1z:parentProcess apqc:PCF10728 .

apqc:PCF10771 a p1z:Process ;
    skos:prefLabel "Develop and maintain budget policies and procedures" ;
    p1z:apqcId "10771" ;
    p1z:apqcHierarchyId "9.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Formulating financial budgetary guidelines and strategies. Develop a framework for rules and regulations regarding budgets. Create a step-by-step process to achieve financial goals." ;
    p1z:parentProcess apqc:PCF10738 .

apqc:PCF10772 a p1z:Process ;
    skos:prefLabel "Prepare periodic budgets and plans" ;
    p1z:apqcId "10772" ;
    p1z:apqcHierarchyId "9.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating reports on a quarterly or annual basis for fund allocation. Create a financial statement that estimates revenues and expenses over a specific period of time. (Leverage budget methods such as cost-based and zero-based budgeting techniques, in light of the periodic targets outlined during Develop and maintain budget policies and procedures [10771].)" ;
    p1z:parentProcess apqc:PCF10738 .

apqc:PCF20135 a p1z:Process ;
    skos:prefLabel "Operationalize and implement plans to achieve budget" ;
    p1z:apqcId "20135" ;
    p1z:apqcHierarchyId "9.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Putting budgeting plans into practical use keeping within designated forecasting parameters." ;
    p1z:parentProcess apqc:PCF10738 .

apqc:PCF10773 a p1z:Process ;
    skos:prefLabel "Prepare periodic financial forecasts" ;
    p1z:apqcId "10773" ;
    p1z:apqcHierarchyId "9.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating estimates of the projected income and expenses required over a predetermined time frame. Develop the projections of profit and loss statements, balance sheets, and the cash flow forecast." ;
    p1z:parentProcess apqc:PCF10738 .

apqc:PCF20136 a p1z:Process ;
    skos:prefLabel "Perform variance analysis against forecasts and budgets" ;
    p1z:apqcId "20136" ;
    p1z:apqcHierarchyId "9.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting a quantitative analysis between what was forecasted and budgeted and actual financial behavior." ;
    p1z:parentProcess apqc:PCF10738 .

apqc:PCF10739 a p1z:Process ;
    skos:prefLabel "Perform cost accounting and control" ;
    p1z:apqcId "10739" ;
    p1z:apqcHierarchyId "9.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Defining costs to be incurred and methods for optimum utilization. Determine the costs of products, processes, projects, etc. to compile in the financial statements, as well as to assist management in making decisions regarding planning and control. Control costs by managing and reducing business expenses." ;
    p1z:parentProcess apqc:PCF10728 .

apqc:PCF10774 a p1z:Process ;
    skos:prefLabel "Perform inventory accounting" ;
    p1z:apqcId "10774" ;
    p1z:apqcHierarchyId "9.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting accounting for assets, and finding reasons for changes (depreciation, obsolescence, deterioration, change in customer taste, increased demand, decreased market supply, etc.)." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF14057 a p1z:Process ;
    skos:prefLabel "Perform profit center accounting" ;
    p1z:apqcId "14057" ;
    p1z:apqcHierarchyId "9.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the revenue, profits, and losses incurred by each unit within the organization that produces profit." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF10775 a p1z:Process ;
    skos:prefLabel "Perform cost of sales analysis" ;
    p1z:apqcId "10775" ;
    p1z:apqcHierarchyId "9.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Studying expenses directly associated with product. Analyze the cost of sales, which is the cost of manufacturing products." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF10776 a p1z:Process ;
    skos:prefLabel "Perform product costing" ;
    p1z:apqcId "10776" ;
    p1z:apqcHierarchyId "9.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Studying and finding out the relevant cost center for a product by studying every resource used in its making." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF10777 a p1z:Process ;
    skos:prefLabel "Perform variance analysis" ;
    p1z:apqcId "10777" ;
    p1z:apqcHierarchyId "9.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Discovering the changes between forecasted and actual costing. Analyze actual and planned behavior by reviewing the amount of a variance on a trend line in order to maintain control over a business." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF11175 a p1z:Process ;
    skos:prefLabel "Report on profitability" ;
    p1z:apqcId "11175" ;
    p1z:apqcHierarchyId "9.1.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Making a report about revenues generated by the organization or business unit concerned. This process requires the organization to create a report which shows how business is generating profits. Profits are the part which is left after paying all expenses directly related to the generation of the revenue, such as producing a product, and other expenses related to conducting business activities." ;
    p1z:parentProcess apqc:PCF10739 .

apqc:PCF10740 a p1z:Process ;
    skos:prefLabel "Perform cost management" ;
    p1z:apqcId "10740" ;
    p1z:apqcHierarchyId "9.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Deciding which expenses can be avoided to reduce some costs and increase revenues. Plan and control the organization's budget to forecast future expenditures." ;
    p1z:parentProcess apqc:PCF10728 .

apqc:PCF10778 a p1z:Process ;
    skos:prefLabel "Determine key cost drivers" ;
    p1z:apqcId "10778" ;
    p1z:apqcHierarchyId "9.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining cost drivers for a particular activity." ;
    p1z:parentProcess apqc:PCF10740 .

apqc:PCF10779 a p1z:Process ;
    skos:prefLabel "Measure cost drivers" ;
    p1z:apqcId "10779" ;
    p1z:apqcHierarchyId "9.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating cost drivers." ;
    p1z:parentProcess apqc:PCF10740 .

apqc:PCF10780 a p1z:Process ;
    skos:prefLabel "Determine critical activities" ;
    p1z:apqcId "10780" ;
    p1z:apqcHierarchyId "9.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine the activities that hinder the progress of finance activities. This requires the organization to determine those business activities carried out by the financial function of the organization and which are indispensable. This undertaking helps the organization triangulate those activities which are essential and where costs cannot be slashed." ;
    p1z:parentProcess apqc:PCF10740 .

apqc:PCF10781 a p1z:Process ;
    skos:prefLabel "Manage asset resource deployment and utilization" ;
    p1z:apqcId "10781" ;
    p1z:apqcHierarchyId "9.1.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Distributing or allocating asset resources in different processes for optimal utilization." ;
    p1z:parentProcess apqc:PCF10740 .

apqc:PCF10741 a p1z:Process ;
    skos:prefLabel "Evaluate and manage financial performance" ;
    p1z:apqcId "10741" ;
    p1z:apqcHierarchyId "9.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Checking and achieving predetermined financial targets and timelines. Assess and manage the profitability, feasibility, and consistency of a business or project. Study the revenues generated." ;
    p1z:parentProcess apqc:PCF10728 .

apqc:PCF10782 a p1z:Process ;
    skos:prefLabel "Assess customer and product profitability" ;
    p1z:apqcId "10782" ;
    p1z:apqcHierarchyId "9.1.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Studying product demand and targeted customer preferences. Study customers' demands or preferences after deducting the cost of delivering the final product." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10783 a p1z:Process ;
    skos:prefLabel "Evaluate new products" ;
    p1z:apqcId "10783" ;
    p1z:apqcHierarchyId "9.1.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking demand about a specific product by a customer segment. Conduct a detailed study--or research a customer behavior or preference for a product--in order to determine its production and profitability in a specific market." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10784 a p1z:Process ;
    skos:prefLabel "Perform life cycle costing" ;
    p1z:apqcId "10784" ;
    p1z:apqcHierarchyId "9.1.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the cost of delivering an end product at different stages of production. Study the total life cycle of a product/process to determine how much revenue and production cost will be incurred at every stage in order to make strategic decisions." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10785 a p1z:Process ;
    skos:prefLabel "Optimize customer and product mix" ;
    p1z:apqcId "10785" ;
    p1z:apqcHierarchyId "9.1.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating the best fit between a product and the end user. Maximize the customer base by providing different products in the market." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10786 a p1z:Process ;
    skos:prefLabel "Track performance of new-customer and product strategies" ;
    p1z:apqcId "10786" ;
    p1z:apqcHierarchyId "9.1.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Observing the behavior of a new set of customers for different products. Prepare strategies to improve sales and profits." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10787 a p1z:Process ;
    skos:prefLabel "Prepare activity-based performance measures" ;
    p1z:apqcId "10787" ;
    p1z:apqcHierarchyId "9.1.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating performance based on different sets of activities created by management to measure performance." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10788 a p1z:Process ;
    skos:prefLabel "Manage continuous cost improvement" ;
    p1z:apqcId "10788" ;
    p1z:apqcHierarchyId "9.1.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting activities to improve cost distribution regularly. Follow or adopt different ways of reducing costs." ;
    p1z:parentProcess apqc:PCF10741 .

apqc:PCF10729 a p1z:FunctionalDomain ;
    skos:prefLabel "Perform revenue accounting" ;
    p1z:apqcId "10729" ;
    p1z:apqcHierarchyId "9.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Comparing revenue targets to reality. Review all transactions and entries passed in final accounts in a year in order to examine profits." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF10742 a p1z:Process ;
    skos:prefLabel "Process customer credit" ;
    p1z:apqcId "10742" ;
    p1z:apqcHierarchyId "9.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Evaluating and processing requests for advances. Evaluate credit requests by customers requiring loans to buy products/services." ;
    p1z:parentProcess apqc:PCF10729 .

apqc:PCF10789 a p1z:Process ;
    skos:prefLabel "Establish credit policies" ;
    p1z:apqcId "10789" ;
    p1z:apqcHierarchyId "9.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating guidelines for providing advances. Set up credit standards, credit terms, and collection policies." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF10790 a p1z:Process ;
    skos:prefLabel "Analyze/Approve new account applications" ;
    p1z:apqcId "10790" ;
    p1z:apqcHierarchyId "9.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Checking and accepting new requests based on eligibility criteria. Analyze the status of applicants and requirements to be met for a new account." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF14187 a p1z:Process ;
    skos:prefLabel "Analyze credit scoring history" ;
    p1z:apqcId "14187" ;
    p1z:apqcHierarchyId "9.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing past credit scores to determine the if a line of credit will be extended to potential customers. This could also include extending additional credit to existing accounts." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF14188 a p1z:Process ;
    skos:prefLabel "Forecast credit scoring requirement" ;
    p1z:apqcId "14188" ;
    p1z:apqcHierarchyId "9.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning credit score requirements based on established credit policies." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF10791 a p1z:Process ;
    skos:prefLabel "Review existing accounts" ;
    p1z:apqcId "10791" ;
    p1z:apqcHierarchyId "9.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Evaluating existing account holders and their past performance. Regularly review existing accounts to get the required information about the status at present." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF10792 a p1z:Process ;
    skos:prefLabel "Produce credit/collection reports" ;
    p1z:apqcId "10792" ;
    p1z:apqcHierarchyId "9.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing account payable reports about payments to be made according to accounting rules and principles, and providing the reports to management." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF10793 a p1z:Process ;
    skos:prefLabel "Reinstate or suspend accounts based on credit policies" ;
    p1z:apqcId "10793" ;
    p1z:apqcHierarchyId "9.2.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Closing or restarting accounts according to changes made in credit policies." ;
    p1z:parentProcess apqc:PCF10742 .

apqc:PCF10743 a p1z:Process ;
    skos:prefLabel "Invoice customer" ;
    p1z:apqcId "10743" ;
    p1z:apqcHierarchyId "9.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing detailed reports of customer purchases. Prepare a commercial document between the seller and customer with details about transaction. Detail the quantity purchased, price of products/services, date, parties involved, unique invoice number, and tax information." ;
    p1z:parentProcess apqc:PCF10729 .

apqc:PCF10794 a p1z:Process ;
    skos:prefLabel "Maintain customer/product master files" ;
    p1z:apqcId "10794" ;
    p1z:apqcHierarchyId "9.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and updating a record of customers and the products being purchased by them in a database. This process element requires the organization to maintain a database of customers and their purchases. Such a master-file can be used to ensure customer touch point, enhance customer satisfaction, explore cross selling opportunities, and identify future trends. This database will include several particulars about the personal details of the organization's customers and a tracking of the products being sold." ;
    p1z:parentProcess apqc:PCF10743 .

apqc:PCF10795 a p1z:Process ;
    skos:prefLabel "Generate customer billing data" ;
    p1z:apqcId "10795" ;
    p1z:apqcHierarchyId "9.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing detailed reports about products purchased by customers. Record and generate a detail account of transactions made by customers fat a particular time and location. Include all details about products such as price, quantity, and name." ;
    p1z:parentProcess apqc:PCF10743 .

apqc:PCF10796 a p1z:Process ;
    skos:prefLabel "Transmit billing data to customers" ;
    p1z:apqcId "10796" ;
    p1z:apqcHierarchyId "9.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Providing information to customers about purchases made by them. Communicate the details of purchases. Provide customers with a copy of details for their reference." ;
    p1z:parentProcess apqc:PCF10743 .

apqc:PCF10797 a p1z:Process ;
    skos:prefLabel "Post receivable entries" ;
    p1z:apqcId "10797" ;
    p1z:apqcHierarchyId "9.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Registering transactions and their scheduled payments." ;
    p1z:parentProcess apqc:PCF10743 .

apqc:PCF10798 a p1z:Process ;
    skos:prefLabel "Resolve customer billing inquiries" ;
    p1z:apqcId "10798" ;
    p1z:apqcHierarchyId "9.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Checking and solving billing queries raised by customers." ;
    p1z:parentProcess apqc:PCF10743 .

apqc:PCF10744 a p1z:Process ;
    skos:prefLabel "Process accounts receivable (AR)" ;
    p1z:apqcId "10744" ;
    p1z:apqcHierarchyId "9.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Processing payments due from customers. This includes all processing of funds received, whether by check or electronically. This does not include the generation of invoices." ;
    p1z:parentProcess apqc:PCF10729 .

apqc:PCF10799 a p1z:Process ;
    skos:prefLabel "Establish AR policies" ;
    p1z:apqcId "10799" ;
    p1z:apqcHierarchyId "9.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating rules and regulations to be followed in case of credit sales to customers. Create rules and procedures to follow at the time of sale (e.g., the allowable number of installments)." ;
    p1z:parentProcess apqc:PCF10744 .

apqc:PCF10800 a p1z:Process ;
    skos:prefLabel "Receive/Deposit customer payments" ;
    p1z:apqcId "10800" ;
    p1z:apqcHierarchyId "9.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Collecting cash from customers. Deposit it into bank account. Make entries into the books of accounts." ;
    p1z:parentProcess apqc:PCF10744 .

apqc:PCF10801 a p1z:Process ;
    skos:prefLabel "Apply cash remittances" ;
    p1z:apqcId "10801" ;
    p1z:apqcHierarchyId "9.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking and moving funds between countries for business activities, typically through authorized remittance agents." ;
    p1z:parentProcess apqc:PCF10744 .

apqc:PCF10802 a p1z:Process ;
    skos:prefLabel "Prepare AR reports" ;
    p1z:apqcId "10802" ;
    p1z:apqcHierarchyId "9.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing reports that detail balances due or what to collect from customers at a certain point in time." ;
    p1z:parentProcess apqc:PCF10744 .

apqc:PCF10803 a p1z:Process ;
    skos:prefLabel "Post AR activity to the general ledger" ;
    p1z:apqcId "10803" ;
    p1z:apqcHierarchyId "9.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing the general ledger for account receivables from journals. Place all journal entries related to accounts receivables in the general ledger accounts of a business." ;
    p1z:parentProcess apqc:PCF10744 .

apqc:PCF10745 a p1z:Process ;
    skos:prefLabel "Manage and process collections" ;
    p1z:apqcId "10745" ;
    p1z:apqcHierarchyId "9.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Posting entries to respective accounts, and preparing accounts for receivables. Manage the cash collected by the business from its debtors. Record it in the books of accounts to provide clear information about the availability of the cash." ;
    p1z:parentProcess apqc:PCF10729 .

apqc:PCF10804 a p1z:Process ;
    skos:prefLabel "Establish policies for delinquent accounts" ;
    p1z:apqcId "10804" ;
    p1z:apqcHierarchyId "9.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a process to follow in case of a failed payment by account holders. Create rules and regulations for the account holder who has failed to make at least the minimum monthly payment by the due date." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF10805 a p1z:Process ;
    skos:prefLabel "Analyze delinquent account balances" ;
    p1z:apqcId "10805" ;
    p1z:apqcHierarchyId "9.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining balance statements of accountholders who failed to make required payments. Study or review the account details of customers' past payments when preparing negotiations policies." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF10806 a p1z:Process ;
    skos:prefLabel "Correspond/Negotiate with delinquent accounts" ;
    p1z:apqcId "10806" ;
    p1z:apqcHierarchyId "9.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine ways for customers in default to repay debts (e.g., allowing more time or discounts)." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF10807 a p1z:Process ;
    skos:prefLabel "Discuss account resolution with internal parties" ;
    p1z:apqcId "10807" ;
    p1z:apqcHierarchyId "9.2.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining rules for handling accounts. Discuss and plan with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF10808 a p1z:Process ;
    skos:prefLabel "Process adjustments/write off balances" ;
    p1z:apqcId "10808" ;
    p1z:apqcHierarchyId "9.2.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Maintaining reserves for write-offs and adjustments. Adjust or write off certain expenses and losses." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF14007 a p1z:Process ;
    skos:prefLabel "Perform recovery workout" ;
    p1z:apqcId "14007" ;
    p1z:apqcHierarchyId "9.2.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Renegotiating the terms of a loan agreement in order to recoup money from a default account." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF14008 a p1z:Process ;
    skos:prefLabel "Manage default accounts" ;
    p1z:apqcId "14008" ;
    p1z:apqcHierarchyId "9.2.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing accounts that have not met the requirements agreed upon to pay off outstanding debts." ;
    p1z:parentProcess apqc:PCF10745 .

apqc:PCF10746 a p1z:Process ;
    skos:prefLabel "Manage and process adjustments/deductions" ;
    p1z:apqcId "10746" ;
    p1z:apqcHierarchyId "9.2.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and providing funds for necessary adjustments and deductions, including all expenses that were required for the business at certain point in time." ;
    p1z:parentProcess apqc:PCF10729 .

apqc:PCF10809 a p1z:Process ;
    skos:prefLabel "Establish policies/procedures for adjustments" ;
    p1z:apqcId "10809" ;
    p1z:apqcHierarchyId "9.2.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating guidelines to follow in case of adjustments to business processes." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10810 a p1z:Process ;
    skos:prefLabel "Analyze adjustments" ;
    p1z:apqcId "10810" ;
    p1z:apqcHierarchyId "9.2.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking changes made in accounts during the year. Examine the alterations made in final accounts to rectify errors/omissions." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10811 a p1z:Process ;
    skos:prefLabel "Correspond/Negotiate with customer" ;
    p1z:apqcId "10811" ;
    p1z:apqcHierarchyId "9.2.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing suitable offers to customers. Present different offers (e.g., discounts) available for customers or buyers." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10812 a p1z:Process ;
    skos:prefLabel "Discuss resolution with internal parties" ;
    p1z:apqcId "10812" ;
    p1z:apqcHierarchyId "9.2.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Discussing and planning with internal parties (department heads, managers, and senior management) about rules to follow in coming months." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10813 a p1z:Process ;
    skos:prefLabel "Prepare chargeback invoices" ;
    p1z:apqcId "10813" ;
    p1z:apqcHierarchyId "9.2.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a mechanism for consumer protection in case of a higher price charged. When a supplier sells a product at a higher price to the distributor than the price they have set with the end user, submit a chargeback to the supplier to recover the money lost in the transaction." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10814 a p1z:Process ;
    skos:prefLabel "Process related entries" ;
    p1z:apqcId "10814" ;
    p1z:apqcHierarchyId "9.2.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recording business transactions as they occur in order to provide a balanced accounts for financial reporting." ;
    p1z:parentProcess apqc:PCF10746 .

apqc:PCF10730 a p1z:FunctionalDomain ;
    skos:prefLabel "Perform general accounting and reporting" ;
    p1z:apqcId "10730" ;
    p1z:apqcHierarchyId "9.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Making statements about business activities and functions. Prepare financial statements (balance sheet, income statement, statement of cash flows, and statement of stockholders' equity) according to accounting concepts and principles." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF10747 a p1z:Process ;
    skos:prefLabel "Manage financial policies and procedures" ;
    p1z:apqcId "10747" ;
    p1z:apqcHierarchyId "9.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating procedures to perform general accounting and reporting. Follow the rules and regulations made for a particular process in the business. Publish accounting policies." ;
    p1z:parentProcess apqc:PCF10730 .

apqc:PCF10815 a p1z:Process ;
    skos:prefLabel "Negotiate service-level agreements" ;
    p1z:apqcId "10815" ;
    p1z:apqcHierarchyId "9.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Agreeing upon terms and conditions. Negotiate an agreement between two or more parties, the customer and service providers. Specify scope, quality, and responsibilities." ;
    p1z:parentProcess apqc:PCF10747 .

apqc:PCF10816 a p1z:Process ;
    skos:prefLabel "Establish accounting policies" ;
    p1z:apqcId "10816" ;
    p1z:apqcHierarchyId "9.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing policies and procedures to prepare financial statements, including methods, measurement systems, and procedures for providing disclosures." ;
    p1z:parentProcess apqc:PCF10747 .

apqc:PCF20604 a p1z:Process ;
    skos:prefLabel "Publish accounting policies" ;
    p1z:apqcId "20604" ;
    p1z:apqcHierarchyId "9.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a written copy of agreed-upon procedures for preparing financial statements, and making them available to the public." ;
    p1z:parentProcess apqc:PCF10747 .

apqc:PCF10817 a p1z:Process ;
    skos:prefLabel "Set and enforce approval limits" ;
    p1z:apqcId "10817" ;
    p1z:apqcHierarchyId "9.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Implementing parameters for accounting. Apply set conditions for any approval process." ;
    p1z:parentProcess apqc:PCF10747 .

apqc:PCF10818 a p1z:Process ;
    skos:prefLabel "Establish common financial systems" ;
    p1z:apqcId "10818" ;
    p1z:apqcHierarchyId "9.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Establishing processes and procedures to exercise financial control and accountability. Record, verify, and report transactions that affect revenues, expenditures, assets, and liabilities." ;
    p1z:parentProcess apqc:PCF10747 .

apqc:PCF10748 a p1z:Process ;
    skos:prefLabel "Perform general accounting" ;
    p1z:apqcId "10748" ;
    p1z:apqcHierarchyId "9.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Applying basic principles, concepts, and accounting practices in recording and preparing final accounts, and using accounting information in management." ;
    p1z:parentProcess apqc:PCF10730 .

apqc:PCF10819 a p1z:Process ;
    skos:prefLabel "Maintain chart of accounts" ;
    p1z:apqcId "10819" ;
    p1z:apqcHierarchyId "9.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing trial balance account from general ledgers. List all accounts used in the general ledger. Alter accounts according to business requirements." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10820 a p1z:Process ;
    skos:prefLabel "Process journal entries" ;
    p1z:apqcId "10820" ;
    p1z:apqcHierarchyId "9.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making ledger and trial balance accounts from journal entries. This process requires the organization to record every transaction into accounts done by business. It is a base documents for preparing final accounts of company." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10821 a p1z:Process ;
    skos:prefLabel "Process allocations" ;
    p1z:apqcId "10821" ;
    p1z:apqcHierarchyId "9.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Allocating funds across functions. Apportion funds in line with the budgets created. Formalize allocations in centralized internal records." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10822 a p1z:Process ;
    skos:prefLabel "Process period end adjustments" ;
    p1z:apqcId "10822" ;
    p1z:apqcHierarchyId "9.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Updating journal entries to adjust the balance of income and expenses at the end of an accounting period." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10823 a p1z:Process ;
    skos:prefLabel "Post and reconcile intercompany transactions" ;
    p1z:apqcId "10823" ;
    p1z:apqcHierarchyId "9.3.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Checking accounts separately for a parent and subsidiary company. Manage relationship between a parent company and subsidiaries. Document intercompany transactions in separate financial statements." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10824 a p1z:Process ;
    skos:prefLabel "Reconcile general ledger accounts" ;
    p1z:apqcId "10824" ;
    p1z:apqcHierarchyId "9.3.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Reviewing general ledger accounts for a parent and subsidiaries companies. Validate the integrity of account balances on the company's general ledger of accounts. Review and compare general ledger accounts balances with source documents to ensure that balances match." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10825 a p1z:Process ;
    skos:prefLabel "Perform consolidations and process eliminations" ;
    p1z:apqcId "10825" ;
    p1z:apqcHierarchyId "9.3.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Aggregating different processes in the business. Eliminate discontinued processes." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10826 a p1z:Process ;
    skos:prefLabel "Prepare trial balance" ;
    p1z:apqcId "10826" ;
    p1z:apqcHierarchyId "9.3.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Balancing debit and credit balances of trial balance to preparing final accounts. Calculate the total debits and credits in company's accounts. Correspond the sum of all debits with the sum of all credits. Adjust entries as appropriate." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10827 a p1z:Process ;
    skos:prefLabel "Prepare and post management adjustments" ;
    p1z:apqcId "10827" ;
    p1z:apqcHierarchyId "9.3.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Accounting for changes due to country-level policy changes. Record adjustments made by management in the accounts." ;
    p1z:parentProcess apqc:PCF10748 .

apqc:PCF10749 a p1z:Process ;
    skos:prefLabel "Perform fixed-asset accounting" ;
    p1z:apqcId "10749" ;
    p1z:apqcHierarchyId "9.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Accounting for long-term and fixed assets. Record purchased, fixed assets that are not easily convertible into cash. Account for costs, useful life, resale value, depreciation, and amortization." ;
    p1z:parentProcess apqc:PCF10730 .

apqc:PCF10828 a p1z:Process ;
    skos:prefLabel "Establish fixed-asset policies and procedures" ;
    p1z:apqcId "10828" ;
    p1z:apqcHierarchyId "9.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating rules for fixed assets market valuation. Make rules and regulations for fixed assets regarding depreciation, provisions, resale, usage, etc." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10829 a p1z:Process ;
    skos:prefLabel "Maintain fixed-asset master data files" ;
    p1z:apqcId "10829" ;
    p1z:apqcHierarchyId "9.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping reports up-to-date regarding fixed assets. Create a fixed assets database detailing price, life cycle, depreciation rate, resale value, installation information, usage information, etc." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10830 a p1z:Process ;
    skos:prefLabel "Process and record fixed-asset additions and retires" ;
    p1z:apqcId "10830" ;
    p1z:apqcHierarchyId "9.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping a summary of sales and purchases of assets. Record any expenses made for new assets purchased and sales of any old assets during the fiscal year." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10831 a p1z:Process ;
    skos:prefLabel "Process and record fixed-asset adjustments, enhancements, revaluations, and transfers" ;
    p1z:apqcId "10831" ;
    p1z:apqcHierarchyId "9.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Keeping a summary of expenses for installing and modifying assets. Record any expenses made for new assets purchased, any expenses incurred on improvements, the valuation of assets to reach current market price, and any transfer assets from one location to another during the fiscal year." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10832 a p1z:Process ;
    skos:prefLabel "Process and record fixed-asset maintenance and repair expenses" ;
    p1z:apqcId "10832" ;
    p1z:apqcHierarchyId "9.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining a record of expenses necessitated for repairs and the preservation of assets. Administer and oversee the maintenance and repair of any fixed assets. Record all related transactions." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10833 a p1z:Process ;
    skos:prefLabel "Calculate and record depreciation expense" ;
    p1z:apqcId "10833" ;
    p1z:apqcHierarchyId "9.3.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out accounting for depreciation over fixed assets. Compute the sums necessitated. Maintain a record of the cost value of fixed assets over their useful life in the book of accounts." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10834 a p1z:Process ;
    skos:prefLabel "Reconcile fixed-asset ledger" ;
    p1z:apqcId "10834" ;
    p1z:apqcHierarchyId "9.3.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Balancing the ledger account balance for fixed assets. Correct errors in the books of fixed assets. Provide correct information in relevant accounts." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10835 a p1z:Process ;
    skos:prefLabel "Track fixed-assets including physical inventory" ;
    p1z:apqcId "10835" ;
    p1z:apqcHierarchyId "9.3.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking and updating the record of all raw materials and fixed assets. Track all fixes asset. Maintain a record of all inventory items." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10836 a p1z:Process ;
    skos:prefLabel "Provide fixed-asset data to support tax, statutory, and regulatory reporting" ;
    p1z:apqcId "10836" ;
    p1z:apqcHierarchyId "9.3.3.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Showing market value and related expenses on fixed assets data for taxation. Provide complete information recorded in the books of fixed assets about purchase price, depreciation, installation charges, resale market value etc. for tax and regulatory purposes." ;
    p1z:parentProcess apqc:PCF10749 .

apqc:PCF10750 a p1z:Process ;
    skos:prefLabel "Perform financial reporting" ;
    p1z:apqcId "10750" ;
    p1z:apqcHierarchyId "9.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Reporting on the organization's financial status to stakeholders. Include balance sheets, income statements, cash flow statements, and statements of shareholders' equity." ;
    p1z:parentProcess apqc:PCF10730 .

apqc:PCF10837 a p1z:Process ;
    skos:prefLabel "Prepare business unit financial statements" ;
    p1z:apqcId "10837" ;
    p1z:apqcHierarchyId "9.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making reports of subsidiaries units to show profits generated from them. Prepare financial statements (balance sheets, income statements, cash flow statements and statements of shareholders' equity) for a single unit of a business." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10838 a p1z:Process ;
    skos:prefLabel "Prepare consolidated financial statements" ;
    p1z:apqcId "10838" ;
    p1z:apqcHierarchyId "9.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making final accounts for all units of company together. Prepare combined financial statements of a parent company and its subsidiaries (i.e., separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses, and cash flows." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10839 a p1z:Process ;
    skos:prefLabel "Perform business unit reporting/review management reports" ;
    p1z:apqcId "10839" ;
    p1z:apqcHierarchyId "9.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making reports for units/subsidiaries to help management in decision making. Prepare financial statements (balance sheets, income statements, cash flow statements, and statements of shareholders' equity) for a single unit of a business. Break down profits and losses by function/unit, clients, products, and region." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10840 a p1z:Process ;
    skos:prefLabel "Perform consolidated reporting/review of cost management reports" ;
    p1z:apqcId "10840" ;
    p1z:apqcHierarchyId "9.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making reports for all units to help higher management in decision making. Prepare combined financial statements of a parent company and its all subsidiaries (separate legal entities controlled by a parent company) showing assets, liabilities, equity, income, expenses and cash flows, and also going through periodic reports which shows the actual and estimated costs and their variances." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10841 a p1z:Process ;
    skos:prefLabel "Prepare statements for board review" ;
    p1z:apqcId "10841" ;
    p1z:apqcHierarchyId "9.3.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing a draft of financial statements for the board to review before they are sent to the auditor." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10842 a p1z:Process ;
    skos:prefLabel "Produce quarterly/annual filings and shareholder reports" ;
    p1z:apqcId "10842" ;
    p1z:apqcHierarchyId "9.3.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Making and presenting financial reports to stakeholders. Create annual and quarterly financial statements for reporting purposes. Prepare shareholder reports with details of the profit-and-loss account, balance sheet, and past year's business activities." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10843 a p1z:Process ;
    skos:prefLabel "Produce regulatory reports" ;
    p1z:apqcId "10843" ;
    p1z:apqcHierarchyId "9.3.4.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Reporting raw or summary data for final accounts following rules and regulations." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF14074 a p1z:Process ;
    skos:prefLabel "Perform legal and management consolidation" ;
    p1z:apqcId "14074" ;
    p1z:apqcHierarchyId "9.3.4.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Carrying out activities associated with legal and management consolidation. Legal consolidation can include currency conversion, balance carry forward, and consolidation of journal entries. Management consolidation can include reporting on financials on a reporting cycle basis to gauge the performance of the organization." ;
    p1z:parentProcess apqc:PCF10750 .

apqc:PCF10731 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage fixed-asset project accounting" ;
    p1z:apqcId "10731" ;
    p1z:apqcHierarchyId "9.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing accounts for large funds-invested projects. Manage and account for fixed assets projects (capital projects), which required significant capital investments over many years." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF10751 a p1z:Process ;
    skos:prefLabel "Perform capital planning and project approval" ;
    p1z:apqcId "10751" ;
    p1z:apqcHierarchyId "9.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Preparing a project finance report to solicit approvals in capital projects. Prepare budgets for projects that require heavy investments. Report on project finances to solicit approvals from management." ;
    p1z:parentProcess apqc:PCF10731 .

apqc:PCF10844 a p1z:Process ;
    skos:prefLabel "Develop capital investment policies and procedures" ;
    p1z:apqcId "10844" ;
    p1z:apqcHierarchyId "9.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating procedures and policies to follow for investing in capital projects. Create rules and regulations regarding large investment plans, which require in-depth forecasting for expenditure and revenue." ;
    p1z:parentProcess apqc:PCF10751 .

apqc:PCF10845 a p1z:Process ;
    skos:prefLabel "Develop and approve capital expenditure plans and budgets" ;
    p1z:apqcId "10845" ;
    p1z:apqcHierarchyId "9.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating budgets, and soliciting approvals for capital projects. Prepare budgets for projects that require heavy investments. Secure approvals from management." ;
    p1z:parentProcess apqc:PCF10751 .

apqc:PCF10846 a p1z:Process ;
    skos:prefLabel "Review and approve capital projects and fixed-asset acquisitions" ;
    p1z:apqcId "10846" ;
    p1z:apqcHierarchyId "9.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and supporting capital investments in projects and fixed assets. Confirm details of capital projects. Secure approvals from managements for large investments." ;
    p1z:parentProcess apqc:PCF10751 .

apqc:PCF10847 a p1z:Process ;
    skos:prefLabel "Conduct financial justification for project approval" ;
    p1z:apqcId "10847" ;
    p1z:apqcHierarchyId "9.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing all project business cases in order to substantiate projected financial gains. Validate any project's business case. Juxtapose the benefits derived from moving a project forward against the associated costs." ;
    p1z:parentProcess apqc:PCF10751 .

apqc:PCF10752 a p1z:Process ;
    skos:prefLabel "Perform capital project accounting" ;
    p1z:apqcId "10752" ;
    p1z:apqcHierarchyId "9.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Accounting for large-scale and large-cost investments. Manage and account for ongoing activities related to capital projects, including setting up new projects, recording project transactions, monitoring and tracking spending, closing and capitalizing projects, and measuring the financial returns on completed projects." ;
    p1z:parentProcess apqc:PCF10731 .

apqc:PCF10848 a p1z:Process ;
    skos:prefLabel "Create project account codes" ;
    p1z:apqcId "10848" ;
    p1z:apqcHierarchyId "9.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Giving reference codes for every project." ;
    p1z:parentProcess apqc:PCF10752 .

apqc:PCF10849 a p1z:Process ;
    skos:prefLabel "Record project-related transactions" ;
    p1z:apqcId "10849" ;
    p1z:apqcHierarchyId "9.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Noting every transaction during a project in a common financial database. Document all transactions associated with any project. Maintain a centralized repository of all such financial data." ;
    p1z:parentProcess apqc:PCF10752 .

apqc:PCF10850 a p1z:Process ;
    skos:prefLabel "Monitor and track capital projects and budget spending" ;
    p1z:apqcId "10850" ;
    p1z:apqcHierarchyId "9.4.2.3" ;
