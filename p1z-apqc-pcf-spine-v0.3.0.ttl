    p1z:parentProcess apqc:PCF20832 .

apqc:PCF20835 a p1z:Process ;
    skos:prefLabel "Determine implementation requirements" ;
    p1z:apqcId "20835" ;
    p1z:apqcHierarchyId "8.6.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
