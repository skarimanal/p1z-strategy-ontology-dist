apqc:PCF10928 a p1z:Process ;
    skos:prefLabel "Consolidate and optimize total tax plan" ;
    p1z:apqcId "10928" ;
    p1z:apqcHierarchyId "9.9.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Combining and enhancing a rational analysis of a financial condition or plan from a tax perspective in order to align financial goals through efficient tax planning." ;
    p1z:parentProcess apqc:PCF10765 .

apqc:PCF10929 a p1z:Process ;
    skos:prefLabel "Maintain tax master data" ;
    p1z:apqcId "10929" ;
    p1z:apqcHierarchyId "9.9.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining a master file about the rational analysis of a financial condition or plan from a tax perspective in order to align financial goals through efficient tax planning." ;
    p1z:parentProcess apqc:PCF10765 .

apqc:PCF10766 a p1z:Process ;
    skos:prefLabel "Process taxes" ;
    p1z:apqcId "10766" ;
    p1z:apqcHierarchyId "9.9.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Processing the taxes of the organization in line with the regional taxation structure, including corporate, property, excise, and service taxes." ;
    p1z:parentProcess apqc:PCF10736 .

apqc:PCF10930 a p1z:Process ;
    skos:prefLabel "Perform tax planning/strategy" ;
    p1z:apqcId "10930" ;
    p1z:apqcHierarchyId "9.9.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing strategies for taxes to be paid or collected by the business." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10931 a p1z:Process ;
    skos:prefLabel "Prepare tax returns" ;
    p1z:apqcId "10931" ;
    p1z:apqcHierarchyId "9.9.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing and submitting tax reports for every employee to the tax department in order to show the tax paid and deducted from their salaries in the year." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10932 a p1z:Process ;
    skos:prefLabel "Prepare foreign taxes" ;
    p1z:apqcId "10932" ;
    p1z:apqcHierarchyId "9.9.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing reports about paid or accrued foreign taxes to an overseas country." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10933 a p1z:Process ;
    skos:prefLabel "Calculate deferred taxes" ;
    p1z:apqcId "10933" ;
    p1z:apqcHierarchyId "9.9.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Calculating the income that has been realized when the tax on that income has not." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10934 a p1z:Process ;
    skos:prefLabel "Account for taxes" ;
    p1z:apqcId "10934" ;
    p1z:apqcHierarchyId "9.9.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the organization's financial accounts for the purpose of taxation. Prepare and maintain the tax paid by the organization to the country they have business in." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10935 a p1z:Process ;
    skos:prefLabel "Monitor tax compliance" ;
    p1z:apqcId "10935" ;
    p1z:apqcHierarchyId "9.9.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking and correcting the tax policies according to the rules and regulations set by the organization." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10936 a p1z:Process ;
    skos:prefLabel "Address tax inquiries" ;
    p1z:apqcId "10936" ;
    p1z:apqcHierarchyId "9.9.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Addressing any tax queries by any regulatory or government authorities. Review historical records related to taxation within the organization in order to respond to queries." ;
    p1z:parentProcess apqc:PCF10766 .

apqc:PCF10737 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage international funds/consolidation" ;
    p1z:apqcId "10737" ;
    p1z:apqcHierarchyId "9.10" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing cash collections and disbursements made by operating units across the enterprise. When appropriate, transfer cash from the operating units to parent-level bank accounts managed by the organization's treasury team." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF10767 a p1z:Process ;
    skos:prefLabel "Monitor international rates" ;
    p1z:apqcId "10767" ;
    p1z:apqcHierarchyId "9.10.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Forecasting and monitoring changes in foreign currency value or interest rates around the world that play an important role in the organization." ;
    p1z:parentProcess apqc:PCF10737 .

apqc:PCF10768 a p1z:Process ;
    skos:prefLabel "Manage transactions" ;
    p1z:apqcId "10768" ;
    p1z:apqcHierarchyId "9.10.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing any transfer of funds in the course of conducting cross-border trades or investments, including conversion across currencies. Find the most suitable alternative for making payments, while saving taxes and avoiding any unwarranted regulation, with the objective of protecting capital." ;
    p1z:parentProcess apqc:PCF10737 .

apqc:PCF10769 a p1z:Process ;
    skos:prefLabel "Monitor currency exposure/hedge currency" ;
    p1z:apqcId "10769" ;
    p1z:apqcHierarchyId "9.10.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing exposure to potential financial losses as a result of changes in the value of currencies. Forecast the impact of movements in foreign currency values. Enter into financial transactions designed to offset or limit potential exposure to loss." ;
    p1z:parentProcess apqc:PCF10737 .

apqc:PCF10770 a p1z:Process ;
    skos:prefLabel "Report results" ;
    p1z:apqcId "10770" ;
    p1z:apqcHierarchyId "9.10.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting and reporting accounting entries to formally report financial gains or losses experienced as a result of foreign exchange activity." ;
    p1z:parentProcess apqc:PCF10737 .

apqc:PCF17059 a p1z:FunctionalDomain ;
    skos:prefLabel "Perform global trade services" ;
    p1z:apqcId "17059" ;
    p1z:apqcHierarchyId "9.11" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Making and collecting payments for transactions in products/services, and transporting them to interested markets." ;
    p1z:parentProcess apqc:PCF17058 .

apqc:PCF14090 a p1z:Process ;
    skos:prefLabel "Screen sanctioned party list" ;
    p1z:apqcId "14090" ;
    p1z:apqcHierarchyId "9.11.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the approved list of parties for engaging in international trade in order to ensure the safety of the organization's business transactions. Examine agents that have been granted legal rights to engage in global trade and their credentials." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14091 a p1z:Process ;
    skos:prefLabel "Control exports and imports" ;
    p1z:apqcId "14091" ;
    p1z:apqcHierarchyId "9.11.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing and directing the flow of trade to/from the organization in order to ensure financial gains." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14092 a p1z:Process ;
    skos:prefLabel "Classify products" ;
    p1z:apqcId "14092" ;
    p1z:apqcHierarchyId "9.11.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Systematically categorizing products/services for their suitability to international trade. Create classes and categories for demarcating the types of products suitable for international trade. Study requisite national and international standards and the adherence of the organization's portfolio of offerings to these." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF19593 a p1z:Process ;
    skos:prefLabel "Perform currency conversion" ;
    p1z:apqcId "19593" ;
    p1z:apqcHierarchyId "9.11.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying current exchange rates between two currencies and converting the foreign currency to that of the local monetary unit. I.E., yen to US dollar." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14093 a p1z:Process ;
    skos:prefLabel "Calculate duty" ;
    p1z:apqcId "14093" ;
    p1z:apqcHierarchyId "9.11.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Computing the excise duty to be paid during international trade." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14094 a p1z:Process ;
    skos:prefLabel "Communicate with customs" ;
    p1z:apqcId "14094" ;
    p1z:apqcHierarchyId "9.11.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating with the customs department to ensure fluid compliance. Share pertinent information mandated by law with the government agency that controls and collects the duties levied for the international exchange of products/services." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14095 a p1z:Process ;
    skos:prefLabel "Document trade" ;
    p1z:apqcId "14095" ;
    p1z:apqcHierarchyId "9.11.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting and recording the trade processes while making transactions, noting the description, quality, number, transportation medium, indemnity, and inspection." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14096 a p1z:Process ;
    skos:prefLabel "Process trade preferences" ;
    p1z:apqcId "14096" ;
    p1z:apqcHierarchyId "9.11.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing global trade under preference, which allows the organization to import/export products at a lower or nil rate of customs duty and/or levy charge." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14097 a p1z:Process ;
    skos:prefLabel "Handle restitution" ;
    p1z:apqcId "14097" ;
    p1z:apqcHierarchyId "9.11.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering and overseeing all restitution activities the organization may be subjected to. Manage compliance with apposite legal frameworks. Make any restitution that may be required by law; comply with authorities over any fines or non-financial measures imposed." ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF14098 a p1z:Process ;
    skos:prefLabel "Prepare letter of credit" ;
    p1z:apqcId "14098" ;
    p1z:apqcHierarchyId "9.11.10" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a document assuring that a seller will receive payment when certain delivery conditions are met. (If the buyer is unable to make payment on the purchase, a bank covers the outstanding amount.)" ;
    p1z:parentProcess apqc:PCF17059 .

apqc:PCF19207 a p1z:FunctionalDomain ;
    skos:prefLabel "Acquire, Construct, and Manage Assets" ;
    p1z:apqcId "19207" ;
    p1z:apqcHierarchyId "10.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Relating to the design, construction, acquisition, and management of both productive and non-productive assets." .

apqc:PCF10937 a p1z:FunctionalDomain ;
    skos:prefLabel "Plan and acquire assets" ;
    p1z:apqcId "10937" ;
    p1z:apqcHierarchyId "10.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning, acquiring, and managing facilities, workspaces, and supporting assets. Acquire, configure, and manage facilities and workspaces, to include supporting equipment and materials." ;
    p1z:parentProcess apqc:PCF19207 .

apqc:PCF10941 a p1z:Process ;
    skos:prefLabel "Develop property strategy and long term vision" ;
    p1z:apqcId "10941" ;
    p1z:apqcHierarchyId "10.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Strategizing a long-term vision for managing properties. Prepare strategies and a long-term vision for managing purchased/retained properties." ;
    p1z:parentProcess apqc:PCF10937 .

apqc:PCF10955 a p1z:Process ;
    skos:prefLabel "Confirm alignment of property requirements with business strategy" ;
    p1z:apqcId "10955" ;
    p1z:apqcHierarchyId "10.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating alignment between the requirement of properties and the overall business strategy. This process requires the organization to align the requirement of properties in accordance with its business strategies of the organization." ;
    p1z:parentProcess apqc:PCF10941 .

apqc:PCF10956 a p1z:Process ;
    skos:prefLabel "Appraise the external environment" ;
    p1z:apqcId "10956" ;
    p1z:apqcHierarchyId "10.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the impact of the external environment. Evaluate the circumstances, objects, events, and aspects surrounding an organization that affects its actions and selections and that recognizes its opportunities and risks." ;
    p1z:parentProcess apqc:PCF10941 .

apqc:PCF10957 a p1z:Process ;
    skos:prefLabel "Determine build, buy, or lease decision" ;
    p1z:apqcId "10957" ;
    p1z:apqcHierarchyId "10.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding whether to buy or build properties. Study the market forces about property prices and cost of construction in order to take decisions based on the market research." ;
    p1z:parentProcess apqc:PCF10941 .

apqc:PCF10943 a p1z:Process ;
    skos:prefLabel "Plan facility" ;
    p1z:apqcId "10943" ;
    p1z:apqcHierarchyId "10.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Recognizing the needs of facility users in order to construct a project proposal that meets those needs." ;
    p1z:parentProcess apqc:PCF10937 .

apqc:PCF10958 a p1z:Process ;
    skos:prefLabel "Design facility" ;
    p1z:apqcId "10958" ;
    p1z:apqcHierarchyId "10.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing and analyzing different designs for a facility in order to finalize which design will be the most suitable option." ;
    p1z:parentProcess apqc:PCF10943 .

apqc:PCF10959 a p1z:Process ;
    skos:prefLabel "Analyze budget" ;
    p1z:apqcId "10959" ;
    p1z:apqcHierarchyId "10.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the feasibility of budgets prepared for the construction of facilities." ;
    p1z:parentProcess apqc:PCF10943 .

apqc:PCF10960 a p1z:Process ;
    skos:prefLabel "Select property" ;
    p1z:apqcId "10960" ;
    p1z:apqcHierarchyId "10.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and choosing the appropriate property. Analyze the property requirements. Review the available property options. Finalize the most suitable option." ;
    p1z:parentProcess apqc:PCF10943 .

apqc:PCF10961 a p1z:Process ;
    skos:prefLabel "Negotiate terms for facility" ;
    p1z:apqcId "10961" ;
    p1z:apqcHierarchyId "10.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Discussing the terms and conditions of facilities to be occupied according to the business requirements and availability of budgets." ;
    p1z:parentProcess apqc:PCF10943 .

apqc:PCF10962 a p1z:Process ;
    skos:prefLabel "Manage construction or modification to building" ;
    p1z:apqcId "10962" ;
    p1z:apqcHierarchyId "10.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Constructing the buildings. Manage renovations according to requirements and demands." ;
    p1z:parentProcess apqc:PCF10943 .

apqc:PCF10944 a p1z:Process ;
    skos:prefLabel "Provide workspace and facilities" ;
    p1z:apqcId "10944" ;
    p1z:apqcHierarchyId "10.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the provision of the workspace and its assets. Arrange an office space with all assets (tables, chairs, computers, admin staff, etc.) according to requirements." ;
    p1z:parentProcess apqc:PCF10937 .

apqc:PCF10963 a p1z:Process ;
    skos:prefLabel "Acquire workspace and facilities" ;
    p1z:apqcId "10963" ;
    p1z:apqcHierarchyId "10.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Attaining the office space with all assets (tables, chairs, computers, admin staff, etc.) according to requirements." ;
    p1z:parentProcess apqc:PCF10944 .

apqc:PCF10964 a p1z:Process ;
    skos:prefLabel "Change fit/form/function of workspace and facilities" ;
    p1z:apqcId "10964" ;
    p1z:apqcHierarchyId "10.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Modifying the formation of the workspace and its assets. Make necessary changes in an office space with all assets (tables, chairs, computers, admin staff, interior designing, etc.) according to requirements." ;
    p1z:parentProcess apqc:PCF10944 .

apqc:PCF10949 a p1z:Process ;
    skos:prefLabel "Manage facilities operations" ;
    p1z:apqcId "10949" ;
    p1z:apqcHierarchyId "10.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing all operational activities of the facility. Manage how each function/business unit works. Support the manufacturing facility to attain organizational goals." ;
    p1z:parentProcess apqc:PCF10937 .

apqc:PCF10965 a p1z:Process ;
    skos:prefLabel "Relocate people" ;
    p1z:apqcId "10965" ;
    p1z:apqcHierarchyId "10.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Shifting staff or employees from one place to another place according to changes in business requirements." ;
    p1z:parentProcess apqc:PCF10949 .

apqc:PCF10966 a p1z:Process ;
    skos:prefLabel "Relocate material and tools" ;
    p1z:apqcId "10966" ;
    p1z:apqcHierarchyId "10.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Relocating the tools and raw materials. Shift raw or finished material and machines of company from one place to another place according to changes in business requirements." ;
    p1z:parentProcess apqc:PCF10949 .

apqc:PCF21690 a p1z:Process ;
    skos:prefLabel "Provide facility access and security" ;
    p1z:apqcId "21690" ;
    p1z:apqcHierarchyId "10.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring safe, controlled access to organizational facilities by implementing and maintaining physical security protocols, systems, and procedures. This includes issuing and managing access credentials; monitoring entry points; coordinating visitor access; and operating security technologies such as surveillance, alarms, and access-control systems. Establish and enforce policies to protect employees, visitors, assets, and information; respond to security incidents or breaches; and routinely assess the effectiveness of security measures." ;
    p1z:parentProcess apqc:PCF10949 .

apqc:PCF21575 a p1z:FunctionalDomain ;
    skos:prefLabel "Design and construct assets" ;
    p1z:apqcId "21575" ;
    p1z:apqcHierarchyId "10.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing and constructing assets such as machines, tools, factories, etc. Manage steps to acquire assets including managing capital, as well as planning, scheduling, and overseeing acquisition/construction." ;
    p1z:parentProcess apqc:PCF19207 .

apqc:PCF19209 a p1z:Process ;
    skos:prefLabel "Manage capital program for assets" ;
    p1z:apqcId "19209" ;
    p1z:apqcHierarchyId "10.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Producing and maintaining a planning schedule and a financial plan to purchase or manufacture assets. Determine the investment plan, monitor capital, and secure the necessary financing in order to realize completion of the program." ;
    p1z:parentProcess apqc:PCF21575 .

apqc:PCF19210 a p1z:Process ;
    skos:prefLabel "Define capital investment plan" ;
    p1z:apqcId "19210" ;
    p1z:apqcHierarchyId "10.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing what funds will be invested in the construction of assets for the advancement of established business objectives." ;
    p1z:parentProcess apqc:PCF19209 .

apqc:PCF19211 a p1z:Process ;
    skos:prefLabel "Monitor capital program" ;
    p1z:apqcId "19211" ;
    p1z:apqcHierarchyId "10.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring plans on capital projects. Capital projects can be purchasing buildings, lands, etc." ;
    p1z:parentProcess apqc:PCF19209 .

apqc:PCF19212 a p1z:Process ;
    skos:prefLabel "Secure construction financing" ;
    p1z:apqcId "19212" ;
    p1z:apqcHierarchyId "10.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Acquiring the loans needed to construct necessary assets." ;
    p1z:parentProcess apqc:PCF19209 .

apqc:PCF20139 a p1z:Process ;
    skos:prefLabel "Design and plan asset construction" ;
    p1z:apqcId "20139" ;
    p1z:apqcHierarchyId "10.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the steps and strategies needed to construct assets. Verify that all regulations are adhered to and that all permissions have been granted. Organize and plan for resources to complete construction." ;
    p1z:parentProcess apqc:PCF21575 .

apqc:PCF19220 a p1z:Process ;
    skos:prefLabel "Develop construction strategy" ;
    p1z:apqcId "19220" ;
    p1z:apqcHierarchyId "10.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a strategy to perform asset construction. Assure that timelines, regulations, and resources are on task and on budget." ;
    p1z:parentProcess apqc:PCF20139 .

apqc:PCF11276 a p1z:Process ;
    skos:prefLabel "Perform construction performance management" ;
    p1z:apqcId "11276" ;
    p1z:apqcHierarchyId "10.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the construction process to ensure that activates are on task, on budget, and are being performed with safety and quality in mind." ;
    p1z:parentProcess apqc:PCF20139 .

apqc:PCF19221 a p1z:Process ;
    skos:prefLabel "Obtain construction permissions" ;
    p1z:apqcId "19221" ;
    p1z:apqcHierarchyId "10.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering the required permits for construction from the proper jurisdiction. This may include inspections during and after construction to verify that the new asset meets all national, regional, and local codes." ;
    p1z:parentProcess apqc:PCF20139 .

apqc:PCF19222 a p1z:Process ;
    skos:prefLabel "Design assets" ;
    p1z:apqcId "19222" ;
    p1z:apqcHierarchyId "10.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing assets to meet organizational needs as well as ensuring that the asset adheres to all national, regional, and local construction codes." ;
    p1z:parentProcess apqc:PCF20139 .

apqc:PCF19223 a p1z:Process ;
    skos:prefLabel "Plan construction resources" ;
    p1z:apqcId "19223" ;
    p1z:apqcHierarchyId "10.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining what resources will need to be acquired in order to carry out construction. Plan when, where, and how resources will be used. Determine the length of time resources will be utilized." ;
    p1z:parentProcess apqc:PCF20139 .

apqc:PCF19229 a p1z:Process ;
    skos:prefLabel "Schedule and perform construction work" ;
    p1z:apqcId "19229" ;
    p1z:apqcHierarchyId "10.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Arranging a timetable for which to perform construction work. Schedule resources to contract assets for new or replacement assets. Reschedule or redesign assets if needed." ;
    p1z:parentProcess apqc:PCF21575 .

apqc:PCF19230 a p1z:Process ;
    skos:prefLabel "Schedule construction work" ;
    p1z:apqcId "19230" ;
    p1z:apqcHierarchyId "10.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a timetable for which to execute the construction of the asset." ;
    p1z:parentProcess apqc:PCF19229 .

apqc:PCF19231 a p1z:Process ;
    skos:prefLabel "Obtain resources" ;
    p1z:apqcId "19231" ;
    p1z:apqcHierarchyId "10.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering resources needed to complete all construction work. Verify that all resources have the proper training and skills to perform the work." ;
    p1z:parentProcess apqc:PCF19229 .

apqc:PCF19232 a p1z:Process ;
    skos:prefLabel "Construct new assets" ;
    p1z:apqcId "19232" ;
    p1z:apqcHierarchyId "10.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Building new assets necessary for the organization. Be aware of any construction codes and permits that need to be addressed." ;
    p1z:parentProcess apqc:PCF19229 .

apqc:PCF19233 a p1z:Process ;
    skos:prefLabel "Augment existing assets" ;
    p1z:apqcId "19233" ;
    p1z:apqcHierarchyId "10.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Modifying existing assets to align with the changing needs of the organization. Be aware of any construction codes and permits that need to be addressed." ;
    p1z:parentProcess apqc:PCF19229 .

apqc:PCF19234 a p1z:Process ;
    skos:prefLabel "Renew/Replace assets" ;
    p1z:apqcId "19234" ;
    p1z:apqcHierarchyId "10.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the need to replace existing assets. Be aware of any construction codes and permits that need to be addressed." ;
    p1z:parentProcess apqc:PCF19229 .

apqc:PCF19224 a p1z:Process ;
    skos:prefLabel "Manage asset construction" ;
    p1z:apqcId "19224" ;
    p1z:apqcHierarchyId "10.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing the performance and quality of work. Assure that records are maintained throughout the construction process. Adhere to all safety, security, and access regulations set forth by the organization and all government standards." ;
    p1z:parentProcess apqc:PCF21575 .

apqc:PCF19225 a p1z:Process ;
    skos:prefLabel "Monitor work performance" ;
    p1z:apqcId "19225" ;
    p1z:apqcHierarchyId "10.2.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring construction to insure that all regulatory laws are being adhered to, that all work is being performed in a timely manner, and that quality assurance is met at all steps of the construction process." ;
    p1z:parentProcess apqc:PCF19224 .

apqc:PCF19226 a p1z:Process ;
    skos:prefLabel "Undertake construction quality control" ;
    p1z:apqcId "19226" ;
    p1z:apqcHierarchyId "10.2.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing a checks and balances system to verify that the construction was performed correctly. Rework when errors are found." ;
    p1z:parentProcess apqc:PCF19224 .

apqc:PCF19227 a p1z:Process ;
    skos:prefLabel "Create work and asset records" ;
    p1z:apqcId "19227" ;
    p1z:apqcHierarchyId "10.2.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing records to include all construction work that has been performed. Include all new or modified construction, and any construction or regulatory issues that might have occurred." ;
    p1z:parentProcess apqc:PCF19224 .

apqc:PCF19228 a p1z:Process ;
    skos:prefLabel "Manage safety, security, and access to sites" ;
    p1z:apqcId "19228" ;
    p1z:apqcHierarchyId "10.2.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that safety, security, and access is maintained. Provide a workplace that meets and exceeds all local, state, and federal guidelines. Provide security and access to the building site as set forth by safety and organizational guidelines." ;
    p1z:parentProcess apqc:PCF19224 .

apqc:PCF21689 a p1z:Process ;
    skos:prefLabel "Schedule and perform commissioning" ;
    p1z:apqcId "21689" ;
    p1z:apqcHierarchyId "10.2.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Scheduling and performing commissioning activities to verify that constructed assets operate as intended, meet specified requirements, and are ready for handover, use, or operational acceptance." ;
    p1z:parentProcess apqc:PCF19224 .

apqc:PCF19238 a p1z:FunctionalDomain ;
    skos:prefLabel "Maintain assets" ;
    p1z:apqcId "19238" ;
    p1z:apqcHierarchyId "10.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Preserving assets through the planning, managing, and performance of preventative, routine, and critical maintenance work." ;
    p1z:parentProcess apqc:PCF19207 .

apqc:PCF19239 a p1z:Process ;
    skos:prefLabel "Plan asset maintenance" ;
    p1z:apqcId "19239" ;
    p1z:apqcHierarchyId "10.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that necessary resources are available and tasks are prioritized accordingly through planning. Provide strategies and policies that identify tasks that need to be completed, and the resources necessary to fulfill those tasks." ;
    p1z:parentProcess apqc:PCF19238 .

apqc:PCF19240 a p1z:Process ;
    skos:prefLabel "Develop maintenance strategies" ;
    p1z:apqcId "19240" ;
    p1z:apqcHierarchyId "10.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating goals and agendas to better realize the success of the maintenance policies that have been put into place." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF10967 a p1z:Process ;
    skos:prefLabel "Analyze assets and predict maintenance requirements" ;
    p1z:apqcId "10967" ;
    p1z:apqcHierarchyId "10.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating assets in order to project future requirements for maintenance. Evaluate the present working condition of assets. Determine the future maintenance requirements of assets." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF19241 a p1z:Process ;
    skos:prefLabel "Specify maintenance policies" ;
    p1z:apqcId "19241" ;
    p1z:apqcHierarchyId "10.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating policies in regards to asset maintenance. Provide a clear set of procedures and policies that outline what will be involved in the maintenance process." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF10968 a p1z:Process ;
    skos:prefLabel "Integrate preventive maintenance into operations schedule" ;
    p1z:apqcId "10968" ;
    p1z:apqcHierarchyId "10.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising a methodology and procedure for assimilating the works of planned maintenance into the schedule scheme for the processing of finished products that utilizes the same machinery." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF19242 a p1z:Process ;
    skos:prefLabel "Identify work management tasks & priorities" ;
    p1z:apqcId "19242" ;
    p1z:apqcHierarchyId "10.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the steps needed for asset maintenance. List out the those tasks that are involved in completing this process. Prioritize the tasks that are created." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF19243 a p1z:Process ;
    skos:prefLabel "Conduct resource planning" ;
    p1z:apqcId "19243" ;
    p1z:apqcHierarchyId "10.3.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing workload needs in relation to asset maintenance and plan resources around those needs." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF19244 a p1z:Process ;
    skos:prefLabel "Create asset work plans" ;
    p1z:apqcId "19244" ;
    p1z:apqcHierarchyId "10.3.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating procedures on how to maintain assets." ;
    p1z:parentProcess apqc:PCF19239 .

apqc:PCF19245 a p1z:Process ;
    skos:prefLabel "Manage asset maintenance" ;
    p1z:apqcId "19245" ;
    p1z:apqcHierarchyId "10.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring that asset maintenance is conducted in a timely manner and successfully. Schedule work with the required resources with an eye on quality control and safety. Verify that contracted maintenance meets performance targets." ;
    p1z:parentProcess apqc:PCF19238 .

apqc:PCF19246 a p1z:Process ;
    skos:prefLabel "Schedule maintenance work" ;
    p1z:apqcId "19246" ;
    p1z:apqcHierarchyId "10.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining a timetable for which to execute the maintenance of the asset." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19247 a p1z:Process ;
    skos:prefLabel "Obtain required resources" ;
    p1z:apqcId "19247" ;
    p1z:apqcHierarchyId "10.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering resources needed to complete all maintenance work. Verify that all resources have the proper training and skills to perform the work." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19248 a p1z:Process ;
    skos:prefLabel "Undertake quality control" ;
    p1z:apqcId "19248" ;
    p1z:apqcHierarchyId "10.3.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing a checks and balances system to verify that the maintenance was performed correctly. Rework when errors are found." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19249 a p1z:Process ;
    skos:prefLabel "Update work and asset records" ;
    p1z:apqcId "19249" ;
    p1z:apqcHierarchyId "10.3.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Modifying existing maintenance records to include all new work that has been performed, what assets were serviced, and any issues that might have arisen." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19250 a p1z:Process ;
    skos:prefLabel "Manage maintenance work safety" ;
    p1z:apqcId "19250" ;
    p1z:apqcHierarchyId "10.3.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assuring that all safety laws and regulations are being implemented and followed. Align practices with regulatory bureaus such as OSHA , EHS, and ISO." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19251 a p1z:Process ;
    skos:prefLabel "Define maintenance performance targets" ;
    p1z:apqcId "19251" ;
    p1z:apqcHierarchyId "10.3.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining what should be achieved through predictive indicators with regard to performing maintenance. This could include the length of time it takes to perform routine maintenance or how often unplanned maintenance feasibly occur." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19252 a p1z:Process ;
    skos:prefLabel "Monitor maintenance performance against targets/contracts" ;
    p1z:apqcId "19252" ;
    p1z:apqcHierarchyId "10.3.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Following set performance targets, monitor and gage the success of the organization in meeting those targets." ;
    p1z:parentProcess apqc:PCF19245 .

apqc:PCF19253 a p1z:Process ;
    skos:prefLabel "Perform asset maintenance" ;
    p1z:apqcId "19253" ;
    p1z:apqcHierarchyId "10.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Engaging in all aspects of asset maintenance. Ensure that all assets are functioning properly and to all specified codes and regulations where applicable. Maintenance includes all preventative, routine, and corrective activates." ;
    p1z:parentProcess apqc:PCF19238 .

apqc:PCF10947 a p1z:Process ;
    skos:prefLabel "Perform preventative asset maintenance" ;
    p1z:apqcId "10947" ;
    p1z:apqcHierarchyId "10.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing prophylactic maintenance in an effort to avoid corrective or unplanned repairs." ;
    p1z:parentProcess apqc:PCF19253 .

apqc:PCF19254 a p1z:Process ;
    skos:prefLabel "Perform routine asset maintenance" ;
    p1z:apqcId "19254" ;
    p1z:apqcHierarchyId "10.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out required maintenance to continue upkeep of equipment or assets." ;
    p1z:parentProcess apqc:PCF19253 .

apqc:PCF19255 a p1z:Process ;
    skos:prefLabel "Perform corrective asset maintenance and repairs" ;
    p1z:apqcId "19255" ;
    p1z:apqcHierarchyId "10.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Repairing or correcting faults that occur with an asset. This could be a break or other repairable damage." ;
    p1z:parentProcess apqc:PCF19253 .

apqc:PCF19256 a p1z:Process ;
    skos:prefLabel "Identify unplanned maintenance requirements" ;
    p1z:apqcId "19256" ;
    p1z:apqcHierarchyId "10.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Realizing potential or current problems with assets that would require unplanned maintenance. Unplanned maintenance is a repair or change that needs to be made that is not preventative or routine." ;
    p1z:parentProcess apqc:PCF19253 .

apqc:PCF19257 a p1z:Process ;
    skos:prefLabel "Perform unplanned maintenance and repairs" ;
    p1z:apqcId "19257" ;
    p1z:apqcHierarchyId "10.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing repairs that occur outside of normal routine or preventative maintenance." ;
    p1z:parentProcess apqc:PCF19253 .

apqc:PCF21576 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage asset end-of-life" ;
    p1z:apqcId "21576" ;
    p1z:apqcHierarchyId "10.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing the disposition of assets at their end-of-life. End-of-life for an asset may be due to obsolescence, replacement, excess capacity, or disrepair among other potential factors. Steps may include decommissioning, disassembly, recycling, etc. Tracking and reporting may also be appropriate for some or all asset types due to law, regulation, or social/environmental responsibility." ;
    p1z:parentProcess apqc:PCF19207 .

apqc:PCF10952 a p1z:Process ;
    skos:prefLabel "Develop exit strategy" ;
    p1z:apqcId "10952" ;
    p1z:apqcHierarchyId "10.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a strategy for managing asset exits." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF18592 a p1z:Process ;
    skos:prefLabel "Monitor useful life of assets" ;
    p1z:apqcId "18592" ;
    p1z:apqcHierarchyId "10.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring assets against their planned useful life. Each asset may have specific criteria that indicate their usability. This may include time-based, maintenance history, capacity planning, etc." ;
    p1z:parentProcess apqc:PCF10952 .

apqc:PCF21577 a p1z:Process ;
    skos:prefLabel "Perform cost vs. benefit analysis for replacement" ;
    p1z:apqcId "21577" ;
    p1z:apqcHierarchyId "10.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Cost/benefit analysis of assets to determine retention or end-of-life. Evaluating asset total lifecycle cost against other factors such as repair/refurbishment, replacement, and alternate solutions." ;
    p1z:parentProcess apqc:PCF10952 .

apqc:PCF19258 a p1z:Process ;
    skos:prefLabel "Decommission productive assets" ;
    p1z:apqcId "19258" ;
    p1z:apqcHierarchyId "10.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Retiring assets that are no longer viable to the business. Decommission assets that are no longer in working order, are out of date, or whose maintenance exceeds the cost of replacement." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF10953 a p1z:Process ;
    skos:prefLabel "Perform sale or trade" ;
    p1z:apqcId "10953" ;
    p1z:apqcHierarchyId "10.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing the sale of assets. Achieve and complete the sale process. Deliver the end product to the customers." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF12717 a p1z:Process ;
    skos:prefLabel "Manage take-back centers" ;
    p1z:apqcId "12717" ;
    p1z:apqcHierarchyId "10.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing locations where end-of-life assets are evaluated for decommissioning, disassembly, recycling, etc." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF21579 a p1z:Process ;
    skos:prefLabel "Dismantle assets" ;
    p1z:apqcId "21579" ;
    p1z:apqcHierarchyId "10.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Dismantling an asset into manageable parts. The parts may follow different dispositions, such as resale, reuse, recycle, etc." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF21580 a p1z:Process ;
    skos:prefLabel "Track parts" ;
    p1z:apqcId "21580" ;
    p1z:apqcHierarchyId "10.4.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking the disposition of all parts from end-of-life assets. Tracking should provide an audit trail to include source, rational for disposition, and destination." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF21581 a p1z:Process ;
    skos:prefLabel "Recycle parts" ;
    p1z:apqcId "21581" ;
    p1z:apqcHierarchyId "10.4.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Recycling parts in accordance with legal, regulatory, and social/environmental responsibilities." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF12721 a p1z:Process ;
    skos:prefLabel "Ship hazardous material" ;
    p1z:apqcId "12721" ;
    p1z:apqcHierarchyId "10.4.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning, conducting, and tracking shipment of hazardous materials." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF12722 a p1z:Process ;
    skos:prefLabel "Provide government reporting" ;
    p1z:apqcId "12722" ;
    p1z:apqcHierarchyId "10.4.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing and distributing government reports." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF21582 a p1z:Process ;
    skos:prefLabel "Perform abandonment" ;
    p1z:apqcId "21582" ;
    p1z:apqcHierarchyId "10.4.10" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning and performing abandonment activities. Whether facilities  or equipment, ensure assets to be abandoned are safe, secure, and meet all legal, regulatory, and social/environmental responsibilities." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF13131 a p1z:Process ;
    skos:prefLabel "Demolish and secure" ;
    p1z:apqcId "13131" ;
    p1z:apqcHierarchyId "10.4.10.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Demolishing and securing asset and resulting parts/debris." ;
    p1z:parentProcess apqc:PCF21582 .

apqc:PCF13132 a p1z:Process ;
    skos:prefLabel "Restore site" ;
    p1z:apqcId "13132" ;
    p1z:apqcHierarchyId "10.4.10.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing remediation or restoration activities." ;
    p1z:parentProcess apqc:PCF21582 .

apqc:PCF19465 a p1z:Process ;
    skos:prefLabel "Monitor site for duration of time required by regulators" ;
    p1z:apqcId "19465" ;
    p1z:apqcHierarchyId "10.4.10.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing and reporting site status. Align efforts to all legal, regulatory and social/environmental responsibilities." ;
    p1z:parentProcess apqc:PCF21582 .

apqc:PCF13133 a p1z:Process ;
    skos:prefLabel "Prepare handover to new operator or landowner" ;
    p1z:apqcId "13133" ;
    p1z:apqcHierarchyId "10.4.10.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting handover to new operator or landowner. Include proper documentation on asset history and current state to enable orderly transition." ;
    p1z:parentProcess apqc:PCF21582 .

apqc:PCF21583 a p1z:Process ;
    skos:prefLabel "Perform waste and hazardous goods management" ;
    p1z:apqcId "21583" ;
    p1z:apqcHierarchyId "10.4.11" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning and performing waste and hazardous goods management. In compliance with all legal, regulatory, and social/environmental requirements, plan, document, and conduct hazardous material handling, disposal, and reporting." ;
    p1z:parentProcess apqc:PCF21576 .

apqc:PCF12180 a p1z:Process ;
    skos:prefLabel "Maintain material safety data sheets" ;
    p1z:apqcId "12180" ;
    p1z:apqcHierarchyId "10.4.11.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing material safety sheets. Capture material safety records to properly apply handling and disposal requirements." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12181 a p1z:Process ;
    skos:prefLabel "Maintain awareness of and communicate regulatory requirements" ;
    p1z:apqcId "12181" ;
    p1z:apqcHierarchyId "10.4.11.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding and communicating hazardous material regulatory requirements." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12182 a p1z:Process ;
    skos:prefLabel "Maintain hazardous material handling and disposal" ;
    p1z:apqcId "12182" ;
    p1z:apqcHierarchyId "10.4.11.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning, overseeing, and tracking hazardous material handling and disposal." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12183 a p1z:Process ;
    skos:prefLabel "Manage compliance audits" ;
    p1z:apqcId "12183" ;
    p1z:apqcHierarchyId "10.4.11.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning, supporting, and documenting hazardous material audits." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12184 a p1z:Process ;
    skos:prefLabel "Recognize need to disposition hazardous materials/waste" ;
    p1z:apqcId "12184" ;
    p1z:apqcHierarchyId "10.4.11.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and establishing approaches to dispose of hazardous materials/waste." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12185 a p1z:Process ;
    skos:prefLabel "Determine disposition and associated processing" ;
    p1z:apqcId "12185" ;
    p1z:apqcHierarchyId "10.4.11.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating hazardous materials and waste for appropriate disposition. Apply requirements and initiate disposition activities." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12186 a p1z:Process ;
    skos:prefLabel "Manage disposition, disposal, reprocessing activities" ;
    p1z:apqcId "12186" ;
    p1z:apqcHierarchyId "10.4.11.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing disposition, disposal, and reprocessing activities." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF12187 a p1z:Process ;
    skos:prefLabel "Manage documentation and reporting" ;
    p1z:apqcId "12187" ;
    p1z:apqcHierarchyId "10.4.11.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting and reporting disposition, disposal, and reprocessing activities." ;
    p1z:parentProcess apqc:PCF21583 .

apqc:PCF16437 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Enterprise Risk, Compliance, Remediation, and Resiliency" ;
    p1z:apqcId "16437" ;
    p1z:apqcHierarchyId "11.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Ensuring that an organization effectively manages its risk. Process groups are aligned with traditional risk management activities." .

apqc:PCF17060 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage enterprise risk" ;
    p1z:apqcId "17060" ;
    p1z:apqcHierarchyId "11.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating requisite frameworks and coordinating all risk management activities for the entire organization and each function. Manage the enterprise risk by outlining the risk policies and procedures. Monitor and communicate all risk management activities. Encourage correspondence among the business units. Manage the risk of all business units and functions." ;
    p1z:parentProcess apqc:PCF16437 .

apqc:PCF16439 a p1z:Process ;
    skos:prefLabel "Establish the enterprise risk framework and policies" ;
    p1z:apqcId "16439" ;
    p1z:apqcHierarchyId "11.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating an agenda for the rules and regulations of enterprise risk that deal with hazardous, financial, operational, and strategic risks. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF17060 .

apqc:PCF16440 a p1z:Process ;
    skos:prefLabel "Determine risk tolerance for organization" ;
    p1z:apqcId "16440" ;
    p1z:apqcHierarchyId "11.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the organization's tolerance for risk, given risk-return trade-offs for one or more anticipated and predictable consequences." ;
    p1z:parentProcess apqc:PCF16439 .

apqc:PCF16441 a p1z:Process ;
    skos:prefLabel "Develop and maintain enterprise risk policies and procedures" ;
    p1z:apqcId "16441" ;
    p1z:apqcHierarchyId "11.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining the policies and procedures for managing risk. Create rules and regulations for enterprise risk dealing with hazardous, financial, operational, and strategic risks." ;
    p1z:parentProcess apqc:PCF16439 .

apqc:PCF16442 a p1z:Process ;
    skos:prefLabel "Identify and implement enterprise risk management tools" ;
    p1z:apqcId "16442" ;
    p1z:apqcHierarchyId "11.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing and implementing tools for managing risk. Identify and apply enterprise risk management tools. Leverage methods and processes to manage risks and opportunities associated with business objectives." ;
    p1z:parentProcess apqc:PCF16439 .

apqc:PCF16443 a p1z:Process ;
    skos:prefLabel "Coordinate the sharing of risk knowledge across the organization" ;
    p1z:apqcId "16443" ;
    p1z:apqcHierarchyId "11.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating the knowledge about risk within the organization. Identify operational risks. Share risk information within the organization." ;
    p1z:parentProcess apqc:PCF16439 .

apqc:PCF16444 a p1z:Process ;
    skos:prefLabel "Prepare and report enterprise risk to executive management and board" ;
    p1z:apqcId "16444" ;
    p1z:apqcHierarchyId "11.1.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing and presenting reports about enterprise risk to the management of the organization. Create reports for management on hazard risks (e.g., property damage and liability torts), financial risks (e.g., currency and liquidity risks), and operational risks (e.g., product failure, customer satisfaction, social trends, and competition)." ;
    p1z:parentProcess apqc:PCF16439 .

apqc:PCF16445 a p1z:Process ;
    skos:prefLabel "Oversee and coordinate enterprise risk management activities" ;
    p1z:apqcId "16445" ;
    p1z:apqcHierarchyId "11.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating to plan, organize, lead, and control the activities of an organization in order to minimize the special effects of risk on capital and earnings." ;
    p1z:parentProcess apqc:PCF17060 .

apqc:PCF16446 a p1z:Process ;
    skos:prefLabel "Identify enterprise level risks" ;
    p1z:apqcId "16446" ;
    p1z:apqcHierarchyId "11.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining risks that could thwart objectives, including crises that may impact customer service such as data breaches or significant product issues. Document and communicate the concern." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16447 a p1z:Process ;
    skos:prefLabel "Assess risks to determine which to mitigate" ;
    p1z:apqcId "16447" ;
    p1z:apqcHierarchyId "11.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying options/actions to enhance opportunities and reduce threats. Recognize the root reasons of the identified risks." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16448 a p1z:Process ;
    skos:prefLabel "Develop risk mitigation and management strategy and integrate with existing performance management processes" ;
    p1z:apqcId "16448" ;
    p1z:apqcHierarchyId "11.1.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing activities to improve opportunities and lessen threats. Specify the organization's objectives. Evolve strategies and policies to attain these objectives. Assign resources to project objectives." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16449 a p1z:Process ;
    skos:prefLabel "Verify business unit and functional risk mitigation plans are implemented" ;
    p1z:apqcId "16449" ;
    p1z:apqcHierarchyId "11.1.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking that the blueprint created for managing risk in individual business units and divisions is correctly effectuated. Validate the implementation of all activities geared to mitigate risks." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16450 a p1z:Process ;
    skos:prefLabel "Ensure risks and risk mitigation actions are monitored" ;
    p1z:apqcId "16450" ;
    p1z:apqcHierarchyId "11.1.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring risk monitoring and mitigation activities. Monitor actions to enhance opportunities and reduce threats to project objectives." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16451 a p1z:Process ;
    skos:prefLabel "Report on enterprise risk activities" ;
    p1z:apqcId "16451" ;
    p1z:apqcHierarchyId "11.1.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a report of activities to address hazard risks, liability torts, financial risks, operational risks, social trends, competition, etc." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16452 a p1z:Process ;
    skos:prefLabel "Coordinate business unit and functional risk management activities" ;
    p1z:apqcId "16452" ;
    p1z:apqcHierarchyId "11.1.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating risk management activities to improve opportunities and lessen threats. Specify the organization's objectives. Assign resources to project objectives." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16453 a p1z:Process ;
    skos:prefLabel "Ensure that each business unit/function follows the enterprise risk management process" ;
    p1z:apqcId "16453" ;
    p1z:apqcHierarchyId "11.1.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF16454 a p1z:Process ;
    skos:prefLabel "Ensure that each business unit/function follows the enterprise risk reporting process" ;
    p1z:apqcId "16454" ;
    p1z:apqcHierarchyId "11.1.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Checking the reporting process of each business unit's/function's options and activities to improve opportunities and lessen threats." ;
    p1z:parentProcess apqc:PCF16445 .

apqc:PCF17462 a p1z:Process ;
    skos:prefLabel "Manage business unit and function risk" ;
    p1z:apqcId "17462" ;
    p1z:apqcHierarchyId "11.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the threats a business unit/function faces to prioritize the controls it implements.." ;
    p1z:parentProcess apqc:PCF17060 .

apqc:PCF16456 a p1z:Process ;
    skos:prefLabel "Identify risks" ;
    p1z:apqcId "16456" ;
    p1z:apqcHierarchyId "11.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a timely and continuous process to identify activities that might hinder a project's goals." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16457 a p1z:Process ;
    skos:prefLabel "Assess risks using enterprise risk framework policies and procedures" ;
    p1z:apqcId "16457" ;
    p1z:apqcHierarchyId "11.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the possibility that a specified undesirable event will occur using established tools, implements, and frameworks. Use risk assessments to determine, for example, whether to undertake a particular venture, what rate of return a particular investment requires, and how to mitigate an activity's potential losses." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16458 a p1z:Process ;
    skos:prefLabel "Develop mitigation plans for risks" ;
    p1z:apqcId "16458" ;
    p1z:apqcHierarchyId "11.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing possibilities and arrangements to improve opportunities and reduce deviations to project objectives." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16459 a p1z:Process ;
    skos:prefLabel "Implement mitigation plans for risks" ;
    p1z:apqcId "16459" ;
    p1z:apqcHierarchyId "11.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing mitigation plans to improve opportunities and reduce deviations to project objectives." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16460 a p1z:Process ;
    skos:prefLabel "Monitor risks" ;
    p1z:apqcId "16460" ;
    p1z:apqcHierarchyId "11.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, examining, and recognizing/justifying any improbability in investment decision making." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16461 a p1z:Process ;
    skos:prefLabel "Analyze risk activities and update plans" ;
    p1z:apqcId "16461" ;
    p1z:apqcHierarchyId "11.1.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the impact of risk activities in order to update the existing scheme of risk management. Analyze and substantiate the potential for adverse consequences to occur. Consider the risks associated with the activity and the methods available to manage those risks." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF16462 a p1z:Process ;
    skos:prefLabel "Report on risk activities" ;
    p1z:apqcId "16462" ;
    p1z:apqcHierarchyId "11.1.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating reports on risk activities, and communicating them to management. Prepare reports on the potential for adverse safety consequences." ;
    p1z:parentProcess apqc:PCF17462 .

apqc:PCF17467 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage compliance" ;
    p1z:apqcId "17467" ;
    p1z:apqcHierarchyId "11.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing steps to confirm enduring compliance to industry regulations and government legislation." ;
    p1z:parentProcess apqc:PCF16437 .

apqc:PCF17468 a p1z:Process ;
    skos:prefLabel "Establish compliance framework and policies" ;
    p1z:apqcId "17468" ;
    p1z:apqcHierarchyId "11.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a set of procedures detailing an organization's progress in complying with established guidelines, provisions, and legislation." ;
    p1z:parentProcess apqc:PCF17467 .

apqc:PCF17469 a p1z:Process ;
    skos:prefLabel "Develop enterprise compliance policies and procedures" ;
    p1z:apqcId "17469" ;
    p1z:apqcHierarchyId "11.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a standardized approach to ethics and compliance. Have a programmatic approach for compliance that focuses on the definite risks the organization faces." ;
    p1z:parentProcess apqc:PCF17468 .

apqc:PCF17470 a p1z:Process ;
    skos:prefLabel "Implement enterprise compliance activities" ;
    p1z:apqcId "17470" ;
    p1z:apqcHierarchyId "11.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing standardized for ethics and compliance. Have a programmatic approach, built from the top down, to enterprise compliance that focuses on the definite risks the organization faces." ;
    p1z:parentProcess apqc:PCF17468 .

apqc:PCF14133 a p1z:Process ;
    skos:prefLabel "Manage internal audits" ;
    p1z:apqcId "14133" ;
    p1z:apqcHierarchyId "11.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing accounts and prepare regular reports on financial performance." ;
    p1z:parentProcess apqc:PCF17468 .

apqc:PCF14137 a p1z:Process ;
    skos:prefLabel "Maintain controls-related technologies and tools" ;
    p1z:apqcId "14137" ;
    p1z:apqcHierarchyId "11.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing technologies and tools related to the confidentiality, integrity, and availability of data in order to ensure the security of the organization's information. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF17468 .

apqc:PCF16463 a p1z:Process ;
    skos:prefLabel "Manage regulatory compliance" ;
    p1z:apqcId "16463" ;
    p1z:apqcHierarchyId "11.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Obeying laws, guidelines, strategies, and stipulations related to the business." ;
    p1z:parentProcess apqc:PCF17467 .

apqc:PCF16464 a p1z:Process ;
    skos:prefLabel "Develop regulatory compliance procedures" ;
    p1z:apqcId "16464" ;
    p1z:apqcHierarchyId "11.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing procedures and methodologies to comply with relevant laws and regulations of an organization's obedience to laws, guidelines, strategies and stipulations related to business." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16465 a p1z:Process ;
    skos:prefLabel "Identify applicable regulatory requirements" ;
    p1z:apqcId "16465" ;
    p1z:apqcHierarchyId "11.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the regulatory requirements that are most appropriate for the organization. Identify goals in order to follow the appropriate rules and regulations, guidelines, and strategies." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16466 a p1z:Process ;
    skos:prefLabel "Monitor the regulatory environment for changing or emerging regulations" ;
    p1z:apqcId "16466" ;
    p1z:apqcHierarchyId "11.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing and overseeing the regulatory environment in order to spot any changing or emerging regulations. This process element calls upon the organization to monitor the regulatory environment for any new statutes, policies, and enactments issued by the respective government authorities or those which have been updated." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16467 a p1z:Process ;
    skos:prefLabel "Assess current compliance position and identify weaknesses or shortfalls therein" ;
    p1z:apqcId "16467" ;
    p1z:apqcHierarchyId "11.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating current regulatory policies and regulations. Assess their performance. Make necessary changes." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16468 a p1z:Process ;
    skos:prefLabel "Implement missing or stronger regulatory compliance controls and policies" ;
    p1z:apqcId "16468" ;
    p1z:apqcHierarchyId "11.2.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the current policies and policies. Implement missing and necessary changes environmental changes, political changes, technological changes, etc." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16469 a p1z:Process ;
    skos:prefLabel "Monitor and test regulatory compliance position and existing controls" ;
    p1z:apqcId "16469" ;
    p1z:apqcHierarchyId "11.2.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Monitoring, appraising, and evaluating the compliance position of the organization in order to fine-tune for effective remediation. Track efforts for handling regulatory and compliance requirements necessitated by law. Test the robustness of internal frameworks, procedures, and approaches for dealing with these requirements, in order to clearly identify any necessary changes." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF19595 a p1z:Process ;
    skos:prefLabel "Compile and communicate compliance scorecard(s)" ;
    p1z:apqcId "19595" ;
    p1z:apqcHierarchyId "11.2.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a graphical representation of metrics in order to communicate the general health of the organization in relation to risk and compliancy." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF19596 a p1z:Process ;
    skos:prefLabel "Compile and communicate internal and regulatory compliance reports" ;
    p1z:apqcId "19596" ;
    p1z:apqcHierarchyId "11.2.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Submitting compliance reports to regulatory agencies. These reports can be made to environmental, securities, or human resources agencies as stipulated by the local governing body." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF16470 a p1z:Process ;
    skos:prefLabel "Maintain relationships with regulators as appropriate" ;
    p1z:apqcId "16470" ;
    p1z:apqcHierarchyId "11.2.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and preserving relationships with the regulators, without compromising the legal basis of the relationship." ;
    p1z:parentProcess apqc:PCF16463 .

apqc:PCF11185 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage remediation efforts" ;
    p1z:apqcId "11185" ;
    p1z:apqcHierarchyId "11.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Administering the efforts and activities for remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's operations. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for remediation." ;
    p1z:parentProcess apqc:PCF16437 .

apqc:PCF11201 a p1z:Process ;
    skos:prefLabel "Create remediation plans" ;
    p1z:apqcId "11201" ;
    p1z:apqcHierarchyId "11.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating plans for remediation efforts. Make a plan to address a case of environmental adulteration. Identify and treat the adulteration so that the area will become operational again." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11202 a p1z:Process ;
    skos:prefLabel "Contact and confer with experts" ;
    p1z:apqcId "11202" ;
    p1z:apqcHierarchyId "11.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Discussing and soliciting advice from experts for in order to incorporate their suggestion (regarding Create remediation plans [11201])." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11203 a p1z:Process ;
    skos:prefLabel "Identify/Dedicate resources" ;
    p1z:apqcId "11203" ;
    p1z:apqcHierarchyId "11.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and dedicating the resources for managing remediation efforts. Discern the resources needed for remediation efforts. Dispense with resources in a sound and well-reasoned manner." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11204 a p1z:Process ;
    skos:prefLabel "Investigate legal aspects" ;
    p1z:apqcId "11204" ;
    p1z:apqcHierarchyId "11.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining regulatory and legislative frameworks. Obligate the organization to remediate any damages through compensations, fines, and any other remedial efforts necessitated to correct the situations. Analyze local environmental laws, binding international covenants, etc. in order to examine legal accuracy about the rules and procedures." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11205 a p1z:Process ;
    skos:prefLabel "Investigate damage cause" ;
    p1z:apqcId "11205" ;
    p1z:apqcHierarchyId "11.3.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Studying the causes of damage, which could be environmental, physical, social, etc. at country level in order to institute better policies and regulations." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11206 a p1z:Process ;
    skos:prefLabel "Amend or create policy" ;
    p1z:apqcId "11206" ;
    p1z:apqcHierarchyId "11.3.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Crafting a new framework of policies and procedures for deploying remediation efforts, or change existing policies and procedures. Adapt the policy structure to the context of the apposite national and international regulatory frameworks." ;
    p1z:parentProcess apqc:PCF11185 .

apqc:PCF11216 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage business resiliency" ;
    p1z:apqcId "11216" ;
    p1z:apqcHierarchyId "11.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Including the processes required to rapidly adapt and respond to any internal or external opportunity, demand, disruption, or threat. Develop a more dynamic, strategic, and integrated approach to managing compliance obligations." ;
    p1z:parentProcess apqc:PCF16437 .

apqc:PCF11221 a p1z:Process ;
    skos:prefLabel "Develop the business resilience strategy" ;
    p1z:apqcId "11221" ;
    p1z:apqcHierarchyId "11.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a strategy for rapidly adapting to disturbances. Maintain continuous business processes and protecting employees, assets, and overall brand equity. This is inclusive of all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF11216 .

apqc:PCF11222 a p1z:Process ;
    skos:prefLabel "Perform continuous business operations planning" ;
    p1z:apqcId "11222" ;
    p1z:apqcHierarchyId "11.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing plans to ensure continuous business operations." ;
    p1z:parentProcess apqc:PCF11216 .

apqc:PCF11223 a p1z:Process ;
    skos:prefLabel "Test continuous business operations" ;
    p1z:apqcId "11223" ;
    p1z:apqcHierarchyId "11.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing ongoing activities within the organization that are not intended to stop except for in an emergency." ;
    p1z:parentProcess apqc:PCF11216 .

apqc:PCF11224 a p1z:Process ;
    skos:prefLabel "Maintain continuous business operations" ;
    p1z:apqcId "11224" ;
    p1z:apqcHierarchyId "11.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating business operations. Determine which activities generate revenues, perform best, and provide good returns." ;
    p1z:parentProcess apqc:PCF11216 .

apqc:PCF16471 a p1z:Process ;
    skos:prefLabel "Share knowledge of specific risks across other parts of the organization" ;
    p1z:apqcId "16471" ;
    p1z:apqcHierarchyId "11.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Sharing information about risks and resilience strategies of business operations across the organization so that prospective risks can be avoided." ;
    p1z:parentProcess apqc:PCF11216 .

apqc:PCF10012 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage External Relationships" ;
    p1z:apqcId "10012" ;
    p1z:apqcHierarchyId "12.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Fostering external relationships with stakeholders of the entity, including investors, government and industry, the board of directors, and the general public. This is not related to customer management." .

apqc:PCF11010 a p1z:FunctionalDomain ;
    skos:prefLabel "Build investor relationships" ;
    p1z:apqcId "11010" ;
    p1z:apqcHierarchyId "12.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a strategic management responsibility for integrating finance, communication, marketing, and securities law compliance. Allow the most effective two-way communication among the organization, the financial community, and other constituencies. Enlist the investor relations function to provide market intelligence to corporate management." ;
    p1z:parentProcess apqc:PCF10012 .

apqc:PCF11035 a p1z:Process ;
    skos:prefLabel "Plan, build, and manage lender relations" ;
    p1z:apqcId "11035" ;
    p1z:apqcHierarchyId "12.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Building and managing relations with bankers or lenders through strong products/services strategies that bankers would want to invest in. Foster a receptive environment for low rates of interest, easy access to loans, etc." ;
    p1z:parentProcess apqc:PCF11010 .

apqc:PCF11036 a p1z:Process ;
    skos:prefLabel "Plan, build, and manage analyst relations" ;
    p1z:apqcId "11036" ;
    p1z:apqcHierarchyId "12.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and maintaining long-term relations with analysts. Involve analysts in strategy and product decisions in order to elicit valuable information." ;
    p1z:parentProcess apqc:PCF11010 .

apqc:PCF11037 a p1z:Process ;
    skos:prefLabel "Communicate with shareholders" ;
    p1z:apqcId "11037" ;
    p1z:apqcHierarchyId "12.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Practicing regular, transparent communication with shareholders through annual shareholders' meetings, quarterly earnings calls, shareholders letters, one-on-one emails or calls, etc." ;
    p1z:parentProcess apqc:PCF11010 .

apqc:PCF11011 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage government and industry relationships" ;
    p1z:apqcId "11011" ;
    p1z:apqcHierarchyId "12.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and maintaining relationships with government and industry representatives." ;
    p1z:parentProcess apqc:PCF10012 .

apqc:PCF11038 a p1z:Process ;
    skos:prefLabel "Manage government relations" ;
    p1z:apqcId "11038" ;
    p1z:apqcHierarchyId "12.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Persuading public and government policy at the local, regional, national, and global level (subject to government regulations)." ;
    p1z:parentProcess apqc:PCF11011 .

apqc:PCF12869 a p1z:Process ;
    skos:prefLabel "Assess relationships" ;
    p1z:apqcId "12869" ;
    p1z:apqcHierarchyId "12.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ascertaining how the business entity relates to all levels of government. Identify areas that needs further growth and resources to foster those relationships." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF12870 a p1z:Process ;
    skos:prefLabel "Appoint responsible executives" ;
    p1z:apqcId "12870" ;
    p1z:apqcHierarchyId "12.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assigning executive level resources to manage, grow, and drive relationships with government bodies." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF12871 a p1z:Process ;
    skos:prefLabel "Monitor relationships" ;
    p1z:apqcId "12871" ;
    p1z:apqcHierarchyId "12.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing current relationships with government bodies and entities." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF12872 a p1z:Process ;
    skos:prefLabel "Receive input from internal advisors" ;
    p1z:apqcId "12872" ;
    p1z:apqcHierarchyId "12.2.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Garnering internal advice from an informal group in order to successfully maintain and advance relationships." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF12873 a p1z:Process ;
    skos:prefLabel "Receive input from external advisors" ;
    p1z:apqcId "12873" ;
    p1z:apqcHierarchyId "12.2.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Garnering third party advice from an informal group in order to successfully maintain and advance relationships." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF12874 a p1z:Process ;
    skos:prefLabel "Liaise with authorities" ;
    p1z:apqcId "12874" ;
    p1z:apqcHierarchyId "12.2.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Meeting with government heads and representatives." ;
    p1z:parentProcess apqc:PCF11038 .

apqc:PCF11039 a p1z:Process ;
    skos:prefLabel "Manage relations with quasi-government bodies" ;
    p1z:apqcId "11039" ;
    p1z:apqcHierarchyId "12.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing relations with quasi-governmental organizations, corporations, businesses, or any other agency that is treated by national laws and principles to be under the supervision of the government but also distinct and self-directed from the government." ;
    p1z:parentProcess apqc:PCF11011 .

apqc:PCF12875 a p1z:Process ;
    skos:prefLabel "Establish relationships with agencies" ;
    p1z:apqcId "12875" ;
    p1z:apqcHierarchyId "12.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Engaging government, regulatory, or industry agencies to establish relationships. Analyze steps and requirements necessary for inclusion, if needed." ;
    p1z:parentProcess apqc:PCF11039 .

apqc:PCF12876 a p1z:Process ;
    skos:prefLabel "Respond to audit inquiries" ;
    p1z:apqcId "12876" ;
    p1z:apqcHierarchyId "12.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Cooperating with auditors regarding potential or ongoing inquiries." ;
    p1z:parentProcess apqc:PCF11039 .

apqc:PCF12877 a p1z:Process ;
    skos:prefLabel "Maintain documentation of contacts" ;
    p1z:apqcId "12877" ;
    p1z:apqcHierarchyId "12.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping a repository of documents that contain information about the network of partners, prospects and customers. Keep records up-to-date with routine reviews and modify as needed." ;
    p1z:parentProcess apqc:PCF11039 .

apqc:PCF12878 a p1z:Process ;
    skos:prefLabel "Plan and manage meetings" ;
    p1z:apqcId "12878" ;
    p1z:apqcHierarchyId "12.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring regular interaction between business entity and quasi-government bodies in order to maintain established relationships. Collect and record meeting data for further analysis and use." ;
    p1z:parentProcess apqc:PCF11039 .

apqc:PCF11040 a p1z:Process ;
    skos:prefLabel "Manage relations with trade or industry groups" ;
    p1z:apqcId "11040" ;
    p1z:apqcHierarchyId "12.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing relations with organizations established and financed by businesses that operate in a specific industry. Participate in public relations actions such as lobbying and publishing, advertising, education, and political donations." ;
    p1z:parentProcess apqc:PCF11011 .

apqc:PCF12879 a p1z:Process ;
    skos:prefLabel "Evaluate the requirements for strategic relationships" ;
    p1z:apqcId "12879" ;
    p1z:apqcHierarchyId "12.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the requirements to enter in to an agreement with trade or industry agencies. Discover what activities or processes can be conducted to provide the best mutual outcome." ;
    p1z:parentProcess apqc:PCF11040 .

apqc:PCF12880 a p1z:Process ;
    skos:prefLabel "Monitor the success of the partnerships" ;
    p1z:apqcId "12880" ;
    p1z:apqcHierarchyId "12.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing current relationships with trade and industry groups. Ensure that the partnership in successful and make modifications where needed." ;
    p1z:parentProcess apqc:PCF11040 .

apqc:PCF12881 a p1z:Process ;
    skos:prefLabel "Extend or change the relationships" ;
    p1z:apqcId "12881" ;
    p1z:apqcHierarchyId "12.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing additional information or inclusion for third party trade or industry entities; or changing existing parameters to modify the current relationship. Communicate and execute changes." ;
    p1z:parentProcess apqc:PCF11040 .

apqc:PCF11041 a p1z:Process ;
    skos:prefLabel "Manage lobby activities" ;
    p1z:apqcId "11041" ;
    p1z:apqcHierarchyId "12.2.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing lobbying activities to affect government policies." ;
    p1z:parentProcess apqc:PCF11011 .

apqc:PCF11012 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage relations with board of directors" ;
    p1z:apqcId "11012" ;
    p1z:apqcHierarchyId "12.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining relations with representatives of the stockholders. Establish corporate management-related policies and to make decisions on major company issues. Implement practices designed to engender communication, trust, and cooperation." ;
    p1z:parentProcess apqc:PCF10012 .

apqc:PCF11042 a p1z:Process ;
    skos:prefLabel "Report financial results" ;
    p1z:apqcId "11042" ;
    p1z:apqcHierarchyId "12.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Reporting financial results to management, and releasing results to the public. Report financial statements, including the income statement, balance sheet, and statement of cash flows." ;
    p1z:parentProcess apqc:PCF11012 .

apqc:PCF11043 a p1z:Process ;
    skos:prefLabel "Report audit findings" ;
    p1z:apqcId "11043" ;
    p1z:apqcHierarchyId "12.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Reporting audit findings to management. Practice an internal audit with criteria for confirming a problem, a description of the situation, and the root cause of the problem. Make recommendations that resolve the issue." ;
    p1z:parentProcess apqc:PCF11012 .

apqc:PCF11013 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage legal and ethical issues" ;
    p1z:apqcId "11013" ;
    p1z:apqcHierarchyId "12.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing legal practices to abide by the law, as well as ethical practices." ;
    p1z:parentProcess apqc:PCF10012 .

apqc:PCF11044 a p1z:Process ;
    skos:prefLabel "Create ethics policies" ;
    p1z:apqcId "11044" ;
    p1z:apqcHierarchyId "12.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a code of ethics that communicate the organization's philosophy to employees, vendors, customers, clients, and the public." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11045 a p1z:Process ;
    skos:prefLabel "Manage corporate governance policies" ;
    p1z:apqcId "11045" ;
    p1z:apqcHierarchyId "12.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the system of rules, practices, and processes through which a company is directed and controlled. Balance stakeholder interests including shareholders, management, customers, suppliers, financiers, government, and the community. Outline a strategy for achieving organizational goals, from action plans and internal controls to performance measurement and corporate disclosure." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11046 a p1z:Process ;
    skos:prefLabel "Develop and perform preventive law programs" ;
    p1z:apqcId "11046" ;
    p1z:apqcHierarchyId "12.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and applying programs and activities. Encourage the adherence preventive laws, such as environmental law, sex discrimination, computer law, estate planning, corporate compliance, business planning, and property transactions." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11047 a p1z:Process ;
    skos:prefLabel "Ensure compliance" ;
    p1z:apqcId "11047" ;
    p1z:apqcHierarchyId "12.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring the organization's compliance position. Validate compliance with different statutes, regulatory directions, and legal principles (using Establish compliance framework and policies [17468]). Coordinate with compliance and risk management personnel." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11053 a p1z:Process ;
    skos:prefLabel "Plan and initiate compliance program" ;
    p1z:apqcId "11053" ;
    p1z:apqcHierarchyId "12.4.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Employing an internal system or process to identify and reduce the risk of breaching the Competition and Consumer Act 2010. Remedy any breach. Create a culture of compliance. Design compliance programs." ;
    p1z:parentProcess apqc:PCF11047 .

apqc:PCF11054 a p1z:Process ;
    skos:prefLabel "Execute compliance program" ;
    p1z:apqcId "11054" ;
    p1z:apqcHierarchyId "12.4.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the established compliance program in order to meet the government laws and regulations. Create a compliance team that scrutinizes the rules set out by government bodies such as the Securities and Exchange Commission." ;
    p1z:parentProcess apqc:PCF11047 .

apqc:PCF11048 a p1z:Process ;
    skos:prefLabel "Manage outside counsel" ;
    p1z:apqcId "11048" ;
    p1z:apqcHierarchyId "12.4.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing professionals, sought externally for assistance over legal and ethical concerns. Administer and oversee assistance from subject matter experts and professionals for sourcing expert opinion and counseling over legal and ethical matters." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11056 a p1z:Process ;
    skos:prefLabel "Assess problem and determine work requirements" ;
    p1z:apqcId "11056" ;
    p1z:apqcHierarchyId "12.4.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the problems and deciding the action requirements for engaging outside counsel. This process element calls upon the organization to internally analyze the issues for which assistance from external counsel is needed. Additionally, the organization needs to break-down the issue, identifying the tasks and exercises where outside counsel can help." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11057 a p1z:Process ;
    skos:prefLabel "Engage/Retain outside counsel if necessary" ;
    p1z:apqcId "11057" ;
    p1z:apqcHierarchyId "12.4.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recruiting the assistance of outside counsel for any legal and/or ethical concerns. Engage and/or retain any external counsel sought from subject matter experts and professionals." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11058 a p1z:Process ;
    skos:prefLabel "Receive strategy/budget" ;
    p1z:apqcId "11058" ;
    p1z:apqcHierarchyId "12.4.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Making a financial plan. This strategy sets out, using figures, an organization's expected future results. Enlist the finance function to support work generated by other business functions in order to build and secure their support for the budget." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11059 a p1z:Process ;
    skos:prefLabel "Receive work product and manage/monitor case and work performed" ;
    p1z:apqcId "11059" ;
    p1z:apqcHierarchyId "12.4.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Receiving deliverables from outside counsel, and monitoring the efforts committed by them. Track the progress of, collect, and validate the required work product from the subject matter experts and professionals engaged as external counsel. Verify the amount of effort dedicated by these counsels to the issue at hand, in order to confirm their fees." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11060 a p1z:Process ;
    skos:prefLabel "Process payment for legal services" ;
    p1z:apqcId "11060" ;
    p1z:apqcHierarchyId "12.4.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Making payments to legal advisers for their services. Payments include addressing issues or suits by customers, suppliers, competitors, bankers, government agencies, etc." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11061 a p1z:Process ;
    skos:prefLabel "Track legal activity/performance" ;
    p1z:apqcId "11061" ;
    p1z:apqcHierarchyId "12.4.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Keeping track of the legal activities and performance of the organization." ;
    p1z:parentProcess apqc:PCF11048 .

apqc:PCF11049 a p1z:Process ;
    skos:prefLabel "Protect intellectual property" ;
    p1z:apqcId "11049" ;
    p1z:apqcHierarchyId "12.4.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Safeguarding the intellectual property of the organization. This process requires the organization to protect a wide variety of intellectual property created by it. This includes leveraging artificial intelligence(AI) to identify potential infringement of intellectual property and making sure employees are adhering to company policies around use of artificial intelligence(AI). It involves creating and managing non-disclosure agreements (NDAs), following up on current developments in the areas where the organization holds patents, tracking the use of the organization's copyrighted material, creating and upholding licensing terms, and administering policies for safeguarding intellectual property." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11062 a p1z:Process ;
    skos:prefLabel "Manage copyrights, patents, and trademarks" ;
    p1z:apqcId "11062" ;
    p1z:apqcHierarchyId "12.4.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the patents and copyrights already held or sought by the organization. Administer and oversee applying for, securing, and maintaining intellectual property rights in the form of patents and copyrights. Submit applications for such rights. Handle associated legal issues. Draft and communicate proper attributions. Collect royalties. Monitor any misuse of the intellectual property rights." ;
    p1z:parentProcess apqc:PCF11049 .

apqc:PCF11063 a p1z:Process ;
    skos:prefLabel "Maintain intellectual property rights and restrictions" ;
    p1z:apqcId "11063" ;
    p1z:apqcHierarchyId "12.4.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the upkeep of intellectual property rights by creating and managing a framework of rules, policies, procedures, and restrictions. Outline a clear policy for any possible scenario of their use by any external agent." ;
    p1z:parentProcess apqc:PCF11049 .

apqc:PCF11064 a p1z:Process ;
    skos:prefLabel "Administer licensing terms" ;
    p1z:apqcId "11064" ;
    p1z:apqcHierarchyId "12.4.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering and overseeing the terms and policies associated with licensing the organization's intellectual property. Create and manage the policies and terms governing the possible granting of a license to any external agent. Demarcate a clear framework that governs the licensing of any patents or copyrights held by the organization." ;
    p1z:parentProcess apqc:PCF11049 .

apqc:PCF11065 a p1z:Process ;
    skos:prefLabel "Administer options" ;
    p1z:apqcId "11065" ;
    p1z:apqcHierarchyId "12.4.6.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing options regarding licensing agreements. Follow favorable terms and conditions." ;
    p1z:parentProcess apqc:PCF11049 .

apqc:PCF11050 a p1z:Process ;
    skos:prefLabel "Resolve disputes and litigations" ;
    p1z:apqcId "11050" ;
    p1z:apqcHierarchyId "12.4.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Resolving disputes or civil lawsuits internally or externally." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11051 a p1z:Process ;
    skos:prefLabel "Provide legal advice/counseling" ;
    p1z:apqcId "11051" ;
    p1z:apqcHierarchyId "12.4.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing legal advice concerning the substance or procedure of a law in relation to a particular situation." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11052 a p1z:Process ;
    skos:prefLabel "Negotiate and document agreements/contracts" ;
    p1z:apqcId "11052" ;
    p1z:apqcHierarchyId "12.4.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Negotiating terms to reach a final draft of a contract that is acceptable to all parties." ;
    p1z:parentProcess apqc:PCF11013 .

apqc:PCF11014 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage public relations program" ;
    p1z:apqcId "11014" ;
    p1z:apqcHierarchyId "12.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing a public relations programs through business and communications skills." ;
    p1z:parentProcess apqc:PCF10012 .

apqc:PCF11066 a p1z:Process ;
    skos:prefLabel "Manage community relations" ;
    p1z:apqcId "11066" ;
    p1z:apqcHierarchyId "12.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and administering community relations. Establish business connections with the people constituting the environment the organization operates in and draws resources from in order to foster mutual understanding, trust, and support. Create programs that promote the organization's image in a positive and community-oriented way." ;
    p1z:parentProcess apqc:PCF11014 .

apqc:PCF11067 a p1z:Process ;
    skos:prefLabel "Manage media relations" ;
    p1z:apqcId "11067" ;
    p1z:apqcHierarchyId "12.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and managing relations with media. Develop connections with journalists to solicit critical, third-party endorsements for a product, issue, service, or organization." ;
    p1z:parentProcess apqc:PCF11014 .

apqc:PCF11068 a p1z:Process ;
    skos:prefLabel "Promote political stability" ;
    p1z:apqcId "11068" ;
    p1z:apqcHierarchyId "12.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Promoting political security and stability in the regions where the organization conducts business. Encourage political stability in the regions where the organization operates. Support civic programs, citizen engagement, connection platforms, etc." ;
    p1z:parentProcess apqc:PCF11014 .

apqc:PCF11069 a p1z:Process ;
    skos:prefLabel "Create press releases" ;
    p1z:apqcId "11069" ;
    p1z:apqcHierarchyId "12.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing press releases to communicate developments and generate interest in the organization." ;
    p1z:parentProcess apqc:PCF11014 .

apqc:PCF11070 a p1z:Process ;
    skos:prefLabel "Issue press releases" ;
    p1z:apqcId "11070" ;
    p1z:apqcHierarchyId "12.5.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Issuing press releases to carefully selected media in distribution channels such as the web, newspapers, and social media." ;
    p1z:parentProcess apqc:PCF11014 .

apqc:PCF10013 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and Manage Business Capabilities" ;
    p1z:apqcId "10013" ;
    p1z:apqcHierarchyId "13.0" ;
    p1z:apqcLevel 1 ;
    p1z:metricsAvailable true ;
    skos:definition "Performing activities by an organization that are fundamental to the successful operation of the organization, even across functions in a business. Capabilities defined in the PCF include business process management; portfolio, program, and project management; quality management; change management; benchmarking; environmental health and safety management; and knowledge management." .

apqc:PCF16378 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage business processes" ;
    p1z:apqcId "16378" ;
    p1z:apqcHierarchyId "13.1" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and administering governance for management of the processes. Outline and manage the frameworks for management of the processes. Define the business processes. Administer the performance of the processes. Enhance the business processes." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF16379 a p1z:Process ;
    skos:prefLabel "Establish and maintain process management governance" ;
    p1z:apqcId "16379" ;
    p1z:apqcHierarchyId "13.1.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and managing the organization's approach to governing business process management. Establish and manage tools to support the governance process. Assign ownership for all business processes. Perform activities to administer the governing process." ;
    p1z:parentProcess apqc:PCF16378 .

apqc:PCF16380 a p1z:Process ;
    skos:prefLabel "Define and manage governance approach" ;
    p1z:apqcId "16380" ;
    p1z:apqcHierarchyId "13.1.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining and managing the methodology for administering business process management (BPM). Define the method for setting standards and priorities for BPM efforts. Identify BPM governance leaders. Define BPM project participants' roles." ;
    p1z:parentProcess apqc:PCF16379 .

apqc:PCF16381 a p1z:Process ;
    skos:prefLabel "Establish and maintain process tools and templates" ;
    p1z:apqcId "16381" ;
    p1z:apqcHierarchyId "13.1.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Instituting, organizing, and maintaining the upkeep of the techniques used for business process management (BPM). Create and maintain templates of BPM tools that can be readily implemented, including process engine, business analytics, content management, and collaboration tools." ;
    p1z:parentProcess apqc:PCF16379 .

apqc:PCF16382 a p1z:Process ;
    skos:prefLabel "Assign and support process ownership" ;
    p1z:apqcId "16382" ;
    p1z:apqcHierarchyId "13.1.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assigning resources (employees) ownership of tasks. These include the responsibility of identifying, analyzing, and improving business processes in order to meet the goals and objectives such as increasing profits and performance, reducing costs, and accelerating schedules." ;
    p1z:parentProcess apqc:PCF16379 .

apqc:PCF16383 a p1z:Process ;
    skos:prefLabel "Perform process governance activities" ;
    p1z:apqcId "16383" ;
    p1z:apqcHierarchyId "13.1.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing and executing activities for governing business processes. Execute activities that encourage participation, accountability, transparency, responsiveness, equity and inclusiveness, etc. within the business processes." ;
    p1z:parentProcess apqc:PCF16379 .

apqc:PCF16384 a p1z:Process ;
    skos:prefLabel "Define and manage process frameworks" ;
    p1z:apqcId "16384" ;
    p1z:apqcHierarchyId "13.1.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and organizing the structural composition of business processes. Design, establish, and administer the framework. Identify any cross-functional processes that are mandatory for achieving business excellence." ;
    p1z:parentProcess apqc:PCF16378 .

apqc:PCF16385 a p1z:Process ;
    skos:prefLabel "Establish and maintain process framework" ;
    p1z:apqcId "16385" ;
    p1z:apqcHierarchyId "13.1.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and managing the framework that outlines the required business processes of the organization, key elements, and how they should interact. Institute strategy infrastructure and product, operations, and enterprise management." ;
    p1z:parentProcess apqc:PCF16384 .

apqc:PCF16386 a p1z:Process ;
    skos:prefLabel "Identify cross-functional processes" ;
    p1z:apqcId "16386" ;
    p1z:apqcHierarchyId "13.1.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the different functional areas working on the same project or goal." ;
    p1z:parentProcess apqc:PCF16384 .

apqc:PCF16387 a p1z:Process ;
    skos:prefLabel "Define processes" ;
    p1z:apqcId "16387" ;
    p1z:apqcHierarchyId "13.1.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining and establishing the business processes of the organization. Scope, analyze, map, and publish processes for the employees who may require it." ;
    p1z:parentProcess apqc:PCF16378 .

apqc:PCF16388 a p1z:Process ;
    skos:prefLabel "Scope processes" ;
    p1z:apqcId "16388" ;
    p1z:apqcHierarchyId "13.1.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the extent and limits of business processes. Define the range and diversity of all the set of activities and tasks that, once completed, will accomplish an organizational goal." ;
    p1z:parentProcess apqc:PCF16387 .

apqc:PCF16389 a p1z:Process ;
    skos:prefLabel "Analyze processes" ;
    p1z:apqcId "16389" ;
    p1z:apqcHierarchyId "13.1.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and examining the set of activities and tasks that, once completed, will accomplish an organizational goal. Create a business process model that captures how a business process works and how individuals from different groups work together to achieve a business goal." ;
    p1z:parentProcess apqc:PCF16387 .

apqc:PCF21452 a p1z:Process ;
    skos:prefLabel "Identify and denote process control points" ;
    p1z:apqcId "21452" ;
    p1z:apqcHierarchyId "13.1.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishment of a \"checkpoint\" in a process that prevent the process from continuing unless all requirements are satisfied." ;
    p1z:parentProcess apqc:PCF16387 .

apqc:PCF16390 a p1z:Process ;
    skos:prefLabel "Model and document processes" ;
    p1z:apqcId "16390" ;
    p1z:apqcHierarchyId "13.1.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining what a business entity does, who is responsible, to what standard a business process should be completed, and how the success of a business process can be determined. Identify processes, gather information gathering, interview participants, map processes, and perform analysis." ;
    p1z:parentProcess apqc:PCF16387 .

apqc:PCF16391 a p1z:Process ;
    skos:prefLabel "Publish processes" ;
    p1z:apqcId "16391" ;
    p1z:apqcHierarchyId "13.1.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Disclosing the information available on business processes. Ensure the availability of the information regarding the business processes to all process team members, business stakeholders, and process owners. Use BPM software, as well as business process diagrams and documents that help depict the required information." ;
    p1z:parentProcess apqc:PCF16387 .

apqc:PCF16392 a p1z:Process ;
    skos:prefLabel "Manage process performance" ;
    p1z:apqcId "16392" ;
    p1z:apqcHierarchyId "13.1.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and handling the performance of business processes. Provide training to process owners. Support the execution of business processes. Measure and report the performance of the business processes." ;
    p1z:parentProcess apqc:PCF16378 .

apqc:PCF16393 a p1z:Process ;
    skos:prefLabel "Provide process training" ;
    p1z:apqcId "16393" ;
    p1z:apqcHierarchyId "13.1.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing training for the employees and process owners that administer the business processes. Design internal training programs or source third party agencies to provide the skills and training necessary." ;
    p1z:parentProcess apqc:PCF16392 .

apqc:PCF16394 a p1z:Process ;
    skos:prefLabel "Support process execution" ;
    p1z:apqcId "16394" ;
    p1z:apqcHierarchyId "13.1.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assisting and executing the business processes. Use business process execution language (BEPL), which is a standard, executable language for specifying actions within the business processes with the use of web services." ;
    p1z:parentProcess apqc:PCF16392 .

apqc:PCF16395 a p1z:Process ;
    skos:prefLabel "Measure and report process performance" ;
    p1z:apqcId "16395" ;
    p1z:apqcHierarchyId "13.1.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Defining and using performance indicators to consider the financial perspective, customer perspective, internal process perspective, and learning perspective of the organization." ;
    p1z:parentProcess apqc:PCF16392 .

apqc:PCF21453 a p1z:Process ;
    skos:prefLabel "Improve processes" ;
    p1z:apqcId "21453" ;
    p1z:apqcHierarchyId "13.1.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, selecting, and managing improvements. Based on the type and scope of the improvement, determination of the appropriate improvement methodology (e.g., Lean, Six Sigma, etc.) should guide the effort. This includes continuous improvement, process redesign, process reengineering, and application of the organizations approaches for Manage projects." ;
    p1z:parentProcess apqc:PCF16378 .

apqc:PCF16397 a p1z:Process ;
    skos:prefLabel "Identify and select improvement opportunities" ;
    p1z:apqcId "16397" ;
    p1z:apqcHierarchyId "13.1.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Helping a process owner to identify, analyze, and improve existing business processes within an organization to meet new goals and objectives." ;
    p1z:parentProcess apqc:PCF21453 .

apqc:PCF11138 a p1z:Process ;
    skos:prefLabel "Select process improvement methodology" ;
    p1z:apqcId "11138" ;
    p1z:apqcHierarchyId "13.1.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and choosing methodologies to identify, analyze, and improve existing processes within an organization to meet new goals and objective. Assess the various methodologies available such as process mapping, statistical process control, and simulation. Choose the most appropriate and effective methodology." ;
    p1z:parentProcess apqc:PCF21453 .

apqc:PCF16398 a p1z:Process ;
    skos:prefLabel "Manage improvement projects" ;
    p1z:apqcId "16398" ;
    p1z:apqcHierarchyId "13.1.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and implementing a systematic approach to help the organization optimize its underlying processes in order to achieve more efficient results. Systematically gather information to clarify issues or problems. Intervene for improvements. Restructure training programs as appropriate to increase effectiveness." ;
    p1z:parentProcess apqc:PCF21453 .

apqc:PCF16399 a p1z:Process ;
    skos:prefLabel "Perform continuous improvement activities" ;
    p1z:apqcId "16399" ;
    p1z:apqcHierarchyId "13.1.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Persistently implementing activities for improving business processes." ;
    p1z:parentProcess apqc:PCF21453 .

apqc:PCF16400 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage portfolio, program, and project" ;
    p1z:apqcId "16400" ;
    p1z:apqcHierarchyId "13.2" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing investments, holdings, products, businesses, and brands, along with the related projects that together constitute a program." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF16401 a p1z:Process ;
    skos:prefLabel "Manage portfolio" ;
    p1z:apqcId "16401" ;
    p1z:apqcHierarchyId "13.2.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the business portfolio of the organization, including investments, holdings, products, businesses, and brands. Establish a portfolio strategy. Define portfolio governance. Monitor and control the portfolio." ;
    p1z:parentProcess apqc:PCF16400 .

apqc:PCF16402 a p1z:Process ;
    skos:prefLabel "Establish portfolio strategy" ;
    p1z:apqcId "16402" ;
    p1z:apqcHierarchyId "13.2.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Instituting the strategy for managing business portfolio. Create a systematic plan that defines the strategy for managing investments, holdings, products, businesses, and brands." ;
    p1z:parentProcess apqc:PCF16401 .

apqc:PCF16403 a p1z:Process ;
    skos:prefLabel "Define portfolio governance" ;
    p1z:apqcId "16403" ;
    p1z:apqcHierarchyId "13.2.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the administration of business portfolio of the organization. Create and manage the rules and regulations regarding the business processes in order to identify, select, prioritize, and monitor portfolio components. Include a set of metrics to indicate the health and progress of the portfolio in the most vital area." ;
    p1z:parentProcess apqc:PCF16401 .

apqc:PCF16404 a p1z:Process ;
    skos:prefLabel "Monitor and control portfolio" ;
    p1z:apqcId "16404" ;
    p1z:apqcHierarchyId "13.2.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing and administering the business portfolio of the organization. Monitor all activities related to investments, holdings, products, businesses, and brands by effectively monitoring and supervising these activities." ;
    p1z:parentProcess apqc:PCF16401 .

apqc:PCF16405 a p1z:Process ;
    skos:prefLabel "Manage programs" ;
    p1z:apqcId "16405" ;
    p1z:apqcHierarchyId "13.2.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing, implementing, and managing business programs. Successfully handle related projects that together constitute a program. Establish the program structure and approach. Coordinate with stakeholders and partners. Execute the program. Assess and report the performance of the program. Coordinate and prioritize resources across projects. Manage links between the projects and the overall costs and risks of the program." ;
    p1z:parentProcess apqc:PCF16400 .

apqc:PCF16406 a p1z:Process ;
    skos:prefLabel "Establish program structure and approach" ;
    p1z:apqcId "16406" ;
    p1z:apqcHierarchyId "13.2.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Constructing and instituting the framework and approach to manage business programs. Monitor key factors such as governance, alignment with the overall business vision, assurance, and management." ;
    p1z:parentProcess apqc:PCF16405 .

apqc:PCF16407 a p1z:Process ;
    skos:prefLabel "Manage program stakeholders and partners" ;
    p1z:apqcId "16407" ;
    p1z:apqcHierarchyId "13.2.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing relationships with stakeholders and partners of the business programs." ;
    p1z:parentProcess apqc:PCF16405 .

apqc:PCF16408 a p1z:Process ;
    skos:prefLabel "Manage program execution" ;
    p1z:apqcId "16408" ;
    p1z:apqcHierarchyId "13.2.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering and implementing business programs. Implement and execute programs with the intention of improving an organization's performance. Execute all the individual projects of the program to ensure the desired success." ;
    p1z:parentProcess apqc:PCF16405 .

apqc:PCF16409 a p1z:Process ;
    skos:prefLabel "Review and report program performance" ;
    p1z:apqcId "16409" ;
    p1z:apqcHierarchyId "13.2.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and documenting the performance of business programs. Evaluate the performance of the programs. Create reports on the basis of the analysis. Use performance indicators and metrics such as desired/achieved goals, completion dates, issues and defects, and cost effectiveness." ;
    p1z:parentProcess apqc:PCF16405 .

apqc:PCF16410 a p1z:Process ;
    skos:prefLabel "Manage projects" ;
    p1z:apqcId "16410" ;
    p1z:apqcHierarchyId "13.2.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the scope of the projects. Create plans for implementing the projects. Initiate projects. Review and report project performance to management. Close projects." ;
    p1z:parentProcess apqc:PCF16400 .

apqc:PCF16411 a p1z:Process ;
    skos:prefLabel "Establish project scope" ;
    p1z:apqcId "16411" ;
    p1z:apqcHierarchyId "13.2.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the horizons of business projects. Identify the objectives of the program, along with the resource requirements. Assess the readiness for the project management approach. Identify methodologies for project management. Obtain funding. Develop performance measures and indicators." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF11119 a p1z:Process ;
    skos:prefLabel "Identify appropriate project management methodologies" ;
    p1z:apqcId "11119" ;
    p1z:apqcHierarchyId "13.2.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and implementing the techniques and procedures for managing business projects. Identify the most appropriate models, which are to be employed by the project managers for the purpose of designing, planning, implementing, and achieving project objectives. Examine and assess various project management methodologies such as adaptive project framework, agile development, crystal methods, and feature-driven development." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF16413 a p1z:Process ;
    skos:prefLabel "Develop project plans" ;
    p1z:apqcId "16413" ;
    p1z:apqcHierarchyId "13.2.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the resources and their roles. Identify IT requirements. Create plans for effective training and communication. Design reward approaches. Plan the launch of project. Deploy the project." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF16414 a p1z:Process ;
    skos:prefLabel "Execute projects" ;
    p1z:apqcId "16414" ;
    p1z:apqcHierarchyId "13.2.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing the business projects of the organization. Evaluate the impact of project management. Record and report the status of the project. Manage the project scope. Promote and sustain activities and involvement. Realign and revamp the project management strategy and approach." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF16417 a p1z:Process ;
    skos:prefLabel "Review and report project performance" ;
    p1z:apqcId "16417" ;
    p1z:apqcHierarchyId "13.2.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring the performance of a business project against key performance indicators including the project scope, schedule, quality, cost, and risk criteria. Identify any deviations from the plan. Assess the impact of these deviations on the project, as well as on the overall program. Report results to key stakeholders." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF16418 a p1z:Process ;
    skos:prefLabel "Close projects" ;
    p1z:apqcId "16418" ;
    p1z:apqcHierarchyId "13.2.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Settling each contract. Close each contract applicable to the project or project phase. Finalize all activities across all of the process groups in order to formally close the project or a project phase." ;
    p1z:parentProcess apqc:PCF16410 .

apqc:PCF17471 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage enterprise quality" ;
    p1z:apqcId "17471" ;
    p1z:apqcHierarchyId "13.3" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing organizational attributes that are closely associated with the quality of output. Determine the quality requirements. Evaluate the correspondence between the quality performance and requirements. Manage non-conformance activities. Ensure implementation and maintenance of the enterprise quality management system." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF17472 a p1z:Process ;
    skos:prefLabel "Establish quality requirements" ;
    p1z:apqcId "17472" ;
    p1z:apqcHierarchyId "13.3.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining essential activities, processes, and attributes for securing enterprise quality. Outline critical characteristics for quality. Outline activities encouraging the preservation of quality. Create quality controls. Confirm capabilities in accordance with quality requirements. Finalize the plan for quality maintenance." ;
    p1z:parentProcess apqc:PCF17471 .

apqc:PCF17473 a p1z:Process ;
    skos:prefLabel "Define critical-to-quality characteristics" ;
    p1z:apqcId "17473" ;
    p1z:apqcHierarchyId "13.3.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining characteristics crucial for managing enterprise quality. Translate broad customer needs into specific, actionable, measurable performance requirements. Define the key measurable characteristics of key products and processes." ;
    p1z:parentProcess apqc:PCF17472 .

apqc:PCF17474 a p1z:Process ;
    skos:prefLabel "Define preventive quality activities" ;
    p1z:apqcId "17474" ;
    p1z:apqcHierarchyId "13.3.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying gaps in customer requirements and determining whether the gap will be mitigated through preventive Quality activities or deemed as acceptable risk. The goal of any preventive quality activities is to create provisions to prevent, control, or reduce the risk of not meeting the CtQCs. In addition, any standard methodology that will be used to design or conduct preventive Quality activities are defined and documented." ;
    p1z:parentProcess apqc:PCF17472 .

apqc:PCF17475 a p1z:Process ;
    skos:prefLabel "Develop quality controls" ;
    p1z:apqcId "17475" ;
    p1z:apqcHierarchyId "13.3.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing controls for managing the quality of enterprise. Define the process steps for quality controls and the sampling plan. Identify the tools and methods to measure quality. Define the competencies required." ;
    p1z:parentProcess apqc:PCF17472 .

apqc:PCF17480 a p1z:Process ;
    skos:prefLabel "Prove capability to assess compliance with requirements" ;
    p1z:apqcId "17480" ;
    p1z:apqcHierarchyId "13.3.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Demonstrating the ability and capability to confirm and fulfill the quality requirements in front of customers, managers, employees, board members, associations, regulatory bodies, and creditors. Leverage tools and techniques such as process behavior or control charts, statistical process control, measurement system analysis, gage calibration management, and process capability analysis." ;
    p1z:parentProcess apqc:PCF17472 .

apqc:PCF17481 a p1z:Process ;
    skos:prefLabel "Finalize quality plan" ;
    p1z:apqcId "17481" ;
    p1z:apqcHierarchyId "13.3.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing how the critical-to-quality characteristics will be achieved, controlled, ensured, and managed throughout the lifecycle of a product/service. Address quality requirements and critical-to-quality characteristics. Conduct a preventive quality assessment. Describe how to verify the product/service, verification criteria, and response to nonconformance. Keep records to demonstrate conformity." ;
    p1z:parentProcess apqc:PCF17472 .

apqc:PCF17482 a p1z:Process ;
    skos:prefLabel "Evaluate performance to requirements" ;
    p1z:apqcId "17482" ;
    p1z:apqcHierarchyId "13.3.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing if the performance of the quality plan has achieved the estimated and desired requirements. Conduct tests against the quality plan. Assess the results of these tests." ;
    p1z:parentProcess apqc:PCF17471 .

apqc:PCF17483 a p1z:Process ;
    skos:prefLabel "Test against quality plan" ;
    p1z:apqcId "17483" ;
    p1z:apqcHierarchyId "13.3.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining the quality of organizational processes. Conduct tests. Collect information and data. Record the results of these tests. Determine the dispositions of the test results." ;
    p1z:parentProcess apqc:PCF17482 .

apqc:PCF17487 a p1z:Process ;
    skos:prefLabel "Assess results of tests" ;
    p1z:apqcId "17487" ;
    p1z:apqcHierarchyId "13.3.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the significance of the sample. Summarize the results of the test. Recommend improvement actions. Decide what steps to take next." ;
    p1z:parentProcess apqc:PCF17482 .

apqc:PCF17492 a p1z:Process ;
    skos:prefLabel "Manage non-conformance" ;
    p1z:apqcId "17492" ;
    p1z:apqcHierarchyId "13.3.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling any nonconformance activities or events. Assess the potential impact of the nonconformity. Decide the immediate actions to take. Identify the root causes. Take corrective or preventive action. Ensure future conformance." ;
    p1z:parentProcess apqc:PCF17471 .

apqc:PCF17493 a p1z:Process ;
    skos:prefLabel "Assess potential impact" ;
    p1z:apqcId "17493" ;
    p1z:apqcHierarchyId "13.3.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing any nonconformance events. Determine the need for corrective and/or preventative action(s). Leverage root-cause analysis, risk exposure, and other evaluations to properly review and approve/reject subsequent actions." ;
    p1z:parentProcess apqc:PCF17492 .

apqc:PCF17494 a p1z:Process ;
    skos:prefLabel "Determine immediate action(s)" ;
    p1z:apqcId "17494" ;
    p1z:apqcHierarchyId "13.3.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Initiating immediate corrective, preventative, or no action based upon the impact and likelihood of reoccurrence. Consider cost/benefit, risk exposure, timing, the assignment of responsibility, and other pertinent factors ." ;
    p1z:parentProcess apqc:PCF17492 .

apqc:PCF17495 a p1z:Process ;
    skos:prefLabel "Identify root cause(s)" ;
    p1z:apqcId "17495" ;
    p1z:apqcHierarchyId "13.3.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the reasons that have triggered the nonconformance events or activities. Perform a root-cause analysis through documentary evidence and interviews. Involve the appropriate individuals. Leverage cause analysis and risk assessment." ;
    p1z:parentProcess apqc:PCF17492 .

apqc:PCF17496 a p1z:Process ;
    skos:prefLabel "Take corrective or preventative action" ;
    p1z:apqcId "17496" ;
    p1z:apqcHierarchyId "13.3.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Pursuing corrective and preventative activities to eliminate the cause of a detected nonconformity. Define the nonconformity. Communicate and assign responsibility. Identify the appropriate corrective and preventive action. Implement and monitor for reoccurrence." ;
    p1z:parentProcess apqc:PCF17492 .

apqc:PCF17497 a p1z:Process ;
    skos:prefLabel "Close non-conformance" ;
    p1z:apqcId "17497" ;
    p1z:apqcHierarchyId "13.3.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Closing nonconformance. Perform all the final processes related to the nonconformance, including documenting root causes. Document corrective and preventive actions." ;
    p1z:parentProcess apqc:PCF17492 .

apqc:PCF17498 a p1z:Process ;
    skos:prefLabel "Implement and maintain the enterprise quality management system (EQMS)" ;
    p1z:apqcId "17498" ;
    p1z:apqcHierarchyId "13.3.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and administering the software that manages content and business processes for quality and compliance across the value chain. Define the quality strategy. Plan and deploy the EQMS scope, targets, and goals. Identify core process controls and metric. Develop EQMS governance. Assess the performance of EQMS. Encourage improvements in EQMS." ;
    p1z:parentProcess apqc:PCF17471 .

apqc:PCF17499 a p1z:Process ;
    skos:prefLabel "Define the quality strategy" ;
    p1z:apqcId "17499" ;
    p1z:apqcHierarchyId "13.3.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the strategy for managing enterprise quality. Define and formalize quality techniques and standards. Assign responsibilities for achieving the required quality levels. Standardize the quality maintenance procedure, tools and techniques, recording and reporting, the timing of quality maintenance activities, and the roles and responsibilities for the quality management team." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF17500 a p1z:Process ;
    skos:prefLabel "Plan and deploy the EQMS scope, targets, and goals" ;
    p1z:apqcId "17500" ;
    p1z:apqcHierarchyId "13.3.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and effectively deploying the scope, targets, and goals of EQMS. Define the role of EQMS through nonconformance/corrective and preventive action, compliance/audit management, risk management, failure mode and effects analysis, and statistical process control. Implement EQMS into operational activities. Define the goals and objectives that are to be achieved by the EQMS." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF17501 a p1z:Process ;
    skos:prefLabel "Identify core EQMS processes, controls, and metrics" ;
    p1z:apqcId "17501" ;
    p1z:apqcHierarchyId "13.3.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing and implementing the processes, controls, and metrics for maintenance of EQMS. Define the role of EQMS in failure mode and effects analysis, complaint handling, and advanced product quality planning. Establish the role of EQMS in evaluating metrics such as cost of quality, overall equipment effectiveness, on-time and complete shipments, percentage of products in compliance, and new product introductions." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF17502 a p1z:Process ;
    skos:prefLabel "Develop and document EQMS policies, procedures, standards, and measures" ;
    p1z:apqcId "17502" ;
    p1z:apqcHierarchyId "13.3.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Setting the process limits. Gather required information. Align with other documents and processes. Define the document structure." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF17503 a p1z:Process ;
    skos:prefLabel "Assess the EQMS performance" ;
    p1z:apqcId "17503" ;
    p1z:apqcHierarchyId "13.3.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Benchmarking current performance in quality metrics that span across the value chain. Identify gaps in performance as compared to industry peers. Identify and implement complementary EQMS capabilities. Enable a continuous improvement environment." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF17504 a p1z:Process ;
    skos:prefLabel "Create environment and capability for EQMS improvement(s)" ;
    p1z:apqcId "17504" ;
    p1z:apqcHierarchyId "13.3.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Rewarding excellence in quality. Create and maintain quality partnerships. Maintain talent capabilities and competencies. Incorporate EQMS messaging into communication channels. Transfer proven EQMS methods. Consider factors such as EQMS reviews and gap assessments and the alignment and compatibility of business processes and quality. Adopt Lean principles." ;
    p1z:parentProcess apqc:PCF17498 .

apqc:PCF11074 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage change" ;
    p1z:apqcId "11074" ;
    p1z:apqcHierarchyId "13.4" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Planning, designing, and implementing the change. Ensure improvement in the change process." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF21457 a p1z:Process ;
    skos:prefLabel "Plan for change" ;
    p1z:apqcId "21457" ;
    p1z:apqcHierarchyId "13.4.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating impact and planning change activities. Spanning the lifecycle of change from initial concept, to designing, implementing, and sustaining the change, change planning identifies the activities to enage and enable the stakeholders and all impacted by the change. Change plans should address the interplay between people, process, technology, and knowledge to guide the transition, or tranformation, from current state to the future state." ;
    p1z:parentProcess apqc:PCF11074 .

apqc:PCF11140 a p1z:Process ;
    skos:prefLabel "Determine stakeholders" ;
    p1z:apqcId "11140" ;
    p1z:apqcHierarchyId "13.4.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and communicating with shareholders affected by the change. Consider internal and external stakeholders that will be affected by the change. Determine the amount of influence the change will have on them. Ensure the involvement of these stakeholders in the change process by effectively communicating with them." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11139 a p1z:Process ;
    skos:prefLabel "Assess readiness for change" ;
    p1z:apqcId "11139" ;
    p1z:apqcHierarchyId "13.4.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the level of preparedness of the conditions, attitudes, and resources at all levels in the organization needed for change to happen successfully. Define scope of the proposed change. Select the tools for a change readiness assessment." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11141 a p1z:Process ;
    skos:prefLabel "Identify change champion(s)" ;
    p1z:apqcId "11141" ;
    p1z:apqcHierarchyId "13.4.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying people exhibit an extraordinary interest in the adoption, implementation, and success of the change. Engage champions in each division or team. Define the roles and responsibilities for the change champions. Determine criteria for selecting change champions. Provide training sessions to champions. Reward and recognize champions." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11142 a p1z:Process ;
    skos:prefLabel "Form design team" ;
    p1z:apqcId "11142" ;
    p1z:apqcHierarchyId "13.4.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing a design team for implementing change throughout the organization." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11143 a p1z:Process ;
    skos:prefLabel "Define scope" ;
    p1z:apqcId "11143" ;
    p1z:apqcHierarchyId "13.4.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the extent of the area or subject matter that the change process deals with or to which it is relevant. Establish a set of tools, processes, skills, and principles for managing the people side of change to achieve the required outcomes of the change process." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11144 a p1z:Process ;
    skos:prefLabel "Understand current state" ;
    p1z:apqcId "11144" ;
    p1z:apqcHierarchyId "13.4.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Using graphical and statistical tools such as pareto diagrams, process flow diagrams, cause-and-effect diagrams, check sheets, histograms, run charts, and scatter diagrams." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11145 a p1z:Process ;
    skos:prefLabel "Define future state" ;
    p1z:apqcId "11145" ;
    p1z:apqcHierarchyId "13.4.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the state or position that the organization wants to be in after the implementation of the change. Gather necessary information about the processes, structures, and cultures. Define resource requirements." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11146 a p1z:Process ;
    skos:prefLabel "Conduct organizational risk analysis" ;
    p1z:apqcId "11146" ;
    p1z:apqcHierarchyId "13.4.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Looking beyond the immediate consequences of the threat to a critical asset and placing it in the context of what is important to the organization. Identify the impact of threats to critical assets. Create risk evaluation criteria. Evaluate the impact of threats to critical assets. Incorporate probability into the risk analysis." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11147 a p1z:Process ;
    skos:prefLabel "Assess cultural context" ;
    p1z:apqcId "11147" ;
    p1z:apqcHierarchyId "13.4.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the culture within the organization. Adopt a quantitative, multidimensional measurement approach of an organization's culture and the aspirations for it. Diagnose cultural activities, enhance leadership sections. Integrate cultures." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF20143 a p1z:Process ;
    skos:prefLabel "Identify impacted groups" ;
    p1z:apqcId "20143" ;
    p1z:apqcHierarchyId "13.4.1.10" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the impact of threats to critical assets. Determine what groups are impacted by this impact." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF20144 a p1z:Process ;
    skos:prefLabel "Determine degree/extent of impact" ;
    p1z:apqcId "20144" ;
    p1z:apqcHierarchyId "13.4.1.11" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the impact of threats to critical assets. Determine what assets will be impacted by the change." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11148 a p1z:Process ;
    skos:prefLabel "Establish accountability for change management" ;
    p1z:apqcId "11148" ;
    p1z:apqcHierarchyId "13.4.1.12" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and assigning the people accountable for effective change management. Hold managers accountable for ensuring change happens systematically and rigorously. Ensure that certain behaviors are rewarded or reprimanded accordingly." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11149 a p1z:Process ;
    skos:prefLabel "Identify barriers to change" ;
    p1z:apqcId "11149" ;
    p1z:apqcHierarchyId "13.4.1.13" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the circumstances or obstacles that keep the organization from progressing. Identify who and what are the resources resisting change. Identify integration failures, threats by competitive forces, and complexity failures." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11150 a p1z:Process ;
    skos:prefLabel "Determine change enablers" ;
    p1z:apqcId "11150" ;
    p1z:apqcHierarchyId "13.4.1.14" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the person(s) or thing(s)responsible for making the change possible. Consider factors such as interdependence of efforts, reward to the integrators, sharing of power and responsibility, and employee understanding of why change is essential." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11151 a p1z:Process ;
    skos:prefLabel "Identify resources and develop measures" ;
    p1z:apqcId "11151" ;
    p1z:apqcHierarchyId "13.4.1.15" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the resource requirements, and developing measures for change. Identify the financial, material, human, and informational resources needed to successfully implement the change. Develop programs, campaigns, etc. for establishing the change within the organization." ;
    p1z:parentProcess apqc:PCF21457 .

apqc:PCF11135 a p1z:Process ;
    skos:prefLabel "Design the change" ;
    p1z:apqcId "11135" ;
    p1z:apqcHierarchyId "13.4.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing plans for change management, training, communication, and rewards/incentives. Establish metrics for measuring the change adoption. Clarify new roles for employees. Identify budgets." ;
    p1z:parentProcess apqc:PCF11074 .

apqc:PCF11152 a p1z:Process ;
    skos:prefLabel "Assess connection to other initiatives" ;
    p1z:apqcId "11152" ;
    p1z:apqcHierarchyId "13.4.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Correlating the change initiative with the other initiatives. Create an alignment between the goals and objectives of the change process and that of the other initiatives." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11153 a p1z:Process ;
    skos:prefLabel "Develop change management plans" ;
    p1z:apqcId "11153" ;
    p1z:apqcHierarchyId "13.4.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a detailed structure summary for the purposes of managing the change. Demonstrate the reasons for the change. Define the type and scope of change. Form a change management team. Create a communication plan." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11154 a p1z:Process ;
    skos:prefLabel "Develop training plan" ;
    p1z:apqcId "11154" ;
    p1z:apqcHierarchyId "13.4.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a detailed summary of all the actions relevant to teaching a person a particular skill or type of behavior. Determine who will deliver the training. Determine when and where the apprentice or trainee needs to go to receive the structured component of the training." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11155 a p1z:Process ;
    skos:prefLabel "Develop communication plan" ;
    p1z:apqcId "11155" ;
    p1z:apqcHierarchyId "13.4.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan for imparting or exchanging information relevant the to change. Define goals, objectives, and audience. Gather tools for all communications." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF20145 a p1z:Process ;
    skos:prefLabel "Assign change champion(s)" ;
    p1z:apqcId "20145" ;
    p1z:apqcHierarchyId "13.4.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Utilizing champions that have been trained to carry out needed changes. Engage champions to communicate roles and responsibilities for the change." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11156 a p1z:Process ;
    skos:prefLabel "Develop rewards/incentives plan" ;
    p1z:apqcId "11156" ;
    p1z:apqcHierarchyId "13.4.2.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and designing the plan for rewarding the employees exhibiting the desired behavior. Specify rewards in recognition of service, effort, or achievement regarding the change, including bonuses, compensation, stock options, profit sharing, vacations, and flexible time." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11157 a p1z:Process ;
    skos:prefLabel "Establish change adoption measures" ;
    p1z:apqcId "11157" ;
    p1z:apqcHierarchyId "13.4.2.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a system or standard of measurement for measuring the adoption of the change. Consider activities such as the number of people who have adopted the change, how quickly have they adopted, number of unique adopters, and adopters by teams/divisions." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11158 a p1z:Process ;
    skos:prefLabel "Establish/Clarify new roles" ;
    p1z:apqcId "11158" ;
    p1z:apqcHierarchyId "13.4.2.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and explaining the new roles to employees. Assign roles and responsibilities to resources." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11159 a p1z:Process ;
    skos:prefLabel "Identify budget/roles" ;
    p1z:apqcId "11159" ;
    p1z:apqcHierarchyId "13.4.2.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan of financial outlay for the newly defined roles. Determine the amount of capital the organization is willing to invest in effectuating these new roles, how would the roles be financed, and what would comprise the ROI from these flows. Coordinate personnel responsible for change management and the finance division." ;
    p1z:parentProcess apqc:PCF11135 .

apqc:PCF11136 a p1z:Process ;
    skos:prefLabel "Implement change" ;
    p1z:apqcId "11136" ;
    p1z:apqcHierarchyId "13.4.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Effectuating the change within the desired impact areas of the organization. Ensure adequate commitment from all corners of the organization for the desired change. Create support structures. Refashion all processes deemed necessary. Observe the progress." ;
    p1z:parentProcess apqc:PCF11074 .

apqc:PCF11160 a p1z:Process ;
    skos:prefLabel "Create commitment for improvement/change" ;
    p1z:apqcId "11160" ;
    p1z:apqcHierarchyId "13.4.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Kindling an organization wide commitment for effectuating the change. Effectively communicate the advantages of the desired change. Personalize the pitch for change." ;
    p1z:parentProcess apqc:PCF11136 .

apqc:PCF11161 a p1z:Process ;
    skos:prefLabel "Reengineer business processes and systems" ;
    p1z:apqcId "11161" ;
    p1z:apqcHierarchyId "13.4.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Restructuring, redesigning, repurposing, and/or retrofitting existing business processes, activities, and frameworks in order to effectuate the desired change. Review pertinent processes from the ground up by starting with the desired result. (Build on Select a process improvement methodology [11138] to create business processes that perfectly fit with the road map for change.)" ;
    p1z:parentProcess apqc:PCF11136 .

apqc:PCF11162 a p1z:Process ;
    skos:prefLabel "Support transition to new roles or exit strategies for incumbents" ;
    p1z:apqcId "11162" ;
    p1z:apqcHierarchyId "13.4.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting the transition of personnel to new roles and the dismissal of any existing employees, necessitated for the desired change. Create an on-boarding process for seamlessly transitioning personnel to new roles. Offer orientation and training. Address any concerns. Create a structured procedure for the discharge of incumbents from their positions." ;
    p1z:parentProcess apqc:PCF11136 .

apqc:PCF11163 a p1z:Process ;
    skos:prefLabel "Monitor change" ;
    p1z:apqcId "11163" ;
    p1z:apqcHierarchyId "13.4.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring activities in the change process in order to assess the performance of individual agents and the process as a whole. Oversee the implementation of activities needed for effectuating the change. Track the pace, impact, enthusiasm, reaction, and feedback over the change process." ;
    p1z:parentProcess apqc:PCF11136 .

apqc:PCF20146 a p1z:Process ;
    skos:prefLabel "Report on change" ;
    p1z:apqcId "20146" ;
    p1z:apqcHierarchyId "13.4.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reporting on the outcome of the change. Document changes and the impact those changes had on critical assets. Share findings with those within the target audience: those impacted by the change, change champions, stakeholders, etc." ;
    p1z:parentProcess apqc:PCF11136 .

apqc:PCF11137 a p1z:Process ;
    skos:prefLabel "Sustain improvement" ;
    p1z:apqcId "11137" ;
    p1z:apqcHierarchyId "13.4.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Sustaining the impact of the change process in order to enact continual process improvement. Monitor the performance of re-engineered business processes. Identify best practices and potential issues. Effectuate remedial steps." ;
    p1z:parentProcess apqc:PCF11074 .

apqc:PCF11164 a p1z:Process ;
    skos:prefLabel "Monitor improved process performance" ;
    p1z:apqcId "11164" ;
    p1z:apqcHierarchyId "13.4.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitoring the performance of improved business processes. Track the key performance indicators of the upgraded processes in order to gauge its contribution to the desired change. Expedite through the use of business process management software." ;
    p1z:parentProcess apqc:PCF11137 .

apqc:PCF11165 a p1z:Process ;
    skos:prefLabel "Capture and reuse lessons learned from change process" ;
    p1z:apqcId "11165" ;
    p1z:apqcHierarchyId "13.4.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting and standardizing insights gleaned and the knowledge acquired from studying the change process already implemented. Create case studies/best practices guides from the process of implementing change. Include experienced personnel." ;
    p1z:parentProcess apqc:PCF11137 .

apqc:PCF11166 a p1z:Process ;
    skos:prefLabel "Take corrective action as necessary" ;
    p1z:apqcId "11166" ;
    p1z:apqcHierarchyId "13.4.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement corrective action to adjust the re-engineered processes for maximizing the desired impact. Adjust business processes and systems to implement the desired change." ;
    p1z:parentProcess apqc:PCF11137 .

apqc:PCF11073 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop and manage enterprise-wide knowledge management (KM) capability" ;
    p1z:apqcId "11073" ;
    p1z:apqcHierarchyId "13.5" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating and administering the capability of the organization's knowledge management function. Develop a strategy for knowledge management. Assess capabilities of the knowledge management function." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF11095 a p1z:Process ;
    skos:prefLabel "Develop KM strategy" ;
    p1z:apqcId "11095" ;
    p1z:apqcHierarchyId "13.5.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Creating a plan for managing the organization's knowledge base. Determine what kind of specialized knowledge the organization possesses, which elements of this collective knowledge can prove beneficial, how to capture and maintain this knowledge, how to grant access to this library of information, and how the organization should proceed." ;
    p1z:parentProcess apqc:PCF11073 .

apqc:PCF11100 a p1z:Process ;
    skos:prefLabel "Develop governance model with roles and accountability" ;
    p1z:apqcId "11100" ;
    p1z:apqcHierarchyId "13.5.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a structure for the governance of the organization's collective knowledge. Gather, maintain, and make accessible the collective knowledge base. Develop a standard procedure for the conservation and perpetuation of the organization's knowledge. Create policies for the usage and maintenance of this knowledge. Establish specialized roles." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11102 a p1z:Process ;
    skos:prefLabel "Define roles and accountability of core group versus operating units" ;
    p1z:apqcId "11102" ;
    p1z:apqcHierarchyId "13.5.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Clearly determining the roles and responsibilities of all personnel involved in the management of the organization's corpus of knowledge. Flesh out the roles and responsibilities of the KM core group, as well as the operational staff involved in the upkeep of the knowledge management program." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11103 a p1z:Process ;
    skos:prefLabel "Develop funding models" ;
    p1z:apqcId "11103" ;
    p1z:apqcHierarchyId "13.5.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyze the organization's current approach to funding. Learn from the funding approaches of peer organizations. Evaluate the revenue potential and costs of those short-list funding models. Select funding models to implement." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11104 a p1z:Process ;
    skos:prefLabel "Identify links to key initiatives" ;
    p1z:apqcId "11104" ;
    p1z:apqcHierarchyId "13.5.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying any links that exist between the strategy for knowledge management and any other functional areas. Determine any correlations that exist between the strategic road map for the knowledge management and any other functional areas. Study each function's/unit's attributes." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11105 a p1z:Process ;
    skos:prefLabel "Develop core KM methodologies" ;
    p1z:apqcId "11105" ;
    p1z:apqcHierarchyId "13.5.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating core knowledge management procedures and methodologies. Initiate developing a strategy, planning, execution, and improvement." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11106 a p1z:Process ;
    skos:prefLabel "Assess IT needs and engage IT function" ;
    p1z:apqcId "11106" ;
    p1z:apqcHierarchyId "13.5.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the IT needs for developing the knowledge management strategy, and collaborating with the IT function to implement the strategy. Assess requirements for technologies such as computer hardware, software, electronics, semiconductors, internet, and telecommunications equipment in order to effectively build and implement the strategy for knowledge management." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11107 a p1z:Process ;
    skos:prefLabel "Develop training and communication plans" ;
    p1z:apqcId "11107" ;
    p1z:apqcHierarchyId "13.5.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating plans for KM training plans and conveying the knowledge management strategy within the organization. Create training programs, sessions, and activities in order to familiarize employees and management with the concept of knowledge management." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11108 a p1z:Process ;
    skos:prefLabel "Develop change management approaches" ;
    p1z:apqcId "11108" ;
    p1z:apqcHierarchyId "13.5.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating approaches for effectively administering the changes in knowledge management. Design an approach that transforms individuals, teams, and the organization to a desired future state represented by the change." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11109 a p1z:Process ;
    skos:prefLabel "Develop strategic measures and indicators" ;
    p1z:apqcId "11109" ;
    p1z:apqcHierarchyId "13.5.1.9" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing measures and indicators for evaluating the performance of the knowledge management function. Define key performance indicators such as the amount of knowledge assets created and number of knowledge projects undertaken." ;
    p1z:parentProcess apqc:PCF11095 .

apqc:PCF11096 a p1z:Process ;
    skos:prefLabel "Assess KM capabilities" ;
    p1z:apqcId "11096" ;
    p1z:apqcHierarchyId "13.5.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Assessing the maturity of the existing initiatives in knowledge management, and evaluating existing KM approaches. Identify the gaps and needs in order to enhance the existing KM approaches. Develop and implement new KM approaches." ;
    p1z:parentProcess apqc:PCF11073 .

apqc:PCF11110 a p1z:Process ;
    skos:prefLabel "Assess maturity of existing KM initiatives" ;
    p1z:apqcId "11110" ;
    p1z:apqcHierarchyId "13.5.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating if initiatives are effective or should be discarded. Design a framework for assessing maturity, typically from Level 1 (undefined), Level 2 (repeatable), Level 3 (defined), and Level 4 (managed) through Level 5 (optimized)." ;
    p1z:parentProcess apqc:PCF11096 .

apqc:PCF11111 a p1z:Process ;
    skos:prefLabel "Evaluate existing KM approaches" ;
    p1z:apqcId "11111" ;
    p1z:apqcHierarchyId "13.5.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating existing procedures, policies, and guidelines for knowledge management. Study and examine the organization's approach against industry best practices by benchmarking, competitive analysis, etc." ;
    p1z:parentProcess apqc:PCF11096 .

apqc:PCF11112 a p1z:Process ;
    skos:prefLabel "Identify gaps and needs" ;
    p1z:apqcId "11112" ;
    p1z:apqcHierarchyId "13.5.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the KM approach evaluations in order to identify any gaps or needs. Compare the performance of the KM approach against the desired or expected performance, as well as against the standard knowledge management industry approach." ;
    p1z:parentProcess apqc:PCF11096 .

apqc:PCF20965 a p1z:Process ;
    skos:prefLabel "Design and implement KM capabilities" ;
    p1z:apqcId "20965" ;
    p1z:apqcHierarchyId "13.5.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating knowledge bases and other repositories to preserve and develop company expertise, and to train new employees." ;
    p1z:parentProcess apqc:PCF11073 .

apqc:PCF11114 a p1z:Process ;
    skos:prefLabel "Develop new KM approaches" ;
    p1z:apqcId "11114" ;
    p1z:apqcHierarchyId "13.5.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing new policies, procedures, and guidelines to support knowledge management." ;
    p1z:parentProcess apqc:PCF20965 .

apqc:PCF20966 a p1z:Process ;
    skos:prefLabel "Design resource model for KM approaches" ;
    p1z:apqcId "20966" ;
    p1z:apqcHierarchyId "13.5.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a model to describe resources and approaches to organization's knowledge management. Establish standards and guidelines to be followed." ;
    p1z:parentProcess apqc:PCF20965 .

apqc:PCF11115 a p1z:Process ;
    skos:prefLabel "Implement new KM approaches" ;
    p1z:apqcId "11115" ;
    p1z:apqcHierarchyId "13.5.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing new policies, procedures, and guidelines to support knowledge management." ;
    p1z:parentProcess apqc:PCF20965 .

apqc:PCF20967 a p1z:Process ;
    skos:prefLabel "Leverage and enhance IT for KM approaches" ;
    p1z:apqcId "20967" ;
    p1z:apqcHierarchyId "13.5.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Using existing technologies to improve organization's knowledge management processes. Research available third-party offerings. Develop proprietary solutions. Employ knowledge engineers, data scientists and other relevant personnel." ;
    p1z:parentProcess apqc:PCF20965 .

apqc:PCF20968 a p1z:Process ;
    skos:prefLabel "Develop measures" ;
    p1z:apqcId "20968" ;
    p1z:apqcHierarchyId "13.5.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating metrics that can be used to systematically describe KM approaches and capabilities. Choose applicable scales, benchmarks and units of measure. Determine required precision and error rates." ;
    p1z:parentProcess apqc:PCF20965 .

apqc:PCF20969 a p1z:Process ;
    skos:prefLabel "Evolve and sustain KM capabilities" ;
    p1z:apqcId "20969" ;
    p1z:apqcHierarchyId "13.5.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing resources for improved knowledge management and knowledge engineering." ;
    p1z:parentProcess apqc:PCF11073 .

apqc:PCF11113 a p1z:Process ;
    skos:prefLabel "Enhance/Modify existing KM approaches" ;
    p1z:apqcId "11113" ;
    p1z:apqcHierarchyId "13.5.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Leveraging KM evaluations and identified gap to enhance existing approaches." ;
    p1z:parentProcess apqc:PCF20969 .

apqc:PCF20970 a p1z:Process ;
    skos:prefLabel "Sustain awareness and engagement" ;
    p1z:apqcId "20970" ;
    p1z:apqcHierarchyId "13.5.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing awareness about available knowledge bases and promoting their use to maximize their impact." ;
    p1z:parentProcess apqc:PCF20969 .

apqc:PCF20971 a p1z:Process ;
    skos:prefLabel "Expand KM infrastructure to meet demand" ;
    p1z:apqcId "20971" ;
    p1z:apqcHierarchyId "13.5.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Augmenting available resources to better leverage the offerings of the organization to serve existing clients and to expand the client base." ;
    p1z:parentProcess apqc:PCF20969 .

apqc:PCF21646 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Content" ;
    p1z:apqcId "21646" ;
    p1z:apqcHierarchyId "13.6" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Storing, managing, curating and delivering enterprise content and knowledge assets to enable consistent reuse and informed decision making.  Establish structures and governance that support classification, semantic enrichment, and lifecycle management of content across formats and repositories.  This includes all forms of emerging technologies such as artificial intelligence (AI), machine learning assisted tagging, automated classification, and semantic content processing." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF21647 a p1z:Process ;
    skos:prefLabel "Define content management strategy" ;
    p1z:apqcId "21647" ;
    p1z:apqcHierarchyId "13.6.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a foundational plan that guides how an organization manages its content through the content lifecycle. Outlining the strategy for organizing, delivering, and facilitating access to enterprise content." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21648 a p1z:Process ;
    skos:prefLabel "Establish content management objectives" ;
    p1z:apqcId "21648" ;
    p1z:apqcHierarchyId "13.6.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing objectives for content management that enhance the organization and accessibility of enterprise content. Objectives can include curation, findability, consistency, user-centric design, lifecycle management, governance and roles, quality assurance, and measurement and evaluation." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21649 a p1z:Process ;
    skos:prefLabel "Develop content management governance model" ;
    p1z:apqcId "21649" ;
    p1z:apqcHierarchyId "13.6.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a structured framework with roles and responsibilities to oversee and guide content management practices within an organization to ensure content is managed consistently, remains high-quality, meets the needs of users, and enhances the overall content management strategy." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21650 a p1z:Process ;
    skos:prefLabel "Develop content management funding models" ;
    p1z:apqcId "21650" ;
    p1z:apqcHierarchyId "13.6.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining funding approaches for content management activities, capabilities, and infrastructure to support sustainable operations, investment prioritization, and alignment with organizational objectives." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21651 a p1z:Process ;
    skos:prefLabel "Develop core content management methodologies" ;
    p1z:apqcId "21651" ;
    p1z:apqcHierarchyId "13.6.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and implementing content management methodologies to effectively store, deliver, and facilitate access to enterprise content. Core methodologies may include prioritization of critical or high-value content, findability to ensure ease of locating relevant content, content lifecycle management, standardization of content creation, review and access, collaboration, and technology integration." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21652 a p1z:Process ;
    skos:prefLabel "Assess content management IT needs and engage IT function" ;
    p1z:apqcId "21652" ;
    p1z:apqcHierarchyId "13.6.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing technology requirements for content management and collaborating with the IT function to align systems, integration, security, and support with content management needs. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21653 a p1z:Process ;
    skos:prefLabel "Develop content management training and communication plans" ;
    p1z:apqcId "21653" ;
    p1z:apqcHierarchyId "13.6.1.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing training, change and communication plans to support the organization's content management practices. Define target audiences, required competencies, learning objectives, and delivery methods to ensure consistent understanding and adoption of content standards, tools, and workflows. Create communication strategies to promote awareness of content governance, reinforce expectations, and inform stakeholders of process updates, system changes, and best practices. Coordinate with internal partners to design training materials, schedule learning sessions, and disseminate communications that enable effective and compliant content creation, storage, use, and lifecycle management. Monitor participation, evaluate effectiveness, and continuously improve based on feedback and evolving organizational needs." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21655 a p1z:Process ;
    skos:prefLabel "Develop strategic measures and indicators for content management" ;
    p1z:apqcId "21655" ;
    p1z:apqcHierarchyId "13.6.1.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and implementing performance measures to assess the effectiveness and strategic value of content management practices. Align indicators with organizational goals, governance requirements, and user needs. Specify data sources, measurement methods, and reporting cadences to provide reliable insight into content quality, accessibility, utilization, and lifecycle compliance. Collaborate with stakeholders to validate metric definitions, integrate measures into dashboards, and set expectations for monitoring and improvement. Periodically review and refine measures in response to changing priorities and requirements." ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21711 a p1z:Process ;
    skos:prefLabel "Manage content intelligence and insights" ;
    p1z:apqcId "21711" ;
    p1z:apqcHierarchyId "13.6.1.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Monitor and analyze content ecosystem performance to understand search behavior, user intent, knowledge gaps, content effectiveness, and content lifecycle health. Use content usage patterns and derived insights to identify emerging needs, anticipate gaps, recommend updates or new content, and continuously optimize the relevance, quality, and accessibility of the content ecosystem. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI)" ;
    p1z:parentProcess apqc:PCF21647 .

apqc:PCF21656 a p1z:Process ;
    skos:prefLabel "Develop and manage taxonomies" ;
    p1z:apqcId "21656" ;
    p1z:apqcHierarchyId "13.6.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing and managing taxonomies, ontologies, and related semantic structures to classify, enrich, and relate enterprise content and knowledge assets, supporting consistent interpretation, discoverability, reuse, and advanced capabilities such as automated classification and semantic processing." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21657 a p1z:Process ;
    skos:prefLabel "Determine content management requirements" ;
    p1z:apqcId "21657" ;
    p1z:apqcHierarchyId "13.6.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying functional, operational, governance, and compliance requirements that content management practices and solutions must satisfy across the organization." ;
    p1z:parentProcess apqc:PCF21656 .

apqc:PCF21658 a p1z:Process ;
    skos:prefLabel "Define content taxonomies" ;
    p1z:apqcId "21658" ;
    p1z:apqcHierarchyId "13.6.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing content metadata structures that function as a common classification language by defining hierarchical categories and attributes used to organize and relate content, ensuring consistency across formats, business areas, and locations and supporting discoverability and semantic enrichment." ;
    p1z:parentProcess apqc:PCF21656 .

apqc:PCF21659 a p1z:Process ;
    skos:prefLabel "Define file naming standards and tagging requirements" ;
    p1z:apqcId "21659" ;
    p1z:apqcHierarchyId "13.6.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining standardized conventions for naming, versioning, and tagging digital files and content assets to support consistency, findability, and compliance across the organization. Establish required metadata elements and tagging structures aligned with enterprise taxonomies, information architecture, and regulatory or operational needs." ;
    p1z:parentProcess apqc:PCF21656 .

apqc:PCF21660 a p1z:Process ;
    skos:prefLabel "Define content systems of record and storage requirements" ;
    p1z:apqcId "21660" ;
    p1z:apqcHierarchyId "13.6.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining requirements for systems of record and storage locations to ensure content is securely stored, retrievable, retained appropriately, and aligned with governance and compliance needs." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21661 a p1z:Process ;
    skos:prefLabel "Define content access controls" ;
    p1z:apqcId "21661" ;
    p1z:apqcHierarchyId "13.6.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining rules and permissions that govern who can create, view, modify, and distribute content to protect sensitive information and support appropriate access." ;
    p1z:parentProcess apqc:PCF21660 .

apqc:PCF21662 a p1z:Process ;
    skos:prefLabel "Develop content audit and retention requirements" ;
    p1z:apqcId "21662" ;
    p1z:apqcHierarchyId "13.6.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing audit and retention requirements to ensure content is reviewed, retained, archived, or disposed of in accordance with governance, legal, and operational obligations." ;
    p1z:parentProcess apqc:PCF21660 .

apqc:PCF21663 a p1z:Process ;
    skos:prefLabel "Manage content infrastructure" ;
    p1z:apqcId "21663" ;
    p1z:apqcHierarchyId "13.6.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the systems, tools, and repositories that support content storage, access, administration, and control across the content lifecycle. Consider AI supported content services (e.g., auto classification, semantic enrichment, embeddings stores, and knowledge graph infrastructure)." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21664 a p1z:Process ;
    skos:prefLabel "Set up and maintain systems of record and storage locations" ;
    p1z:apqcId "21664" ;
    p1z:apqcHierarchyId "13.6.4.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining content repositories and systems of record to support secure storage, organization, access, and lifecycle management." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21665 a p1z:Process ;
    skos:prefLabel "Implement and execute content administration responsibilities" ;
    p1z:apqcId "21665" ;
    p1z:apqcHierarchyId "13.6.4.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing administrative activities required to manage content systems, permissions, structures, and configurations in accordance with defined standards and governance." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21666 a p1z:Process ;
    skos:prefLabel "Audit content compliance" ;
    p1z:apqcId "21666" ;
    p1z:apqcHierarchyId "13.6.4.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing activities to verify that content complies with established standards, policies, and requirements across its lifecycle." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21667 a p1z:Process ;
    skos:prefLabel "Plan content audits" ;
    p1z:apqcId "21667" ;
    p1z:apqcHierarchyId "13.6.4.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning content audits by defining scope, criteria, timing, and responsibilities to assess compliance and effectiveness of content management practices." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21668 a p1z:Process ;
    skos:prefLabel "Perform content audits" ;
    p1z:apqcId "21668" ;
    p1z:apqcHierarchyId "13.6.4.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting reviews of content to evaluate compliance with defined standards, controls, and retention requirements. Includes auditing for semantic accuracy, metadata completeness, and AI-readiness. Consider leveraging all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21669 a p1z:Process ;
    skos:prefLabel "Track content non-compliance resolution" ;
    p1z:apqcId "21669" ;
    p1z:apqcHierarchyId "13.6.4.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking identified content non-compliance issues and monitoring corrective actions to ensure timely resolution and adherence to content standards." ;
    p1z:parentProcess apqc:PCF21663 .

apqc:PCF21670 a p1z:Process ;
    skos:prefLabel "Develop and manage content" ;
    p1z:apqcId "21670" ;
    p1z:apqcHierarchyId "13.6.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating, acquiring, refining, and maintaining content to ensure it is accurate, relevant, consistent, and aligned with organizational standards and intended use. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI). Apply metadata, tags, and semantic relationships to improve findability, compliance, and reuse." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21671 a p1z:Process ;
    skos:prefLabel "Identify new and existing content" ;
    p1z:apqcId "21671" ;
    p1z:apqcHierarchyId "13.6.5.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying content needs and existing content assets to support reuse, updates, and alignment with organizational requirements." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21672 a p1z:Process ;
    skos:prefLabel "Identify content control requirements" ;
    p1z:apqcId "21672" ;
    p1z:apqcHierarchyId "13.6.5.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying control requirements for content, including review, approval, access, and compliance needs across the content lifecycle." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21673 a p1z:Process ;
    skos:prefLabel "Prepare created content" ;
    p1z:apqcId "21673" ;
    p1z:apqcHierarchyId "13.6.5.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing newly created content for use by applying required standards, structure, and controls prior to review and approval." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21674 a p1z:Process ;
    skos:prefLabel "Prepare acquired content" ;
    p1z:apqcId "21674" ;
    p1z:apqcHierarchyId "13.6.5.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing externally sourced or acquired content for organizational use by validating quality, applying standards, and aligning it with governance requirements." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21675 a p1z:Process ;
    skos:prefLabel "Refine content" ;
    p1z:apqcId "21675" ;
    p1z:apqcHierarchyId "13.6.5.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Refining content to improve clarity, accuracy, consistency, and quality for its existing intended purpose and audience. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21676 a p1z:Process ;
    skos:prefLabel "Enhance and adapt content" ;
    p1z:apqcId "21676" ;
    p1z:apqcHierarchyId "13.6.5.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Enhancing and adapting content to support new or different audiences, formats, channels, or contexts while preserving core meaning and intent of the original content. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21677 a p1z:Process ;
    skos:prefLabel "Perform content branding" ;
    p1z:apqcId "21677" ;
    p1z:apqcHierarchyId "13.6.5.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Applying branding elements and standards to content to ensure consistent identity, presentation, and alignment with organizational guidelines." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21678 a p1z:Process ;
    skos:prefLabel "Execute technical edits on content" ;
    p1z:apqcId "21678" ;
    p1z:apqcHierarchyId "13.6.5.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing technical edits to ensure content meets formatting, accessibility, usability, and technical quality requirements. This includes leveraging all forms of new and evolving technology such as artificial intelligence (AI)." ;
    p1z:parentProcess apqc:PCF21670 .

apqc:PCF21679 a p1z:Process ;
    skos:prefLabel "Deliver approved content" ;
    p1z:apqcId "21679" ;
    p1z:apqcHierarchyId "13.6.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Delivering approved content to intended audiences through appropriate channels, repositories, or platforms in accordance with defined standards and controls." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21680 a p1z:Process ;
    skos:prefLabel "Assess and approve content" ;
    p1z:apqcId "21680" ;
    p1z:apqcHierarchyId "13.6.6.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing content to confirm accuracy, quality, compliance, and readiness prior to approval for distribution or use." ;
    p1z:parentProcess apqc:PCF21679 .

apqc:PCF21681 a p1z:Process ;
    skos:prefLabel "Publish approved content" ;
    p1z:apqcId "21681" ;
    p1z:apqcHierarchyId "13.6.6.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Publishing approved content to designated locations or channels to make it available to intended users." ;
    p1z:parentProcess apqc:PCF21679 .

apqc:PCF21682 a p1z:Process ;
    skos:prefLabel "Store approved content" ;
    p1z:apqcId "21682" ;
    p1z:apqcHierarchyId "13.6.6.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Storing approved content in designated repositories to support controlled access, retrieval, and lifecycle management." ;
    p1z:parentProcess apqc:PCF21679 .

apqc:PCF21683 a p1z:Process ;
    skos:prefLabel "Control delivered content" ;
    p1z:apqcId "21683" ;
    p1z:apqcHierarchyId "13.6.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Controlling the use, evaluation, retention, and disposition of delivered content to ensure continued relevance, compliance, and value over time. Includes monitoring content quality and semantic coherence." ;
    p1z:parentProcess apqc:PCF21646 .

apqc:PCF21686 a p1z:Process ;
    skos:prefLabel "Evaluate content" ;
    p1z:apqcId "21686" ;
    p1z:apqcHierarchyId "13.6.7.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating content usage, effectiveness, and relevance to inform updates, improvements, or retirement decisions." ;
    p1z:parentProcess apqc:PCF21683 .

apqc:PCF21687 a p1z:Process ;
    skos:prefLabel "Archive content" ;
    p1z:apqcId "21687" ;
    p1z:apqcHierarchyId "13.6.7.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Archiving content that is no longer actively used but must be retained to meet governance, legal, or historical requirements." ;
    p1z:parentProcess apqc:PCF21683 .

apqc:PCF21688 a p1z:Process ;
    skos:prefLabel "Delete content" ;
    p1z:apqcId "21688" ;
    p1z:apqcHierarchyId "13.6.7.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deleting content that has reached the end of its retention period and is no longer required, in accordance with defined policies and controls." ;
    p1z:parentProcess apqc:PCF21683 .

apqc:PCF21584 a p1z:FunctionalDomain ;
    skos:prefLabel "Measure and benchmark" ;
    p1z:apqcId "21584" ;
    p1z:apqcHierarchyId "13.7" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and managing measurement and benchmarking. Measure and benchmark the performance of internal processes, as well as the organization as a whole." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF21585 a p1z:Process ;
    skos:prefLabel "Define and manage organizational performance strategy" ;
    p1z:apqcId "21585" ;
    p1z:apqcHierarchyId "13.7.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing a strategy for managing organizational performance. The strategy should include approaches for measuring, tracking, streamlining, and improving internal performance. It encompasses a blueprint for the tactical measurement of internal processes and work force improvement, in alignment with Employee Metrics Developed and Managed [10526]." ;
    p1z:parentProcess apqc:PCF21584 .

apqc:PCF11075 a p1z:Process ;
    skos:prefLabel "Define enterprise measurement models" ;
    p1z:apqcId "11075" ;
    p1z:apqcHierarchyId "13.7.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a model for organization's management systems. Develop a high-level measurement system to track performance across the enterprise or in specific functions or business units. Determine which processes to measure, which measures to use, how often to measure, and measurement targets. Review strategic decisions about how to best measure an organization." ;
    p1z:parentProcess apqc:PCF21585 .

apqc:PCF21586 a p1z:Process ;
    skos:prefLabel "Maintain enterprise measurement models" ;
    p1z:apqcId "21586" ;
    p1z:apqcHierarchyId "13.7.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing, evaluating, and updating enterprise measurement models. Align measurement models to current and future goals and performance targets, and make adjustments to support visibility and reporting needs across the organization." ;
    p1z:parentProcess apqc:PCF21585 .

apqc:PCF11072 a p1z:Process ;
    skos:prefLabel "Benchmark performance" ;
    p1z:apqcId "11072" ;
    p1z:apqcHierarchyId "13.7.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Comparing organizational performance internally or externally with other organizations." ;
    p1z:parentProcess apqc:PCF21584 .

apqc:PCF11083 a p1z:Process ;
    skos:prefLabel "Conduct performance assessments" ;
    p1z:apqcId "11083" ;
    p1z:apqcHierarchyId "13.7.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring, researching, and recording the performance of people, processes, mechanisms, or other areas of the business that the organization wants to benchmark or track." ;
    p1z:parentProcess apqc:PCF11072 .

apqc:PCF11084 a p1z:Process ;
    skos:prefLabel "Develop benchmarking capabilities" ;
    p1z:apqcId "11084" ;
    p1z:apqcHierarchyId "13.7.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Improving an organization's ability to compare its performance internally or externally, and maintaining benchmarking relationships with other organizations. Train staff in benchmarking. Develop technological solutions or other materials to aid benchmarking efforts. Consult with external entities to gain knowledge or tools to help benchmark." ;
    p1z:parentProcess apqc:PCF11072 .

apqc:PCF11085 a p1z:Process ;
    skos:prefLabel "Conduct internal and external benchmarking" ;
    p1z:apqcId "11085" ;
    p1z:apqcHierarchyId "13.7.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Benchmarking internal processes and against external competitors." ;
    p1z:parentProcess apqc:PCF11072 .

apqc:PCF11087 a p1z:Process ;
    skos:prefLabel "Conduct gap analysis" ;
    p1z:apqcId "11087" ;
    p1z:apqcHierarchyId "13.7.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining performance against benchmarked organizations or entities. Determine how much performance needs to change to meet expectations. Reach strategic goals." ;
    p1z:parentProcess apqc:PCF11072 .

apqc:PCF11088 a p1z:Process ;
    skos:prefLabel "Establish need for change" ;
    p1z:apqcId "11088" ;
    p1z:apqcHierarchyId "13.7.2.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a need for changing the performance of the organization. Make use of the gap analysis results in order to define the need for change." ;
    p1z:parentProcess apqc:PCF11072 .

apqc:PCF20147 a p1z:Process ;
    skos:prefLabel "Evaluate performance" ;
    p1z:apqcId "20147" ;
    p1z:apqcHierarchyId "13.7.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing process data, measures, and trends in an effort to evaluate process performance and identify possible improvements." ;
    p1z:parentProcess apqc:PCF21584 .

apqc:PCF10270 a p1z:Process ;
    skos:prefLabel "Establish performance indicators (measures)" ;
    p1z:apqcId "10270" ;
    p1z:apqcHierarchyId "13.7.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing key measures that analyze and interpret how effectively the business is achieving its objectives." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10271 a p1z:Process ;
    skos:prefLabel "Establish monitoring frequency" ;
    p1z:apqcId "10271" ;
    p1z:apqcHierarchyId "13.7.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding on the appropriate amount of supervisions that are needed to effectively assess the performance of business plans." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF20148 a p1z:Process ;
    skos:prefLabel "Collect performance data" ;
    p1z:apqcId "20148" ;
    p1z:apqcHierarchyId "13.7.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Consolidating acquired metrics and trends. Provide data that can be benchmarked against historical data." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10272 a p1z:Process ;
    skos:prefLabel "Calculate performance measures" ;
    p1z:apqcId "10272" ;
    p1z:apqcHierarchyId "13.7.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring the performance of process planning. Quantify the performance, record results of the performance tests, and report them to the appropriate authority." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10273 a p1z:Process ;
    skos:prefLabel "Identify performance trends" ;
    p1z:apqcId "10273" ;
    p1z:apqcHierarchyId "13.7.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing the trends in performance. Carefully and strategically assess the results in order to effectively spot the trends." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10274 a p1z:Process ;
    skos:prefLabel "Analyze performance" ;
    p1z:apqcId "10274" ;
    p1z:apqcHierarchyId "13.7.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the gaps between achieved and benchmarked performance. Analyze how performance differs from the optimal or expected performance." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10275 a p1z:Process ;
    skos:prefLabel "Prepare performance reports" ;
    p1z:apqcId "10275" ;
    p1z:apqcHierarchyId "13.7.3.7" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating reports that systematically record and represent the performance planning. Construct a detailed report specifying the performance, and include indicators such as the performance gaps, performance trends, and analysis." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF10276 a p1z:Process ;
    skos:prefLabel "Develop performance improvement plan" ;
    p1z:apqcId "10276" ;
    p1z:apqcHierarchyId "13.7.3.8" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Using performance indicators to report, analyze, and create a detailed performance improvement plan to bridge the performance gaps." ;
    p1z:parentProcess apqc:PCF20147 .

apqc:PCF20959 a p1z:FunctionalDomain ;
    skos:prefLabel "Develop, Manage, and Deliver Analytics" ;
    p1z:apqcId "20959" ;
    p1z:apqcHierarchyId "13.8" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating new and improving existing analytical capabilities to enhance data management pipeline." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF21459 a p1z:Process ;
    skos:prefLabel "Identify needs from stakeholders" ;
    p1z:apqcId "21459" ;
    p1z:apqcHierarchyId "13.8.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering information from stakeholders prior to conducting analytics." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF21460 a p1z:Process ;
    skos:prefLabel "Scope analytics project" ;
    p1z:apqcId "21460" ;
    p1z:apqcHierarchyId "13.8.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the size and scale of the project based upon the collected information and analytics." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF20960 a p1z:Process ;
    skos:prefLabel "Develop and manage hypotheses" ;
    p1z:apqcId "20960" ;
    p1z:apqcHierarchyId "13.8.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating theories that explain empirical data. Use the hypotheses to guide feature selection in the process of data collection." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF20961 a p1z:Process ;
    skos:prefLabel "Collect data" ;
    p1z:apqcId "20961" ;
    p1z:apqcHierarchyId "13.8.4" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering and harvesting structured and unstructured data from disparate sources. Clean and pre-process data. Remove duplicates. Convert to a uniform format to make records comparable." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF21461 a p1z:Process ;
    skos:prefLabel "Prepare data" ;
    p1z:apqcId "21461" ;
    p1z:apqcHierarchyId "13.8.5" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creation and validation of data in order to initiate the process of analysis." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF20962 a p1z:Process ;
    skos:prefLabel "Analyze data" ;
    p1z:apqcId "20962" ;
    p1z:apqcHierarchyId "13.8.6" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting data analysis. Choose statistical algorithms that best reveal patterns and trends in the data. Compare with hypotheses and time series forecasts. Determine error rates and significant outliers." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF21462 a p1z:Process ;
    skos:prefLabel "Create data models" ;
    p1z:apqcId "21462" ;
    p1z:apqcHierarchyId "13.8.7" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Creation of conceptual and physical data models as an outline for data structure and storage." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF21463 a p1z:Process ;
    skos:prefLabel "Review data models with stakeholders" ;
    p1z:apqcId "21463" ;
    p1z:apqcHierarchyId "13.8.8" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Confirm data models represent the hypothesis supporting the original research question" ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF21464 a p1z:Process ;
    skos:prefLabel "Refine data models" ;
    p1z:apqcId "21464" ;
    p1z:apqcHierarchyId "13.8.9" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Make required changes to data model based upon review with stakeholders." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF20963 a p1z:Process ;
    skos:prefLabel "Report on analysis" ;
    p1z:apqcId "20963" ;
    p1z:apqcHierarchyId "13.8.10" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Summarizing and documenting the results of data analysis. Create graphs and visualizations to illustrate numerical findings to make them more accessible to readers." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF20964 a p1z:Process ;
    skos:prefLabel "Identify remedial actions" ;
    p1z:apqcId "20964" ;
    p1z:apqcHierarchyId "13.8.11" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the steps that need to be taken to correct the shortcomings." ;
    p1z:parentProcess apqc:PCF20959 .

apqc:PCF11179 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage Environmental Health and Safety (EHS)" ;
    p1z:apqcId "11179" ;
    p1z:apqcHierarchyId "13.9" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the impacts of environmental health and safety. Create and implement the EHS program. Train and educate employees of the EHS function. Oversee and manage the EHS program." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF11180 a p1z:Process ;
    skos:prefLabel "Determine environmental health and safety impacts" ;
    p1z:apqcId "11180" ;
    p1z:apqcHierarchyId "13.9.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining the impact of EHS offering--and the procedures it employs to process them--on the environment at large, as well as the health and safety of employees. Evaluate the environmental impact of the organization's products, services, and operations. Conduct health, safety, and environmental audits." ;
    p1z:parentProcess apqc:PCF11179 .

apqc:PCF11186 a p1z:Process ;
    skos:prefLabel "Evaluate environmental impact of products, services, and operations" ;
    p1z:apqcId "11186" ;
    p1z:apqcHierarchyId "13.9.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the impact of offerings and the auxiliary operations required to process them on the immediate ecosystem and the environment at large. Study the lifecycle of the products/services offered by the organization. Estimate any affect on the environment through metrics such as a calculation of carbon footprint." ;
    p1z:parentProcess apqc:PCF11180 .

apqc:PCF11187 a p1z:Process ;
    skos:prefLabel "Conduct health and safety and environmental audits" ;
    p1z:apqcId "11187" ;
    p1z:apqcHierarchyId "13.9.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting an inspection to verify that the organization adequately complies with the environmental, health, and safety standards. Audit procedures and records regarding responsibility for the environment, health, and safety." ;
    p1z:parentProcess apqc:PCF11180 .

apqc:PCF11181 a p1z:Process ;
    skos:prefLabel "Develop EHS program" ;
    p1z:apqcId "11181" ;
    p1z:apqcHierarchyId "13.9.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Identify the requirements for regulation and shareholders. Assess future risks and opportunities. Develop a policy for the EHS program. Record and manage EHS program events." ;
    p1z:parentProcess apqc:PCF11179 .

apqc:PCF11188 a p1z:Process ;
    skos:prefLabel "Identify regulatory and stakeholder requirements" ;
    p1z:apqcId "11188" ;
    p1z:apqcHierarchyId "13.9.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining any protocols or standards to comply with, set by regulatory agencies or the organization's stakeholders. Closely examine all standards and matters of compliance relating to the environment, health, and safety." ;
    p1z:parentProcess apqc:PCF11181 .

apqc:PCF11189 a p1z:Process ;
    skos:prefLabel "Assess future risks and opportunities" ;
    p1z:apqcId "11189" ;
    p1z:apqcHierarchyId "13.9.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating any risks and opportunities that might affect the environmental, health, and safety of products/services. Leverage techniques such as cost-benefit analysis, trend extrapolation, systems analysis, social surveys, historical surveys, historical analogy, Delphi, conferences, workshops, briefings, hearings, advisory committees, moot courts, artistic judgment, on-site field investigation, scaling techniques, and scenario creation." ;
    p1z:parentProcess apqc:PCF11181 .

apqc:PCF11190 a p1z:Process ;
    skos:prefLabel "Create EHS policy" ;
    p1z:apqcId "11190" ;
    p1z:apqcHierarchyId "13.9.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan for managing the environmental, health, and safety impact of products/services. Establish minimum requirements for the organization regarding the environment at large and the health and safety of employees. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    p1z:parentProcess apqc:PCF11181 .

apqc:PCF11191 a p1z:Process ;
    skos:prefLabel "Record and manage EHS events" ;
    p1z:apqcId "11191" ;
    p1z:apqcHierarchyId "13.9.2.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Recording and managing all events and activities associated with complying with environmental, health and safety standards. Create event calendars. Assign funds. Educate employees. Conduct events." ;
    p1z:parentProcess apqc:PCF11181 .

apqc:PCF21587 a p1z:Process ;
    skos:prefLabel "Monitor and manage EHS program" ;
    p1z:apqcId "21587" ;
    p1z:apqcHierarchyId "13.9.3" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing the performance, costs and benefits of EHS. Measure and report the performance of EHS. Implement plans for emergency response and pollution prevention. Train and educate employees. Provide EHS support." ;
    p1z:parentProcess apqc:PCF11179 .

apqc:PCF11193 a p1z:Process ;
    skos:prefLabel "Manage EHS costs and benefits" ;
    p1z:apqcId "11193" ;
    p1z:apqcHierarchyId "13.9.3.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the costs and benefits of EHS management program. Evaluate program costs to ensure that the benefits of the program always outweigh its costs." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF11194 a p1z:Process ;
    skos:prefLabel "Measure and report EHS performance" ;
    p1z:apqcId "11194" ;
    p1z:apqcHierarchyId "13.9.3.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Using performance techniques and indicators. Utilize number of audits or inspections performed, safety committee meetings, the number and types of findings and observations, timely preventive maintenance tasks performed, etc." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF11196 a p1z:Process ;
    skos:prefLabel "Implement emergency response program" ;
    p1z:apqcId "11196" ;
    p1z:apqcHierarchyId "13.9.3.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing a program for organizing, coordinating, and directing available resources to respond to the event. Conduct a risk assessment to identify potential emergency scenarios in order to create a program that ensures that resources are on hand--or quickly available--in case of emergencies." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF11197 a p1z:Process ;
    skos:prefLabel "Implement pollution prevention program" ;
    p1z:apqcId "11197" ;
    p1z:apqcHierarchyId "13.9.3.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing a program that reduces or eliminates the creation of pollutants through increased efficiency in the use of raw materials, energy, water, or other resources. Implement a program to inspect facilities that store, manufacture, or use hazardous, toxic, or polluting materials." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF11182 a p1z:Process ;
    skos:prefLabel "Train and educate functional employees" ;
    p1z:apqcId "11182" ;
    p1z:apqcHierarchyId "13.9.3.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting programs such as on-the-job training sessions, group training workshops, and online training." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF11195 a p1z:Process ;
    skos:prefLabel "Provide EHS support" ;
    p1z:apqcId "11195" ;
    p1z:apqcHierarchyId "13.9.3.6" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting employees in light of the organization's environmental, health, and safety policies and standards. Provide medical insurance, maternity leave, environmental education, training over safety, etc." ;
    p1z:parentProcess apqc:PCF21587 .

apqc:PCF21588 a p1z:FunctionalDomain ;
    skos:prefLabel "Manage sustainability" ;
    p1z:apqcId "21588" ;
    p1z:apqcHierarchyId "13.10" ;
    p1z:apqcLevel 2 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing and managing sustainability practices for the organization. Ensure proper understanding and communication of ESG standards, requirements, capabilities, and future trends. Promote awareness, alignment, and continuity." ;
    p1z:parentProcess apqc:PCF10013 .

apqc:PCF21589 a p1z:Process ;
    skos:prefLabel "Develop sustainability capability" ;
    p1z:apqcId "21589" ;
    p1z:apqcHierarchyId "13.10.1" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Developing sustainability (ESG) capabilities for the organization. Understand and communicate legal, regulatory, and social/environmental requirements. Establish policies, objectives, guidelines and approaches for ESG efforts and reporting." ;
    p1z:parentProcess apqc:PCF21588 .

apqc:PCF21590 a p1z:Process ;
    skos:prefLabel "Identify sustainability requirements" ;
    p1z:apqcId "21590" ;
    p1z:apqcHierarchyId "13.10.1.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying, documenting, and communicating sustainability requirements. Closely examine all standards and matters of compliance relating to ESG. Determine protocols or standards to comply with, set by regulatory agencies or the organizations stakeholders." ;
    p1z:parentProcess apqc:PCF21589 .

apqc:PCF21594 a p1z:Process ;
    skos:prefLabel "Establish sustainability goals/objectives" ;
    p1z:apqcId "21594" ;
    p1z:apqcHierarchyId "13.10.1.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing organizational sustainability goals/objectives. Gather, align, and promote organization-wide sustainability goals that collectively address the overall sustainability requirements. Ensure the goals are measurable and have qualitative and quantitative targets." ;
    p1z:parentProcess apqc:PCF21589 .

apqc:PCF21595 a p1z:Process ;
    skos:prefLabel "Create sustainability policies" ;
    p1z:apqcId "21595" ;
    p1z:apqcHierarchyId "13.10.1.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing, documenting, and communicating sustainability policies. Develop policies, written procedures, and supporting tools to dictate how the organization will meet policy requirements." ;
    p1z:parentProcess apqc:PCF21589 .

apqc:PCF21596 a p1z:Process ;
    skos:prefLabel "Define sustainability measures" ;
    p1z:apqcId "21596" ;
    p1z:apqcHierarchyId "13.10.1.4" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining sustainability measures. Provide organization-wide measures, to include data collection strategies, calculations, analytics, and reporting formats." ;
    p1z:parentProcess apqc:PCF21589 .

apqc:PCF21597 a p1z:Process ;
    skos:prefLabel "Create sustainability plan(s)" ;
    p1z:apqcId "21597" ;
    p1z:apqcHierarchyId "13.10.1.5" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating sustainability plans. Develop and socialize sustainability plans for the organization, functional units, and support services. Ensure alignment to sustainability requirements, goals, and governance." ;
    p1z:parentProcess apqc:PCF21589 .

apqc:PCF21598 a p1z:Process ;
    skos:prefLabel "Manage sustainability capability" ;
    p1z:apqcId "21598" ;
    p1z:apqcHierarchyId "13.10.2" ;
    p1z:apqcLevel 3 ;
    p1z:metricsAvailable true ;
    skos:definition "Managing sustainability across the organization. Provide training, support, reporting, and oversight to the distributed sustainability efforts across functional units and support services." ;
    p1z:parentProcess apqc:PCF21588 .

apqc:PCF21599 a p1z:Process ;
    skos:prefLabel "Provide sustainability training" ;
    p1z:apqcId "21599" ;
    p1z:apqcHierarchyId "13.10.2.1" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing sustainability training and awareness. Plan, prepare, and oversee delivery of sustainability education and enablement activities." ;
    p1z:parentProcess apqc:PCF21598 .

apqc:PCF21600 a p1z:Process ;
    skos:prefLabel "Provide sustainability support" ;
    p1z:apqcId "21600" ;
    p1z:apqcHierarchyId "13.10.2.2" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing support for sustainability activities. Augment functional units and support teams with coaching, mentoring, and SME capacity to perform sustainability projects and activities." ;
    p1z:parentProcess apqc:PCF21598 .

apqc:PCF21601 a p1z:Process ;
    skos:prefLabel "Perform sustainability reporting" ;
    p1z:apqcId "21601" ;
    p1z:apqcHierarchyId "13.10.2.3" ;
    p1z:apqcLevel 4 ;
    p1z:metricsAvailable true ;
    skos:definition "Conducting and supporting sustainability reporting. Collect, analyze, and report sustainability performance to requirements. Align reporting across functional units and support teams." ;
    p1z:parentProcess apqc:PCF21598 .

