    p1z:parentProcess apqc:PCF20760 .

apqc:PCF21692 a p1z:Process ;
    skos:prefLabel "Implement identity federation and single sign-on (SSO)" ;
    p1z:apqcId "21692" ;
    p1z:apqcHierarchyId "8.3.8.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Integrating identity federation and SSO solutions to enhance user experience and security." ;
    p1z:parentProcess apqc:PCF20760 .

apqc:PCF20810 a p1z:Process ;
    skos:prefLabel "Assess and validate IT service/solution requirements" ;
    p1z:apqcId "20810" ;
    p1z:apqcHierarchyId "8.5.4.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating and validating the requirements and needs of IT service/solution." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20811 a p1z:Process ;
    skos:prefLabel "Create service/solution design" ;
    p1z:apqcId "20811" ;
    p1z:apqcHierarchyId "8.5.4.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Formulating a design for service/solution that helps an organization to meet its objectives. Develop a new framework for molding the service/solution processes into a coherent and structured form." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20812 a p1z:Process ;
    skos:prefLabel "Build and test IT service/solution components" ;
    p1z:apqcId "20812" ;
    p1z:apqcHierarchyId "8.5.4.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Building and testing new components required for the development of IT services and solutions." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20813 a p1z:Process ;
    skos:prefLabel "Integrate IT components and services" ;
    p1z:apqcId "20813" ;
    p1z:apqcHierarchyId "8.5.4.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Combining the newly built IT component along with IT services in order to gain optimum output." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20814 a p1z:Process ;
    skos:prefLabel "Execute IT service/solution validation" ;
    p1z:apqcId "20814" ;
    p1z:apqcHierarchyId "8.5.4.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating that the proposed IT service/solution is feasible and provides the needed services for the customer." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20815 a p1z:Process ;
    skos:prefLabel "Bundle service/solution deployment packaging" ;
    p1z:apqcId "20815" ;
    p1z:apqcHierarchyId "8.5.4.1.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and implementing a strategy for the deployment of IT service/solution by defining all of the activities that make the IT function available for use. Define the deployment process, procedures, and tools. Select the most feasible and practical methodologies for the deployment process." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20816 a p1z:Process ;
    skos:prefLabel "Manage service/solution process exceptions" ;
    p1z:apqcId "20816" ;
    p1z:apqcHierarchyId "8.5.4.1.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and resolving internal needs/inquiries for service/solution that cannot be resolved immediately. Research inquiries that require the need of exceptional solutions." ;
    p1z:parentProcess apqc:PCF20809 .

apqc:PCF20819 a p1z:Process ;
    skos:prefLabel "Assess IT remediation" ;
    p1z:apqcId "20819" ;
    p1z:apqcHierarchyId "8.5.5.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluate plans to address information technology environmental adulteration for rectification efforts." ;
    p1z:parentProcess apqc:PCF20818 .

apqc:PCF20820 a p1z:Process ;
    skos:prefLabel "Modify service/solution design" ;
    p1z:apqcId "20820" ;
    p1z:apqcHierarchyId "8.5.5.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Redesign the roadmap to seek solution or service with an overall process flow and impact timeframe." ;
    p1z:parentProcess apqc:PCF20818 .

apqc:PCF20821 a p1z:Process ;
    skos:prefLabel "Perform IT service/solution remediation" ;
    p1z:apqcId "20821" ;
    p1z:apqcHierarchyId "8.5.5.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the efforts and activities for IT service/solution remediation. This process element requires the organization to create plans for corrective action in collaboration with government agencies and pertinent professional services agencies which specialize in remediation efforts relevant to the organization's service/solution. Additionally, the organization needs to consult experts to validate the plan, determine resources allocation, resolve any legal concerns, and formulate a company-wide policy for IT service/solution remediation." ;
    p1z:parentProcess apqc:PCF20818 .

apqc:PCF20822 a p1z:Process ;
    skos:prefLabel "Manage service/solution operations" ;
    p1z:apqcId "20822" ;
    p1z:apqcHierarchyId "8.5.5.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Understanding customer requirements. Managing services/solutions based on the requirements. Develop components for providing the requirements. Train resources to provide support. Confirm the customer experience post-sale. Evaluate the performance of service/solution. Communicate the results to the management." ;
    p1z:parentProcess apqc:PCF20818 .

apqc:PCF20823 a p1z:Process ;
    skos:prefLabel "Prepare fixed/enhanced service/solution packaging" ;
    p1z:apqcId "20823" ;
    p1z:apqcHierarchyId "8.5.5.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing packaging for fixed/enhanced service/solution based on the standalone or bundled offerings to be used by the organization." ;
    p1z:parentProcess apqc:PCF20818 .

apqc:PCF20882 a p1z:Process ;
    skos:prefLabel "Schedule service delivery resources" ;
    p1z:apqcId "20882" ;
    p1z:apqcHierarchyId "8.7.3.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Scheduling resources to provide service delivery to IT users. Ensure design, development, deployment, and operations are aligned with the business objectives." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF20883 a p1z:Process ;
    skos:prefLabel "Maintain/optimize batch job schedule" ;
    p1z:apqcId "20883" ;
    p1z:apqcHierarchyId "8.7.3.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining and scheduling batch jobs to run in the background at a certain date and time." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF20884 a p1z:Process ;
    skos:prefLabel "Schedule change/release windows" ;
    p1z:apqcId "20884" ;
    p1z:apqcHierarchyId "8.7.3.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine the timely change or release of IT services or support. Assign periodic release/change to IT systems or services." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF20885 a p1z:Process ;
    skos:prefLabel "Schedule/optimize backup and archive activities" ;
    p1z:apqcId "20885" ;
    p1z:apqcHierarchyId "8.7.3.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Schedule or optimize backup and archive activities for IT services and solutions. Use a backup system or application and archive operations data for future retrieval." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF20886 a p1z:Process ;
    skos:prefLabel "Balance operational workloads across available infrastructure components" ;
    p1z:apqcId "20886" ;
    p1z:apqcHierarchyId "8.7.3.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Balancing workloads of all the processes and services that are provisioned to their internal or external clients, across available components of IT infrastructure. No component should be over or under utilized with the workflow of the IT operations." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF20887 a p1z:Process ;
    skos:prefLabel "Determine specific problem support procedures" ;
    p1z:apqcId "20887" ;
    p1z:apqcHierarchyId "8.7.3.1.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining process and procedure to provide support for specific IT service problems." ;
    p1z:parentProcess apqc:PCF20881 .

apqc:PCF19575 a p1z:Process ;
    skos:prefLabel "Manage interest rate market data" ;
    p1z:apqcId "19575" ;
    p1z:apqcHierarchyId "9.7.5.2.1" ;
