@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix p1z:  <https://ontology.pointonezero.com/strategy/core#> .
@prefix apqc: <https://ontology.pointonezero.com/strategy/apqc#> .

<https://ontology.pointonezero.com/strategy/apqc/tasks> a owl:Ontology ;
    dct:title "P1Z Scope Instances: APQC PCF Cross-Industry Tasks (Level 5, dormant extension)" ;
    owl:versionInfo "0.3.0" ;
    dct:source "APQC Process Classification Framework (PCF), Cross-Industry, Excel Version 8.0, February 2026" ;
    dct:description "APQC PCF level-5 tasks (215 elements), a dormant depth extension. Not loaded by default consumers; an engagement loads this file alongside the spine when work reaches requirements or build stage and needs task-level scope precision. APQC notes tasks vary widely across industries. Joins the spine seamlessly through shared PCF IDs and parentProcess links." ;
    dct:rights "APQC Process Classification Framework (PCF) is an open standard developed by APQC, a nonprofit that promotes benchmarking and best practices worldwide. The PCF is intended to facilitate organizational improvement through process management and benchmarking, regardless of industry, size, or geography. To download the full PCF or industry-specific versions of the PCF, as well as associated measures and benchmarking, please visit www.apqc.org/pcf." .

apqc:PCF16796 a p1z:Process ;
    skos:prefLabel "Evaluate acquisition options" ;
    p1z:apqcId "16796" ;
    p1z:apqcHierarchyId "1.1.5.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Appraising entities identified as being suitable for acquisition, taking into account the restructuring opportunities in the internal and external context. Verify the appropriateness and viability of the short-listed options. Ensure these entities pertain to the state-of-affairs in the market, as well as fit with the resources and capabilities of the organization." ;
    p1z:parentProcess apqc:PCF16795 .

apqc:PCF16797 a p1z:Process ;
    skos:prefLabel "Evaluate merger options" ;
    p1z:apqcId "16797" ;
    p1z:apqcHierarchyId "1.1.5.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Appraising entities identified as being suitable for a merger, taking stock of the restructuring opportunities within the firm and the market. Verify the appropriateness and viability of such options. Assess these entities to ensure their pertinence to the contextual state-of-affairs in the market, as well as a fit with the resources and capabilities of the organization itself. (This process can be carried out, in its entirety, by qualified in-house personnel or may be designated to specialist professional services providers.)" ;
    p1z:parentProcess apqc:PCF16795 .

apqc:PCF16798 a p1z:Process ;
    skos:prefLabel "Evaluate de-merger options" ;
    p1z:apqcId "16798" ;
    p1z:apqcHierarchyId "1.1.5.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating departments and subsidiaries within the organization, and/or previously merged entities, to assess the appropriateness of a de-merger, taking account of the fit between these entities as well as any relevant externalities. Examine the pertinence and soundness of a formalized dissociation." ;
    p1z:parentProcess apqc:PCF16795 .

apqc:PCF16799 a p1z:Process ;
    skos:prefLabel "Evaluate divesture options" ;
    p1z:apqcId "16799" ;
    p1z:apqcHierarchyId "1.1.5.3.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating departments and/or subsidiaries within the organization to assess the appropriateness of a divestment, taking account of all market externalities. Examine any internal entities that have been identified to be suitable for dismemberment from the organization. Ensure the pertinence and soundness of such a move." ;
    p1z:parentProcess apqc:PCF16795 .

apqc:PCF18083 a p1z:Process ;
    skos:prefLabel "Select partnerships and relationships to support the extended enterprise" ;
    p1z:apqcId "18083" ;
    p1z:apqcHierarchyId "1.2.2.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Supporting the design, manufacture and distribution of product and services through the extended enterprise model.  This is concerned with the strategic decisions on make vs buy, in house or out sourced.  Senior Executives map out how they want to run their business.  Make strategic choices as to whether to buy in components / sub-assemblies, run their own distribution fleet or contract out, own their dealerships or franchise out, etc.  Strategize with partnerships. Collaborate design consideration at strategy level for automotive and procurement act within the Target Operating Model set at strategy level." ;
    p1z:parentProcess apqc:PCF10047 .

apqc:PCF13289 a p1z:Process ;
    skos:prefLabel "Identify implications for key operating model business elements that require change" ;
    p1z:apqcId "13289" ;
    p1z:apqcHierarchyId "1.2.2.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine impacts of elements such as staffing, skills, training, new markets, technology, or policies within operating model which needs change." ;
    p1z:parentProcess apqc:PCF10048 .

apqc:PCF13290 a p1z:Process ;
    skos:prefLabel "Identify implications for key technology aspects" ;
    p1z:apqcId "13290" ;
    p1z:apqcHierarchyId "1.2.2.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining key factors for technology ROI, benefits, architecture, etc." ;
    p1z:parentProcess apqc:PCF10048 .

apqc:PCF19961 a p1z:Process ;
    skos:prefLabel "Identify and review customer touchpoints" ;
    p1z:apqcId "19961" ;
    p1z:apqcHierarchyId "1.2.8.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating methods to gauge customer experiences, expectations, and suggestions. Review both liked and disliked areas of product/services to be delivered. Evaluate touchpoints based on the nature of product/service in the market e.g., billboards, web sites, direct mail, service calls, etc." ;
    p1z:parentProcess apqc:PCF19960 .

apqc:PCF19962 a p1z:Process ;
    skos:prefLabel "Assess customer experience across touchpoints" ;
    p1z:apqcId "19962" ;
    p1z:apqcHierarchyId "1.2.8.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating customer experiences, expectations, and suggestions in both liked and disliked areas of the product or services. Analyze all modes of communication, human and physical interactions, or customers experience during the relationship lifecycle with your organization. Evaluate the gaps/further development/alterations to the existing product/service to attain better customer response." ;
    p1z:parentProcess apqc:PCF19960 .

apqc:PCF19963 a p1z:Process ;
    skos:prefLabel "Perform root cause analysis of problematic customer experiences" ;
    p1z:apqcId "19963" ;
    p1z:apqcHierarchyId "1.2.8.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the core reason for the customer experience/feedback/response about the product/service to take considerable action for better customer experience." ;
    p1z:parentProcess apqc:PCF19960 .

apqc:PCF16612 a p1z:Process ;
    skos:prefLabel "Define and manage personas" ;
    p1z:apqcId "16612" ;
    p1z:apqcHierarchyId "1.2.8.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying a set of characteristics that define the demographic and behavioral patterns of the customer. Further, use persona scoring to design your marketing strategies around personas, and measure and optimize your interactions with the contacts classified by a certain persona." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19965 a p1z:Process ;
    skos:prefLabel "Create customer journey maps" ;
    p1z:apqcId "19965" ;
    p1z:apqcHierarchyId "1.2.8.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a story of the customer's experience: from initial contact, through the process of engagement and into a long-term relationship. The goal is to teach organization about the customer." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19966 a p1z:Process ;
    skos:prefLabel "Define single view of the customer for the organization" ;
    p1z:apqcId "19966" ;
    p1z:apqcHierarchyId "1.2.8.2.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining parameters to show aggregated, consistent, and holistic representation of known data about customers. Define key parameters which enable the tracking of customers and communications across every channel." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19967 a p1z:Process ;
    skos:prefLabel "Define a vision for the customer experience" ;
    p1z:apqcId "19967" ;
    p1z:apqcHierarchyId "1.2.8.2.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a direction and vision on how the organization behaves towards customers in a consistent, effective way. The key attributes for customer experience vision consists of emotional connection, commitments and expectations, compelling value proposition, and ease of understanding the organization's behavior." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19968 a p1z:Process ;
    skos:prefLabel "Validate with customers" ;
    p1z:apqcId "19968" ;
    p1z:apqcHierarchyId "1.2.8.2.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a process to validate the sales process and the assumptions that underpin the business model. Understand if the products/services have a repeatable, scalable business model around that product." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19969 a p1z:Process ;
    skos:prefLabel "Align experience with brand values and business strategies" ;
    p1z:apqcId "19969" ;
    p1z:apqcHierarchyId "1.2.8.2.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Aligning and defining a relevant, differentiated, and credible value proposition for the brand. Align experience to ensure that the product and service quality is consistent with brand promise and business strategies." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19970 a p1z:Process ;
    skos:prefLabel "Develop content strategy" ;
    p1z:apqcId "19970" ;
    p1z:apqcHierarchyId "1.2.8.2.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Planning, development, and management of content-written or in other media. Getting the right content to the right user at the right time through strategic planning of content creation, delivery, and governance." ;
    p1z:parentProcess apqc:PCF19964 .

apqc:PCF19972 a p1z:Process ;
    skos:prefLabel "Identify required capabilities" ;
    p1z:apqcId "19972" ;
    p1z:apqcHierarchyId "1.2.8.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the necessary skills and competencies required to efficiently collect customer experiences through the support structure." ;
    p1z:parentProcess apqc:PCF19971 .

apqc:PCF19973 a p1z:Process ;
    skos:prefLabel "Identify impact on functional processes" ;
    p1z:apqcId "19973" ;
    p1z:apqcHierarchyId "1.2.8.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the affect of customer experience through customer experience support structure on other functions of customer services related to customer." ;
    p1z:parentProcess apqc:PCF19971 .

apqc:PCF19646 a p1z:Process ;
    skos:prefLabel "Carry out post launch analytics to test the acceptability in the market" ;
    p1z:apqcId "19646" ;
    p1z:apqcHierarchyId "2.1.2.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring the performance of marketing once the product/services are launched. This broadly covers measuring user engagement and product's/service's performance in the market." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF11424 a p1z:Process ;
    skos:prefLabel "Review market performance" ;
    p1z:apqcId "11424" ;
    p1z:apqcHierarchyId "2.1.2.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting customer and market analysis to review progress and identify opportunities for increasing market position. Track and review product/service response through sales reports, website statistics, direct response from customers, and survey reports." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF11425 a p1z:Process ;
    skos:prefLabel "Review effectiveness of supply chain and distribution network" ;
    p1z:apqcId "11425" ;
    p1z:apqcHierarchyId "2.1.2.5.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the performance of supply chain to all departments and logistics from input to shop floor. Seeking performance reviews at each intersection and communication channels. Review effectiveness of supply chain and distribution to check if it is meeting the demands of the various groups and organizations that are concerned with its activities (groups might include customers, partners, suppliers, and vendors)." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF19647 a p1z:Process ;
    skos:prefLabel "Apply data and analytics to review supply chain methodologies" ;
    p1z:apqcId "19647" ;
    p1z:apqcHierarchyId "2.1.2.5.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Collecting and examining raw data with the purpose of drawing conclusions about that information and correlate gaps and efficiencies to the existing supply chain channels. Apply the information to make better business decisions to the related supply chain methodologies to meet efficiency." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF11426 a p1z:Process ;
    skos:prefLabel "Review quality and performance of the product/service" ;
    p1z:apqcId "11426" ;
    p1z:apqcHierarchyId "2.1.2.5.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the quality and performance of the product/service delivered to customers. Analyze data from the customer feedback, audits, measures of customer satisfaction (such as product quality complaints and recalls), and organizational policies on delivery." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF11427 a p1z:Process ;
    skos:prefLabel "Conduct financial review" ;
    p1z:apqcId "11427" ;
    p1z:apqcHierarchyId "2.1.2.5.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating organization's financial reports and financial reporting processes. Review and document the ROI catered by the product/service delivery to the customer in the market." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF11428 a p1z:Process ;
    skos:prefLabel "Conduct new product development process assessment" ;
    p1z:apqcId "11428" ;
    p1z:apqcHierarchyId "2.1.2.5.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Analyzing the steps involved in the development of new product, its effect on existing product, resources, and functions related to the development of the new product until its sale in the competitive market place." ;
    p1z:parentProcess apqc:PCF11423 .

apqc:PCF12772 a p1z:Process ;
    skos:prefLabel "Train employees on appropriate regulatory requirements" ;
    p1z:apqcId "12772" ;
    p1z:apqcHierarchyId "2.1.3.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting training and impart learning to existing and new employees. Training will relate to the most recent/enforced regulations of the business to meet Manage regulatory requirements [12771]." ;
    p1z:parentProcess apqc:PCF12771 .

apqc:PCF12773 a p1z:Process ;
    skos:prefLabel "Maintain records for regulatory agencies" ;
    p1z:apqcId "12773" ;
    p1z:apqcHierarchyId "2.1.3.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying steps and procedures to manage and regularly update the records for regulatory agencies. Updates will be made to safety procedures, identity and access management, software tools and applications, internal accessibility policies, internal quality parameters, etc." ;
    p1z:parentProcess apqc:PCF12771 .

apqc:PCF12776 a p1z:Process ;
    skos:prefLabel "Manage regulatory submission life cycle" ;
    p1z:apqcId "12776" ;
    p1z:apqcHierarchyId "2.1.3.5.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determine and follow the timely input and update of regulatory information by assessing reforms, regulatory policies, and guidelines." ;
    p1z:parentProcess apqc:PCF12771 .

apqc:PCF19991 a p1z:Process ;
    skos:prefLabel "Define basic functional requirements" ;
    p1z:apqcId "19991" ;
    p1z:apqcHierarchyId "2.2.3.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the operations of functions related to the product/service in the marketing environment." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16808 a p1z:Process ;
    skos:prefLabel "Derive interoperability requirements for products and services" ;
    p1z:apqcId "16808" ;
    p1z:apqcHierarchyId "2.2.3.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the ability of products and services to work together, exchange and use information in a multi-vendor, multi-network, and multi-service environment." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16809 a p1z:Process ;
    skos:prefLabel "Derive safety requirements for products and services" ;
    p1z:apqcId "16809" ;
    p1z:apqcHierarchyId "2.2.3.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing safety requirements in line with environmental safety, occupational health and safety, and community health and safety guidelines." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16810 a p1z:Process ;
    skos:prefLabel "Derive security requirements for products and services" ;
    p1z:apqcId "16810" ;
    p1z:apqcHierarchyId "2.2.3.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Implementing security requirements through authentication and encryption of CE device data stream.  Utilize security measures such as cryptographic protocols and hardware security (smart cards)." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16811 a p1z:Process ;
    skos:prefLabel "Derive regulatory compliance requirements" ;
    p1z:apqcId "16811" ;
    p1z:apqcHierarchyId "2.2.3.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Meeting regulatory requirements set forth by such directives as RoHS, WEEE, ELV, and REACH." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16812 a p1z:Process ;
    skos:prefLabel "Derive requirements from industry standards" ;
    p1z:apqcId "16812" ;
    p1z:apqcHierarchyId "2.2.3.1.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Complying with consumer electronic industry standards developed by the Consumer Technology Association (CTA)." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF19992 a p1z:Process ;
    skos:prefLabel "Develop user experience requirements" ;
    p1z:apqcId "19992" ;
    p1z:apqcHierarchyId "2.2.3.1.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and creating steps and tools to develop the user experience." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF16814 a p1z:Process ;
    skos:prefLabel "Derive \u2018services-as-a-product\u2019 offering" ;
    p1z:apqcId "16814" ;
    p1z:apqcHierarchyId "2.2.3.1.8" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Productizing the service by defining the scope of the service/cost.  Target market for the service and make the service more tangible." ;
    p1z:parentProcess apqc:PCF11331 .

apqc:PCF19994 a p1z:Process ;
    skos:prefLabel "Identify requirements for product/service design/development partners" ;
    p1z:apqcId "19994" ;
    p1z:apqcHierarchyId "2.3.1.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining essential elements for collaborators involved in blueprint/development of product/service." ;
    p1z:parentProcess apqc:PCF10083 .

apqc:PCF16819 a p1z:Process ;
    skos:prefLabel "Design for manufacturing" ;
    p1z:apqcId "16819" ;
    p1z:apqcHierarchyId "2.3.1.8.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Carrying out the steps necessary to appropriately manufacture correct parts.  This includes designing application, product hardware, mold, casting, mechanical, and electrical aspects of the product." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF16820 a p1z:Process ;
    skos:prefLabel "Design for product servicing" ;
    p1z:apqcId "16820" ;
    p1z:apqcHierarchyId "2.3.1.8.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating product application service view to allow for product servicing and refurbishing." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF16821 a p1z:Process ;
    skos:prefLabel "Design for re-manufacturing" ;
    p1z:apqcId "16821" ;
    p1z:apqcHierarchyId "2.3.1.8.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Replacing core components and republishing." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF16822 a p1z:Process ;
    skos:prefLabel "Review product troubleshooting methodology" ;
    p1z:apqcId "16822" ;
    p1z:apqcHierarchyId "2.3.1.8.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing the design and approach for troubleshooting the product." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF16818 a p1z:Process ;
    skos:prefLabel "Design and manage product data, design, and bill of materials" ;
    p1z:apqcId "16818" ;
    p1z:apqcHierarchyId "2.3.1.8.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing the BOM-Bill of material, manufacturing BOM and Service BOMA bill of materials list for all the raw materials and components/parts used in the producing end product." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF16823 a p1z:Process ;
    skos:prefLabel "Design for product upgrades" ;
    p1z:apqcId "16823" ;
    p1z:apqcHierarchyId "2.3.1.8.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing hardware and software upgrade techniques." ;
    p1z:parentProcess apqc:PCF19995 .

apqc:PCF11417 a p1z:Process ;
    skos:prefLabel "Monitor initial production runs" ;
    p1z:apqcId "11417" ;
    p1z:apqcHierarchyId "2.3.3.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Regularly monitoring production runs of the production and/or delivery operations." ;
    p1z:parentProcess apqc:PCF10100 .

apqc:PCF10114 a p1z:Process ;
    skos:prefLabel "Understand consumer needs and historical behaviors" ;
    p1z:apqcId "10114" ;
    p1z:apqcHierarchyId "3.1.1.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the factors that drive the targeted market segment. Model customer purchasing patterns, and forecast their future purchasing behavior." ;
    p1z:parentProcess apqc:PCF10108 .

apqc:PCF21424 a p1z:Process ;
    skos:prefLabel "Predict customer purchasing behavior" ;
    p1z:apqcId "21424" ;
    p1z:apqcHierarchyId "3.1.1.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Using customer segmentation tools to examine past customer behavior to predict future purchasing patterns." ;
    p1z:parentProcess apqc:PCF10108 .

apqc:PCF10115 a p1z:Process ;
    skos:prefLabel "Determine market share gain/loss" ;
    p1z:apqcId "10115" ;
    p1z:apqcHierarchyId "3.1.1.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the increase or decrease of the company's sales volume in the targeted markets. Conduct an analysis to determine the factors and underlying causes that affect the changes in the demand for products or services offered. Consider changes in offerings or in the business strategy to regain or increase the market share." ;
    p1z:parentProcess apqc:PCF10109 .

apqc:PCF18941 a p1z:Process ;
    skos:prefLabel "Identify under-served and saturated market segments" ;
    p1z:apqcId "18941" ;
    p1z:apqcHierarchyId "3.1.2.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining which groups of potential customers do not yet, or already do have access to the product or a service that the company produces or markets. Use those findings to create specialized product offerings and differentiated marketing campaigns." ;
    p1z:parentProcess apqc:PCF10117 .

apqc:PCF10120 a p1z:Process ;
    skos:prefLabel "Test with customers/consumers" ;
    p1z:apqcId "10120" ;
    p1z:apqcHierarchyId "3.1.2.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Validating identified market opportunities by testing company's offerings on limited-size samples of the consumer population that are hypothesized to be representative of the target market at large and to have similar purchasing behavior. The feedback gained through consumer testing can be used to modify or reject product offerings before their full scale launch, saving the company valuable resources, should the initial offering not be successful." ;
    p1z:parentProcess apqc:PCF10119 .

apqc:PCF10121 a p1z:Process ;
    skos:prefLabel "Confirm internal capabilities" ;
    p1z:apqcId "10121" ;
    p1z:apqcHierarchyId "3.1.2.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Verifying that the company has sufficient infrastructure and resources to deliver their offerings in a timely and cost-effective manner, and that it is able to scale up from the small-scale market samples, used for consumer testing, to the entire identified market segment." ;
    p1z:parentProcess apqc:PCF10119 .

apqc:PCF16590 a p1z:Process ;
    skos:prefLabel "Define omni-channel strategy" ;
    p1z:apqcId "16590" ;
    p1z:apqcHierarchyId "3.2.4.7.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Devising a strategy to market company's products or services seamlessly through all or most channels that are in widespread use among the target market. This may mean cross-channel access to customer preferences and purchasing history to accept returned merchandise, provide refunds, resolve payment issues or to provide technical support." ;
    p1z:parentProcess apqc:PCF20004 .

apqc:PCF16591 a p1z:Process ;
    skos:prefLabel "Define omni-channel requirements" ;
    p1z:apqcId "16591" ;
    p1z:apqcHierarchyId "3.2.4.7.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying necessary preconditions that a channel should fulfill in order to be included as one of the adopted channels, such as required throughput capacities, service capabilities, competitive pricing, and alignment with organizational marketing strategies." ;
    p1z:parentProcess apqc:PCF20004 .

apqc:PCF16592 a p1z:Process ;
    skos:prefLabel "Develop omni-channel policies and procedures" ;
    p1z:apqcId "16592" ;
    p1z:apqcHierarchyId "3.2.4.7.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the detailed policies and procedures that each of the channels needs to follow in order to conform to the organizational marketing strategy and to provide seamless customer service experience." ;
    p1z:parentProcess apqc:PCF20004 .

apqc:PCF10190 a p1z:Process ;
    skos:prefLabel "Perform sales calls" ;
    p1z:apqcId "10190" ;
    p1z:apqcHierarchyId "3.5.1.8.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Communicating with customers and prospects with the intent of creating sales opportunities. Reach out to existing and prospective customers through alternate media and networking channels, apart from cold calling/emailing." ;
    p1z:parentProcess apqc:PCF10184 .

apqc:PCF10191 a p1z:Process ;
    skos:prefLabel "Perform pre-sales activities" ;
    p1z:apqcId "10191" ;
    p1z:apqcHierarchyId "3.5.1.8.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Capitalizing on sales calls by pitching on bids and closing deals. Outline the nature and scope of the work, draft agreement terms, prepare proposals and agreements, and propose timelines and prices." ;
    p1z:parentProcess apqc:PCF10184 .

apqc:PCF20012 a p1z:Process ;
    skos:prefLabel "Manage customer meetings/workshops" ;
    p1z:apqcId "20012" ;
    p1z:apqcHierarchyId "3.5.1.8.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Arranging and leading meetings, seminars, workshops and training events with customers to educate them about current offerings, best practices and technological advances to provide more value to customers and to increase their attrition and loyalty." ;
    p1z:parentProcess apqc:PCF10184 .

apqc:PCF10192 a p1z:Process ;
    skos:prefLabel "Close the sale" ;
    p1z:apqcId "10192" ;
    p1z:apqcHierarchyId "3.5.1.8.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Formalizing a sale by reaching an agreement on terms of the deal. Negotiate on the price, and reach a consensus on the terms and conditions." ;
    p1z:parentProcess apqc:PCF10184 .

apqc:PCF10193 a p1z:Process ;
    skos:prefLabel "Record outcome of sales process" ;
    p1z:apqcId "10193" ;
    p1z:apqcHierarchyId "3.5.1.8.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable true ;
    skos:definition "Completing all the paper-work associated with the sale of its products/services. Exchange any pertinent legal/financial information required for completing the sale, signing of a contract/work-order, and issuing copies of bills/invoices." ;
    p1z:parentProcess apqc:PCF10184 .

apqc:PCF16598 a p1z:Process ;
    skos:prefLabel "Collect and merge internal and third-party customer information" ;
    p1z:apqcId "16598" ;
    p1z:apqcHierarchyId "3.5.2.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Gathering the data about customers. Combine the information available locally with the data obtained from external sources." ;
    p1z:parentProcess apqc:PCF14208 .

apqc:PCF16599 a p1z:Process ;
    skos:prefLabel "De-duplicate customer data" ;
    p1z:apqcId "16599" ;
    p1z:apqcHierarchyId "3.5.2.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Eliminating redundant information in customer data." ;
    p1z:parentProcess apqc:PCF14208 .

apqc:PCF10201 a p1z:Process ;
    skos:prefLabel "Administer key account details" ;
    p1z:apqcId "10201" ;
    p1z:apqcHierarchyId "3.5.4.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing essential information of customer accounts." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10202 a p1z:Process ;
    skos:prefLabel "Retrieve full customer details" ;
    p1z:apqcId "10202" ;
    p1z:apqcHierarchyId "3.5.4.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining detailed information about customers." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10203 a p1z:Process ;
    skos:prefLabel "Modify involved party details" ;
    p1z:apqcId "10203" ;
    p1z:apqcHierarchyId "3.5.4.2.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Altering information about involved parties." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10204 a p1z:Process ;
    skos:prefLabel "Record address details" ;
    p1z:apqcId "10204" ;
    p1z:apqcHierarchyId "3.5.4.2.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting address information." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10205 a p1z:Process ;
    skos:prefLabel "Record contact details" ;
    p1z:apqcId "10205" ;
    p1z:apqcHierarchyId "3.5.4.2.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting contact information." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10206 a p1z:Process ;
    skos:prefLabel "Record key customer communication profile details" ;
    p1z:apqcId "10206" ;
    p1z:apqcHierarchyId "3.5.4.2.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing information about important business rules regarding communicating with customers." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10207 a p1z:Process ;
    skos:prefLabel "Review involved party information" ;
    p1z:apqcId "10207" ;
    p1z:apqcHierarchyId "3.5.4.2.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Revising information about involved parties." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF10208 a p1z:Process ;
    skos:prefLabel "Terminate involved party information" ;
    p1z:apqcId "10208" ;
    p1z:apqcHierarchyId "3.5.4.2.8" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Dismissing information about involved parties." ;
    p1z:parentProcess apqc:PCF10195 .

apqc:PCF20019 a p1z:Process ;
    skos:prefLabel "Provide certification enablement training" ;
    p1z:apqcId "20019" ;
    p1z:apqcHierarchyId "3.5.5.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Provide training and certification to develop strategies for marketing-driven sales." ;
    p1z:parentProcess apqc:PCF10211 .

apqc:PCF20020 a p1z:Process ;
    skos:prefLabel "Manage certifications and skills" ;
    p1z:apqcId "20020" ;
    p1z:apqcHierarchyId "3.5.5.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing, processing and issuing certifications and accrediting skills and competencies." ;
    p1z:parentProcess apqc:PCF10211 .

apqc:PCF20021 a p1z:Process ;
    skos:prefLabel "Provide support to partners/alliances" ;
    p1z:apqcId "20021" ;
    p1z:apqcHierarchyId "3.5.5.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Backing sales partners and strategic alliances." ;
    p1z:parentProcess apqc:PCF10211 .

apqc:PCF19567 a p1z:Process ;
    skos:prefLabel "Automate and control plant" ;
    p1z:apqcId "19567" ;
    p1z:apqcHierarchyId "4.3.2.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and applying technology to monitor and control the production and delivery of products and services. Automation involves a broad range of technologies." ;
    p1z:parentProcess apqc:PCF19566 .

apqc:PCF19568 a p1z:Process ;
    skos:prefLabel "Perform advanced process control" ;
    p1z:apqcId "19568" ;
    p1z:apqcHierarchyId "4.3.2.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Including a broad range of techniques and technologies implemented within industrial process control systems that are routinely reviewed, audited, and improved, advanced process controls typically address particular performance or economic improvement opportunities. An advanced set of process control measures can be used to reduce variation and identify primary improvement options. Results of analysis are fed back into process design for incorporation into production." ;
    p1z:parentProcess apqc:PCF19566 .

apqc:PCF19569 a p1z:Process ;
    skos:prefLabel "Perform real-time optimization" ;
    p1z:apqcId "19569" ;
    p1z:apqcHierarchyId "4.3.2.5.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Helping organizations increase performance and efficiency, real-time optimization is a category of closed-loop process control that aims at optimizing process performance in real time for systems. It is normally built upon model-based optimization systems and is usually large scale. Real-time optimization automatically detects errors, and can modify and eliminate both random and non-random errors, as well as analyze and monitor all systems involved." ;
    p1z:parentProcess apqc:PCF19566 .

apqc:PCF19570 a p1z:Process ;
    skos:prefLabel "Manage plant alarms and alerts" ;
    p1z:apqcId "19570" ;
    p1z:apqcHierarchyId "4.3.2.5.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Applying human factors and instrumentation engineering and systems thinking to manage the design of an alarm or alert system to increase its usability. Typical challenges include having too many alarms in a plant, poorly designed alarms/alerts, improperly set alarm/alert points, unclear alarm/alert messages, etc. Poor alarm management is one of the leading causes of unplanned downtime." ;
    p1z:parentProcess apqc:PCF19566 .

apqc:PCF12708 a p1z:Process ;
    skos:prefLabel "Determine quality of controlled part" ;
    p1z:apqcId "12708" ;
    p1z:apqcHierarchyId "4.4.2.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Implement a checks and balances system to verify that returned parts meet acceptable quality standards to determine appropriate disposition activity." ;
    p1z:parentProcess apqc:PCF20109 .

apqc:PCF10366 a p1z:Process ;
    skos:prefLabel "Perform salvage activities" ;
    p1z:apqcId "10366" ;
    p1z:apqcHierarchyId "4.4.2.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing activities for reinstating the returned products. Present the customer with additional incentives of compensation in case of any defective products delivery or any discrepancy in the product specifications in order to save the order from being permanently returned." ;
    p1z:parentProcess apqc:PCF20109 .

apqc:PCF21604 a p1z:Process ;
    skos:prefLabel "Manage repair/refurbishment" ;
    p1z:apqcId "21604" ;
    p1z:apqcHierarchyId "4.4.2.5.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering the reinstatement of the returned product in order to return them back to customers. Repair or remanufacture the defective or ineffective products returned by the customer. Process the delivery of the repaired or remanufactured products back to the customer." ;
    p1z:parentProcess apqc:PCF20109 .

apqc:PCF21605 a p1z:Process ;
    skos:prefLabel "Return to finished goods inventory" ;
    p1z:apqcId "21605" ;
    p1z:apqcHierarchyId "4.4.2.5.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Moving a returned product back to inventory or stock. Whether a product is sufficient as returned, repaired, or refurbished, moving that product back to inventory for resale or returning to customer is the fnal step in Manage disposition of returned products." ;
    p1z:parentProcess apqc:PCF20109 .

apqc:PCF21619 a p1z:Process ;
    skos:prefLabel "Process customer request" ;
    p1z:apqcId "21619" ;
    p1z:apqcHierarchyId "4.4.5.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Soliciting or acquiring information using various sources such as databases, customer interactions, and customer request forms. Hand them further up the hierarchy to deal with them. Categorize the user's request, determining if the request is supportable and prioritizing the request." ;
    p1z:parentProcess apqc:PCF21618 .

apqc:PCF21620 a p1z:Process ;
    skos:prefLabel "Create customer profile" ;
    p1z:apqcId "21620" ;
    p1z:apqcHierarchyId "4.4.5.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting the individual customer service requirements solicited, along with personal information of the customers, in order to generate customized profiles that hasten the delivery process." ;
    p1z:parentProcess apqc:PCF21618 .

apqc:PCF21621 a p1z:Process ;
    skos:prefLabel "Generate last mile delivery order" ;
    p1z:apqcId "21621" ;
    p1z:apqcHierarchyId "4.4.5.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a short-term agreement between the service provider and customer. One-time services are ordered by the service recipient and resource-related billing is performed upon completion. Use the service order to document service and customer service work." ;
    p1z:parentProcess apqc:PCF21618 .

apqc:PCF21623 a p1z:Process ;
    skos:prefLabel "Create resourcing plan and schedule" ;
    p1z:apqcId "21623" ;
    p1z:apqcHierarchyId "4.4.5.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan for sourcing and deploying the resources required to fulfill customer service needs. Document a detailed summary of all types of resources (equipment, finance, personnel, time, etc.) required to complete customer service requests and procure these resources. Identify and assess various sources in order to effectively create a resourcing plan." ;
    p1z:parentProcess apqc:PCF21622 .

apqc:PCF21624 a p1z:Process ;
    skos:prefLabel "Create last mile delivery service order fulfillment schedule" ;
    p1z:apqcId "21624" ;
    p1z:apqcHierarchyId "4.4.5.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a detailed summary of customer service order requirements, along with information concerning the timing and duration for these services. Categorize the customer needs. Monitor the services delivered." ;
    p1z:parentProcess apqc:PCF21622 .

apqc:PCF21626 a p1z:Process ;
    skos:prefLabel "Organize daily last mile delivery order fulfillment schedule" ;
    p1z:apqcId "21626" ;
    p1z:apqcHierarchyId "4.4.5.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Laying out a daily plan of specific service orders that need to be fulfilled. Document and systematically order these activities to ensure high effectiveness and efficiency." ;
    p1z:parentProcess apqc:PCF21625 .

apqc:PCF21627 a p1z:Process ;
    skos:prefLabel "Execute product delivery" ;
    p1z:apqcId "21627" ;
    p1z:apqcHierarchyId "4.4.5.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services." ;
    p1z:parentProcess apqc:PCF21625 .

apqc:PCF21628 a p1z:Process ;
    skos:prefLabel "Manage last mile delivery order fulfillment" ;
    p1z:apqcId "21628" ;
    p1z:apqcHierarchyId "4.4.5.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling and managing orders fulfilled, along with the orders are not or partially fulfilled to track the order fulfillment progress. Use electronic devices such as trackers and GPS in order track and ensure delivery of the orders." ;
    p1z:parentProcess apqc:PCF21625 .

apqc:PCF21630 a p1z:Process ;
    skos:prefLabel "Identify completed last mile delivery orders for feedback" ;
    p1z:apqcId "21630" ;
    p1z:apqcHierarchyId "4.4.5.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the service orders that have been successfully delivered. Identify the service orders completed and delivered to the customer. Leverage communication systems to ensure coordination with the customers in order to avoid mishaps." ;
    p1z:parentProcess apqc:PCF21629 .

apqc:PCF21631 a p1z:Process ;
    skos:prefLabel "Identify incomplete last mile delivery orders and last mile delivery service failures" ;
    p1z:apqcId "21631" ;
    p1z:apqcHierarchyId "4.4.5.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining orders which have not been completed or delivered. Identify the service orders that are partially or entirely incomplete, as well as the orders that have not been delivered to the customer. Use techniques such as project trackers to recognize the progress of the service orders." ;
    p1z:parentProcess apqc:PCF21629 .

apqc:PCF21632 a p1z:Process ;
    skos:prefLabel "Solicit customer feedback on last mile services delivered" ;
    p1z:apqcId "21632" ;
    p1z:apqcHierarchyId "4.4.5.4.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining and procuring customer reviews or feedback on the services delivered. Design a customer feedback form, or communicate with the customer through the phone or online." ;
    p1z:parentProcess apqc:PCF21629 .

apqc:PCF21633 a p1z:Process ;
    skos:prefLabel "Process customer feedback on last mile services delivered" ;
    p1z:apqcId "21633" ;
    p1z:apqcHierarchyId "4.4.5.4.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and incorporating customer reviews/feedback into the service plan to ensure high quality of service." ;
    p1z:parentProcess apqc:PCF21629 .

apqc:PCF20066 a p1z:Process ;
    skos:prefLabel "Establish people objectives" ;
    p1z:apqcId "20066" ;
    p1z:apqcHierarchyId "5.4.1.6.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing the workforce with a plan of action and goals necessary to provide a service. Make sure that those objectives are met." ;
    p1z:parentProcess apqc:PCF20065 .

apqc:PCF20067 a p1z:Process ;
    skos:prefLabel "Establish engagement rules" ;
    p1z:apqcId "20067" ;
    p1z:apqcHierarchyId "5.4.1.6.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing guidelines for how resources engage with the customer. For example, set rules of accountability, interaction, and accommodation when engaging the customer. Resources should be polite, empathetic, and attentive." ;
    p1z:parentProcess apqc:PCF20065 .

apqc:PCF20098 a p1z:Process ;
    skos:prefLabel "Define issue" ;
    p1z:apqcId "20098" ;
    p1z:apqcHierarchyId "6.3.2.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the issue of the claim. The warranty team will look into the issue and understand whether it is covered by the claim code or if more detail is required. Field service will be scheduled to further qualify the definition of the issue and to collect more evidence." ;
    p1z:parentProcess apqc:PCF20097 .

apqc:PCF12677 a p1z:Process ;
    skos:prefLabel "Schedule field service" ;
    p1z:apqcId "12677" ;
    p1z:apqcHierarchyId "6.3.2.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Scheduling additional investigative field service. This is performed for high priority claims or claims that require additional investigation. Field service engineers will gather additional information, perform further investigation, and qualify the definition of the issue." ;
    p1z:parentProcess apqc:PCF20097 .

apqc:PCF12678 a p1z:Process ;
    skos:prefLabel "Request and receive defective part" ;
    p1z:apqcId "12678" ;
    p1z:apqcHierarchyId "6.3.2.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Requesting receipt of a defective part for further investigation." ;
    p1z:parentProcess apqc:PCF20097 .

apqc:PCF20099 a p1z:Process ;
    skos:prefLabel "Investigate issue/perform root cause analysis" ;
    p1z:apqcId "20099" ;
    p1z:apqcHierarchyId "6.3.2.3.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Investigating claims by an appropriate functional representative. Once the issue has been clearly defined and diagnosed and a recommendation for corrective action is determined, it will be provided to the warranty management team." ;
    p1z:parentProcess apqc:PCF20097 .

apqc:PCF20100 a p1z:Process ;
    skos:prefLabel "Receive investigation result/recommendation for corrective action" ;
    p1z:apqcId "20100" ;
    p1z:apqcHierarchyId "6.3.2.3.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Receiving investigative results to assess claim approval or denial. The warranty team will assess the results of the investigation and the recommendations for corrective action." ;
    p1z:parentProcess apqc:PCF20097 .

apqc:PCF10324 a p1z:Process ;
    skos:prefLabel "Process customer request" ;
    p1z:apqcId "10324" ;
    p1z:apqcHierarchyId "6.3.4.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Soliciting or acquiring information using various sources such as databases, customer interactions, and customer request forms. Hand them further up the hierarchy to deal with them. Categorize the user's request, determining if the request is supportable and prioritizing the request." ;
    p1z:parentProcess apqc:PCF10320 .

apqc:PCF10325 a p1z:Process ;
    skos:prefLabel "Create customer profile" ;
    p1z:apqcId "10325" ;
    p1z:apqcHierarchyId "6.3.4.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Documenting the individual customer service requirements solicited, along with personal information of the customers, in order to generate customized profiles that hasten the delivery process." ;
    p1z:parentProcess apqc:PCF10320 .

apqc:PCF10326 a p1z:Process ;
    skos:prefLabel "Generate service order" ;
    p1z:apqcId "10326" ;
    p1z:apqcHierarchyId "6.3.4.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a short-term agreement between the service provider and customer. One-time services are ordered by the service recipient and resource-related billing is performed upon completion. Use the service order to document service and customer service work." ;
    p1z:parentProcess apqc:PCF10320 .

apqc:PCF10327 a p1z:Process ;
    skos:prefLabel "Create resourcing plan and schedule" ;
    p1z:apqcId "10327" ;
    p1z:apqcHierarchyId "6.3.4.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing a plan for sourcing and deploying the resources required to fulfill customer service needs. Document a detailed summary of all types of resources (equipment, finance, personnel, time, etc.) required to complete customer service requests and procure these resources. Identify and assess various sources in order to effectively create a resourcing plan." ;
    p1z:parentProcess apqc:PCF10321 .

apqc:PCF10328 a p1z:Process ;
    skos:prefLabel "Create service order fulfillment schedule" ;
    p1z:apqcId "10328" ;
    p1z:apqcHierarchyId "6.3.4.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a detailed summary of customer service order requirements, along with information concerning the timing and duration for these services. Categorize the customer needs. Monitor the services delivered." ;
    p1z:parentProcess apqc:PCF10321 .

apqc:PCF10330 a p1z:Process ;
    skos:prefLabel "Organize daily service order fulfillment schedule" ;
    p1z:apqcId "10330" ;
    p1z:apqcHierarchyId "6.3.4.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Laying out a daily plan of specific service orders that need to be fulfilled. Document and systematically order these activities to ensure high effectiveness and efficiency." ;
    p1z:parentProcess apqc:PCF10322 .

apqc:PCF10331 a p1z:Process ;
    skos:prefLabel "Execute product repair" ;
    p1z:apqcId "10331" ;
    p1z:apqcHierarchyId "6.3.4.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Dispatching and delivering the resources needed for the specific service requirements from the source/warehouse. Manage the dispatch, transportation, and delivery of the services." ;
    p1z:parentProcess apqc:PCF10322 .

apqc:PCF10332 a p1z:Process ;
    skos:prefLabel "Manage service order fulfillment" ;
    p1z:apqcId "10332" ;
    p1z:apqcHierarchyId "6.3.4.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling and managing orders fulfilled, along with the orders are not or partially fulfilled to track the order fulfillment progress. Use electronic devices such as trackers and GPS in order track and ensure delivery of the orders." ;
    p1z:parentProcess apqc:PCF10322 .

apqc:PCF10334 a p1z:Process ;
    skos:prefLabel "Identify completed service orders for feedback" ;
    p1z:apqcId "10334" ;
    p1z:apqcHierarchyId "6.3.4.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the service orders that have been successfully delivered. Identify the service orders completed and delivered to the customer. Leverage communication systems to ensure coordination with the customers in order to avoid mishaps." ;
    p1z:parentProcess apqc:PCF10323 .

apqc:PCF10335 a p1z:Process ;
    skos:prefLabel "Identify incomplete service orders and service failures" ;
    p1z:apqcId "10335" ;
    p1z:apqcHierarchyId "6.3.4.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable true ;
    skos:definition "Determining orders which have not been completed or delivered. Identify the service orders that are partially or entirely incomplete, as well as the orders that have not been delivered to the customer. Use techniques such as project trackers to recognize the progress of the service orders." ;
    p1z:parentProcess apqc:PCF10323 .

apqc:PCF10336 a p1z:Process ;
    skos:prefLabel "Solicit customer feedback on services delivered" ;
    p1z:apqcId "10336" ;
    p1z:apqcHierarchyId "6.3.4.4.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Obtaining and procuring customer reviews or feedback on the services delivered. Design a customer feedback form, or communicate with the customer through the phone or online." ;
    p1z:parentProcess apqc:PCF10323 .

apqc:PCF10337 a p1z:Process ;
    skos:prefLabel "Process customer feedback on services delivered" ;
    p1z:apqcId "10337" ;
    p1z:apqcHierarchyId "6.3.4.4.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing and incorporating customer reviews/feedback into the service plan to ensure high quality of service." ;
    p1z:parentProcess apqc:PCF10323 .

apqc:PCF21640 a p1z:Process ;
    skos:prefLabel "Develop and manage strategic workforce planning framework" ;
    p1z:apqcId "21640" ;
    p1z:apqcHierarchyId "7.1.2.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and maintaining the structure, principles, and approaches used to assess workforce supply and demand, capabilities, and gaps over the strategic planning horizon." ;
    p1z:parentProcess apqc:PCF21693 .

apqc:PCF10424 a p1z:Process ;
    skos:prefLabel "Perform business unit workforce planning" ;
    p1z:apqcId "10424" ;
    p1z:apqcHierarchyId "7.1.2.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the requirements for employees and the need for employee resourcing for each unit/function. Lay out a plan detailing employee resourcing requirements of individual functions and the organization as a whole." ;
    p1z:parentProcess apqc:PCF21693 .

apqc:PCF21641 a p1z:Process ;
    skos:prefLabel "Advise business in implementing strategic workforce planning" ;
    p1z:apqcId "21641" ;
    p1z:apqcHierarchyId "7.1.2.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing guidance and expertise to business leaders on applying the strategic workforce planning framework to inform workforce decisions, plans, and initiatives." ;
    p1z:parentProcess apqc:PCF21693 .

apqc:PCF21642 a p1z:Process ;
    skos:prefLabel "Partner with the business to execute workforce plan" ;
    p1z:apqcId "21642" ;
    p1z:apqcHierarchyId "7.1.2.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Collaborating with business leaders to translate workforce plans into actionable initiatives and to support execution of agreed workforce actions." ;
    p1z:parentProcess apqc:PCF21693 .

apqc:PCF21643 a p1z:Process ;
    skos:prefLabel "Monitor and adjust strategic workforce plan" ;
    p1z:apqcId "21643" ;
    p1z:apqcHierarchyId "7.1.2.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Tracking workforce outcomes and changes in business needs to update workforce plans and address emerging gaps, risks, or opportunities." ;
    p1z:parentProcess apqc:PCF21693 .

apqc:PCF21644 a p1z:Process ;
    skos:prefLabel "Establish wages, salaries, and benefits strategy" ;
    p1z:apqcId "21644" ;
    p1z:apqcHierarchyId "7.1.2.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the strategic approach for wages, salaries, and benefits to support workforce attraction, retention, performance, and alignment with organizational objectives and market conditions." ;
    p1z:parentProcess apqc:PCF10425 .

apqc:PCF10210 a p1z:Process ;
    skos:prefLabel "Establish incentive strategy" ;
    p1z:apqcId "10210" ;
    p1z:apqcHierarchyId "7.1.2.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a scheme of rewards and recognition for employees to promote a results-based culture. Create specific incentives to reach desired outcomes, such as landing key clients, growing the customer base, providing exceptional servicing, and increasing profit margins." ;
    p1z:parentProcess apqc:PCF10425 .

apqc:PCF21645 a p1z:Process ;
    skos:prefLabel "Establish a severance pay strategy" ;
    p1z:apqcId "21645" ;
    p1z:apqcHierarchyId "7.1.2.2.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the approach to severance pay, including principles and guidelines, to support workforce transitions while managing financial, legal, and reputational considerations." ;
    p1z:parentProcess apqc:PCF10425 .

apqc:PCF20124 a p1z:Process ;
    skos:prefLabel "Complete position classification and level of experience" ;
    p1z:apqcId "20124" ;
    p1z:apqcHierarchyId "7.2.5.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the requirements for the position to be filled. Determine the experience and skills necessary to perform the tasks outlined." ;
    p1z:parentProcess apqc:PCF10467 .

apqc:PCF21702 a p1z:Process ;
    skos:prefLabel "Identify critical roles" ;
    p1z:apqcId "21702" ;
    p1z:apqcHierarchyId "7.3.3.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining roles that are essential to organizational performance or continuity and that require succession planning." ;
    p1z:parentProcess apqc:PCF21701 .

apqc:PCF21703 a p1z:Process ;
    skos:prefLabel "Select potential successors" ;
    p1z:apqcId "21703" ;
    p1z:apqcHierarchyId "7.3.3.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying and selecting employees with the potential to assume critical roles based on defined criteria and future capability requirements." ;
    p1z:parentProcess apqc:PCF21701 .

apqc:PCF21704 a p1z:Process ;
    skos:prefLabel "Develop and implement individual succession plans" ;
    p1z:apqcId "21704" ;
    p1z:apqcHierarchyId "7.3.3.4.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating and executing development plans for identified successors to prepare them for future roles through targeted learning and experience opportunities." ;
    p1z:parentProcess apqc:PCF21701 .

apqc:PCF21705 a p1z:Process ;
    skos:prefLabel "Review and update succession plans" ;
    p1z:apqcId "21705" ;
    p1z:apqcHierarchyId "7.3.3.4.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Reviewing succession plans on a regular basis and updating them to reflect changes in roles, talent, organizational priorities, and performance outcomes." ;
    p1z:parentProcess apqc:PCF21701 .

apqc:PCF20126 a p1z:Process ;
    skos:prefLabel "Liaise with external certification authorities" ;
    p1z:apqcId "20126" ;
    p1z:apqcHierarchyId "7.3.4.6.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Coordinating with third party certification authorities to provide training and certifications for necessary skills." ;
    p1z:parentProcess apqc:PCF20125 .

apqc:PCF20127 a p1z:Process ;
    skos:prefLabel "Administer certification tests" ;
    p1z:apqcId "20127" ;
    p1z:apqcHierarchyId "7.3.4.6.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Providing tests to the workforce that will satisfy completion of certifications." ;
    p1z:parentProcess apqc:PCF20125 .

apqc:PCF20128 a p1z:Process ;
    skos:prefLabel "Appraise experience qualifications" ;
    p1z:apqcId "20128" ;
    p1z:apqcHierarchyId "7.3.4.6.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Ascertaining the experience level needed to qualify for a specific job or certification within the organization. Some certificates require practical experience as well as training programs." ;
    p1z:parentProcess apqc:PCF20125 .

apqc:PCF20129 a p1z:Process ;
    skos:prefLabel "Administer certificate issue and maintenance" ;
    p1z:apqcId "20129" ;
    p1z:apqcHierarchyId "7.3.4.6.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Administering certificates to all candidates that have successfully met experience qualifications, and passed all tests necessary to obtain the certificate." ;
    p1z:parentProcess apqc:PCF20125 .

apqc:PCF21440 a p1z:Process ;
    skos:prefLabel "Manage flexible working" ;
    p1z:apqcId "21440" ;
    p1z:apqcHierarchyId "7.5.3.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creation and execution of a plan that might allow for work from home days, or alternate hours." ;
    p1z:parentProcess apqc:PCF10508 .

apqc:PCF21709 a p1z:Process ;
    skos:prefLabel "Manage transportation programs and services" ;
    p1z:apqcId "21709" ;
    p1z:apqcHierarchyId "7.5.3.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Managing transportation-related programs and services provided to employees to support commuting, mobility, and work/life balance objectives." ;
    p1z:parentProcess apqc:PCF10508 .

apqc:PCF21695 a p1z:Process ;
    skos:prefLabel "Align IT risk management with cybersecurity frameworks" ;
    p1z:apqcId "21695" ;
    p1z:apqcHierarchyId "8.3.1.10.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Include alignment with established cybersecurity frameworks like NIST CSF, ISO 27001, and ENISA risk management guidelines." ;
    p1z:parentProcess apqc:PCF20715 .

apqc:PCF21696 a p1z:Process ;
    skos:prefLabel "Integrate IT and OT risk management strategies" ;
    p1z:apqcId "21696" ;
    p1z:apqcHierarchyId "8.3.1.10.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensure risk management processes are extended to cover OT systems and environments." ;
    p1z:parentProcess apqc:PCF20715 .

apqc:PCF21691 a p1z:Process ;
    skos:prefLabel "Implement multi-factor authentication (MFA)" ;
    p1z:apqcId "21691" ;
    p1z:apqcHierarchyId "8.3.8.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
