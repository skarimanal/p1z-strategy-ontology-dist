    p1z:apqcId "19577" ;
    p1z:apqcHierarchyId "9.7.5.2.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding the requirements on interest rate investments that are made by trading in futures or options market, on the basis of the accepted risk policy." ;
    p1z:parentProcess apqc:PCF11209 .

apqc:PCF19578 a p1z:Process ;
    skos:prefLabel "Execute interest rate trades" ;
    p1z:apqcId "19578" ;
    p1z:apqcHierarchyId "9.7.5.2.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Performing trading on interest rates." ;
    p1z:parentProcess apqc:PCF11209 .

apqc:PCF19579 a p1z:Process ;
    skos:prefLabel "Manage foreign exchange market data" ;
    p1z:apqcId "19579" ;
    p1z:apqcHierarchyId "9.7.5.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling and processing information about changes in foreign exchange rates." ;
    p1z:parentProcess apqc:PCF11210 .

apqc:PCF19580 a p1z:Process ;
    skos:prefLabel "Determine foreign exchange exposure for all currencies" ;
    p1z:apqcId "19580" ;
    p1z:apqcHierarchyId "9.7.5.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing potential foreign exchange risks for all currencies." ;
    p1z:parentProcess apqc:PCF11210 .

apqc:PCF19581 a p1z:Process ;
    skos:prefLabel "Determine foreign exchange hedge requirements in accordance with risk policy" ;
    p1z:apqcId "19581" ;
    p1z:apqcHierarchyId "9.7.5.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding the requirements on investments in foreign exchange made by trading in futures or options market, on the basis of current risk policy." ;
    p1z:parentProcess apqc:PCF11210 .

apqc:PCF19582 a p1z:Process ;
    skos:prefLabel "Execute foreign exchange trades" ;
    p1z:apqcId "19582" ;
    p1z:apqcHierarchyId "9.7.5.3.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Executing all aspects for foreign exchange trade within foreign exchange market. This includes buying, selling, and exchanging currencies at the current or expressed price point." ;
    p1z:parentProcess apqc:PCF11210 .

apqc:PCF19583 a p1z:Process ;
    skos:prefLabel "Manage foreign exchange balance sheet risk" ;
    p1z:apqcId "19583" ;
    p1z:apqcHierarchyId "9.7.5.3.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Overseeing the foreign exchange balance sheet with an eye towards potential risk. Risks include changes in conversion rates between the time the transaction occurred and when it is completed, or when transactions are made in a denomination other than that of the organization's base currency." ;
    p1z:parentProcess apqc:PCF11210 .

apqc:PCF19584 a p1z:Process ;
    skos:prefLabel "Determine current customer exposures and limit exceptions" ;
    p1z:apqcId "19584" ;
    p1z:apqcHierarchyId "9.7.5.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing ongoing risks that the customers face, and the exceptions to exceeded limits." ;
    p1z:parentProcess apqc:PCF11211 .

apqc:PCF19585 a p1z:Process ;
    skos:prefLabel "Resolve customer exposure limit violations" ;
    p1z:apqcId "19585" ;
    p1z:apqcHierarchyId "9.7.5.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Settling cases that involve violations of customer exposure limit." ;
    p1z:parentProcess apqc:PCF11211 .

apqc:PCF19586 a p1z:Process ;
    skos:prefLabel "Manage customer collateral" ;
    p1z:apqcId "19586" ;
    p1z:apqcHierarchyId "9.7.5.4.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Handling customer securities to recover loans that are not paid back." ;
    p1z:parentProcess apqc:PCF11211 .

apqc:PCF19587 a p1z:Process ;
    skos:prefLabel "Perform annual customer credit reviews" ;
    p1z:apqcId "19587" ;
    p1z:apqcHierarchyId "9.7.5.4.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Conducting reviews to assess customer credit on a yearly basis. Introduce changes or make recommendations, if needed." ;
    p1z:parentProcess apqc:PCF11211 .

apqc:PCF19588 a p1z:Process ;
    skos:prefLabel "Measure physical positions" ;
    p1z:apqcId "19588" ;
    p1z:apqcHierarchyId "9.7.5.5.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating investments made in some market to offset the risks of investing in a contrary or opposing market." ;
    p1z:parentProcess apqc:PCF20137 .

apqc:PCF19589 a p1z:Process ;
    skos:prefLabel "Establish hedges" ;
    p1z:apqcId "19589" ;
    p1z:apqcHierarchyId "9.7.5.5.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining which hedge options to execute." ;
    p1z:parentProcess apqc:PCF20137 .

apqc:PCF19590 a p1z:Process ;
    skos:prefLabel "Unwind hedges" ;
    p1z:apqcId "19590" ;
    p1z:apqcHierarchyId "9.7.5.5.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Closing out a position or cashing in derivatives early." ;
    p1z:parentProcess apqc:PCF20137 .

apqc:PCF11213 a p1z:Process ;
    skos:prefLabel "Evaluate and refine hedging positions" ;
    p1z:apqcId "11213" ;
    p1z:apqcHierarchyId "9.7.5.5.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Examining options in the market for hedging investments. Select an option." ;
    p1z:parentProcess apqc:PCF20137 .

apqc:PCF11215 a p1z:Process ;
    skos:prefLabel "Monitor credit" ;
    p1z:apqcId "11215" ;
    p1z:apqcHierarchyId "9.7.5.5.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Revising credit reports periodically for accurateness and changes that could be suggestive of duplicitous activity." ;
    p1z:parentProcess apqc:PCF20137 .

apqc:PCF18129 a p1z:Process ;
    skos:prefLabel "Assess adequacy of insurance coverage" ;
    p1z:apqcId "18129" ;
    p1z:apqcHierarchyId "11.1.3.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the changing needs for insurance coverage. Research available insurance providers and offerings." ;
    p1z:parentProcess apqc:PCF16458 .

apqc:PCF20140 a p1z:Process ;
    skos:prefLabel "Identify published best practices" ;
    p1z:apqcId "20140" ;
    p1z:apqcHierarchyId "13.1.3.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Realizing those practices and procedures that are the most effective to the success of the business and making that information available." ;
    p1z:parentProcess apqc:PCF16389 .

apqc:PCF20141 a p1z:Process ;
    skos:prefLabel "Identify additional metrics as required" ;
    p1z:apqcId "20141" ;
    p1z:apqcHierarchyId "13.1.4.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the need for additional performance indicators that would be necessary to successfully achieve the business goal." ;
    p1z:parentProcess apqc:PCF16395 .

apqc:PCF11117 a p1z:Process ;
    skos:prefLabel "Identify project requirements and objectives" ;
    p1z:apqcId "11117" ;
    p1z:apqcHierarchyId "13.2.3.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Recognizing and defining what the project is ultimately supposed to do. Specify the capabilities, features, or attributes of the project's deliverables, as well as any kind of formal documentation." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF16412 a p1z:Process ;
    skos:prefLabel "Identify project resource requirements" ;
    p1z:apqcId "16412" ;
    p1z:apqcHierarchyId "13.2.3.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Identifying the prerequisites of business projects. Identify the people with appropriate and applicable skills and competencies. Locate resources such as capital, facilities, equipment, material, and information required to accomplish the objectives of a specific project." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF11118 a p1z:Process ;
    skos:prefLabel "Assess culture and readiness for project management approach" ;
    p1z:apqcId "11118" ;
    p1z:apqcHierarchyId "13.2.3.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating the culture and readiness of the organizational environment is order to implement the project management approach." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF11120 a p1z:Process ;
    skos:prefLabel "Create business case" ;
    p1z:apqcId "11120" ;
    p1z:apqcHierarchyId "13.2.3.1.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a document that includes the current situation, proposed solution, financial analysis, conclusion, etc. Convince a decision maker and investors to approve the project. Obtain funding." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF11121 a p1z:Process ;
    skos:prefLabel "Develop project measures and indicators" ;
    p1z:apqcId "11121" ;
    p1z:apqcHierarchyId "13.2.3.1.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Developing procedures and indictors to assess performance of business projects. Design and develop metrics and indicators--such as cost, schedule, resources, risk, and quality--that exhibit the performance of the business projects." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF21454 a p1z:Process ;
    skos:prefLabel "Prioritize and select projects for the portfolio" ;
    p1z:apqcId "21454" ;
    p1z:apqcHierarchyId "13.2.3.1.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Stack ranking of projects in the portfolio based upon preestablished criteria." ;
    p1z:parentProcess apqc:PCF16411 .

apqc:PCF11123 a p1z:Process ;
    skos:prefLabel "Define roles and resources" ;
    p1z:apqcId "11123" ;
    p1z:apqcHierarchyId "13.2.3.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the resources and their roles in the business projects." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF20142 a p1z:Process ;
    skos:prefLabel "Acquire/secure project resources" ;
    p1z:apqcId "20142" ;
    p1z:apqcHierarchyId "13.2.3.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Procuring the necessary resources outlined in Define roles and resources [11123]" ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11124 a p1z:Process ;
    skos:prefLabel "Identify specific IT requirements" ;
    p1z:apqcId "11124" ;
    p1z:apqcHierarchyId "13.2.3.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining the IT requirements for specific business projects. Identify the requirements of computers and telecommunications equipment to store, retrieve, transmit, and manipulate data related to the project. Consider factors such as functional requirements, design requirements, project phases, and project schedule." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11125 a p1z:Process ;
    skos:prefLabel "Create training and communication plans" ;
    p1z:apqcId "11125" ;
    p1z:apqcHierarchyId "13.2.3.3.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Designing a plan for equipping the project team with the necessary skills and abilities to fulfill their roles and responsibilities in the project effectively and efficiently. Offer formal training, mentoring, or coaching. Initiate informal conversations. Communicate messages during the project." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11127 a p1z:Process ;
    skos:prefLabel "Design recognition and reward approaches" ;
    p1z:apqcId "11127" ;
    p1z:apqcHierarchyId "13.2.3.3.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan for recognizing and rewarding extraordinary performances within the business projects. Use incentives, bonuses, and certificates for recognition and rewarding purposes." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11128 a p1z:Process ;
    skos:prefLabel "Design and plan launch of project" ;
    p1z:apqcId "11128" ;
    p1z:apqcHierarchyId "13.2.3.3.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Creating a plan specifying when to initiate the project, and introducing it to the target audience. Clearly define the project team, objectives, timelines, and milestone." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11129 a p1z:Process ;
    skos:prefLabel "Deploy the project" ;
    p1z:apqcId "11129" ;
    p1z:apqcHierarchyId "13.2.3.3.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Putting the project into position by effectively bringing it into action." ;
    p1z:parentProcess apqc:PCF16413 .

apqc:PCF11131 a p1z:Process ;
    skos:prefLabel "Evaluate impact of project management (strategy and projects) on measures and outcomes" ;
    p1z:apqcId "11131" ;
    p1z:apqcHierarchyId "13.2.3.4.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the impact of business project management on the measures and outcomes of the projects. Gauge non-financial measures, frequency of measurement, action plan, etc." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF16415 a p1z:Process ;
    skos:prefLabel "Report the status of project" ;
    p1z:apqcId "16415" ;
    p1z:apqcHierarchyId "13.2.3.4.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Recording and documenting the current status and position of the project. Record and report items such as completed tasks, incomplete tasks, planned tasks, and problems faced." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF16416 a p1z:Process ;
    skos:prefLabel "Manage project scope" ;
    p1z:apqcId "16416" ;
    p1z:apqcHierarchyId "13.2.3.4.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Determining and documenting a list of specific project goals, deliverables, tasks, costs, and deadlines. Use the scope statement to explain the boundaries of the project. Assign responsibilities for team members. Set up procedures for verifying and approving the completed tasks." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF11132 a p1z:Process ;
    skos:prefLabel "Promote and sustain activity and involvement" ;
    p1z:apqcId "11132" ;
    p1z:apqcHierarchyId "13.2.3.4.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Encouraging and sustaining the activities and involvement while executing projects. Promote the execution activities of the projects. Encourage employee involvement in project implementation." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF21455 a p1z:Process ;
    skos:prefLabel "Conduct Project Reviews with Program Managers and other stakeholders" ;
    p1z:apqcId "21455" ;
    p1z:apqcHierarchyId "13.2.3.4.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Hold post project reviews, lessons learned, or After Action Reviews (AARs) at the end of each project to understand what could be improved during future projects." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF11133 a p1z:Process ;
    skos:prefLabel "Realign and refresh project management strategy and approaches" ;
    p1z:apqcId "11133" ;
    p1z:apqcHierarchyId "13.2.3.4.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Reorganizing and stimulating the approach and strategy for managing business projects. Make improvements based on the project scope and on findings from Evaluate the impact of project management (strategy and projects) on measures and outcomes [11131]." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF21456 a p1z:Process ;
    skos:prefLabel "Adjust project plan as needed" ;
    p1z:apqcId "21456" ;
    p1z:apqcHierarchyId "13.2.3.4.7" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Changes to project plans based upon internal and or external influences on the project.  This would include the update to the project plan file, as well as the communication to the team." ;
    p1z:parentProcess apqc:PCF16414 .

apqc:PCF17476 a p1z:Process ;
    skos:prefLabel "Define process steps for controls (or integration points)" ;
    p1z:apqcId "17476" ;
    p1z:apqcHierarchyId "13.3.1.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing the steps for developing quality controls. Conduct Alpha testing. Have the product team conduct rework. Send the product/service for Beta testing, and carry on rework as needed." ;
    p1z:parentProcess apqc:PCF17475 .

apqc:PCF17477 a p1z:Process ;
    skos:prefLabel "Define sampling plan" ;
    p1z:apqcId "17477" ;
    p1z:apqcHierarchyId "13.3.1.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing a detailed summary including measures, on which material, in what manner, and by whom. Identify the parameters to be measured, the range of possible values, and the required resolution. Provide a sampling scheme that details how and when samples will be taken. Select sample sizes. Assign roles and responsibilities." ;
    p1z:parentProcess apqc:PCF17475 .

apqc:PCF17478 a p1z:Process ;
    skos:prefLabel "Identify measurement methods" ;
    p1z:apqcId "17478" ;
    p1z:apqcHierarchyId "13.3.1.3.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Using tools to measure quality. Use tools such as quality improvement oversight system tool, performance measurement tools, consumer information models/guides, and validation tools to effectively determine the quality levels." ;
    p1z:parentProcess apqc:PCF17475 .

apqc:PCF17479 a p1z:Process ;
    skos:prefLabel "Define required competencies" ;
    p1z:apqcId "17479" ;
    p1z:apqcHierarchyId "13.3.1.3.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining the competencies required for developing quality controls. Define the required competencies including compliance management, audit management, and document control and document management." ;
    p1z:parentProcess apqc:PCF17475 .

apqc:PCF17484 a p1z:Process ;
    skos:prefLabel "Conduct test and collect data" ;
    p1z:apqcId "17484" ;
    p1z:apqcHierarchyId "13.3.2.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Evaluating quality performance through periodic or episodic testing against the established standards for quality characteristics. For periodic testing, design a schedule with sufficient time to make any required adjustments to the process or system to maintain the desired level of quality. For episodic testing, conduct a test whenever a known non-conformance or fault occurs, which results in outputs or outcomes known to be unsatisfactory to performance requirements." ;
    p1z:parentProcess apqc:PCF17483 .

apqc:PCF17485 a p1z:Process ;
    skos:prefLabel "Record result(s)" ;
    p1z:apqcId "17485" ;
    p1z:apqcHierarchyId "13.3.2.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining and recording the results of Test against the quality plan [17483] electronically and in standard formats. Assign ownership to a designated function or role." ;
    p1z:parentProcess apqc:PCF17483 .

apqc:PCF17486 a p1z:Process ;
    skos:prefLabel "Determine disposition of result(s)" ;
    p1z:apqcId "17486" ;
    p1z:apqcHierarchyId "13.3.2.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Deciding whether to take any additional actions based on the results of quality tests. Initiate a quarantine disposition and relocated inventory, scrap workflow item and scrap transaction, rework operation, net-able and nonnet-able items, and the activity list." ;
    p1z:parentProcess apqc:PCF17483 .

apqc:PCF17488 a p1z:Process ;
    skos:prefLabel "Assess sample significance" ;
    p1z:apqcId "17488" ;
    p1z:apqcHierarchyId "13.3.2.2.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Assessing the significance of the sample chosen for the test in order to determine whether or not the sample is representative of the larger output or outcome. Determine if the sample meets or does not meet the requirements. Identify the conditions for acceptance, rejection, remediation, and prevention." ;
    p1z:parentProcess apqc:PCF17487 .

apqc:PCF17489 a p1z:Process ;
    skos:prefLabel "Summarize result(s)" ;
    p1z:apqcId "17489" ;
    p1z:apqcHierarchyId "13.3.2.2.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Outlining the major facts and figures of the quality test results in order to provide insights and information. Use charts, tables, statistical test results, and written findings and conclusions in a summary of results." ;
    p1z:parentProcess apqc:PCF17487 .

apqc:PCF17490 a p1z:Process ;
    skos:prefLabel "Recommend actions" ;
    p1z:apqcId "17490" ;
    p1z:apqcHierarchyId "13.3.2.2.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Recommending measures for improvement. Assess the summarized results to identify areas which can be improved. Suggest actions to management for improving the quality plan basis on the results of the tests." ;
    p1z:parentProcess apqc:PCF17487 .

apqc:PCF17491 a p1z:Process ;
    skos:prefLabel "Decide next steps" ;
    p1z:apqcId "17491" ;
    p1z:apqcHierarchyId "13.3.2.2.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Selecting the subsequent actions that the organization can adopt for improving the enterprise quality. Select measures and recommended actions for managing the enterprise quality." ;
    p1z:parentProcess apqc:PCF17487 .

apqc:PCF17505 a p1z:Process ;
    skos:prefLabel "Reward quality excellence" ;
    p1z:apqcId "17505" ;
    p1z:apqcHierarchyId "13.3.4.6.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Provisioning rewards for achieving quality excellence. Provide monetary and nonmonetary rewards such as compensation, vacations, gift cards, and reimbursements to employees in in recognition of their services, efforts, and achievements in quality excellence." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF17506 a p1z:Process ;
    skos:prefLabel "Create and maintain quality partnerships" ;
    p1z:apqcId "17506" ;
    p1z:apqcHierarchyId "13.3.4.6.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Establishing and maintaining partnerships with third-party sources to achieve quality excellence. Source and evaluate third-party sources both public and private to ensure that the most effective and efficient partnerships are formed." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF17507 a p1z:Process ;
    skos:prefLabel "Maintain talent capabilities and competencies" ;
    p1z:apqcId "17507" ;
    p1z:apqcHierarchyId "13.3.4.6.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Maintaining a common denominator for the competency level within the organization's talent circle. Conduct training sessions, skill development activities, and quality excellence activities to ensure that the resources of the organization are competent enough and have the capabilities to achieve the required level of quality." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF17508 a p1z:Process ;
    skos:prefLabel "Incorporate EQMS messaging into communication channels" ;
    p1z:apqcId "17508" ;
    p1z:apqcHierarchyId "13.3.4.6.4" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Assimilating all the communication related to the EQMS into the organization's already established communication channels." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF17509 a p1z:Process ;
    skos:prefLabel "Assure independent EQMS management access to appropriate authority in the organization" ;
    p1z:apqcId "17509" ;
    p1z:apqcHierarchyId "13.3.4.6.5" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Ensuring EQMS access to the person in charge of the quality management process. Establish who has the authority to manage the EQMS. Ensure access of EQMS to only the person(s) in authority." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF17510 a p1z:Process ;
    skos:prefLabel "Transfer proven EQMS methods" ;
    p1z:apqcId "17510" ;
    p1z:apqcHierarchyId "13.3.4.6.6" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Recording and transferring the best practices and proven methods associated with enterprise quality management systems (EQMS) that can be leveraged in improving the organization's framework. Record proven methodologies and approaches with the objective of communicating them for upgrading, refining, and enhancing the organization's systems." ;
    p1z:parentProcess apqc:PCF17504 .

apqc:PCF21591 a p1z:Process ;
    skos:prefLabel "Define sustainability disclosure requirements" ;
    p1z:apqcId "21591" ;
    p1z:apqcHierarchyId "13.10.1.1.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining and communicating sustainability disclosure requirements. Clarify and align disclosure requirements to other organizational reporting requirements and needs. Integrate preparation and reporting activities." ;
    p1z:parentProcess apqc:PCF21590 .

apqc:PCF21592 a p1z:Process ;
    skos:prefLabel "Define sustainability governance requirements" ;
    p1z:apqcId "21592" ;
    p1z:apqcHierarchyId "13.10.1.1.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining governance requirements for sustainability. Include structure, roles, alignment to organization models, processes and standards to be applied." ;
    p1z:parentProcess apqc:PCF21590 .

apqc:PCF21593 a p1z:Process ;
    skos:prefLabel "Define sustainability functional and performance requirements" ;
    p1z:apqcId "21593" ;
    p1z:apqcHierarchyId "13.10.1.1.3" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Defining functional and performance requirements for sustainability. Align with ESG strategies, goals, and the implementation of sustainability efforts across the organization, provide a roadmap and visibility to shared and collective requirements." ;
    p1z:parentProcess apqc:PCF21590 .

apqc:PCF21602 a p1z:Process ;
    skos:prefLabel "Measure sustainability performance" ;
    p1z:apqcId "21602" ;
    p1z:apqcHierarchyId "13.10.2.3.1" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Measuring sustainability performance. Setup, collect, and validate sustainability data. Conduct audits and inspections. Evaluate results to requirements and targets. Identify and track resolution of gaps and variances." ;
    p1z:parentProcess apqc:PCF21601 .

apqc:PCF21603 a p1z:Process ;
    skos:prefLabel "Prepare sustainability statements" ;
    p1z:apqcId "21603" ;
    p1z:apqcHierarchyId "13.10.2.3.2" ;
    p1z:apqcLevel 5 ;
    p1z:metricsAvailable false ;
    skos:definition "Preparing sustainability statements. Given the multitude of potential audiences for reporting, alignment and consistency of sustainability statements provides clarity and reusability for those audiences." ;
    p1z:parentProcess apqc:PCF21601 .

