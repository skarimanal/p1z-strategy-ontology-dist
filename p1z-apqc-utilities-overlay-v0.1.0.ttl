    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

