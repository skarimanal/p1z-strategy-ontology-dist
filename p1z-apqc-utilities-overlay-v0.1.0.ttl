    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Overhead cost to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

apqc:MET105538 a p1z:Metric ;
    skos:prefLabel "Systems cost to perform the finance function as a percentage of internal finance function cost" ;
    p1z:apqcMetricId "105538" ;
    p1z:metricClass p1zv:OperationalDriver ;
    p1z:apqcMetricCategory p1zv:SupplementalInformation ;
    p1z:formula "(Systems cost to perform the function \"manage financial resources\" / (Personnel cost to perform the function \"manage financial resources\" + Systems cost to perform the function \"manage financial resources\" + Overhead cost to perform the function \"manage financial resources\" + Costs other than personnel, systems, overhead, and outsourced to perform the function \"manage financial resources\")) * 100" ;
    p1z:units "percent" .

apqc:MET105540 a p1z:Metric ;
