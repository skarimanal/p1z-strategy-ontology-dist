@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix p1z:  <https://ontology.pointonezero.com/strategy/core#> .
@prefix p1zn: <https://ontology.pointonezero.com/strategy/industry-classification#> .

<https://ontology.pointonezero.com/strategy/industry-classification> a owl:Ontology ;
    dct:title "P1Z Industry Classification Vocabulary (NAICS / NACE)" ;
    owl:versionInfo "0.1.0" ;
    dct:source "North American Industry Classification System (NAICS) 2022, U.S. Census Bureau; Statistical classification of economic activities in the European Community (NACE) Rev. 2, Eurostat" ;
    dct:description "A standalone company-classification vocabulary, deliberately outside the process-taxonomy pipeline: NAICS classifies what a company is; APQC classifies what work is done. Two SKOS concept schemes at the top level of each standard (20 NAICS sectors, 21 NACE Rev. 2 sections) with skos:closeMatch alignments, used to tag Company and StrategyBinding instances via industryClassification, and later benchmark observations, since benchmark sources differ on which standard they report against. NAICS is primary given the US client base. Publisher codes are the stable keys (URIs and skos:notation). Deeper codes (subsectors through 6-digit national industries) are added per engagement need under the same schemes, never in bulk. Fast-drifting vocabularies version independently of the core; note NACE Rev. 2.1 applies in EU statistics from 2025 and adoption here is a governed change to this file alone." .

p1zn:NaicsScheme a skos:ConceptScheme ;
    skos:prefLabel "NAICS 2022 Sectors" ;
    skos:definition "The 20 sectors of NAICS 2022. Partition principle: the primary economic activity of the establishment." .

p1zn:NaceScheme a skos:ConceptScheme ;
    skos:prefLabel "NACE Rev. 2 Sections" ;
    skos:definition "The 21 sections of NACE Rev. 2. Partition principle: the principal economic activity of the unit." .

p1zn:N11 a skos:Concept ;
    skos:inScheme p1zn:NaicsScheme ;
    skos:notation "11" ;
    skos:prefLabel "Agriculture, Forestry, Fishing and Hunting" ;
    skos:closeMatch p1zn:NACE-A .

p1zn:N21 a skos:Concept ;
